flowchart TB
    subgraph WECOM[Enterprise WeCom]
        GROUP[临床报修群]
        DIRECT[机器人单聊]
        BOT[信息保障助手]
    end

    subgraph PILOT[Phase 1 公网试点]
        ADAPTER[WeCom SDK Adapter]
        GATEWAY[WeCom Gateway]
        MESSAGE[Channel Message]
        INTAKE[Service Intake]
        PILOT_TICKET[Pilot Ticket Core]
        INCIDENT[Incident]
        OUTBOX[Notification Outbox]
        DELIVERY[Delivery Worker]
        PG[(Pilot PostgreSQL)]
    end

    subgraph AI[Phase 2 异步增强]
        RULES[规则/系统指纹]
        OCR[OCR Service]
        TRIAGE[AI Triage]
    end

    subgraph HOSPITAL[Phase 3 医院融合]
        TICKET_ADAPTER[Ticket Adapter]
        HOSPITAL_TICKETS[Hospital Tickets]
        MAPPING[ticket_external_mapping]
    end

    GROUP --> BOT
    DIRECT --> BOT
    BOT <-->|WSS 443| ADAPTER
    ADAPTER --> GATEWAY
    GATEWAY --> MESSAGE
    MESSAGE --> INTAKE
    INTAKE --> PILOT_TICKET
    PILOT_TICKET --> INCIDENT
    PILOT_TICKET --> OUTBOX
    OUTBOX --> DELIVERY
    DELIVERY --> GATEWAY
    MESSAGE --> PG
    INTAKE --> PG
    PILOT_TICKET --> PG
    INTAKE -.async.-> RULES
    RULES -.optional.-> OCR
    OCR -.optional.-> TRIAGE
    TRIAGE -.suggestion only.-> INTAKE
    PILOT_TICKET -.Phase 3 only.-> TICKET_ADAPTER
    TICKET_ADAPTER --> HOSPITAL_TICKETS
    TICKET_ADAPTER --> MAPPING
