{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2_016_takeover_completion_targets.schema.json",
  "title": "WBINT-T12 SOURCE candidate takeover and staff completion targets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolver_teams",
    "resolver_team_id",
    "allowed_actions"
  ],
  "properties": {
    "resolver_teams": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "team_id",
          "display_name"
        ],
        "properties": {
          "team_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "resolver_team_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_actions": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "takeover-and-complete"
      }
    }
  }
}
