{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"workbench_manual_report_projection.schema.json",
  "anyOf":[{"type":"object","additionalProperties":false,
  "required":["source_kind","source","description","location","reporter","identity_source","actor_principal_id","manual_contact_required","external_notification"],
  "properties":{
    "source_kind":{"const":"MANUAL_REPORT"},"source":{"enum":["PHONE","ON_SITE"]},
    "description":{"type":"string","minLength":1,"maxLength":4000},
    "location":{"anyOf":[
      {"type":"object","additionalProperties":false,"required":["unknown","text"],"properties":{"unknown":{"const":true},"text":{"type":"null"}}},
      {"type":"object","additionalProperties":false,"required":["unknown","text"],"properties":{"unknown":{"const":false},"text":{"type":"string","minLength":1,"maxLength":200}}}
    ]},
    "reporter":{"type":"object","additionalProperties":false,"required":["verification","name","contact","department"],"properties":{
      "verification":{"const":"UNVERIFIED"},"name":{"type":"string","minLength":1,"maxLength":100},"contact":{"type":"string","minLength":1,"maxLength":100},
      "department":{"anyOf":[{"type":"null"},{"type":"string","minLength":1,"maxLength":100}]}
    }},
    "identity_source":{"const":"HAND_ENTERED"},"actor_principal_id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "manual_contact_required":{"const":true},"external_notification":{"const":false}
  }},{"$ref":"workbench_verified_manual_report_projection.schema.json"}]
}
