{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hospital.local/contracts/p2_016_assignment_receipt.schema.json",
  "title":"Currently authorized principal Ticket assignment acknowledgement without communication identities",
  "type":"object",
