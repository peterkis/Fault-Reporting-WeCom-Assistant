    {"type":"object","additionalProperties":false,"required":["state","ticket_id","ticket_version","ticket_event_id"],"properties":{"state":{"const":"COMMITTED"},"ticket_id":{"type":"string","pattern":"^[0-9a-f-]{36}$"},"ticket_version":{"type":"integer","minimum":1,"maximum":2147483647},"ticket_event_id":{"type":"string","pattern":"^[0-9a-f-]{36}$"}}},
    {"type":"object","additionalProperties":false,"required":["state","error"],"properties":{"state":{"const":"FAILED"},"error":{"type":"object","additionalProperties":false,"required":["code","retryable"],"properties":{"code":{"type":"string","pattern":"^P2_016_[A-Z][A-Z0-9_]{0,55}$"},"retryable":{"const":false}}}}}
