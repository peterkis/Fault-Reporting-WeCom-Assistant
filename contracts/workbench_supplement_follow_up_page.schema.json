{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_supplement_follow_up_page.schema.json",
  "title": "PLANNED WBINT-T36 authorized retained supplement page",
  "type": "object", "additionalProperties": false,
  "required": ["ticket_id", "items", "next_cursor", "has_pending_supplements"],
  "properties": {
    "ticket_id": {"$ref": "workbench_supplement_follow_up_command.schema.json#/$defs/uuid"},
    "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/item"}},
    "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
    "has_pending_supplements": {"type": "boolean"}
  },
  "$defs": {
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution_id", "basis", "occurred_at"],
      "properties": {
        "resolution_id": {"$ref": "workbench_supplement_follow_up_command.schema.json#/$defs/uuid"},
        "basis": {"enum": ["RECORDED_DISPOSITION", "VERIFIED_REPLY"]},
        "occurred_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ref", "source_kind", "revision", "follow_up_state", "resolution"],
      "properties": {
        "source_ref": {"$ref": "workbench_supplement_follow_up_command.schema.json#/$defs/source_ref"},
        "source_kind": {"enum": ["WEB", "BOT"]},
        "revision": {"$ref": "workbench_supplement_follow_up_command.schema.json#/$defs/revision"},
        "follow_up_state": {"enum": ["PENDING", "FOLLOWED_UP"]},
        "resolution": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/resolution"}]}
      },
      "oneOf": [
        {"properties": {"follow_up_state": {"const": "PENDING"}, "resolution": {"type": "null"}}},
        {"properties": {"follow_up_state": {"const": "FOLLOWED_UP"}, "resolution": {"$ref": "#/$defs/resolution"}}}
      ]
    }
  }
}
