{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2_016_takeover_completion_receipt.schema.json",
  "title": "WBINT-T12 SOURCE candidate takeover and staff completion receipt",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "UNKNOWN"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "ticket_id",
        "ticket_version",
        "ticket_event_id",
        "completion"
      ],
      "properties": {
        "state": {
          "const": "COMMITTED"
        },
        "ticket_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "ticket_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "ticket_event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cycle_id",
            "cycle_no",
            "event_id",
            "basis"
          ],
          "properties": {
            "cycle_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "cycle_no": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "event_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "basis": {
              "const": "STAFF_COMPLETED"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "error"
      ],
      "properties": {
        "state": {
          "const": "FAILED"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            },
            "retryable": {
              "const": false
            }
          }
        }
      }
    }
  ]
}
