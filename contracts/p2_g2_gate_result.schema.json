{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p2_g2_gate_result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "run_id",
    "candidate_fingerprint",
    "status",
    "reasons",
    "checked_scenarios",
    "observation_ms",
    "owner_approval_present",
    "live_delivery_complete",
    "task_done"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gate": {
      "const": "P2-G2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "candidate_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "BLOCKED",
        "INCOMPLETE",
        "PASSED"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,100}$"
      },
      "minItems": 0,
      "maxItems": 200,
      "uniqueItems": true
    },
    "checked_scenarios": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^G2-[EJTNICRFAO][0-9]{2}$"
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "observation_ms": {
      "type": "number",
      "minimum": 0
    },
    "owner_approval_present": {
      "type": "boolean"
    },
    "live_delivery_complete": {
      "type": "boolean"
    },
    "task_done": {
      "type": "boolean"
    }
  }
}
