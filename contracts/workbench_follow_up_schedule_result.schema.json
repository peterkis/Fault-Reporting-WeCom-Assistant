{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"workbench_follow_up_schedule_result.schema.json",
  "title":"WBINT-T37 safe shared follow-up mutation result (planned)",
  "type":"object",
  "additionalProperties":false,
  "required":["ok","ticket_id","ticket_version","ticket_event_id","control_event_id","schedule_version","replayed"],
  "properties":{
    "ok":{"const":true},
    "ticket_id":{"type":"string","format":"uuid"},
    "ticket_version":{"type":"integer","minimum":1,"maximum":2147483647},
    "ticket_event_id":{"type":"string","format":"uuid"},
    "control_event_id":{"type":"null"},
    "schedule_version":{"type":"string","pattern":"^[1-9][0-9]{0,18}$","x-postgresql-bigint-maximum":"9223372036854775807"},
    "replayed":{"type":"boolean"}
  }
}
