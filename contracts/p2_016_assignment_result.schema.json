{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit Ticket assignment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "ticket_id",
    "ticket_version",
    "ticket_event_id",
    "control_event_id",
    "handling_cycle",
    "communication_choice",
    "conversations",
    "replayed"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "ticket_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "ticket_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "ticket_event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "control_event_id": {
      "type": "null"
    },
    "handling_cycle": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "cycle_no",
            "first_responsibility_event_id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "cycle_no": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "first_responsibility_event_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "communication_choice": {
      "enum": [
        "TRANSFER_SELECTED",
        "RETAIN_CURRENT"
      ]
    },
    "conversations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "session_row_version",
          "control_event_id",
          "changed"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "session_row_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "control_event_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "changed": {
            "type": "boolean"
          }
        }
      }
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
