{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fault-reporting.local/contracts/conversation_read_cursor.schema.json",
  "title": "Conversation Read Cursor",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "last_read_sequence", "row_version", "created_at", "updated_at"],
  "properties": {
    "session_id": { "type": "string", "format": "uuid" },
    "last_read_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "row_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
