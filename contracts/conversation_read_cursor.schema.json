{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fault-reporting.local/contracts/conversation_read_cursor.schema.json",
  "title": "Conversation Read Cursor",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "last_read_sequence", "row_version", "created_at", "updated_at"],
  "properties": {
    "session_id": { "type": "string", "format": "uuid" },
    "last_read_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "row_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$", "x-business-timezone": "Asia/Shanghai", "x-precision": "second", "x-offset-allowed": false },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$", "x-business-timezone": "Asia/Shanghai", "x-precision": "second", "x-offset-allowed": false }
  }
}
