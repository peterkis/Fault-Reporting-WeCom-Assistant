{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_reminder_item.schema.json",
  "title": "T40 currently authorized locatable reminder projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reminder_id",
    "event_id",
    "reason",
    "canonical_item",
    "source_key",
    "source_revision",
    "occurred_at"
  ],
  "properties": {
    "reminder_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "event_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "minLength": 1,
      "maxLength": 19,
      "x-maximum-decimal": "9223372036854775807"
    },
    "reason": {
      "enum": [
        "AUTHORIZED_TEAM_NEW_REPORT",
        "RELATED_NEW_MATERIAL",
        "RELATED_REOPEN",
        "RELATED_FOLLOW_UP_DUE",
        "RELATED_REPORT_URGE"
      ]
    },
    "canonical_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ticket",
            "review",
            "intake"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "source_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "minLength": 1,
      "maxLength": 19,
      "x-maximum-decimal": "9223372036854775807"
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
      "minLength": 19,
      "maxLength": 19,
      "x-business-timezone": "Asia/Shanghai"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "enum": [
              "RELATED_REOPEN",
              "RELATED_FOLLOW_UP_DUE",
              "RELATED_REPORT_URGE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "canonical_item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "const": "ticket"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              }
            }
          }
        }
      }
    }
  ],
  "x-runtime-constraints": [
    "resolve current READ and current authorized team queue or canonical HANDLING/COMMUNICATION/FOLLOW membership before matching, counting or LIMIT",
    "source_key and source_revision must bind a retained original Intake/material/reopen/due fact, never arbitrary SSE payload",
    "reminder_id is the SHA256 of the reason plus stable original source key/revision; repeated projections and Review-to-Ticket conversion do not duplicate it",
    "event_id names an original authorized realtime projection used to locate and re-read the source fact; it grants no READ or write authority"
  ]
}
