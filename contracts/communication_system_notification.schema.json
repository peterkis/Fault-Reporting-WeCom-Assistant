{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/communication_system_notification.schema.json",
  "title": "Trusted Communication System Notification Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_command_id", "sender_system_code", "message_type", "content", "privacy_class", "retention_until"],
  "properties": {
    "session_id": { "type": ["string", "null"], "format": "uuid" },
    "client_command_id": { "type": "string", "format": "uuid" },
    "sender_system_code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "message_type": { "type": "string", "enum": ["text", "markdown"] },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 20480 } }
    },
    "privacy_class": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "SENSITIVE_INTERNAL", "PERSONAL", "PATIENT_SENSITIVE", "SECRET"] },
    "retention_until": { "type": "string", "format": "date-time", "maxLength": 40 }
  }
}
