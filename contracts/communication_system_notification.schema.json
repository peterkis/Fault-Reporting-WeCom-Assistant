{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/communication_system_notification.schema.json",
  "title": "Trusted Communication System Notification Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_command_id", "sender_system_code", "message_type", "content", "privacy_class", "retention_until", "retention_until_epoch_ms"],
  "properties": {
    "session_id": { "type": ["string", "null"], "format": "uuid" },
    "client_command_id": { "type": "string", "format": "uuid" },
    "sender_system_code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "message_type": { "type": "string", "enum": ["text", "markdown"] },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 20480 } }
    },
    "privacy_class": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "SENSITIVE_INTERNAL", "PERSONAL", "PATIENT_SENSITIVE", "SECRET"] },
    "retention_until": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$", "x-business-timezone": "Asia/Shanghai", "x-precision": "second", "x-offset-allowed": false, "maxLength": 40 },
    "retention_until_epoch_ms": { "$ref": "./epoch_ms_string.schema.json" }
  }
}
