  },
  "oneOf": [
    {
      "properties": {
        "workbench_reminders_enabled": {
          "const": false
        },
        "reminders_endpoint": {
          "const": null
        }
      }
    },
    {
      "properties": {
        "workbench_reminders_enabled": {
          "const": true
        },
        "reminders_endpoint": {
          "const": "/api/workbench/reminders"
        }
      }
    }
  ],
  "x-source-status": "SOURCE_ONLY_NOT_MOUNTED",
  "x-feature-default": false
}
