{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_reminder_capability.schema.json",
  "title": "T40 planned additive bootstrap capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workbench_reminders_enabled",
    "reminders_endpoint"
