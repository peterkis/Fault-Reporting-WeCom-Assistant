{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_supplement_follow_up_receipt.schema.json",
  "title": "PLANNED WBINT-T36 original-principal purpose receipt",
  "type": "object", "additionalProperties": false,
  "required": ["client_command_id", "ticket_id", "state"],
  "properties": {
    "client_command_id": {"$ref": "workbench_supplement_follow_up_command.schema.json#/$defs/uuid"},
    "ticket_id": {"$ref": "workbench_supplement_follow_up_command.schema.json#/$defs/uuid"},
    "state": {"enum": ["UNKNOWN", "COMMITTED", "FAILED"]},
    "result": {"$ref": "workbench_supplement_follow_up_result.schema.json"},
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "retryable"],
      "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "retryable": {"const": false}}
    }
  },
  "oneOf": [
    {"properties": {"state": {"const": "UNKNOWN"}}, "not": {"anyOf": [{"required": ["result"]}, {"required": ["error"]}]}},
    {"required": ["result"], "properties": {"state": {"const": "COMMITTED"}, "result": {"properties": {"replayed": {"const": true}}}}, "not": {"required": ["error"]}},
    {"required": ["error"], "properties": {"state": {"const": "FAILED"}}, "not": {"required": ["result"]}}
  ]
}
