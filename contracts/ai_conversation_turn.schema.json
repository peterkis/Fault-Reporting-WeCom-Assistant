{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/ai_conversation_turn.schema.json",
  "title": "AI Conversation Turn Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply",
    "intent",
    "urgency",
    "facts",
    "missing_fields",
    "should_handoff",
    "should_create_intake",
    "confidence",
    "safety"
  ],
  "properties": {
    "reply": {
      "type": "string",
      "maxLength": 2000
    },
    "intent": {
      "type": "string",
      "enum": [
        "INCIDENT",
        "SERVICE_REQUEST",
        "QUESTION",
        "COMPLAINT",
        "STATUS_QUERY",
        "FOLLOW_UP",
        "CHATTER",
        "UNKNOWN"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "urgency": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL",
        "UNKNOWN"
      ]
    },
    "facts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "confidence",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "USER_EXPLICIT",
              "RULE_DERIVED",
              "MODEL_INFERRED"
            ]
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "should_handoff": {
      "type": "boolean"
    },
    "handoff_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "should_create_intake": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_patient_data",
        "contains_secret",
        "allow_external_reply"
      ],
      "properties": {
        "contains_patient_data": {
          "type": "boolean"
        },
        "contains_secret": {
          "type": "boolean"
        },
        "allow_external_reply": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        }
      }
    }
  }
}
