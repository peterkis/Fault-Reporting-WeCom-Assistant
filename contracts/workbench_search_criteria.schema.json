{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_search_criteria.schema.json",
  "title": "WBINT-T41 canonical search criteria (SOURCE_ONLY, not mounted)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "q",
    "column",
    "range",
    "scope",
    "responsibility",
    "resolver_team_id",
    "assignee_id",
    "sources",
    "source_group_ref",
    "statuses",
    "supplement",
    "schedule"
  ],
  "properties": {
    "q": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "column": {
      "enum": [
        "all",
        "pending",
        "active",
        "closed"
      ]
    },
    "range": {
      "enum": [
        "recent",
        "all",
        "custom"
      ]
    },
    "scope": {
      "enum": [
        "team",
        "related"
      ]
    },
    "responsibility": {
      "enum": [
        "any",
        "handling",
        "communication",
        "following",
        "unassigned"
      ]
    },
    "resolver_team_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        }
      ]
    },
    "assignee_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "uuid"
        }
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "WECOM_DIRECT",
          "WECOM_GROUP",
          "WEB_REQUEST",
          "MANUAL_PHONE",
          "MANUAL_ON_SITE"
        ]
      }
    },
    "source_group_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "statuses": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NEW",
          "QUEUED",
          "ACCEPTED",
          "REOPENED",
          "IN_PROGRESS",
          "WAITING_REQUESTER",
          "WAITING_VENDOR",
          "RESOLVED",
          "CLOSED",
          "CANCELLED",
          "DUPLICATE_LINKED",
          "PENDING",
          "RECEIVED",
          "WAITING_DESCRIPTION",
          "WAITING_TRIAGE",
          "FAILED",
          "COMPLETED",
          "IGNORED"
        ]
      }
    },
    "supplement": {
      "enum": [
        "any",
        "pending",
        "followed",
        "none"
      ]
    },
    "schedule": {
      "enum": [
        "any",
        "active",
        "due",
        "none"
      ]
    },
    "closure_kind": {
      "enum": [
        "completed",
        "dismissed"
      ],
      "description": "Optional restriction of third-column states only; pending and active states retain their existing selection."
    },
    "closed_from": {
      "allOf": [
        {
          "$ref": "local_date.schema.json"
        },
        {
          "type": "string",
          "pattern": "^(?!0000-)"
        }
      ],
      "description": "Only with custom range. Inclusive Shanghai date; runtime validates the real calendar and date order."
    },
    "closed_to": {
      "allOf": [
        {
          "$ref": "local_date.schema.json"
        },
        {
          "type": "string",
          "pattern": "^(?!0000-)(?!9999-12-31$)"
        }
      ],
      "description": "Only with custom range. Inclusive Shanghai date below 9999-12-31 so the exclusive next-day bound stays four-digit."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "range": {
            "const": "custom"
          }
        },
        "required": [
          "range"
        ]
      },
      "then": {
        "required": [
          "closed_from",
          "closed_to"
        ]
      },
      "else": {
        "properties": {
          "q": {},
          "column": {},
          "range": {},
          "scope": {},
          "responsibility": {},
          "resolver_team_id": {},
          "assignee_id": {},
          "sources": {},
          "source_group_ref": {},
          "statuses": {},
          "supplement": {},
          "schedule": {},
          "closure_kind": {}
        },
        "additionalProperties": false
      }
    }
  ],
  "x-date-order-validation-required": "For custom range, closed_from <= closed_to; shared runtime calendar guards enforce this cross-field rule."
}
