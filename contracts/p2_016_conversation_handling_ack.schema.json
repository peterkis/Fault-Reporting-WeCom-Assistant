{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private-field-free readonly Ticket acknowledgement",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "UNKNOWN"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "error"
      ],
      "properties": {
        "state": {
          "const": "FAILED"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^P2_016_[A-Z0-9_]{1,90}$"
            },
            "retryable": {
              "const": false
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "ticket_id",
        "ticket_version",
        "ticket_event_id"
      ],
      "properties": {
        "state": {
          "const": "COMMITTED"
        },
        "ticket_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "ticket_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "ticket_event_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      }
    }
  ]
}
