{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fault-reporting.local/contracts/workbench_activity_batch_view_request.schema.json",
  "title": "ADR-0057 read-only activity batch view request",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "targets": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "id"],
        "properties": {"kind": {"enum": ["ticket", "review", "intake"]}, "id": {"type": "string", "format": "uuid"}}
      }
    }
  }
}
