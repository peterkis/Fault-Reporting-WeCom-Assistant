{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2-007-rule-set.schema.json",
  "title": "P2-007 Deterministic Rule Set",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "rule_set_id",
    "rule_set_version",
    "execution_mode",
    "forbidden_actions",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "execution_mode": {
      "const": "PURE_FUNCTION_NO_SIDE_EFFECT"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "version",
          "group",
          "priority",
          "description_zh",
          "when",
          "actions",
          "explanation_template_zh",
          "safety"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "pattern": "^[A-Z_]{3,64}$"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "description_zh": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "object"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "explanation_template_zh": {
            "type": "string",
            "minLength": 1
          },
          "safety": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
