{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_personal_read_receipt.schema.json",
  "title": "PLANNED WBINT-T35 current-authority personal material read receipt",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["client_command_id", "state"],
      "properties": {
        "client_command_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
        "state": {"const": "UNKNOWN"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["client_command_id", "state", "result"],
      "properties": {
        "client_command_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
        "state": {"const": "COMMITTED"},
        "result": {"$ref": "workbench_personal_read_acknowledgement.schema.json"}
      }
    }
  ]
}
