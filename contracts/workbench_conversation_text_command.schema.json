{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_conversation_text_command.schema.json",
  "title": "workbench_conversation_text_command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_command_id",
    "expected_row_version",
    "text"
  ],
  "properties": {
    "client_command_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "expected_row_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20480
    }
  }
}
