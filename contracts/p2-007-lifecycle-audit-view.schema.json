{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2-007-lifecycle-audit-view.schema.json",
  "title": "P2-007 Cross-Source Lifecycle Audit View",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_ref",
    "authoritative_owner_ref",
    "collaborator_refs",
    "events",
    "source_streams",
    "complete_through",
    "is_source_of_truth"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "authoritative_owner_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "collaborator_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,160}$"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "p2-007-human-lifecycle-event.schema.json"
      }
    },
    "source_streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "enum": [
          "CHANNEL_MESSAGE",
          "SERVICE_INTAKE",
          "TICKET_EVENT",
          "CONVERSATION_CONTROL_EVENT",
          "COMMUNICATION_MESSAGE",
          "COMMUNICATION_DELIVERY",
          "REALTIME_EVENT",
          "INCIDENT_RELATION_FUTURE"
        ]
      }
    },
    "complete_through": {
      "$ref": "./local_datetime.schema.json"
    },
    "is_source_of_truth": {
      "const": false
    }
  }
}
