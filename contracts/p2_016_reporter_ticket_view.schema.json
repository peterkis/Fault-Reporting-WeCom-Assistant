{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2_016_reporter_ticket_view.schema.json",
  "title": "p2_016_reporter_ticket_view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "public_ref",
    "ticket_no",
    "suffix",
    "title",
    "external_status",
    "created_at",
    "updated_at",
    "version",
    "guidance"
  ],
  "properties": {
    "public_ref": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_-]{32}$"
    },
    "ticket_no": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "suffix": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "pattern": "^[0-9]{4}$"
    },
    "title": {
      "enum": [
        "信息服务申请",
        "信息系统故障报修"
      ]
    },
    "external_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "created_at": {
      "$ref": "local_datetime.schema.json"
    },
    "updated_at": {
      "$ref": "local_datetime.schema.json"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "guidance": {
      "const": "如未解决，请在企业微信机器人单聊中回复。"
    },
    "incident_milestones": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "p2_012_reporter_milestone.schema.json"
      }
    }
  },
  "x-business-timezone": "Asia/Shanghai",
  "x-runtime-boundary": "bounded plain JSON; no Proxy/accessor/symbol/toJSON/cycle/prototype keys"
}
