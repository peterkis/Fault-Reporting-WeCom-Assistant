{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yixiaoxiu.local/contracts/h5-media-reservation",
  "title": "H5 Web media reservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client_command_id", "kind", "mime_type", "byte_size", "duration_ms"],
  "properties": {
    "schema_version": {"const": 1},
    "client_command_id": {"type": "string", "format": "uuid"},
    "kind": {"enum": ["VOICE", "IMAGE", "VIDEO"]},
    "mime_type": {"type": "string", "maxLength": 64},
    "byte_size": {"type": ["integer", "null"], "minimum": 1, "maximum": 20971520},
    "duration_ms": {"type": ["integer", "null"], "minimum": 1, "maximum": 60000}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "VOICE"}}}, "then": {"properties": {"byte_size": {"maximum": 5242880}, "mime_type": {"enum": ["audio/amr", "audio/wav", "audio/mp4", "audio/webm", "audio/ogg", "audio/mpeg"]}}}},
    {"if": {"properties": {"kind": {"const": "IMAGE"}}}, "then": {"properties": {"byte_size": {"maximum": 10485760}, "duration_ms": {"type": "null"}, "mime_type": {"enum": ["image/png", "image/jpeg", "image/webp"]}}}},
    {"if": {"properties": {"kind": {"const": "VIDEO"}}}, "then": {"properties": {"mime_type": {"enum": ["video/mp4", "video/webm", "video/quicktime"]}}}}
  ]
}
