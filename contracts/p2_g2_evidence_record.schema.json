{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p2_g2_evidence_record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "run_id",
    "run_mode",
    "candidate_fingerprint",
    "scenario_id",
    "evidence_type",
    "producer",
    "occurred_at",
    "physical_epoch_ms",
    "sequence",
    "result",
    "source_refs",
    "details",
    "previous_hash",
    "record_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gate": {
      "const": "P2-G2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "run_mode": {
      "enum": [
        "synthetic",
        "live"
      ]
    },
    "candidate_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^G2-(?:[EJTNICRFAO][0-9]{2}|START|END|CLEANUP|OWNER|ENV|AUTOMATION)$"
    },
    "evidence_type": {
      "enum": [
        "UNIT_CONTRACT",
        "POSTGRES_HTTP_INTEGRATION",
        "SYNTHETIC_PROCESS_BROWSER",
        "LIVE_WECOM_RECEIPT",
        "CLIENT_OBSERVATION",
        "RESOURCE_MEASUREMENT",
        "PROJECT_OWNER_APPROVAL"
      ]
    },
    "producer": {
      "enum": [
        "AUTOMATED",
        "MANUAL_ATTESTATION"
      ]
    },
    "occurred_at": {
      "$ref": "local_datetime.schema.json"
    },
    "physical_epoch_ms": {
      "$ref": "epoch_ms_string.schema.json"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "INCOMPLETE"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "MODULE",
              "TEST_OUTPUT",
              "PROCESS_IPC",
              "DB_QUERY",
              "CLIENT_FILE",
              "OWNER_FILE",
              "ENVIRONMENT_FILE"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./:-]{1,256}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed"
      ],
      "properties": {
        "executed": {
          "type": "boolean"
