{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/schemas/local_datetime.schema.json",
  "title": "LocalDateTime",
  "description": "Asia/Shanghai local business date-time at exact second precision. Runtime calendar validation is mandatory.",
  "type": "string",
  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
  "x-business-timezone": "Asia/Shanghai",
  "x-precision": "second",
  "x-calendar-validation-required": true,
  "x-offset-allowed": false
}
