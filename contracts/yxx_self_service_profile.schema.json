{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/schemas/yxx_self_service_profile.schema.json",
  "title": "YXX self-service profile",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "oauth", "business_read", "web_write", "processor", "external_delivery", "write_flag"],
  "properties": {
    "profile": {"enum": ["OAUTH_ONLY", "MEMBER_TICKET_READONLY", "MEMBER_SELF_SERVICE", "FULL_SERVICE_LOOP"]},
    "oauth": {"const": "WECom_MEMBER"}, "business_read": {"type": "boolean"}, "web_write": {"type": "boolean"},
    "processor": {"enum": ["NONE", "APP_BOUNDED_PUMP", "EXISTING_WORKER"]},
    "external_delivery": {"const": "NONE_FOR_WEB"}, "write_flag": {"type": "boolean"},
    "x-readonly-write-denied": {"const": true}
  },
  "allOf": [
    {"if": {"properties": {"profile": {"const": "OAUTH_ONLY"}}}, "then": {"properties": {"business_read": {"const": false}, "web_write": {"const": false}, "processor": {"const": "NONE"}}}},
    {"if": {"properties": {"profile": {"const": "MEMBER_TICKET_READONLY"}}}, "then": {"properties": {"web_write": {"const": false}, "processor": {"const": "NONE"}, "write_flag": {"const": false}}}},
    {"if": {"properties": {"profile": {"const": "MEMBER_SELF_SERVICE"}}}, "then": {"properties": {"processor": {"const": "APP_BOUNDED_PUMP"}}}},
    {"if": {"properties": {"profile": {"const": "FULL_SERVICE_LOOP"}}}, "then": {"properties": {"processor": {"const": "EXISTING_WORKER"}}}}
  ]
}
