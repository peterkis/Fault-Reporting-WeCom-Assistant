{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Ticket-only self handling command",
  "type":"object","additionalProperties":false,
  "required":["client_command_id","expected_version","reason_code","resolver_team_id"],
  "properties":{
    "client_command_id":{"type":"string","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "expected_version":{"type":"integer","minimum":1,"maximum":2147483647},
    "reason_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},
    "resolver_team_id":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"}
  }
}
