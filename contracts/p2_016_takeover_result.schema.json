{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2_016_takeover_result.schema.json",
  "title": "PLANNED self Ticket takeover result - WBINT-T07, runtime NOT_RUN",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "ticket_id", "ticket_version", "ticket_event_id", "control_event_id", "handling_cycle", "communication_choice", "conversations", "replayed"],
  "properties": {
    "ok": {"const": true},
    "ticket_id": {"$ref": "#/$defs/uuid"},
    "ticket_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "ticket_event_id": {"$ref": "#/$defs/uuid"},
    "control_event_id": {"type": "null"},
    "handling_cycle": {
      "anyOf": [
        {"type": "object", "additionalProperties": false,
          "required": ["id", "cycle_no", "first_responsibility_event_id"],
          "properties": {
            "id": {"$ref": "#/$defs/uuid"},
            "cycle_no": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "first_responsibility_event_id": {"anyOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]}
          }
        },
        {"type": "null"}
      ]
    },
    "communication_choice": {"enum": ["TAKE_SELECTED", "RETAIN_CURRENT"]},
    "conversations": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["session_id", "session_row_version", "control_event_id", "changed"],
        "properties": {
          "session_id": {"$ref": "#/$defs/uuid"},
          "session_row_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "control_event_id": {"anyOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
          "changed": {"type": "boolean"}
        }
      }
    },
    "replayed": {"type": "boolean"}
  },
  "allOf": [{
    "if": {"properties": {"communication_choice": {"const": "RETAIN_CURRENT"}}},
    "then": {"properties": {"conversations": {"maxItems": 0}}},
    "else": {"properties": {"conversations": {"minItems": 1}}}
  }],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "started_result": {
      "allOf": [
        {"$ref": "#"},
        {"properties": {"handling_cycle": {"type": "object", "properties": {"first_responsibility_event_id": {"$ref": "#/$defs/uuid"}}}}}
      ],
      "description": "PLANNED takeover-and-start result: a valid current cycle and its non-null first responsibility basis are independently required before the atomic start."
    }
  },
  "description": "PLANNED only. Takeover alone preserves the original nullable current cycle and nullable first responsibility basis exactly as the existing legal transfer does; absent history is not invented. A corrupt current pointer or orphaned existing cycle fails closed. ticket_event_id is the last Ticket event of this command; takeover alone has exactly one assignment_transferred event. Current Ticket and selected Session read scope must be checked before returning any replay."
}
