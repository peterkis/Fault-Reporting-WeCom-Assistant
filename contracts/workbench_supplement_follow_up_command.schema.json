{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_supplement_follow_up_command.schema.json",
  "title": "PLANNED WBINT-T36 exact supplement disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_command_id", "action", "source_ref", "revision", "disposition_note", "mark_followed_up"],
  "properties": {
    "client_command_id": {"$ref": "#/$defs/uuid"},
    "action": {"const": "RECORD_DISPOSITION"},
    "source_ref": {"$ref": "#/$defs/source_ref"},
    "revision": {"$ref": "#/$defs/revision"},
    "disposition_note": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "mark_followed_up": {"const": true}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "source_ref": {"type": "string", "maxLength": 64, "pattern": "^(?:channel:[1-9][0-9]{0,18}|web:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"},
    "revision": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"}
  }
}
