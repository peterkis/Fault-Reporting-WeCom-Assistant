{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_personal_read_acknowledgement.schema.json",
  "title": "PLANNED WBINT-T35 personal read committed acknowledgement",
  "type": "object", "additionalProperties": false,
  "required": ["ok", "client_command_id", "source_key", "source_kind", "last_read_position", "row_version", "replayed"],
  "properties": {
    "ok": {"const": true},
    "client_command_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "source_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_kind": {"enum": ["BOT", "WEB", "MANUAL"]},
    "last_read_position": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "row_version": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "replayed": {"type": "boolean"}
  }
}
