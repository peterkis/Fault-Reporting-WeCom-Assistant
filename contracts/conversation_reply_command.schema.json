{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/conversation_reply_command.schema.json",
  "title": "Conversation Reply Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_command_id",
    "session_id",
    "expected_row_version",
    "message_type",
    "visibility",
    "privacy_class",
    "retention_until"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "client_command_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_row_version": {
      "type": "integer",
      "minimum": 1
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "markdown",
        "image",
        "file",
        "mixed",
        "template_card"
      ]
    },
    "visibility": {
      "const": "EXTERNAL"
    },
    "text": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 20480
    },
    "reply_to_item_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "attachment_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "sender_display_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "privacy_class": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL", "SENSITIVE_INTERNAL", "PERSONAL", "PATIENT_SENSITIVE", "SECRET"]
    },
    "retention_until": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$", "x-business-timezone": "Asia/Shanghai", "x-precision": "second", "x-offset-allowed": false,
      "maxLength": 40
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": {
            "enum": [
              "text",
              "markdown"
            ]
          }
        }
      },
      "then": {
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "enum": [
              "image",
              "file",
              "mixed",
              "template_card"
            ]
          }
        }
      },
      "then": {
        "required": [
          "attachment_ids"
        ],
        "properties": {
          "attachment_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
