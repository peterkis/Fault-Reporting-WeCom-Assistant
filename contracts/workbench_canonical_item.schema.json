{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/workbench_canonical_item.schema.json",
  "title": "workbench_canonical_item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id"
  ],
  "properties": {
    "kind": {
      "enum": [
        "ticket",
        "review",
        "intake"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
