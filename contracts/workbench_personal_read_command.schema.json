{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_personal_read_command.schema.json",
  "title": "PLANNED WBINT-T35 exact material read command",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_command_id", "source_ref", "revision"],
  "properties": {
    "client_command_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "source_ref": {"type": "string", "maxLength": 64, "pattern": "^(?:channel:[1-9][0-9]{0,18}|(?:web|manual):[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"},
    "revision": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"}
  }
}
