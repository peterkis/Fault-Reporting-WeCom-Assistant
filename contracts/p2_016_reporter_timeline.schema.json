{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2_016_reporter_timeline.schema.json",
  "title": "p2_016_reporter_timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "text",
          "occurred_at",
          "source_rank",
          "source_ordinal"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "occurred_at": {
            "$ref": "local_datetime.schema.json"
          },
          "source_rank": {
            "const": 0
          },
          "source_ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 10,
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "x-business-timezone": "Asia/Shanghai",
  "x-runtime-boundary": "bounded plain JSON; no Proxy/accessor/symbol/toJSON/cycle/prototype keys"
}
