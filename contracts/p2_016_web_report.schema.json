{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2_016_web_report.schema.json",
  "title": "p2_016_web_report",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_kind", "description", "location", "service_code", "impact_scope", "reported_department_text", "extension", "supplements"],
  "properties": {
    "source_kind": {"const": "WEB_REQUEST"},
    "description": {"type": "string", "minLength": 1, "maxLength": 4000},
    "location": {"anyOf": [
      {"type": "object", "additionalProperties": false, "required": ["text", "unknown"], "properties": {
        "text": {"type": ["string", "null"], "maxLength": 200}, "unknown": {"type": "boolean"}
      }},
      {"type": "null"}
    ]},
    "service_code": {"type": ["string", "null"], "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "impact_scope": {"enum": ["UNKNOWN", "SELF", "SINGLE_WORKSTATION", "MULTIPLE_USERS", "DEPARTMENT"]},
    "reported_department_text": {"type": ["string", "null"], "maxLength": 100},
    "extension": {"type": ["string", "null"], "maxLength": 20, "pattern": "^[0-9][0-9 -]{0,19}$"},
    "supplements": {"type": "array", "maxItems": 49, "items": {"type": "object", "additionalProperties": false,
      "required": ["input_revision", "text"], "properties": {
        "input_revision": {"type": "string", "pattern": "^([2-9]|[1-9][0-9]+)$"},
        "text": {"type": ["string", "null"], "maxLength": 2000}
      }
    }}
  }
}
