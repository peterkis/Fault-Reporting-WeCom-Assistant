{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"workbench_reporter_verification.schema.json",
  "title":"Internal configured Directory authority; not browser request or public response",
  "anyOf":[
    {"type":"object","additionalProperties":false,"required":["schema_version","purpose","selection","application","directory_source_scope","actor_principal_id","object_access","authorized_at","authorized_at_epoch_ms","valid_until","valid_until_epoch_ms","proof"],"properties":{
      "schema_version":{"const":1},"purpose":{"const":"ADMISSION"},"selection":{"$ref":"#/$defs/selection"},"application":{"$ref":"#/$defs/application"},
      "directory_source_scope":{"$ref":"#/$defs/scopeLabel"},"actor_principal_id":{"$ref":"#/$defs/uuid"},"object_access":{"const":"ALLOWED"},
      "authorized_at":{"$ref":"#/$defs/localTime"},"authorized_at_epoch_ms":{"$ref":"#/$defs/epoch"},"valid_until":{"$ref":"#/$defs/localTime"},"valid_until_epoch_ms":{"$ref":"#/$defs/epoch"},
      "proof":{"$ref":"#/$defs/proof"}
    }},
    {"type":"object","additionalProperties":false,"required":["schema_version","purpose","selection","application","directory_source_scope","actor_principal_id","object_access","authorized_at","authorized_at_epoch_ms","valid_until","valid_until_epoch_ms","target_scope"],"properties":{
      "schema_version":{"const":1},"purpose":{"const":"READ_COMMITTED"},"selection":{"$ref":"#/$defs/selection"},"application":{"$ref":"#/$defs/application"},
      "directory_source_scope":{"$ref":"#/$defs/scopeLabel"},"actor_principal_id":{"$ref":"#/$defs/uuid"},"object_access":{"const":"ALLOWED"},
      "authorized_at":{"$ref":"#/$defs/localTime"},"authorized_at_epoch_ms":{"$ref":"#/$defs/epoch"},"valid_until":{"$ref":"#/$defs/localTime"},"valid_until_epoch_ms":{"$ref":"#/$defs/epoch"},
      "target_scope":{"$ref":"#/$defs/memberScope"}
    }}
  ],
  "$defs":{
    "selection":{"$ref":"workbench_verified_manual_report_command.schema.json#/properties/reporter"},
    "uuid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "scopeLabel":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[^\u0000-\u001f\u007f]+$"},
    "proofRef":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9_./-]*$"},
    "localTime":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"},
    "epoch":{"type":"string","minLength":1,"maxLength":19,"pattern":"^(0|[1-9][0-9]*)$"},
    "application":{"type":"object","additionalProperties":false,"required":["sourceCorpScope","sourceAppScope"],"properties":{"sourceCorpScope":{"$ref":"#/$defs/scopeLabel"},"sourceAppScope":{"$ref":"#/$defs/scopeLabel"}}},
    "memberScope":{"type":"object","additionalProperties":false,"required":["scopeHash","sourceCorpScope","sourceAppScope","proofRef"],"properties":{"scopeHash":{"$ref":"#/$defs/hash"},"sourceCorpScope":{"$ref":"#/$defs/scopeLabel"},"sourceAppScope":{"$ref":"#/$defs/scopeLabel"},"proofRef":{"$ref":"#/$defs/proofRef"}}},
    "profile":{"type":"object","additionalProperties":false,"required":["display_name","departments"],"properties":{"display_name":{"$ref":"workbench_reporter_candidates.schema.json#/properties/candidates/items/properties/display_name"},"departments":{"$ref":"workbench_reporter_candidates.schema.json#/properties/candidates/items/properties/departments"}}},
    "reachability":{"type":"object","additionalProperties":false,"required":["status","target_scope_hash","checked_at","checked_at_epoch_ms","proof_ref"],"properties":{
      "status":{"enum":["REACHABLE","UNREACHABLE","UNKNOWN"]},"target_scope_hash":{"$ref":"#/$defs/hash"},"checked_at":{"$ref":"#/$defs/localTime"},"checked_at_epoch_ms":{"$ref":"#/$defs/epoch"},"proof_ref":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/proofRef"}]}
    },"allOf":[{"if":{"properties":{"status":{"const":"REACHABLE"}}},"then":{"properties":{"proof_ref":{"$ref":"#/$defs/proofRef"}}}}]},
    "proof":{"type":"object","additionalProperties":false,"required":["source","scope","mapping_config_hash","verification_method","profile_source","directory_source_scope","directory_snapshot_version","profile_at_report","binding_proof_ref","account_status","binding_state","proof_kind","reachability","verified_at","verified_at_epoch_ms","actor_principal_id"],"properties":{
      "source":{"const":"VERIFIED_DIRECTORY_SELECTION"},"scope":{"$ref":"#/$defs/memberScope"},"mapping_config_hash":{"$ref":"#/$defs/hash"},"verification_method":{"const":"VERIFIED_DELEGATED_MAPPING"},
      "profile_source":{"enum":["WECOM_DIRECTORY","THIRD_PARTY_STAFF_DIRECTORY"]},"directory_source_scope":{"$ref":"#/$defs/scopeLabel"},"directory_snapshot_version":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\u0000-\u001f\u007f]+$"},
      "profile_at_report":{"$ref":"#/$defs/profile"},"binding_proof_ref":{"$ref":"#/$defs/proofRef"},"account_status":{"const":"ACTIVE"},"binding_state":{"const":"VERIFIED"},"proof_kind":{"enum":["LIVE","SYNTHETIC"]},
      "reachability":{"$ref":"#/$defs/reachability"},"verified_at":{"$ref":"#/$defs/localTime"},"verified_at_epoch_ms":{"$ref":"#/$defs/epoch"},"actor_principal_id":{"$ref":"#/$defs/uuid"}
    }}
  }
}
