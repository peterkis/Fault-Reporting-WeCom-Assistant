{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"workbench_follow_up_schedule_receipt.schema.json",
  "title":"WBINT-T37 immutable original-command acknowledgement (planned)",
  "oneOf":[
    {"type":"object","additionalProperties":false,"required":["client_command_id","ticket_id","state"],"properties":{
      "client_command_id":{"type":"string","format":"uuid"},"ticket_id":{"type":"string","format":"uuid"},"state":{"const":"UNKNOWN"}
    }},
    {"type":"object","additionalProperties":false,"required":["client_command_id","ticket_id","state","result"],"properties":{
      "client_command_id":{"type":"string","format":"uuid"},"ticket_id":{"type":"string","format":"uuid"},"state":{"const":"COMMITTED"},
      "result":{"allOf":[{"$ref":"workbench_follow_up_schedule_result.schema.json"},{"properties":{"replayed":{"const":true}}}]}
    }},
    {"type":"object","additionalProperties":false,"required":["client_command_id","ticket_id","state","error"],"properties":{
      "client_command_id":{"type":"string","format":"uuid"},"ticket_id":{"type":"string","format":"uuid"},"state":{"const":"FAILED"},
      "error":{"type":"object","additionalProperties":false,"required":["code","retryable"],"properties":{"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},"retryable":{"const":false}}}
    }}
  ]
}
