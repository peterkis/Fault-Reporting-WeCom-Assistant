{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/workbench_incident_owner_transfer_event.schema.json",
  "title": "T29 frozen SOURCE / NOT_MOUNTED / NOT_RUN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "event_type",
    "event_ordinal",
    "old_status",
    "new_status",
    "old_scope",
    "new_scope",
    "occurred_at",
    "actor_principal_id",
    "owner_transfer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "incident.owner.transferred"
    },
    "event_ordinal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "Decimal PostgreSQL BIGINT string; existing runtime guard enforces 1..9223372036854775807."
    },
    "old_status": {
      "type": "null"
    },
    "new_status": {
      "type": "null"
    },
    "old_scope": {
      "type": "null"
    },
    "new_scope": {
      "type": "null"
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "actor_principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous",
        "next"
      ],
      "properties": {
        "previous": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner_principal_id",
            "owner_team_id"
          ],
          "properties": {
            "owner_principal_id": {
              "type": "string",
              "format": "uuid"
            },
            "owner_team_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "next": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner_principal_id",
            "owner_team_id"
          ],
          "properties": {
            "owner_principal_id": {
              "type": "string",
              "format": "uuid"
            },
            "owner_team_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
