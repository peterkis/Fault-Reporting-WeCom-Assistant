{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/workbench_incident_owner_transfer_command.schema.json",
  "title": "T29 frozen SOURCE / NOT_MOUNTED / NOT_RUN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_command_id",
    "reason_code",
    "expected_row_version",
    "owner_principal_id",
    "owner_team_id"
  ],
  "properties": {
    "client_command_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "OPERATOR_REVIEWED",
        "CONFIRMED_SHARED_FAULT",
        "INCORRECT_ASSOCIATION",
        "RECOVERY_CONFIRMED",
        "SUBSCRIPTION_REQUEST",
        "SCOPE_CORRECTION",
        "MAINTENANCE_EXPIRED",
        "WORKBENCH_CONFIRMED"
      ]
    },
    "expected_row_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "Decimal PostgreSQL BIGINT string; existing runtime guard enforces 1..9223372036854775807."
    },
    "owner_principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_team_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
