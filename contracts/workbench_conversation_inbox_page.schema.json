{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_conversation_inbox_page.schema.json",
  "title": "workbench_conversation_inbox_page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contact_ref",
          "participant_label",
          "department_label",
          "anchor_session_id",
          "matching_topic_count",
          "latest_activity_at",
          "last_item_preview",
          "unread_count",
          "source_badges",
          "additional_source_count",
          "assignment_summary",
          "has_delivery_exception"
        ],
        "properties": {
          "contact_ref": {
            "type": "string",
            "pattern": "^cci_v1_[a-f0-9]{64}$"
          },
          "participant_label": {
            "type": "string",
            "maxLength": 128
          },
          "department_label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "anchor_session_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "matching_topic_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "latest_activity_at": {
            "$ref": "local_datetime.schema.json"
          },
          "last_item_preview": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "item_id",
                  "text",
                  "sender_kind",
                  "visibility"
                ],
                "properties": {
                  "item_id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                  },
                  "text": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 256
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sender_kind": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "visibility": {
                    "enum": [
                      "EXTERNAL",
                      "INTERNAL",
                      "RESTRICTED"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "unread_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_badges": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "label",
                "ref"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "group",
                    "direct",
                    "unknown"
                  ]
                },
                "label": {
                  "type": "string",
                  "maxLength": 256
                },
                "ref": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "additional_source_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "assignment_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "label"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "UNASSIGNED",
                  "MINE",
                  "SINGLE",
                  "MIXED"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            }
          },
          "has_delivery_exception": {
            "type": "boolean"
          }
        }
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
