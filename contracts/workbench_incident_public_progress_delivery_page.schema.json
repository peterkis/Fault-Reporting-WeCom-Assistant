{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/workbench_incident_public_progress_delivery_page.schema.json",
  "title": "T31 frozen SOURCE PROPOSED_NOT_MOUNTED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "publication_id",
    "items",
    "next_cursor"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "format": "uuid"
    },
    "publication_id": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "route",
          "audience",
          "status",
          "attempt_count",
          "side_effect_state",
          "last_error_code",
          "sent_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "route": {
            "const": "BOT_DIRECT"
          },
          "audience": {
            "const": "REPORTER_DIRECT"
          },
          "status": {
            "enum": [
              "PENDING",
              "LEASED",
              "SENDING",
              "SENT",
              "RECONCILIATION_REQUIRED",
              "DEAD_LETTER",
              "CANCELLED"
            ]
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 0
          },
          "side_effect_state": {
            "enum": [
              "NOT_ATTEMPTED",
              "ACKNOWLEDGED",
              "UNKNOWN"
            ]
          },
          "last_error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "sent_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
