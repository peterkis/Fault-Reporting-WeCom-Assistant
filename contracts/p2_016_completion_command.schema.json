{
  "$id": "https://hospital.local/contracts/p2_016_completion_command.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current handler staff completion command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_command_id",
    "expected_version",
    "reason_code",
    "handling_cycle_id",
    "internal_process",
    "external_summary",
    "external_summary_confirmed"
  ],
  "properties": {
    "client_command_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "reason_code": {
      "const": "STAFF_COMPLETED"
    },
    "handling_cycle_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "internal_process": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "external_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "external_summary_confirmed": {
      "const": true
    }
  }
}
