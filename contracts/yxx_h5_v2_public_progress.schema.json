{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["client_command_id", "expected_version", "summary", "estimated_at"],
  "properties": {
    "client_command_id": {"type": "string", "format": "uuid"},
    "expected_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "estimated_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"}
  }
}
