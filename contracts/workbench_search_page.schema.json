{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_search_page.schema.json",
  "title": "WBINT-T41 authorized canonical search page (SOURCE_ONLY, not mounted)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor",
    "column",
    "range",
    "criteria"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "intake_id",
          "number",
          "title",
          "status",
          "column",
          "priority",
          "source",
          "source_label",
          "source_group",
          "location",
          "reporter_name",
          "assignee_name",
          "review_reason",
          "created_at",
          "updated_at",
          "completed_at",
          "closure"
        ],
        "properties": {
          "kind": {
            "enum": [
              "ticket",
              "review",
              "intake"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "intake_id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "NEW",
              "QUEUED",
              "ACCEPTED",
              "REOPENED",
              "IN_PROGRESS",
              "WAITING_REQUESTER",
              "WAITING_VENDOR",
              "RESOLVED",
              "CLOSED",
              "CANCELLED",
              "DUPLICATE_LINKED",
              "PENDING",
              "RECEIVED",
              "WAITING_DESCRIPTION",
              "WAITING_TRIAGE",
              "FAILED",
              "COMPLETED",
              "IGNORED"
            ]
          },
          "column": {
            "enum": [
              "pending",
              "active",
              "closed"
            ]
          },
          "priority": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "source": {
            "type": "string"
          },
          "source_label": {
            "type": "string"
          },
          "source_group": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "display_name",
                  "name_source",
                  "row_version"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "display_name": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "maxLength": 128
                      }
                    ]
                  },
                  "name_source": {
                    "enum": [
                      "ADMIN_CONFIRMED",
                      "UNREGISTERED"
                    ]
                  },
                  "row_version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,18})$"
                  }
                }
              }
            ]
          },
          "location": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "reporter_name": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "assignee_name": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "review_reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "created_at": {
            "$ref": "local_datetime.schema.json"
          },
          "updated_at": {
            "$ref": "local_datetime.schema.json"
          },
          "completed_at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "local_datetime.schema.json"
              }
            ]
          },
          "attention": {
            "$ref": "workbench_item_follow_attention.schema.json"
          },
          "supplement_follow_up": {
            "$ref": "workbench_supplement_follow_up_summary.schema.json"
          },
          "follow_up_schedule": {
            "$ref": "workbench_follow_up_schedule_view.schema.json#/properties/active"
          },
          "closure": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "source",
                  "reason_code",
                  "reason_label",
                  "reason_note",
                  "closed_by_display_name",
                  "closed_at",
                  "duplicate_of",
                  "can_restore",
                  "secondary_reason"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "COMPLETED",
                      "DISMISSED"
                    ]
                  },
                  "source": {
                    "enum": [
                      "MANUAL",
                      "SYSTEM",
                      null
                    ]
                  },
                  "reason_code": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "\\S"
                      }
                    ]
                  },
                  "reason_label": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "\\S"
                      }
                    ]
                  },
                  "reason_note": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "pattern": "\\S"
                      }
                    ]
                  },
                  "closed_by_display_name": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "\\S"
                      }
                    ]
                  },
                  "closed_at": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "local_datetime.schema.json"
                      }
                    ]
                  },
                  "duplicate_of": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "display_no"
                        ],
                        "properties": {
                          "display_no": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "\\S"
                          }
                        }
                      }
                    ]
                  },
                  "can_restore": {
                    "type": "boolean"
                  },
                  "secondary_reason": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "code",
                          "label"
                        ],
                        "properties": {
                          "code": {
                            "enum": [
                              "HUMAN_CONFIRMED",
                              "INFORMATION_INSUFFICIENT",
                              "BUSINESS_CONSULTATION_CONFIRMED",
                              "ACKNOWLEDGED",
                              "OUT_OF_SCOPE_CONFIRMED",
                              "SERVICE_REQUEST_CONFIRMED",
                              "INCIDENT_REVIEW_PENDING",
                              "STALE_REVIEW_CANCELLED"
                            ]
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          }
                        }
                      }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "DISMISSED"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason_code": {
                          "enum": [
                            "FALSE_REPORT_OR_TEST",
                            "DUPLICATE",
                            "NOT_IT_SCOPE",
                            "REPORTER_WITHDREW",
                            "REPORTER_UNREACHABLE",
                            "OTHER"
                          ]
                        },
                        "source": {
                          "enum": [
                            "MANUAL",
                            "SYSTEM"
                          ]
                        },
                        "closed_at": {
                          "$ref": "./local_datetime.schema.json"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "service": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "name_zh",
                  "category",
                  "category_name_zh",
                  "source"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "name_zh": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "category_name_zh": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "source": {
                    "enum": [
                      "MANUAL_CONFIRMED",
                      "REPORTER_EXPLICIT",
                      "RULE_DETERMINISTIC"
                    ]
                  }
                }
              }
            ]
          },
          "stage_entered_at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "local_datetime.schema.json"
              }
            ]
          },
          "reporter_department": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "reporter_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "source",
              "captured_at"
            ],
            "properties": {
              "state": {
                "enum": [
                  "PENDING",
                  "PARTIAL",
                  "RESOLVED",
                  "UNAVAILABLE"
                ]
              },
              "source": {
                "enum": [
                  "REPORT_SNAPSHOT",
                  "LATER_LOOKUP",
                  null
                ]
              },
              "captured_at": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "local_datetime.schema.json"
                  }
                ]
              }
            }
          },
          "web_report_urge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "active",
              "count",
              "last_urged_at"
            ],
            "properties": {
              "active": {
                "type": "boolean"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "last_urged_at": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "local_datetime.schema.json"
                  }
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "column": {
                  "const": "closed"
                }
              }
            },
            "then": {
              "properties": {
                "closure": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "closure": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "RESOLVED",
                    "CLOSED",
                    "COMPLETED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "closure": {
                  "properties": {
                    "kind": {
                      "const": "COMPLETED"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "CANCELLED",
                    "DUPLICATE_LINKED",
                    "IGNORED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "closure": {
                  "properties": {
                    "kind": {
                      "const": "DISMISSED"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "next_cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      ]
    },
    "column": {
      "enum": [
        "all",
        "pending",
        "active",
        "closed"
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "from",
        "until",
        "timezone"
      ],
      "properties": {
        "mode": {
          "enum": [
            "recent",
            "all",
            "custom"
          ]
        },
        "from": {
          "$ref": "local_datetime.schema.json"
        },
        "until": {
          "$ref": "local_datetime.schema.json"
        },
        "timezone": {
          "const": "Asia/Shanghai"
        }
      }
    },
    "criteria": {
      "$ref": "workbench_search_criteria.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "criteria": {
            "properties": {
              "range": {
                "const": "recent"
              }
            },
            "required": [
              "range"
            ]
          }
        },
        "required": [
          "criteria"
        ]
      },
      "then": {
        "properties": {
          "range": {
            "properties": {
              "mode": {
                "const": "recent"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "criteria": {
            "properties": {
              "range": {
                "const": "all"
              }
            },
            "required": [
              "range"
            ]
          }
        },
        "required": [
          "criteria"
        ]
      },
      "then": {
        "properties": {
          "range": {
            "properties": {
              "mode": {
                "const": "all"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "criteria": {
            "properties": {
              "range": {
                "const": "custom"
              }
            },
            "required": [
              "range"
            ]
          }
        },
        "required": [
          "criteria"
        ]
      },
      "then": {
        "properties": {
          "range": {
            "properties": {
              "mode": {
                "const": "custom"
              }
            }
          }
        }
      }
    }
  ]
}
