{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "client_command_id", "expected_ticket_version", "completed_round_ref", "rating", "comment"],
  "properties": {
    "schema_version": {"const": 1},
    "client_command_id": {"type": "string", "format": "uuid"},
    "expected_ticket_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "completed_round_ref": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32}$"},
    "rating": {"type": "integer", "minimum": 1, "maximum": 5},
    "comment": {"type": ["string", "null"], "maxLength": 200}
  }
}
