{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2_016_takeover_completion_command.schema.json",
  "title": "WBINT-T12 SOURCE candidate takeover and staff completion command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_command_id",
    "expected_version",
    "reason_code",
    "resolver_team_id",
    "handling_cycle_id",
    "communication_choice",
    "sessions",
    "internal_process",
    "external_summary",
    "external_summary_confirmed"
  ],
  "properties": {
    "client_command_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "reason_code": {
      "const": "STAFF_COMPLETED"
    },
    "resolver_team_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "handling_cycle_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "communication_choice": {
      "enum": [
        "RETAIN_CURRENT",
        "TAKE_SELECTED"
      ]
    },
    "sessions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "expected_row_version"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "expected_row_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      }
    },
    "internal_process": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "external_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "external_summary_confirmed": {
      "const": true
    }
  },
  "oneOf": [
    {
      "properties": {
        "communication_choice": {
          "const": "RETAIN_CURRENT"
        },
        "sessions": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "communication_choice": {
          "const": "TAKE_SELECTED"
        },
        "sessions": {
          "minItems": 1
        }
      }
    }
  ]
}
