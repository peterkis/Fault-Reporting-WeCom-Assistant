{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/schemas/ai-triage-result.schema.json",
  "title": "AITriageResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline_version",
    "model",
    "result"
  ],
  "properties": {
    "pipeline_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "rule_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "catalog_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_type",
        "decision_band",
        "evidence",
        "missing_fields"
      ],
      "properties": {
        "request_type": {
          "enum": [
            "INCIDENT",
            "SERVICE_REQUEST",
            "QUESTION",
            "COMPLAINT",
            "STATUS_QUERY",
            "FOLLOW_UP",
            "CHATTER",
            "UNKNOWN"
          ]
        },
        "system_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "module_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "symptom_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "error_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 20
        },
        "reported_location": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "campus_text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "department_text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "location_text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            }
          }
        },
        "impact_scope_suggestion": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "SINGLE_USER",
            "SINGLE_TERMINAL",
            "SINGLE_LOCATION",
            "SINGLE_WARD",
            "SINGLE_DEPARTMENT",
            "MULTI_DEPARTMENT",
            "SINGLE_CAMPUS",
            "MULTI_CAMPUS",
            "HOSPITAL_WIDE",
            "UNKNOWN"
          ]
        },
        "clinical_impact_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 20
        },
        "recommended_resolver_team": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 20
        },
        "decision_band": {
          "enum": [
            "MANUAL_TRIAGE",
            "SUGGEST_ROUTE",
            "AUTO_ROUTE",
            "CRITICAL_REVIEW"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "value"
            ],
            "properties": {
              "source": {
                "enum": [
                  "USER_TEXT",
                  "OCR",
                  "RULE",
                  "CATALOG",
                  "SENDER_PROFILE",
                  "MODEL"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 500
              },
              "field": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 128
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "maxItems": 20
        }
      }
    }
  }
}
