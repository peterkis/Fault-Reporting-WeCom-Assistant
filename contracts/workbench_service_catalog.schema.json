{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_service_catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "categories"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "categories": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "category_name_zh",
          "services"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "category_name_zh": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "services": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "service_code",
                "name_zh"
              ],
              "properties": {
                "service_code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "name_zh": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        }
      }
    }
  }
}
