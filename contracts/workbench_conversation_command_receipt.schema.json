{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_conversation_command_receipt.schema.json",
  "title": "workbench_conversation_command_receipt",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "client_command_id",
        "state"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "client_command_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "state": {
          "const": "UNKNOWN"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "client_command_id",
        "state",
        "result"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "client_command_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "state": {
          "const": "COMMITTED"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message_id",
            "outbox_id",
            "delivery_ids",
            "command_status",
            "replayed",
            "created_at"
          ],
          "properties": {
            "message_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "outbox_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "delivery_ids": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              }
            },
            "command_status": {
              "enum": [
                "COMMITTED",
                "REPLAYED"
              ]
            },
            "replayed": {
              "type": "boolean"
            },
            "created_at": {
              "$ref": "local_datetime.schema.json"
            }
          }
        }
      }
    }
  ]
}
