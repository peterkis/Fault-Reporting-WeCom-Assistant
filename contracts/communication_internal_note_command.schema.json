{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/communication_internal_note_command.schema.json",
  "title": "Communication Internal Note Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "expected_row_version", "client_command_id", "text", "privacy_class", "retention_until", "retention_until_epoch_ms"],
  "properties": {
    "session_id": { "type": "string", "format": "uuid" },
    "expected_row_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "client_command_id": { "type": "string", "format": "uuid" },
    "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "privacy_class": { "type": "string", "enum": ["INTERNAL", "SENSITIVE_INTERNAL", "PERSONAL", "PATIENT_SENSITIVE", "SECRET"] },
    "retention_until": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$", "x-business-timezone": "Asia/Shanghai", "x-precision": "second", "x-offset-allowed": false, "maxLength": 40 },
    "retention_until_epoch_ms": { "$ref": "./epoch_ms_string.schema.json" },
    "sender_display_name": { "type": ["string", "null"], "maxLength": 128 }
  }
}
