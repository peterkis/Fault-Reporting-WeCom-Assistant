{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/contracts/p2_016_related_conversation_page.schema.json",
  "title": "Authorized canonical related conversation page with exact BIGINT versions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "session_row_version",
          "conversation_principal_id",
          "conversation_principal_name",
          "assignment_status",
          "take_allowed"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "session_row_version": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "x-maximum": "9223372036854775807"
          },
          "conversation_principal_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "conversation_principal_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "assignment_status": {
            "enum": [
              "ASSIGNED",
              "UNASSIGNED",
              null
            ]
          },
          "take_allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
