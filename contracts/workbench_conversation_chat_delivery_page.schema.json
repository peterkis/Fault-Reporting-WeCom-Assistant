{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench_conversation_chat_delivery_page.schema.json",
  "title": "workbench_conversation_chat_delivery_page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "purpose",
          "delivery_id",
          "status",
          "side_effect_state",
          "channel",
          "attempt_count",
          "last_error_code",
          "sent_at",
          "created_at"
        ],
        "properties": {
          "message_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "purpose": {
            "type": "string",
            "maxLength": 64
          },
          "delivery_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "status": {
            "type": "string",
            "maxLength": 64
          },
          "side_effect_state": {
            "type": "string",
            "maxLength": 64
          },
          "channel": {
            "type": "string",
            "maxLength": 64
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "last_error_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "sent_at": {
            "anyOf": [
              {
                "$ref": "local_datetime.schema.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "$ref": "local_datetime.schema.json"
          }
        }
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
