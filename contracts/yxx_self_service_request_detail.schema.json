{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital.local/schemas/yxx_self_service_request_detail.schema.json",
  "title": "YXX self-service safe request detail",
  "type": "object", "additionalProperties": false,
  "required": ["request_ref", "intake_no", "source_kind", "input_revision", "processed_revision", "display_status", "needs_action", "safe_description", "safe_location", "created_at", "created_epoch_ms", "updated_at", "updated_epoch_ms", "ticket", "safe_clarification", "can_supplement"],
  "properties": {
    "request_ref": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32}$"},
    "intake_no": {"type": "string"}, "source_kind": {"const": "WEB_REQUEST"},
    "input_revision": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "processed_revision": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "display_status": {"type": "string", "enum": ["RECEIVED_PROCESSING", "WAITING_FOR_DETAILS", "UNDER_REVIEW", "TICKET_CREATED", "NOT_SERVICE"]},
    "needs_action": {"type": ["string", "null"]}, "safe_description": {"type": "string"},
    "safe_location": {"type": ["string", "null"]},
    "created_at": {"$ref": "./local_datetime.schema.json"}, "created_epoch_ms": {"$ref": "./epoch_ms_string.schema.json"}, "updated_at": {"$ref": "./local_datetime.schema.json"}, "updated_epoch_ms": {"$ref": "./epoch_ms_string.schema.json"},
    "ticket": {"anyOf": [{"$ref": "./yxx_self_service_ticket_summary.schema.json"}, {"type": "null"}]}, "safe_clarification": {"type": ["string", "null"]}, "can_supplement": {"type": "boolean"}
  }
}
