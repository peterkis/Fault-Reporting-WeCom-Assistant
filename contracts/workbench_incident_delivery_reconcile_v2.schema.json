{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fault-reporting.local/contracts/workbench_incident_delivery_reconcile_v2.schema.json",
  "title": "T33 Incident notification control v2 — explicit Delivery attempt snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_command_id",
    "expected_row_version",
    "expected_status",
    "expected_side_effect_state",
    "reason_code",
    "resolution",
    "expected_delivery_attempt_count"
  ],
  "properties": {
    "client_command_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_row_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "expected_status": {
      "const": "RECONCILIATION_REQUIRED"
    },
    "expected_side_effect_state": {
      "const": "UNKNOWN"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{1,128}$"
    },
    "resolution": {
      "enum": [
        "CONFIRMED_SENT",
        "CONFIRMED_NOT_SENT_REQUEUE",
        "CANCEL"
      ]
    },
    "expected_delivery_attempt_count": {
      "minimum": 0,
      "type": "integer",
      "maximum": 2147483647
    }
  }
}
