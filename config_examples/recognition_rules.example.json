{
  "version": "rules-v1-example",
  "intents": {
    "incident_positive_terms": [
      "报错",
      "打不开",
      "进不去",
      "登录失败",
      "卡死",
      "闪退",
      "蓝屏",
      "无响应",
      "一直转圈",
      "保存失败",
      "提交失败",
      "打印不了",
      "读卡失败",
      "断网",
      "连不上",
      "数据不对",
      "查不到",
      "接口异常",
      "服务不可用",
      "权限错误"
    ],
    "service_request_terms": [
      "开通账号",
      "重置密码",
      "增加权限",
      "安装软件",
      "修改数据",
      "配置打印机",
      "新增用户",
      "离职停用",
      "科室调整"
    ],
    "negation_terms": [
      "没有问题",
      "已经好了",
      "不报错了",
      "无需处理",
      "测试正常",
      "不用管了"
    ],
    "new_request_terms": [
      "新报修",
      "另一个问题",
      "还有一个问题",
      "重新报修"
    ],
    "recovery_terms": [
      "好了",
      "恢复了",
      "可以了",
      "正常了"
    ],
    "status_query_terms": [
      "处理到哪了",
      "怎么样了",
      "有进展吗",
      "谁在处理"
    ]
  },
  "clinical_critical_terms": [
    "抢救",
    "急诊",
    "手术",
    "麻醉",
    "输血",
    "用药",
    "发药",
    "医嘱",
    "危急值",
    "急救",
    "卒中",
    "胸痛",
    "生命支持"
  ],
  "error_code_patterns": [
    "HTTP\\s?[1-5][0-9]{2}",
    "ORA-\\d{5}",
    "SQLSTATE\\[[A-Z0-9]+\\]",
    "0x[0-9A-Fa-f]+",
    "ERR[_-][A-Z0-9_-]+",
    "[A-Z]{2,10}-\\d{2,8}"
  ],
  "context_aggregation": {
    "window_seconds": 90,
    "same_chat_required": true,
    "same_sender_required": true,
    "stop_on_new_request_term": true,
    "max_messages": 10
  },
  "ticket_creation": {
    "explicit_incident_create_immediately": true,
    "pure_image_create_waiting_description": true,
    "ai_required": false,
    "silent_drop_explicit_request": false
  },
  "incident_candidate": {
    "auto_link_enabled": false,
    "required_signals_for_candidate": 3,
    "signals": [
      "same_system",
      "same_module",
      "same_error_code",
      "high_text_similarity",
      "different_reporters",
      "close_time",
      "monitoring_match"
    ],
    "forbidden_rule": "same_category_and_time_only"
  }
}
