{
  "schema_version": "1.0.0",
  "rule_set_id": "CD3H_P2_007_MULTICHANNEL_EXTENSION_RULES",
  "rule_set_version": "0.2.0-draft",
  "depends_on_rule_set_id": "CD3H_P2_007_DETERMINISTIC_RULES",
  "status": "DRAFT_FOR_P2_007_IMPLEMENTATION",
  "evaluation_order": "priority DESC, rule_id ASC",
  "execution_mode": "PURE_FUNCTION_NO_SIDE_EFFECT",
  "inputs": [
    "normalized conversation turns",
    "trusted channel/session metadata",
    "contact journey context",
    "optional authoritative reporter directory snapshot",
    "P2-005 control event read model",
    "P2-004 communication and delivery read model",
    "safe cross-channel correlation context",
    "time-window incident correlation context",
    "optional authoritative monitoring corroboration"
  ],
  "outputs": [
    "entry journey facts",
    "reporter profile snapshot facts",
    "cross-channel correlation decision",
    "description sufficiency",
    "lifecycle audit view",
    "incident candidate only",
    "notification recommendations only",
    "explainable rule hits"
  ],
  "forbidden_actions": [
    "CREATE_TICKET",
    "UPDATE_TICKET_STATUS",
    "CREATE_INCIDENT",
    "LINK_TICKET_TO_INCIDENT",
    "SEND_WECOM_MESSAGE",
    "CALL_WECOM_SDK",
    "CALL_LLM_PROVIDER",
    "WRITE_PATIENT_IDENTIFIER_TO_LOG",
    "WRITE_RAW_CHANNEL_IDENTIFIER_TO_PUBLIC_LOG"
  ],
  "rules": [
    {
      "rule_id": "ENTRY-001",
      "version": "1.0.0",
      "group": "ENTRY_JOURNEY",
      "priority": 2000,
      "description_zh": "群内 @Bot 且同一触发消息包含可用故障描述时，标记为群内直接描述入口。",
      "when": {
        "all": [
          {
            "field": "channel.type",
            "eq": "WECOM_GROUP"
          },
          {
            "field": "channel.bot_mentioned",
            "eq": true
          },
          {
            "field": "description.has_incident_signal",
            "eq": true
          }
        ]
      },
      "actions": [
        {
          "action": "SET_ENTRY_MODE",
          "value": "GROUP_MENTION_INLINE"
        },
        {
          "action": "PRESERVE_ORIGIN",
          "channel": "WECOM_GROUP"
        }
      ],
      "explanation_template_zh": "群聊是不可变来源，即使后续转入单聊也不得改写来源。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "ENTRY-002",
      "version": "1.0.0",
      "group": "ENTRY_JOURNEY",
      "priority": 1999,
      "description_zh": "群内仅 @Bot、问候或无有效描述时，建议建立单聊引导，但先保留 Intake 来源。",
      "when": {
        "all": [
          {
            "field": "channel.type",
            "eq": "WECOM_GROUP"
          },
          {
            "field": "channel.bot_mentioned",
            "eq": true
          },
          {
            "field": "description.has_incident_signal",
            "eq": false
          }
        ]
      },
      "actions": [
        {
          "action": "SET_ENTRY_MODE",
          "value": "GROUP_MENTION_TO_DIRECT_GUIDED"
        },
        {
          "action": "SET_SUFFICIENCY",
          "value": "EMPTY"
        },
        {
          "action": "RECOMMEND_NOTIFICATION",
          "purpose": "PRIVATE_GUIDANCE"
        }
      ],
      "explanation_template_zh": "群内入口不等于已有故障事实；应先引导描述。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "ENTRY-003",
      "version": "1.0.0",
      "group": "ENTRY_JOURNEY",
      "priority": 1998,
      "description_zh": "群内描述中出现患者敏感信息或需要患者标识时，建议转入受控单聊。",
      "when": {
        "all": [
          {
            "field": "channel.type",
            "eq": "WECOM_GROUP"
          },
          {
            "field": "privacy.patient_sensitive_detected",
            "eq": true
          }
        ]
      },
      "actions": [
        {
          "action": "SET_SUFFICIENCY",
          "value": "SENSITIVE_MOVE_TO_PRIVATE"
        },
        {
          "action": "RECOMMEND_NOTIFICATION",
          "purpose": "PRIVATE_GUIDANCE"
        },
        {
          "action": "MARK_GROUP_CONTENT",
          "value": "DO_NOT_ECHO"
        }
      ],
      "explanation_template_zh": "不得在群内继续追问患者号、姓名、电话或证件信息。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "ENTRY-004",
      "version": "1.0.0",
      "group": "ENTRY_JOURNEY",
      "priority": 1997,
      "description_zh": "用户主动单聊 Bot 且没有可验证群聊延续关系时，标记为单聊自然入口。",
      "when": {
        "all": [
          {
            "field": "channel.type",
            "eq": "WECOM_DIRECT"
          },
          {
            "field": "correlation.explicit_link_present",
            "eq": false
          }
        ]
      },
      "actions": [
        {
          "action": "SET_ENTRY_MODE",
          "value": "DIRECT_ORGANIC"
        },
        {
          "action": "PRESERVE_ORIGIN",
          "channel": "WECOM_DIRECT"
        }
      ],
      "explanation_template_zh": "单聊自然入口不得虚构群聊来源。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "ENTRY-005",
      "version": "1.0.0",
      "group": "ENTRY_JOURNEY",
      "priority": 1996,
      "description_zh": "单聊消息携带 Provider reply context 或服务器 continuation_ref 时，精确关联群聊来源旅程。",
      "when": {
        "all": [
          {
            "field": "channel.type",
            "eq": "WECOM_DIRECT"
          },
          {
            "field": "correlation.verified_continuation",
            "eq": true
          }
        ]
      },
      "actions": [
        {
          "action": "APPEND_CHANNEL_LEG",
          "role": "CONTINUATION"
        },
        {
          "action": "SET_CORRELATION",
          "state": "EXACT"
        }
      ],
      "explanation_template_zh": "跨渠道关联依赖可验证引用，不依赖文本猜测。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "ENTRY-006",
      "version": "1.0.0",
      "group": "ENTRY_JOURNEY",
      "priority": 1995,
      "description_zh": "同一用户同时存在多个待补充 Intake 且单聊没有关联引用时，禁止自动合并。",
      "when": {
        "all": [
          {
            "field": "channel.type",
            "eq": "WECOM_DIRECT"
          },
          {
            "field": "correlation.pending_intake_count",
            "gt": 1
          },
          {
            "field": "correlation.verified_continuation",
            "eq": false
          }
        ]
      },
      "actions": [
        {
          "action": "SET_CORRELATION",
          "state": "AMBIGUOUS"
        },
        {
          "action": "ASK",
          "question_code": "Q_SELECT_PENDING_INTAKE"
        }
      ],
      "explanation_template_zh": "避免把两个故障错误合并。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "ENTRY-007",
      "version": "1.0.0",
      "group": "ENTRY_JOURNEY",
      "priority": 1994,
      "description_zh": "仅凭相同用户和相近时间不得把群聊与单聊自动合并。",
      "when": {
        "all": [
          {
            "field": "correlation.same_user",
            "eq": true
          },
          {
            "field": "correlation.close_in_time",
            "eq": true
          },
          {
            "field": "correlation.explicit_link_present",
            "eq": false
          }
        ]
      },
      "actions": [
        {
          "action": "SET_CORRELATION",
          "state": "CANDIDATE"
        },
        {
          "action": "SET_REQUIRES_HUMAN_CONFIRMATION",
          "value": true
        }
      ],
      "explanation_template_zh": "身份和时间只能产生候选，不能成为跨渠道事实。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "ENTRY-008",
      "version": "1.0.0",
      "group": "ENTRY_JOURNEY",
      "priority": 1993,
      "description_zh": "群内转单聊后，origin_channel 仍保持 WECOM_GROUP。",
      "when": {
        "all": [
          {
            "field": "entry_mode",
            "eq": "GROUP_MENTION_TO_DIRECT_GUIDED"
          },
          {
            "field": "current_channel",
            "eq": "WECOM_DIRECT"
          }
        ]
      },
      "actions": [
        {
          "action": "ASSERT_ORIGIN_IMMUTABLE",
          "value": "WECOM_GROUP"
        }
      ],
      "explanation_template_zh": "当前渠道变化不改写最初来源。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "IDENT-001",
      "version": "1.0.0",
      "group": "REPORTER_IDENTITY",
      "priority": 1900,
      "description_zh": "上报人身份只从可信渠道元数据读取，不从正文中的姓名或账号猜测。",
      "when": {
        "field": "channel.trusted_reporter_ref",
        "exists": true
      },
      "actions": [
        {
          "action": "EMIT_FACT",
          "field_path": "reporter.reporter_ref",
          "source_kind": "TRUSTED_CHANNEL_METADATA"
        }
      ],
      "explanation_template_zh": "正文中的署名可能是转述、引用或患者姓名。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "IDENT-002",
      "version": "1.0.0",
      "group": "REPORTER_IDENTITY",
      "priority": 1899,
      "description_zh": "首次接触时查询权威目录并保留姓名、部门的时间点快照。",
      "when": {
        "field": "directory.lookup_status",
        "eq": "RESOLVED"
      },
      "actions": [
        {
          "action": "CREATE_PROFILE_SNAPSHOT",
          "source_kind": "DIRECTORY_PROFILE_SNAPSHOT"
        }
      ],
      "explanation_template_zh": "快照用于审计，当前目录引用用于后续展示。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "IDENT-003",
      "version": "1.0.0",
      "group": "REPORTER_IDENTITY",
      "priority": 1898,
      "description_zh": "目录返回多个部门成员关系时全部保留，不擅自选择唯一部门。",
      "when": {
        "field": "directory.department_membership_count",
        "gt": 1
      },
      "actions": [
        {
          "action": "PRESERVE_ALL_DEPARTMENT_MEMBERSHIPS"
        },
        {
          "action": "MARK_PRIMARY_ONLY_IF_AUTHORITATIVE"
        }
      ],
      "explanation_template_zh": "兼岗、轮转、借调和多科室身份不能被压扁。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "IDENT-004",
      "version": "1.0.0",
      "group": "REPORTER_IDENTITY",
      "priority": 1897,
      "description_zh": "目录查询失败时姓名和部门保持未知，业务仍可继续。",
      "when": {
        "field": "directory.lookup_status",
        "in": [
          "NOT_FOUND",
          "UNAVAILABLE"
        ]
      },
      "actions": [
        {
          "action": "SET_PROFILE_LOOKUP_STATUS",
          "from": "directory.lookup_status"
        },
        {
          "action": "DO_NOT_GUESS_PROFILE"
        }
      ],
      "explanation_template_zh": "身份补全失败不能造成漏单，也不能从群名推断部门。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "IDENT-005",
      "version": "1.0.0",
      "group": "REPORTER_IDENTITY",
      "priority": 1896,
      "description_zh": "上报人所属部门与故障发生地点/科室分开建模。",
      "when": {
        "field": "reporter.department_present",
        "eq": true
      },
      "actions": [
        {
          "action": "ASSERT_SEPARATE_FIELD",
          "left": "reporter.department",
          "right": "occurrence_location.department"
        }
      ],
      "explanation_template_zh": "医生可能替其他诊室、病区或患者报修。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "TIME-001",
      "version": "1.0.0",
      "group": "TIME_SEMANTICS",
      "priority": 1880,
      "description_zh": "reported_at 使用最早可信的用户发起消息时间。",
      "when": {
        "field": "journey.origin.occurred_at",
        "exists": true
      },
      "actions": [
        {
          "action": "EMIT_FACT",
          "field_path": "reported_at",
          "value_from": "journey.origin.occurred_at"
        }
      ],
      "explanation_template_zh": "转入单聊不应重写最初上报时间。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "TIME-002",
      "version": "1.0.0",
      "group": "TIME_SEMANTICS",
      "priority": 1879,
      "description_zh": "Provider 发送、Gateway 接收、Inbox 提交、Intake/Ticket 创建时间分别留存。",
      "when": {
        "field": "pipeline.timestamps",
        "exists": true
      },
      "actions": [
        {
          "action": "PRESERVE_DISTINCT_TIMESTAMPS"
        }
      ],
      "explanation_template_zh": "单一“报修时间”不能满足延迟分析和审计。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "TIME-003",
      "version": "1.0.0",
      "group": "TIME_SEMANTICS",
      "priority": 1878,
      "description_zh": "领域业务时间使用 Asia/Shanghai 本地秒，物理期限使用 epoch ms。",
      "when": {
        "field": "time.business_timezone",
        "eq": "Asia/Shanghai"
      },
      "actions": [
        {
          "action": "ENFORCE_LOCAL_DATETIME_CONTRACT",
          "value": "YYYY-MM-DD HH:mm:ss"
        }
      ],
      "explanation_template_zh": "业务时间不依赖服务器时区；期限和 elapsed time 由 PhysicalEpochMs 承担。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "XAGG-001",
      "version": "1.0.0",
      "group": "MULTICHANNEL_AGGREGATION",
      "priority": 1800,
      "description_zh": "单聊引导会话按 Session 聚合，不受 P1 90 秒持久化窗口强制切断。",
      "when": {
        "all": [
          {
            "field": "channel.type",
            "eq": "WECOM_DIRECT"
          },
          {
            "field": "session.active",
            "eq": true
          },
          {
            "field": "context.explicit_new_report",
            "eq": false
          }
        ]
      },
      "actions": [
        {
          "action": "APPEND_TO_ACTIVE_ANALYSIS_WINDOW",
          "relation": "SUPPLEMENT"
        }
      ],
      "explanation_template_zh": "用户可能隔数分钟补 IP、诊室、影响和尝试结果。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "XAGG-002",
      "version": "1.0.0",
      "group": "MULTICHANNEL_AGGREGATION",
      "priority": 1799,
      "description_zh": "每条碎片消息立即入库并增量更新事实，不等待用户一次说完。",
      "when": {
        "field": "turn.accepted",
        "eq": true
      },
      "actions": [
        {
          "action": "INCREMENTAL_EXTRACT"
        },
        {
          "action": "PRESERVE_SOURCE_TURN"
        }
      ],
      "explanation_template_zh": "实时持久化优先，聚合只用于解释上下文。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "XAGG-003",
      "version": "1.0.0",
      "group": "MULTICHANNEL_AGGREGATION",
      "priority": 1798,
      "description_zh": "短暂停顿只用于 UI/规则评估防抖，不延迟高风险 Intake。",
      "when": {
        "field": "fragmentation.waiting_for_more",
        "eq": true
      },
      "actions": [
        {
          "action": "APPLY_DEBOUNCE",
          "default_ms": 8000
        },
        {
          "action": "BYPASS_DEBOUNCE_IF_HIGH_RISK"
        }
      ],
      "explanation_template_zh": "防抖不是事务一致性或工单创建门槛。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "XAGG-004",
      "version": "1.0.0",
      "group": "MULTICHANNEL_AGGREGATION",
      "priority": 1797,
      "description_zh": "群聊和单聊 Leg 只能通过精确关联附加到同一 Intake。",
      "when": {
        "field": "correlation.link_state",
        "eq": "EXACT"
      },
      "actions": [
        {
          "action": "LINK_CHANNEL_LEG_TO_INTAKE"
        }
      ],
      "explanation_template_zh": "不得把两份原始时间线物理合并或覆盖。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "XAGG-005",
      "version": "1.0.0",
      "group": "MULTICHANNEL_AGGREGATION",
      "priority": 1796,
      "description_zh": "用户明确说另一个问题、新报修时创建新的分析窗口。",
      "when": {
        "field": "context.explicit_new_report",
        "eq": true
      },
      "actions": [
        {
          "action": "START_NEW_ANALYSIS_WINDOW",
          "reason": "EXPLICIT_NEW_REPORT"
        }
      ],
      "explanation_template_zh": "即使同一单聊 Session，也可能同时存在多个问题。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "XAGG-006",
      "version": "1.0.0",
      "group": "MULTICHANNEL_AGGREGATION",
      "priority": 1795,
      "description_zh": "描述已达到最小故障事实时建议继续建 Intake/路由，缺失字段后补。",
      "when": {
        "all": [
          {
            "field": "description.observable_symptom",
            "exists": true
          },
          {
            "any": [
              {
                "field": "description.service_or_object",
                "exists": true
              },
              {
                "field": "description.occurrence_location",
                "exists": true
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "action": "SET_SUFFICIENCY",
          "value": "SUFFICIENT_FOR_INTAKE"
        },
        {
          "action": "RECOMMEND_INTAKE_CREATION"
        }
      ],
      "explanation_template_zh": "医院故障不应因等待完美描述而漏报。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "HUMAN-001",
      "version": "1.0.0",
      "group": "HUMAN_LIFECYCLE",
      "priority": 1700,
      "description_zh": "每个 Session 同时只有一个权威责任坐席。",
      "when": {
        "field": "assignment.active_owner_count",
        "gte": 0
      },
      "actions": [
        {
          "action": "ASSERT_MAX_ACTIVE_OWNER",
          "value": 1
        }
      ],
      "explanation_template_zh": "多人协作不等于多人同时拥有状态修改权。",
      "safety": [
        "仅输出结构化事实、候选或通知建议，不产生业务副作用。"
      ]
    },
    {
      "rule_id": "HUMAN-002",
      "version": "1.0.0",
      "group": "HUMAN_LIFECYCLE",
      "priority": 1699,
      "description_zh": "并发接管时成功和冲突尝试都进入审计视图。",
      "when": {
