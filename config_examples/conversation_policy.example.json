{
  "version": "1.2",
  "contract_task": "P2-006",
  "default_control_mode": "HUMAN",
  "session": {
    "idle_timeout_minutes": 720,
    "recent_message_limit": 20,
    "context_token_budget": 8000,
    "message_aggregation_ms": 1500,
    "max_open_sessions_per_participant": 1,
    "group_context_key": "provider+bot_id+chat_id+participant_user_id+session_id+service_intake_id",
    "topic_switch_reasons": [
      "EXPLICIT_USER_NEW_TOPIC",
      "MANUAL_NEW_INTAKE",
      "DIFFERENT_INTAKE",
      "DIFFERENT_TICKET",
      "IDLE_TIMEOUT"
    ]
  },
  "handoff": {
    "enabled": false,
    "feature_flag": "HUMAN_WORKBENCH_V2_ENABLED",
    "release_target_mode": "HUMAN",
    "assignment_cache_enabled": false,
    "global_unread_cache_enabled": false,
    "command_list_limit": 200,
    "user_keywords": [
      "人工",
      "转人工",
      "找信息科"
    ],
    "force_human_on_sensitive_data": true,
    "force_human_on_critical_urgency": true,
    "force_human_after_failed_turns": 2,
    "generation_version_increment_on": [
      "new_user_message",
      "takeover",
      "transfer",
      "release",
      "new_session",
      "ticket_key_state_change",
      "cancel_generation"
    ]
  },
  "ai": {
    "enabled": false,
    "controlled_auto_authorized": false,
    "rollout_mode": "SHADOW",
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "thinking": "disabled",
    "temperature": 0.3,
    "max_output_tokens": 500,
    "timeout_ms": 15000,
    "max_concurrency": 1,
    "auto_reply_allowlist": [
      "GREETING",
      "MISSING_FIELD_QUESTION",
      "STATUS_QUERY"
    ],
    "auto_reply_min_confidence": 0.95,
    "deny_auto_reply_when": [
      "contains_patient_data",
      "contains_secret",
      "complaint",
      "critical_urgency",
      "patient_care_impact",
      "human_assigned",
      "generation_version_changed"
    ]
  },
  "internal_notes": {
    "include_in_ai_context": false,
    "allow_external_delivery": false,
    "append_only": true
  },
  "communication": {
    "enabled": false,
    "feature_flag": "HUMAN_WORKBENCH_V2_ENABLED",
    "worker_concurrency": 1,
    "batch_size": 20,
    "lease_ms": 30000,
    "send_timeout_ms": 5000,
    "retry_base_ms": 1000,
    "max_attempts": 5,
    "max_deliveries_per_target_window": 20,
    "rate_limit_window_ms": 60000,
    "real_wecom_sender_authorized": false,
    "media_delivery_authorized": false,
    "unknown_side_effect_requires_reconciliation": true
  },
  "realtime": {
    "transport": "SSE",
    "sse_enabled": false,
    "heartbeat_seconds": 20,
    "max_clients": 32,
    "replay_enabled": true,
    "polling_fallback_seconds": 5,
    "event_retention_hours": 168,
    "recovery_poll_seconds": 5,
    "max_writable_buffer_bytes": 65536,
    "drain_timeout_ms": 5000,
    "cleanup_batch_size": 200
  },
  "workbench": {
    "enabled": false,
    "feature_flag": "HUMAN_WORKBENCH_V2_ENABLED",
    "reference_client_only": true,
    "conversation_page_default": 30,
    "conversation_page_max": 100,
    "timeline_page_default": 50,
    "timeline_page_max": 200,
    "polling_fallback_ms": 5000,
    "public_origin_required": true,
    "real_hospital_identity_authorized": false,
    "production_frontend_authorized": false
  }
}
