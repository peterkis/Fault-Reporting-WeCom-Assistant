# Copy outside tracked files. Reuse existing values; do not generate/rotate keys.
WORKBENCH_RUNTIME_PROFILE=human-v1
WORKBENCH_RUNTIME_CONFIG=D:/Projects/Fault-Reporting-WeCom-Assistant/secrets/human-workbench.json
PILOT_DATABASE_URL=replace-with-approved-postgresql-connection
PILOT_LOG_IDENTITY_HASH_KEY=replace-with-existing-identity-hmac-key
P2_016_REPORTER_HMAC_SECRET=replace-with-existing-reporter-hmac-secret
APP_SECRET=replace-with-existing-enterprise-application-secret
# Required when transportEnabled=true or botInboundEnabled=true:
# WECOM_BOT_SECRET=replace-with-existing-bot-secret
# Receive-only authorization; does not enable any real send:
# WORKBENCH_INBOUND_IO_APPROVED=true
# WORKBENCH_INBOUND_IO_APPROVAL_REF=replace-with-current-receive-authorization-reference
# Required only when transportEnabled=true, after separate named send authorization:
# WORKBENCH_EXTERNAL_IO_APPROVED=true
# WORKBENCH_EXTERNAL_IO_APPROVAL_REF=replace-with-current-named-authorization-reference
