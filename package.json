    "g0:003:capture": "node --env-file=.env src/g0-003-frame-capture.mjs",
    "test:g0:003": "node --test tests/g0-003-frame-capture.test.mjs",
    "g0:004:capture": "node --env-file=.env src/g0-004-media-capture.mjs",
    "test:g0:004": "node --test tests/g0-004-media-capture.test.mjs",
    "g0:005:push": "node --env-file=.env src/g0-005-active-push.mjs",
    "test:g0:005": "node --test tests/g0-005-active-push.test.mjs",
    "g0:006:card": "node --env-file=.env src/g0-006-template-card.mjs",
    "g0:006:reply-mention": "node --env-file=.env src/g0-006-group-reply-mention.mjs",
