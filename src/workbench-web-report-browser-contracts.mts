import type {WorkbenchWebReportView,WorkbenchWebMedia,WorkbenchWebUrge,WorkbenchMemberProgress,WorkbenchMemberProgressResult,WorkbenchMemberProgressReceipt,WorkbenchMemberProgressInput} from '../contracts/workbench_web_report_contracts.js';

function invalid():never {throw new TypeError('WEB_REPORT_RESPONSE_INVALID');}
function object(v:unknown,keys:readonly string[]):Record<string,unknown>{if(!v||typeof v!=='object'||Array.isArray(v)||Object.keys(v).length!==keys.length||keys.some(k=>!Object.hasOwn(v,k)))invalid();return v as Record<string,unknown>;}
function text(v:unknown,max:number):string{if(typeof v!=='string'||[...v].length>max||/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/u.test(v))invalid();return v;}
function uuid(v:unknown):string{const s=text(v,36);if(!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/iu.test(s))invalid();return s.toLowerCase();}
function integer(v:unknown,min:number,max=2147483647):number{if(typeof v!=='number'||!Number.isSafeInteger(v)||v<min||v>max)invalid();return v;}
function flag(v:unknown):boolean{if(typeof v!=='boolean')invalid();return v;}
function time(v:unknown):string{const s=text(v,19);if(!/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/u.test(s))invalid();const [date,clock]=s.split(' '),[y,m,d]=(date??'').split('-').map(Number),[h,min,sec]=(clock??'').split(':').map(Number);if(y===undefined||m===undefined||d===undefined||h===undefined||min===undefined||sec===undefined||y<1||m<1||m>12||d<1||d>([31,y%4===0&&(y%100!==0||y%400===0)?29:28,31,30,31,30,31,31,30,31,30,31][m-1]??0)||h>23||min>59||sec>59)invalid();return s;}
function nullableTime(v:unknown):string|null{return v===null?null:time(v);}
export function decodeWebUrge(raw:unknown):WorkbenchWebUrge{const v=object(raw,['active','count','last_urged_at']),active=flag(v.active),count=integer(v.count,0),last=nullableTime(v.last_urged_at);if(count===0&&last!==null||count>0&&last===null||active&&count===0)invalid();return {active,count,last_urged_at:last};}
function epoch(raw:unknown,local:string,exact=false):string{const v=text(raw,16),expected=Date.parse(local.replace(' ','T')+'+08:00');if(!/^[1-9][0-9]{0,15}$/u.test(v)||!Number.isSafeInteger(expected)||BigInt(v)/1000n!==BigInt(expected)/1000n||exact&&BigInt(v)%1000n!==0n)invalid();return v;}
export function decodeMemberProgress(raw:unknown):WorkbenchMemberProgress{const v=object(raw,['summary','estimated_at','estimated_epoch_ms','version','updated_at','updated_epoch_ms']),summary=text(v.summary,1000);if(!summary.trim())invalid();const estimated=nullableTime(v.estimated_at),updated=time(v.updated_at);if(estimated===null&&v.estimated_epoch_ms!==null)invalid();return {summary,estimated_at:estimated,estimated_epoch_ms:estimated===null?null:epoch(v.estimated_epoch_ms,estimated,true),version:integer(v.version,1),updated_at:updated,updated_epoch_ms:epoch(v.updated_epoch_ms,updated)};}
export function decodeWebMedia(raw:unknown):WorkbenchWebMedia{const v=object(raw,['media_ref','kind','mime_type','byte_size','duration_ms','playback_status','playback_mime_type']);if(v.kind!=='VOICE'&&v.kind!=='IMAGE'&&v.kind!=='VIDEO'||v.playback_status!=='READY'&&v.playback_status!=='PENDING'&&v.playback_status!=='UNAVAILABLE')invalid();const mime=text(v.mime_type,96),playback=v.playback_mime_type===null?null:text(v.playback_mime_type,96);if(!/^(?:image\/(?:jpeg|png|webp)|audio\/(?:amr|mpeg|mp4|wav|webm|ogg|x-wav)|video\/(?:mp4|webm|quicktime))$/u.test(mime)||playback!==null&&!/^(?:image\/(?:jpeg|png|webp)|audio\/(?:mpeg|mp4|wav|webm|ogg)|video\/(?:mp4|webm))$/u.test(playback))invalid();if(v.kind==='IMAGE'&&!mime.startsWith('image/')||v.kind==='VOICE'&&!mime.startsWith('audio/')||v.kind==='VIDEO'&&!mime.startsWith('video/')||v.playback_status==='READY'&&playback===null||playback!==null&&(v.kind==='VOICE'&&!playback.startsWith('audio/')||v.kind==='VIDEO'&&!playback.startsWith('video/')||v.kind==='IMAGE'&&!playback.startsWith('image/'))||v.kind==='IMAGE'&&v.duration_ms!==null)invalid();return {media_ref:uuid(v.media_ref),kind:v.kind,mime_type:mime,byte_size:integer(v.byte_size,1,20*1024*1024),duration_ms:v.duration_ms===null?null:integer(v.duration_ms,1,60_000),playback_status:v.playback_status,playback_mime_type:playback};}
export function decodeWebReport(raw:unknown,expected:{kind:string;id:string}):WorkbenchWebReportView{const v=object(raw,['schema_version','applicable','item','ticket_id','ticket_version','contact_requested','can_publish_progress','public_progress','urge','evaluation','media_available','media']),item=object(v.item,['kind','id']);if(v.schema_version!==1||item.kind!=='ticket'&&item.kind!=='review'&&item.kind!=='intake'||item.kind!==expected.kind||uuid(item.id)!==uuid(expected.id)||!Array.isArray(v.media)||v.media.length>8)invalid();const media=v.media.map(decodeWebMedia);if(media.filter(m=>m.kind==='VOICE').length>1||media.filter(m=>m.kind==='VIDEO').length>1||media.filter(m=>m.kind==='IMAGE').length>6||media.reduce((sum,m)=>sum+m.byte_size,0)>40*1024*1024)invalid();const available=flag(v.media_available),applicable=flag(v.applicable),ticketId=v.ticket_id===null?null:uuid(v.ticket_id),ticketVersion=v.ticket_version===null?null:integer(v.ticket_version,1),canPublish=flag(v.can_publish_progress);if(new Set(media.map(m=>m.media_ref)).size!==media.length||!available&&media.length||ticketId===null&&ticketVersion!==null||ticketId!==null&&ticketVersion===null||canPublish&&ticketId===null||!applicable&&(media.length||canPublish))invalid();let evaluation:WorkbenchWebReportView['evaluation']=null;if(v.evaluation!==null){const e=object(v.evaluation,['rating','comment','evaluated_at']);evaluation={rating:integer(e.rating,1,5),comment:e.comment===null?null:text(e.comment,200),evaluated_at:time(e.evaluated_at)};}return {schema_version:1,applicable,item:{kind:item.kind,id:uuid(item.id)},ticket_id:ticketId,ticket_version:ticketVersion,contact_requested:flag(v.contact_requested),can_publish_progress:canPublish,public_progress:v.public_progress===null?null:decodeMemberProgress(v.public_progress),urge:decodeWebUrge(v.urge),evaluation,media_available:available,media};}
export function decodeMemberProgressResult(raw:unknown,expected:{ticketId:string;commandId:string;input?:WorkbenchMemberProgressInput}):WorkbenchMemberProgressResult{const v=object(raw,['ok','replayed','client_command_id','ticket_id','ticket_version','public_progress']);if(v.ok!==true||uuid(v.ticket_id)!==uuid(expected.ticketId)||uuid(v.client_command_id)!==uuid(expected.commandId))invalid();const version=integer(v.ticket_version,1),progress=decodeMemberProgress(v.public_progress);if(progress.version!==version)invalid();if(expected.input&&(version!==expected.input.expected_version+1||progress.summary!==expected.input.summary||progress.estimated_at!==expected.input.estimated_at))invalid();return {ok:true,replayed:flag(v.replayed),client_command_id:uuid(v.client_command_id),ticket_id:uuid(v.ticket_id),ticket_version:version,public_progress:progress};}
export function decodeMemberProgressReceipt(raw:unknown,expected:{ticketId:string;commandId:string}):WorkbenchMemberProgressReceipt{if(!raw||typeof raw!=='object'||Array.isArray(raw))invalid();const state=Reflect.get(raw,'state');if(state==='UNKNOWN'){const v=object(raw,['state','client_command_id','ticket_id']);if(uuid(v.ticket_id)!==uuid(expected.ticketId)||uuid(v.client_command_id)!==uuid(expected.commandId))invalid();return {state,client_command_id:uuid(v.client_command_id),ticket_id:uuid(v.ticket_id)};}if(state==='COMMITTED'){const v=object(raw,['state','client_command_id','ticket_id','result']);if(uuid(v.ticket_id)!==uuid(expected.ticketId)||uuid(v.client_command_id)!==uuid(expected.commandId))invalid();return {state,client_command_id:uuid(v.client_command_id),ticket_id:uuid(v.ticket_id),result:decodeMemberProgressResult(v.result,expected)};}return invalid();}
