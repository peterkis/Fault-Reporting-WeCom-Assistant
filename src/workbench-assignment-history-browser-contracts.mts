import type {LocalDateTime} from '../contracts/time_contracts.js';
import type {P2016AssignmentHistoryPage,P2016AssignmentHistoryName,P2016AssignmentHistoryResponsibility,P2016AssignmentHistoryItem,P2016AssignmentHistoryCommunication} from '../contracts/p2_016_assignment_history_contracts.js';
function invalid():never{throw new TypeError('ASSIGNMENT_HISTORY_INVALID_RESPONSE');}
function object(value:unknown,keys:readonly string[]):Record<string,unknown>{if(!value||typeof value!=='object'||Array.isArray(value)||Object.keys(value).length!==keys.length||keys.some(key=>!Object.hasOwn(value,key)))invalid();return value as Record<string,unknown>;}
function text(value:unknown):string{if(typeof value!=='string')invalid();return value;}
function uuid(value:unknown):string{const v=text(value);if(!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u.test(v))invalid();return v;}
function integer(value:unknown):number{if(!Number.isSafeInteger(value)||(value as number)<1||(value as number)>2147483647)invalid();return value as number;}
function time(value:unknown):LocalDateTime{const v=text(value);if(!/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/u.test(v))invalid();const y=Number(v.slice(0,4)),m=Number(v.slice(5,7)),d=Number(v.slice(8,10)),maximum=[31,y%4===0&&(y%100!==0||y%400===0)?29:28,31,30,31,30,31,31,30,31,30,31][m-1];if(y<1||m<1||m>12||d<1||maximum===undefined||d>maximum||Number(v.slice(11,13))>23||Number(v.slice(14,16))>59||Number(v.slice(17,19))>59)invalid();return v as LocalDateTime;}
function name(value:unknown):P2016AssignmentHistoryName{if(value&&typeof value==='object'&&!Array.isArray(value)&&'state'in value&&value.state==='KNOWN'){const v=object(value,['state','name']),label=text(v.name);if(!label.trim()||label.length>128||/[\u0000-\u001f\u007f]/u.test(label))invalid();return{state:'KNOWN',name:label};}const v=object(value,['state']);if(v.state!=='NONE'&&v.state!=='UNKNOWN')invalid();return{state:v.state};}
function responsibility(value:unknown):P2016AssignmentHistoryResponsibility{const v=object(value,['person','team']);return{person:name(v.person),team:name(v.team)};}
function communication(value:unknown):P2016AssignmentHistoryCommunication{const v=object(value,['session_id','control_event_id','occurred_at','actor','previous','next']);return{session_id:uuid(v.session_id),control_event_id:uuid(v.control_event_id),occurred_at:time(v.occurred_at),actor:name(v.actor),previous:name(v.previous),next:name(v.next)};}
function item(value:unknown):P2016AssignmentHistoryItem{const v=object(value,['ticket_event_id','event_ordinal','kind','occurred_at','actor','handling_cycle','previous','next','communication']);if(v.kind!=='FIRST_RESPONSIBILITY'&&v.kind!=='RESPONSIBILITY_CHANGE')invalid();const cycle=v.handling_cycle&&typeof v.handling_cycle==='object'&&'state'in v.handling_cycle&&v.handling_cycle.state==='KNOWN'?object(v.handling_cycle,['state','cycle_no']):object(v.handling_cycle,['state']);if(cycle.state!=='KNOWN'&&cycle.state!=='UNKNOWN')invalid();if(!Array.isArray(v.communication)||v.communication.length>8)invalid();const controls=v.communication.map(communication);if(new Set(controls.map(control=>control.control_event_id)).size!==controls.length)invalid();return{ticket_event_id:uuid(v.ticket_event_id),event_ordinal:integer(v.event_ordinal),kind:v.kind,occurred_at:time(v.occurred_at),actor:name(v.actor),handling_cycle:cycle.state==='KNOWN'?{state:'KNOWN',cycle_no:integer(cycle.cycle_no)}:{state:'UNKNOWN'},previous:responsibility(v.previous),next:responsibility(v.next),communication:controls};}
/** A malformed or cross-Ticket page cannot become confirmed historical display. */
export function decodeAssignmentHistory(value:unknown,ticketId:string):P2016AssignmentHistoryPage{const v=object(value,['schema_version','ticket_id','initial_basis','items','next_cursor']);if(v.schema_version!==1||uuid(v.ticket_id)!==uuid(ticketId)||v.initial_basis!=='RECORDED'&&v.initial_basis!=='UNKNOWN'||!Array.isArray(v.items)||v.items.length>100)invalid();const items=v.items.map(item);if(new Set(items.map(row=>row.ticket_event_id)).size!==items.length||items.some((row,index)=>index>0&&row.event_ordinal<=(items[index-1]?.event_ordinal??0)))invalid();const cursor=v.next_cursor===null?null:text(v.next_cursor);if(cursor!==null&&(!cursor.length||cursor.length>2048||items.length===0))invalid();return{schema_version:1,ticket_id:ticketId,initial_basis:v.initial_basis,items,next_cursor:cursor};}