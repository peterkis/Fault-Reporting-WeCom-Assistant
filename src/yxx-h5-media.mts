  async claimInTransaction({transaction,scope,refs,intakeId,submissionId,requestRef:ref,retentionUntilEpochMs}:H5MediaClaim):Promise<void>{writable();if(!Array.isArray(refs)||refs.length>8||new Set(refs).size!==refs.length)mediaFail('YXX_MEDIA_INPUT_INVALID');if(!refs.length)return;const values=safeScope(scope),ids=refs.map(mediaUuid);mediaUuid(intakeId);mediaUuid(submissionId);requestRef(ref);if(!/^[1-9][0-9]{0,15}$/u.test(retentionUntilEpochMs)||BigInt(retentionUntilEpochMs)<=BigInt(now()))mediaFail('YXX_MEDIA_INPUT_INVALID');
