  async cleanupExpired():Promise<number>{return operation(undefined,async()=>{const q=await pool.query<MediaRow>('SELECT * FROM intake.web_media_upload WHERE expires_epoch_ms<=platform.physical_epoch_ms() AND purged_epoch_ms IS NULL ORDER BY expires_epoch_ms LIMIT 16');for(const row of q.rows){await store.remove(row.media_ref,'ORIGINAL');await store.remove(row.media_ref,'PLAYABLE');await store.remove(row.media_ref,'THUMBNAIL');await pool.query('UPDATE intake.web_media_upload SET purged_epoch_ms=platform.physical_epoch_ms() WHERE media_ref=$1::uuid AND expires_epoch_ms<=platform.physical_epoch_ms()',[row.media_ref]);}return q.rows.length;},0);},
