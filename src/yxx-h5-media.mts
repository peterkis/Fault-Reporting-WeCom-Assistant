 if(Object.keys(v).length!==keys.length||keys.some(k=>!Object.hasOwn(v,k))||v.schema_version!==1||!['VOICE','IMAGE','VIDEO'].includes(String(v.kind))||typeof v.mime_type!=='string')mediaFail('YXX_MEDIA_INPUT_INVALID');const kind=v.kind as H5MediaKind,mime=v.mime_type;
 if(!supportedMedia(kind,mime)||v.byte_size!==null&&(!Number.isSafeInteger(v.byte_size)||Number(v.byte_size)<1||Number(v.byte_size)>H5_MEDIA_LIMITS[kind])||v.duration_ms!==null&&(!Number.isSafeInteger(v.duration_ms)||Number(v.duration_ms)<1||Number(v.duration_ms)>H5_MEDIA_LIMITS.duration)||kind==='IMAGE'&&v.duration_ms!==null)mediaFail('YXX_MEDIA_INPUT_INVALID');
 return {schema_version:1,client_command_id:mediaUuid(v.client_command_id),kind,mime_type:mime,byte_size:v.byte_size as number|null,duration_ms:v.duration_ms as number|null};
}
const currentBinding=`(m.intake_id IS NULL OR (b.intake_id=m.intake_id AND b.request_ref=m.request_ref AND b.canonical_reporter_binding=m.scope_hash AND b.source_corp_scope=m.source_corp_scope AND b.source_app_scope=m.source_app_scope AND b.revoked_at IS NULL AND b.retention_until_epoch_ms>platform.physical_epoch_ms() AND i.retention_until>platform.local_now()))`;
const selectCurrent=`SELECT m.* FROM intake.web_media_upload m LEFT JOIN intake.web_request_binding b ON b.intake_id=m.intake_id LEFT JOIN intake.service_intake i ON i.id=m.intake_id WHERE m.expires_epoch_ms>platform.physical_epoch_ms() AND ${currentBinding}`;

export function createYxxH5Media({pool,store,wecom=null,transcoder=null,enabled=false,now=Date.now}:YxxH5MediaOptions){
 if(!pool||!store||typeof enabled!=='boolean')mediaFail('YXX_MEDIA_CONFIG_INVALID',503);let stopped=false,active=0,plaintextBytes=0;const controllers=new Set<AbortController>();let settled:Promise<void>=Promise.resolve(),finish=()=>{};
 function writable(){if(!enabled||stopped)mediaFail('YXX_MEDIA_WRITE_DISABLED',403);}
 async function operation<T>(signal:AbortSignal|undefined,run:(combined:AbortSignal)=>Promise<T>):Promise<T>{if(stopped)mediaFail('YXX_MEDIA_STORAGE_UNAVAILABLE',503);if(active)mediaFail('YXX_MEDIA_BUSY',429);active=1;settled=new Promise<void>(r=>{finish=r;});const controller=new AbortController();controllers.add(controller);const combined=signal?AbortSignal.any([signal,controller.signal]):controller.signal;const timer=setTimeout(()=>controller.abort(),H5_MEDIA_LIMITS.deadline);timer.unref();try{return await run(combined);}finally{clearTimeout(timer);controllers.delete(controller);active=0;finish();}}
 async function own({scope,ref}:Own,tx:PostgresTransaction=pool):Promise<MediaRow>{const q=await tx.query<MediaRow>(selectCurrent+' AND m.scope_hash=$1 AND m.source_corp_scope=$2 AND m.source_app_scope=$3 AND m.media_ref=$4::uuid',[...safeScope(scope),mediaUuid(ref)]);if(!q.rows[0])mediaFail('YXX_MEDIA_NOT_FOUND',404);return q.rows[0];}
 async function staff(intakeId:string,ref:string):Promise<MediaRow>{const q=await pool.query<MediaRow>(selectCurrent+" AND m.state='BOUND' AND m.intake_id=$1::uuid AND m.media_ref=$2::uuid",[mediaUuid(intakeId),mediaUuid(ref)]);if(!q.rows[0])mediaFail('YXX_MEDIA_NOT_FOUND',404);return q.rows[0];}
 async function collect(body:AsyncIterable<Uint8Array>,max:number,signal:AbortSignal){const chunks:Buffer[]=[];let length=0,complete=false;const iterator=body[Symbol.asyncIterator]();let abort=()=>{};const cancelled=new Promise<never>((_,reject)=>{abort=()=>{if(body instanceof Readable)body.destroy();reject(new H5MediaError('YXX_MEDIA_UPLOAD_CANCELLED',408));};signal.addEventListener('abort',abort,{once:true});});
  try{signal.throwIfAborted();for(;;){const result=await Promise.race([iterator.next(),cancelled]);signal.throwIfAborted();if(result.done){complete=true;break;}const value=result.value;if(!(value instanceof Uint8Array))mediaFail('YXX_MEDIA_INPUT_INVALID');length+=value.byteLength;if(length>max)mediaFail('YXX_MEDIA_OVERSIZED',413);chunks.push(Buffer.from(value));}return Buffer.concat(chunks,length);}
  finally{signal.removeEventListener('abort',abort);if(!complete){if(body instanceof Readable)body.destroy();void iterator.return?.().catch(()=>{});}for(const c of chunks)c.fill(0);}}
 async function acquire(input:Write):Promise<{row:MediaRow;lease:string}>{writable();await input.verifyCurrentWrite();const values=safeScope(input.scope),ref=mediaUuid(input.ref),lease=randomUUID();return transactionP2016(pool,async tx=>{
  const found=await tx.query<MediaRow>("SELECT * FROM intake.web_media_upload WHERE scope_hash=$1 AND source_corp_scope=$2 AND source_app_scope=$3 AND media_ref=$4::uuid AND expires_epoch_ms>platform.physical_epoch_ms() FOR UPDATE",[...values,ref]);const row=found.rows[0];if(!row)mediaFail('YXX_MEDIA_NOT_FOUND',404);if(['READY','BOUND'].includes(row.state)){await input.verifyCurrentWrite();return {row,lease:''};}
  if(row.state==='WRITING'&&row.write_started_epoch_ms&&BigInt(row.write_started_epoch_ms)+BigInt(H5_MEDIA_LIMITS.deadline+5000)<BigInt(now())){await store.remove(row.media_ref,'ORIGINAL');await store.remove(row.media_ref,'PLAYABLE');}else if(row.state!=='RESERVED')mediaFail('YXX_MEDIA_CONFLICT',409);
  await tx.query("UPDATE intake.web_media_upload SET state='WRITING',write_lease=$2::uuid,write_started_epoch_ms=platform.physical_epoch_ms() WHERE media_ref=$1::uuid",[ref,lease]);await input.verifyCurrentWrite();return {row,lease};
 });}
 async function persist(input:Write,row:MediaRow,lease:string,bytes:Buffer,mime:string,signal:AbortSignal):Promise<H5MediaMetadata>{
  let saved=false;try{signal.throwIfAborted();const duration=inspectMedia(bytes,row.kind,mime);if(row.expected_byte_size!==null&&Number(row.expected_byte_size)!==bytes.length)mediaFail('YXX_MEDIA_SIZE_MISMATCH',422);await input.verifyCurrentWrite();
   const asset:H5MediaObject={media_ref:row.media_ref,variant:'ORIGINAL',kind:row.kind,mime_type:mime,byte_size:bytes.length,sha256:hash(bytes)};await store.write(asset,bytes,signal);saved=true;signal.throwIfAborted();
   const playback=row.kind==='IMAGE'?'READY':'PENDING';return await transactionP2016(pool,async tx=>{
    const q=await tx.query<MediaRow>(`UPDATE intake.web_media_upload SET state='READY',write_lease=NULL,write_started_epoch_ms=NULL,mime_type=$3,byte_size=$4,sha256=$5,duration_ms=$6,playback_status=$7,playback_mime_type=$8,playback_byte_size=$9,playback_sha256=$10
      WHERE media_ref=$1::uuid AND write_lease=$2::uuid AND state='WRITING' AND expires_epoch_ms>platform.physical_epoch_ms() RETURNING *`,[row.media_ref,lease,mime,bytes.length,asset.sha256,duration,playback,row.kind==='IMAGE'?mime:null,row.kind==='IMAGE'?bytes.length:null,row.kind==='IMAGE'?asset.sha256:null]);if(!q.rows[0])mediaFail('YXX_MEDIA_CONFLICT',409);await input.verifyCurrentWrite();signal.throwIfAborted();return metadata(q.rows[0]);
   });
  }catch(error){if(saved)await store.remove(row.media_ref,'ORIGINAL').catch(()=>{});throw error;}
 }
 async function reset(ref:string,lease:string){if(lease)await pool.query("UPDATE intake.web_media_upload SET state='RESERVED',write_lease=NULL,write_started_epoch_ms=NULL WHERE media_ref=$1::uuid AND write_lease=$2::uuid AND state='WRITING'",[ref,lease]);}
 async function leaseRead(row:MediaRow,verify:Current,variant:H5MediaVariant,signal:AbortSignal|undefined,refresh:()=>Promise<MediaRow>):Promise<H5MediaLease>{
  if(stopped)mediaFail('YXX_MEDIA_STORAGE_UNAVAILABLE',503);if(active)mediaFail('YXX_MEDIA_BUSY',429);const controller=new AbortController();controllers.add(controller);const combined=signal?AbortSignal.any([signal,controller.signal]):controller.signal;const timer=setTimeout(()=>controller.abort(),H5_MEDIA_LIMITS.deadline);timer.unref();let bytes:Buffer|null=null,released=false;active=1;settled=new Promise<void>(r=>{finish=r;});
  const close=async()=>{if(released)return;released=true;clearTimeout(timer);combined.removeEventListener('abort',abort);bytes?.fill(0);bytes=null;plaintextBytes=0;controllers.delete(controller);active=0;finish();};
  let stream:Readable|null=null;const abort=()=>{stream?.destroy();void close();};
  try{const asset=object(row,variant);await verify();bytes=await store.read(asset,combined);plaintextBytes=bytes.length;const latest=await refresh();if(JSON.stringify(object(latest,variant))!==JSON.stringify(asset))mediaFail('YXX_MEDIA_INTEGRITY_FAILED',422);await verify();combined.throwIfAborted();const content=bytes;
   stream=Readable.from((async function*(){try{for(let at=0;at<content.length;at+=H5_MEDIA_LIMITS.chunk){combined.throwIfAborted();const current=await refresh();if(JSON.stringify(object(current,variant))!==JSON.stringify(asset))mediaFail('YXX_MEDIA_INTEGRITY_FAILED',422);await verify();combined.throwIfAborted();yield Buffer.from(content.subarray(at,at+H5_MEDIA_LIMITS.chunk));}}finally{await close();}})(),{objectMode:false,highWaterMark:H5_MEDIA_LIMITS.chunk});
   combined.addEventListener('abort',abort,{once:true});return {asset:metadata(row),mime_type:asset.mime_type,byte_size:asset.byte_size,stream,close:async()=>{stream?.destroy();await close();}};
  }catch(error){await close();throw error;}
 }
 async function listForRequestInTransaction({transaction,scope,requestRef:ref}:{transaction:PostgresTransaction;scope:YxxMemberScope;requestRef:string}):Promise<readonly H5MediaMetadata[]>{const q=await transaction.query<MediaRow>(selectCurrent+" AND m.state='BOUND' AND m.scope_hash=$1 AND m.source_corp_scope=$2 AND m.source_app_scope=$3 AND m.request_ref=$4 ORDER BY m.created_epoch_ms,m.media_ref LIMIT 8",[...safeScope(scope),requestRef(ref)]);return Object.freeze(q.rows.map(metadata));}
 async function listForRequest({scope,requestRef:ref,verifyCurrentRead}:{scope:YxxMemberScope;requestRef:string;verifyCurrentRead:Current}):Promise<readonly H5MediaMetadata[]>{await verifyCurrentRead();const result=await listForRequestInTransaction({transaction:pool,scope,requestRef:ref});await verifyCurrentRead();return result;}
 return Object.freeze({
  async reserve({scope,input,verifyCurrentWrite}:{scope:YxxMemberScope;input:unknown;verifyCurrentWrite:Current}):Promise<H5MediaReservation>{writable();await verifyCurrentWrite();const v=parse(input),values=safeScope(scope),commandHash=hash(JSON.stringify(v));return transactionP2016(pool,async tx=>{
   await tx.query('SELECT pg_advisory_xact_lock(hashtextextended($1,0))',[values.join(':')]);const existing=await tx.query<MediaRow>('SELECT * FROM intake.web_media_upload WHERE scope_hash=$1 AND client_command_id=$2::uuid',[scope.scopeHash,v.client_command_id]);let row=existing.rows[0],replayed=Boolean(row);
   if(row){if(row.command_hash!==commandHash||row.source_corp_scope!==scope.sourceCorpScope||row.source_app_scope!==scope.sourceAppScope)mediaFail('YXX_MEDIA_CONFLICT',409);if(BigInt(row.expires_epoch_ms)<=BigInt(now()))mediaFail('YXX_MEDIA_EXPIRED',410);}
   else{const count=await tx.query<{n:number}>("SELECT count(*)::int AS n FROM intake.web_media_upload WHERE scope_hash=$1 AND state IN ('RESERVED','WRITING','READY') AND expires_epoch_ms>platform.physical_epoch_ms()",[scope.scopeHash]);if(Number(count.rows[0]?.n)>=H5_MEDIA_LIMITS.unbound)mediaFail('YXX_MEDIA_QUOTA_EXCEEDED',429);
    const q=await tx.query<MediaRow>(`INSERT INTO intake.web_media_upload(media_ref,scope_hash,source_corp_scope,source_app_scope,client_command_id,command_hash,kind,mime_type,expected_byte_size,duration_ms,state,expires_epoch_ms)
      VALUES($1::uuid,$2,$3,$4,$5::uuid,$6,$7,$8,$9,$10,'RESERVED',platform.physical_epoch_ms()+$11::bigint) RETURNING *`,[randomUUID(),...values,v.client_command_id,commandHash,v.kind,v.mime_type,v.byte_size,v.duration_ms,H5_MEDIA_LIMITS.ttl]);row=q.rows[0];}
   if(!row)mediaFail('YXX_MEDIA_STORAGE_UNAVAILABLE',503);await verifyCurrentWrite();return {media_ref:row.media_ref,kind:row.kind,status:row.state,expires_epoch_ms:row.expires_epoch_ms,replayed};
  });},
  async reservation({scope,ref,verifyCurrentRead}:Own&{verifyCurrentRead:Current}){await verifyCurrentRead();const row=await own({scope,ref});await verifyCurrentRead();return {media_ref:row.media_ref,kind:row.kind,status:row.state,expires_epoch_ms:row.expires_epoch_ms,replayed:true};},
  async upload(input:Write&{body:AsyncIterable<Uint8Array>}):Promise<H5MediaMetadata>{return operation(input.signal,async signal=>{const {row,lease}=await acquire(input);if(!lease)return metadata(row);let bytes:Buffer|null=null;try{if(row.expected_byte_size===null)mediaFail('YXX_MEDIA_KNOWN_SIZE_REQUIRED');bytes=await collect(input.body,H5_MEDIA_LIMITS[row.kind],signal);plaintextBytes=bytes.length;return await persist(input,row,lease,bytes,row.mime_type,signal);}catch(error){await reset(row.media_ref,lease);throw error;}finally{bytes?.fill(0);plaintextBytes=0;}});},
  async importWeCom(input:Write&{serverId:string}):Promise<H5MediaMetadata>{return operation(input.signal,async signal=>{const {row,lease}=await acquire(input);if(!lease)return metadata(row);let bytes:Buffer|null=null;try{if(!wecom)mediaFail('YXX_MEDIA_PROVIDER_UNAVAILABLE',503);const result=await wecom.download({kind:row.kind,serverId:input.serverId,signal});bytes=result.bytes;plaintextBytes=bytes.length;await input.verifyCurrentWrite();return await persist(input,row,lease,bytes,result.mime_type,signal);}catch(error){await reset(row.media_ref,lease);throw error;}finally{bytes?.fill(0);plaintextBytes=0;}});},
  async cancel(input:Write){writable();await input.verifyCurrentWrite();const row=await own(input);if(row.state==='BOUND'||row.state==='WRITING')mediaFail('YXX_MEDIA_CONFLICT',409);await transactionP2016(pool,async tx=>{await tx.query("UPDATE intake.web_media_upload SET state='CANCELLED' WHERE media_ref=$1::uuid AND state IN ('RESERVED','READY','CANCELLED')",[row.media_ref]);await input.verifyCurrentWrite();});await store.remove(row.media_ref,'ORIGINAL');await store.remove(row.media_ref,'PLAYABLE');},
  list:listForRequest,listForRequest,listForRequestInTransaction,
  async listForIntake({intakeId,verifyCurrentRead}:{intakeId:string;verifyCurrentRead:Current}):Promise<readonly H5MediaMetadata[]>{await verifyCurrentRead();const q=await pool.query<MediaRow>(selectCurrent+" AND m.state='BOUND' AND m.intake_id=$1::uuid ORDER BY m.created_epoch_ms,m.media_ref LIMIT 8",[mediaUuid(intakeId)]);await verifyCurrentRead();return Object.freeze(q.rows.map(metadata));},
  async read(input:Read):Promise<H5MediaLease>{await input.verifyCurrentRead();const refresh=async()=>{const row=await own(input);if(!['READY','BOUND'].includes(row.state)||input.requestRef!==undefined&&row.request_ref!==requestRef(input.requestRef))mediaFail('YXX_MEDIA_NOT_FOUND',404);return row;};const row=await refresh();return leaseRead(row,input.verifyCurrentRead,input.variant??'PLAYABLE',input.signal,refresh);},
  async readForIntake({intakeId,ref,verifyCurrentRead,variant='PLAYABLE',signal}:{intakeId:string;ref:string;verifyCurrentRead:Current;variant?:H5MediaVariant;signal?:AbortSignal}):Promise<H5MediaLease>{await verifyCurrentRead();const refresh=()=>staff(intakeId,ref);return leaseRead(await refresh(),verifyCurrentRead,variant,signal,refresh);},
  async claimInTransaction({transaction,scope,refs,intakeId,submissionId,requestRef:ref,retentionUntilEpochMs}:H5MediaClaim):Promise<void>{writable();if(!Array.isArray(refs)||refs.length>8||new Set(refs).size!==refs.length)mediaFail('YXX_MEDIA_INPUT_INVALID');if(!refs.length)return;const values=safeScope(scope),ids=refs.map(mediaUuid);mediaUuid(intakeId);mediaUuid(submissionId);requestRef(ref);if(!/^[1-9][0-9]{0,15}$/u.test(retentionUntilEpochMs)||BigInt(retentionUntilEpochMs)<=BigInt(now()))mediaFail('YXX_MEDIA_INPUT_INVALID');
   await transaction.query('SELECT pg_advisory_xact_lock(hashtextextended($1,0))',['web-media:'+intakeId]);const q=await transaction.query<MediaRow>('SELECT * FROM intake.web_media_upload WHERE media_ref=ANY($1::uuid[]) ORDER BY media_ref FOR UPDATE',[ids]);if(q.rows.length!==ids.length)mediaFail('YXX_MEDIA_NOT_FOUND',404);let total=0;const counts={VOICE:0,IMAGE:0,VIDEO:0};
   const bound=await transaction.query<MediaRow>("SELECT * FROM intake.web_media_upload WHERE state='BOUND' AND intake_id=$1::uuid ORDER BY media_ref FOR UPDATE",[intakeId]);for(const row of bound.rows){counts[row.kind]++;total+=Number(row.byte_size);}
   for(const row of q.rows){if(row.scope_hash!==values[0]||row.source_corp_scope!==values[1]||row.source_app_scope!==values[2])mediaFail('YXX_MEDIA_NOT_FOUND',404);if(row.state!=='READY'||BigInt(row.expires_epoch_ms)<=BigInt(now())||!row.byte_size)mediaFail('YXX_MEDIA_NOT_READY',409);counts[row.kind]++;total+=Number(row.byte_size);}
   if(counts.VOICE>1||counts.IMAGE>6||counts.VIDEO>1||total>H5_MEDIA_LIMITS.total)mediaFail('YXX_MEDIA_QUOTA_EXCEEDED',422);
   const updated=await transaction.query(`UPDATE intake.web_media_upload m SET state='BOUND',intake_id=$2::uuid,submission_id=$3::uuid,request_ref=$4,
     expires_epoch_ms=LEAST($5::bigint,b.retention_until_epoch_ms,s.retention_until_epoch_ms,i.retention_until_epoch_ms)
     FROM intake.web_request_binding b JOIN intake.service_intake i ON i.id=b.intake_id JOIN intake.web_submission s ON s.intake_id=b.intake_id AND s.id=$3::uuid
     WHERE m.media_ref=ANY($1::uuid[]) AND b.intake_id=$2::uuid AND b.request_ref=$4 AND b.revoked_at IS NULL AND b.canonical_reporter_binding=m.scope_hash AND b.source_corp_scope=m.source_corp_scope AND b.source_app_scope=m.source_app_scope`,[ids,intakeId,submissionId,ref,retentionUntilEpochMs]);if(updated.rowCount!==ids.length)mediaFail('YXX_MEDIA_NOT_FOUND',404);
  },
  async processNextTranscode():Promise<{processed:boolean}>{if(!transcoder||stopped)return {processed:false};return operation(undefined,async signal=>{
   const token=randomUUID();const q=await transactionP2016(pool,async tx=>tx.query<MediaRow>(`WITH selected AS(${selectCurrent} AND m.state IN ('READY','BOUND') AND m.kind IN ('VOICE','VIDEO') AND m.playback_status='PENDING'
      AND (m.transcode_lease IS NULL OR m.transcode_started_epoch_ms<platform.physical_epoch_ms()-60000) ORDER BY m.created_epoch_ms,m.media_ref FOR UPDATE OF m SKIP LOCKED LIMIT 1)
      UPDATE intake.web_media_upload m SET transcode_lease=$1::uuid,transcode_started_epoch_ms=platform.physical_epoch_ms() FROM selected s WHERE m.media_ref=s.media_ref RETURNING m.*`,[token]));const row=q.rows[0];if(!row)return {processed:false};let original:Buffer|null=null,converted:Buffer|null=null;
   try{original=await store.read(object(row,'ORIGINAL'),signal);plaintextBytes=original.length;const result=await transcoder.normalize({bytes:original,kind:row.kind==='VOICE'?'VOICE':'VIDEO',mime_type:row.mime_type,signal});converted=result.bytes;plaintextBytes+=converted.length;if(!Number.isSafeInteger(result.duration_ms)||result.duration_ms<1||result.duration_ms>H5_MEDIA_LIMITS.duration)mediaFail('YXX_MEDIA_DURATION_EXCEEDED',422);
