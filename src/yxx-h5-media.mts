    const stillCurrent=await pool.query<MediaRow>(selectCurrent+" AND m.media_ref=$1::uuid AND m.state IN ('READY','BOUND') AND m.transcode_lease=$2::uuid",[row.media_ref,token]);if(!stillCurrent.rows[0])mediaFail('YXX_MEDIA_NOT_FOUND',404);
