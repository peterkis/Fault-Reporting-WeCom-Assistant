   const unavailable=async()=>{await pool.query(`UPDATE intake.web_media_upload SET ${prefix}_status='UNAVAILABLE',${prefix}_mime_type=NULL,${prefix}_byte_size=NULL,${prefix}_sha256=NULL,transcode_lease=NULL,transcode_started_epoch_ms=NULL WHERE media_ref=$1::uuid AND transcode_lease=$2::uuid`,[row.media_ref,token]);};
