export {H5MediaError,H5_MEDIA_LIMITS} from './yxx-h5-media-format.mjs';
type Current=()=>Promise<void>;
interface MediaRow extends Record<string,unknown> {media_ref:string;scope_hash:string;source_corp_scope:string;source_app_scope:string;kind:H5MediaKind;mime_type:string;expected_byte_size:string|null;byte_size:string|null;sha256:string|null;duration_ms:number|null;state:H5MediaReservation['status'];write_lease:string|null;write_started_epoch_ms:string|null;playback_status:H5MediaMetadata['playback_status'];playback_mime_type:string|null;playback_byte_size:string|null;playback_sha256:string|null;expires_epoch_ms:string;intake_id:string|null;submission_id:string|null;request_ref:string|null;command_hash:string;created_epoch_ms:string}
interface Own {scope:YxxMemberScope;ref:string}
interface Write extends Own {verifyCurrentWrite:Current;signal?:AbortSignal}
interface Read extends Own {requestRef?:string;verifyCurrentRead:Current;variant?:H5MediaVariant;signal?:AbortSignal}
export interface H5MediaClaim {transaction:PostgresTransaction;scope:YxxMemberScope;refs:readonly string[];intakeId:string;submissionId:string;requestRef:string;retentionUntilEpochMs:string}
export interface YxxH5MediaOptions {pool:PostgresPool;store:H5MediaPrivateStore;wecom?:H5MediaWeCom|null;transcoder?:H5MediaTranscoder|null;enabled?:boolean;now?:()=>number}
const hash=(value:Buffer|string)=>createHash('sha256').update(value).digest('hex');
function safeScope(scope:YxxMemberScope){if(!scope||!/^[a-f0-9]{64}$/u.test(scope.scopeHash)||!scope.sourceCorpScope||scope.sourceCorpScope.length>128||!scope.sourceAppScope||scope.sourceAppScope.length>128)mediaFail('YXX_MEDIA_FORBIDDEN',403);return [scope.scopeHash,scope.sourceCorpScope,scope.sourceAppScope];}
function requestRef(value:string){if(!/^[A-Za-z0-9_-]{32}$/u.test(value))mediaFail('YXX_MEDIA_INPUT_INVALID');return value;}
function metadata(row:MediaRow):H5MediaMetadata {if(!row.byte_size||!row.sha256)mediaFail('YXX_MEDIA_NOT_READY',409);return Object.freeze({media_ref:row.media_ref,kind:row.kind,mime_type:row.mime_type,byte_size:Number(row.byte_size),duration_ms:row.duration_ms,playback_status:row.playback_status,playback_mime_type:row.playback_mime_type});}
function object(row:MediaRow,variant:H5MediaVariant):H5MediaObject {const playable=variant==='PLAYABLE'&&row.kind!=='IMAGE';if(playable&&row.playback_status!=='READY')mediaFail('YXX_MEDIA_PLAYBACK_UNAVAILABLE',503);const byte_size=playable?row.playback_byte_size:row.byte_size,sha256=playable?row.playback_sha256:row.sha256,mime_type=playable?row.playback_mime_type:row.mime_type;if(!byte_size||!sha256||!mime_type)mediaFail('YXX_MEDIA_NOT_READY',409);return {media_ref:row.media_ref,variant:playable?'PLAYABLE':'ORIGINAL',kind:row.kind,mime_type,byte_size:Number(byte_size),sha256};}
function parse(value:unknown):H5MediaReservationInput {
