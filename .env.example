# Hospital IT Support Unified Ticket Platform V1.4 example
# Copy to .env.pilot for P1. Do not commit real values.

ARCHITECTURE_BASELINE=V1.4
APP_PHASE=P1
PILOT_ENV=development
PILOT_LISTEN_HOST=127.0.0.1
PILOT_LISTEN_PORT=3100
PILOT_PUBLIC_EDGE_APPROVED=false
PILOT_SECURITY_BOUNDARY_APPROVED=false
PILOT_OWNER_ID=replace-with-authorized-pilot-owner-id
PILOT_TEST_GROUP_ID=replace-with-authorized-pilot-test-group-id
PILOT_TEST_ACCOUNT_USER_ID=replace-with-authorized-wecom-test-account-user-id

PILOT_DATABASE_URL=postgresql://pilot-user:replace-with-local-password@127.0.0.1:5432/pilot_ticket_core

WECOM_BOT_ID=replace-with-authorized-wecom-bot-id
WECOM_BOT_SECRET=replace-with-authorized-wecom-bot-secret
WECOM_WS_URL=wss://openws.work.weixin.qq.com

# P2-016 Workbench WeCom Web login; keep disabled until the separate public verification gate.
CORP_ID=replace-with-wecom-corp-id
APP_ID=replace-with-wecom-workbench-agent-id
APP_SECRET=replace-with-wecom-workbench-app-secret
WORKBENCH_WECOM_LOGIN_ENABLED=false
WORKBENCH_PUBLIC_ORIGIN=https://replace-with-public-workbench-hostname
WORKBENCH_EXTERNAL_SEND_ENABLED=false

# P2/P3 flags remain false until their Assembly Gate is approved.
CONVERSATION_CENTER_ENABLED=false
CONVERSATION_REALTIME_SSE_ENABLED=false
HUMAN_WORKBENCH_V2_ENABLED=false
AI_TRIAGE_ENABLED=false
AI_CONVERSATION_ENABLED=false
AI_AUTO_REPLY_ENABLED=false
RULE_FIRST_ORCHESTRATION_ENABLED=false
MANUAL_REVIEW_QUEUE_ENABLED=false
TICKET_LIFECYCLE_WORKBENCH_ENABLED=false
REPORTER_TIMELINE_ENABLED=false
WECOM_TEMPLATE_CARD_ENABLED=false
OCR_ENABLED=false
INCIDENT_CORRELATION_ENABLED=false
INTEGRATION_CONNECTOR_ENABLED=false
HOSPITAL_IDENTITY_ENABLED=false
INTRANET_PORTAL_SOURCE_ENABLED=false
HOSPITAL_API_SOURCE_ENABLED=false
MONITORING_SOURCE_ENABLED=false

# Formal third-party staff directory Provider; remains disabled until separately authorized.
THIRD_STAFF_DIRECTORY_ENABLED=false
THIRD_STAFF_DIRECTORY_BASE_URL=https://rd-api.mobimedical.cn/8024
THIRD_STAFF_DIRECTORY_ROOT_ID=replace-with-approved-formal-root-id
# THIRD_STAFF_INFO_SYNC_KEY=replace-with-secret

# DeepSeek provider: configure only in an approved P2 environment.
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=replace-with-secret
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_THINKING_MODE=disabled
# DEEPSEEK_MAX_OUTPUT_TOKENS=500
# DEEPSEEK_TIMEOUT_MS=15000
# DEEPSEEK_MAX_CONCURRENCY=1

# V1.4 2C4G runtime limits.
APP_HTTP_MAX_CONNECTIONS=128
APP_WORKER_CONCURRENCY=1
APP_OUTBOX_BATCH_SIZE=20
APP_AI_JOB_BATCH_SIZE=1
APP_INTEGRATION_BATCH_SIZE=20
APP_SSE_MAX_CLIENTS=32
P2_003_EVENT_RETENTION_HOURS=168
P2_003_RECOVERY_POLL_SECONDS=5
P2_003_MAX_WRITABLE_BUFFER_BYTES=65536
P2_003_DRAIN_TIMEOUT_MS=5000
P2_003_CLEANUP_BATCH_SIZE=200
P2_003_RETENTION_CLEANUP_APPROVED=false
APP_DB_POOL_MAX=8
APP_DB_POOL_IDLE_MS=30000
APP_REQUEST_BODY_MAX_BYTES=262144
APP_MESSAGE_AGGREGATION_MS=1500
APP_SESSION_RECENT_MESSAGE_LIMIT=20
APP_SESSION_CONTEXT_TOKEN_BUDGET=8000
APP_PROCESS_MEMORY_SOFT_LIMIT_MB=768
APP_PROCESS_MEMORY_HARD_LIMIT_MB=1024

STORAGE_DRIVER=local-encrypted
STORAGE_LOCAL_ROOT=./var/private-media
STORAGE_MAX_OBJECT_BYTES=10485760

PILOT_LOG_IDENTITY_HASH_KEY=replace-with-random-log-hash-key
PILOT_BACKUP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PILOT_BACKUP_ENCRYPTION_KEY_ID=replace-with-non-secret-key-id
PILOT_BACKUP_RETENTION_DAYS=30
P1_012_LIVE_TEST_APPROVED=false

# P2-G1 approvals are one-process test fuses only. Never commit them as true.
P2_G1_LIVE_TEST_APPROVED=false
P2_G1_TEST_SCOPE_CONFIGURED=false
P2_G1_REAL_WECOM_SEND_APPROVED=false
P2_G1_LISTEN_PORT=3200
P2_G1_TEST_PRINCIPAL_IDS=replace-with-two-comma-separated-server-configured-pilot-principal-ids
P2_G1_ALLOWED_TARGET_HASHES=replace-with-comma-separated-sha256-target-hashes
P2_G1_OBSERVATION_ORIGIN=http://127.0.0.1:3200

NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Shanghai

# P2-012 fixed templates; no real delivery without all live fuses.
INCIDENT_PUBLIC_NOTICE_ENABLED=false
INCIDENT_PRIVATE_NOTICE_ENABLED=false
P2_012_REPORTER_SCOPE_MODE=APPROVED_GROUP_PARTICIPANTS
P2_012_TEST_USER_TARGET_HASHES=
P2_012_TEST_GROUP_TARGET_HASHES=replace-with-comma-separated-approved-test-group-sha256-hashes
