# Phase 1 Pilot example configuration
#
# Copy this file to .env.pilot, then replace every replace-with-* placeholder
# locally. Do not commit .env.pilot or use this template as production values.
# P1-012 outbound-WSS testing needs an approved bot, test group, test account,
# local Pilot runtime, and host egress (DNS, TCP 443, TLS). It does not need a
# public inbound IP/listener. A public edge is separate approval for HTTP/Webhook
# callbacks, external Workbench access, or an independent public Web/API gateway.

# Architecture and local listener
ARCHITECTURE_BASELINE=V1.2
APP_PHASE=P1
PILOT_ENV=development
PILOT_LISTEN_HOST=127.0.0.1
PILOT_LISTEN_PORT=3100
PILOT_PUBLIC_EDGE_APPROVED=false
PILOT_SECURITY_BOUNDARY_APPROVED=false
PILOT_OWNER_ID=replace-with-authorized-pilot-owner-id
PILOT_TEST_GROUP_ID=replace-with-authorized-pilot-test-group-id
PILOT_TEST_ACCOUNT_USER_ID=replace-with-authorized-wecom-test-account-user-id

# Pilot Ticket Core only. Use a dedicated Pilot PostgreSQL database; URL-encode
# the local password when it contains reserved URL characters.
PILOT_DATABASE_URL=postgresql://pilot-user:replace-with-local-password@127.0.0.1:5432/pilot_ticket_core

# Enterprise WeCom. The secret belongs only in local .env.pilot or an approved
# secret store and must never be committed, printed, or copied into evidence.
WECOM_BOT_ID=replace-with-authorized-wecom-bot-id
WECOM_BOT_SECRET=replace-with-authorized-wecom-bot-secret
WECOM_WS_URL=wss://openws.work.weixin.qq.com

# Phase 1 feature boundary. These must remain false for every P1-012 scenario.
AI_TRIAGE_ENABLED=false
OCR_ENABLED=false
HOSPITAL_TICKETS_ENABLED=false

# P1-011 operational controls. Supply only for an approved local backup/restore
# drill; do not use the placeholder as a real key.
PILOT_LOG_IDENTITY_HASH_KEY=replace-with-random-log-hash-key
PILOT_BACKUP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PILOT_BACKUP_ENCRYPTION_KEY_ID=replace-with-non-secret-key-id
PILOT_BACKUP_RETENTION_DAYS=30
# PILOT_BACKUP_RESTORE_DRILL_APPROVED=true is a one-time, authorized action and
# must not be enabled by default in .env.pilot.

# P1-012 live tests are an explicit, one-process authorization only. Keep false
# in .env.pilot and set true only for an approved test-group run; this flag does
# not replace client-side observation or authorize public ingress.
P1_012_LIVE_TEST_APPROVED=false

# Runtime diagnostics: do not add raw message, patient, media, URL, or Secret
# values as environment-backed log labels.
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Shanghai
