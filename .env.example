# Architecture baseline
ARCHITECTURE_BASELINE=V1.2
APP_PHASE=G0

# Enterprise WeCom / Gate 0 / Phase 1
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_WS_URL=wss://openws.work.weixin.qq.com

# Phase 1 Pilot data and core services
PILOT_DATABASE_URL=postgresql://user:password@localhost:5432/wecom_pilot
PILOT_TICKET_CORE_BASE_URL=http://pilot-ticket-core:3000
PILOT_INTERNAL_TOKEN=
REDIS_URL=redis://localhost:6379/0

# Phase 2 private object storage
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_PRIVATE=it-assistant-pilot-private

# Phase 2 asynchronous AI/OCR
AI_TRIAGE_BASE_URL=http://ai-triage-service:8000
AI_TRIAGE_ENABLED=false
OCR_ENABLED=false

# Phase 3 only. These settings must remain disabled before P3 entry approval.
HOSPITAL_TICKETS_ENABLED=false
TICKET_ADAPTER_BASE_URL=
TICKET_ADAPTER_INTERNAL_TOKEN=
HOSPITAL_TICKETS_API_BASE_URL=

# Runtime
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Shanghai
