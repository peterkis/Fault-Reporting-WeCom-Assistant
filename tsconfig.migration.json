{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./.build/emit",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "app/server/src/**/*.mts",
    "app/server/scripts/**/*.mts",
    "shared/**/*.mts",
    "app/pc-admin/src/contracts/*.mts",
    "app/pc-admin/src/realtime/workbench-realtime-client.mts",
    "app/pc-admin/src/app/activity-time.mts",
    "app/pc-admin/src/app/activity-actors.mts",
    "tests/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".build",
    "web/admin-workbench-prototype",
    "tests/types"
  ]
}
