import assert from 'node:assert/strict';
import {test} from 'node:test';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';

test('T27 a current same-principal scope denial clears its protected canonical projection and sensitive recovery without posting or recreating it on reload',async()=>{
 await candidateBrowser({purpose:'t27current',recovery:true},async({pool,f,candidateId,browser,root,choose})=>{
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);const before=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(before.drafts)&&before.drafts.length===1);
  const actor=record(f.admin);await createPilotAccessService({pool}).upsertPrincipal({wecomUserId:text(actor.wecom_user_id),displayName:text(actor.display_name),roles:['HANDLER'],resolverTeamIds:[]});const fresh=record(await browser.evaluate('fetch("/api/lifecycle/bootstrap").then(response=>response.json())'));assert.equal(fresh.principal_id,actor.id);assert.deepEqual(fresh.roles,['HANDLER']);assert.equal(await browser.evaluate(`fetch('/api/incident-candidates/${candidateId}').then(response=>response.status)`),404);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=refresh-candidate]').click()`);await browser.waitFor(`Boolean(document.querySelector(${JSON.stringify(root)})?.querySelector('[role=alert]'))`);assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('.detail-body'))`),false);
  let after:Record<string,unknown>=before;for(let i=0;i<100;i++){after=record(await browser.evaluate(candidateCopies));if(Array.isArray(after.drafts)&&after.drafts.length===0)break;await new Promise<void>(resolve=>setTimeout(resolve,50));}assert.deepEqual(after.drafts,[],'current resource denial must remove the canonical candidate sensitive recovery');assert.deepEqual(after.operations,[]);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);const previous=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${previous}&&Boolean(document.querySelector(${JSON.stringify(root)})?.querySelector('[role=alert]'))`);assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('.detail-body'))`),false);assert.deepEqual(record(await browser.evaluate(candidateCopies)).drafts,[]);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);
 });
});
