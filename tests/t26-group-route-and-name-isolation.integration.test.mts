import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID} from 'node:crypto';
import {withT26Fixture,t26Group,t26Deliveries,t26Control,t26Object} from './helpers/t26-group-notification-fixture.mjs';
import {createCommunicationDeliveryWorker} from '../app/server/src/p2-004-communication-delivery-worker.mjs';
import {createWorkbenchGroupNotificationSender} from '../app/server/src/workbench-group-notification-sender.mjs';

test('same and renamed display names never replace the original group or Bot and unqualified or disabled routes never call fetch',{timeout:240000},async()=>{
 await withT26Fixture(async context=>{
  const a=await t26Group(context,'t26-name-a'),b=await t26Group(context,'t26-name-b'),getGroup=async(id:string)=>{const response=await a.http.get('/api/workbench/items/ticket/'+id);assert.equal(response.status,200);return t26Object(t26Object(t26Object(await response.json()).item).source_group);};
  const groupA=await getGroup(a.id),groupB=await getGroup(b.id);assert.notEqual(groupA.ref,groupB.ref);
  const bootstrap=t26Object(await (await a.http.get('/api/lifecycle/bootstrap')).json()),cookie=context.cookies[0];assert.ok(cookie);
  const name=async(group:Record<string,unknown>,display_name:string)=>{const body={client_command_id:randomUUID(),expected_row_version:String(group.row_version),display_name},response=await fetch(context.origin+'/api/workbench/source-groups/'+String(group.ref)+'/name',{method:'POST',headers:{cookie,origin:context.origin,'content-type':'application/json','x-csrf-token':String(bootstrap.csrf_token),'idempotency-key':body.client_command_id,'if-match':'"'+body.expected_row_version+'"'},body:JSON.stringify(body)});assert.equal(response.status,200);return t26Object(t26Object(await response.json()).group);};
  const namedA=await name(groupA,'同名合成支持群');await name(groupB,'同名合成支持群');assert.equal((await getGroup(a.id)).display_name,(await getGroup(b.id)).display_name);
  const initialA=await t26Deliveries(a.http,a.id),initialB=await t26Deliveries(b.http,b.id),deliveryA=initialA.find(r=>r.destination_type==='GROUP'),deliveryB=initialB.find(r=>r.destination_type==='GROUP');assert.ok(deliveryA&&deliveryB);
  const calls:string[]=[],fetchImpl:typeof fetch=async(url)=>{calls.push(String(url));return new Response('{"errcode":0}');};
  const wrong=createWorkbenchGroupNotificationSender({pool:context.pool,enabled:true,routes:[{botId:'another-bot',groupId:'group-t26-name-a',url:'https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=t26-route-wrong'},{botId:'bot-test',groupId:'group-t26-name-b',url:'https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=t26-route-b'}],resolveMentionUserId:async()=> 't26-verified-webhook-user',fetchImpl});
  await createCommunicationDeliveryWorker({pool:context.pool,enabled:true,sender:wrong}).deliver({deliveryId:String(deliveryA.delivery_id)});assert.deepEqual(calls,[]);assert.equal((await t26Deliveries(a.http,a.id)).find(r=>r.delivery_id===deliveryA.delivery_id)?.status,'DEAD_LETTER');assert.deepEqual(await t26Deliveries(b.http,b.id),initialB);
  const control=await t26Control(context);assert.equal((await control(b.id,String(deliveryA.delivery_id),'retry',{client_command_id:randomUUID(),reason_code:'T26_WRONG_PARENT'})).status,404);
  await name(namedA,'改名后的合成支持群');assert.equal((await getGroup(a.id)).display_name,'改名后的合成支持群');assert.equal((await getGroup(a.id)).ref,groupA.ref);
  const retry={client_command_id:randomUUID(),reason_code:'T26_EXACT_ROUTE_RESTORED'};assert.equal((await control(a.id,String(deliveryA.delivery_id),'retry',retry)).status,200);assert.equal(t26Object(await (await control(a.id,String(deliveryA.delivery_id),'retry',retry)).json()).replayed,true);
  const routeA={botId:'bot-test',groupId:'group-t26-name-a',url:'https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=t26-route-a'},routeB={botId:'bot-test',groupId:'group-t26-name-b',url:'https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=t26-route-b'},routes=[routeA,routeB],sender=createWorkbenchGroupNotificationSender({pool:context.pool,enabled:true,routes,resolveMentionUserId:async()=> 't26-verified-webhook-user',fetchImpl}),worker=createCommunicationDeliveryWorker({pool:context.pool,enabled:true,sender});
  await worker.deliver({deliveryId:String(deliveryA.delivery_id)});await worker.deliver({deliveryId:String(deliveryB.delivery_id)});assert.deepEqual(calls,[routeA.url,routeB.url]);for(const row of initialA.filter(r=>r.destination_type==='PERSON'))assert.deepEqual((await t26Deliveries(a.http,a.id)).find(r=>r.delivery_id===row.delivery_id),row);
  for(const mode of ['DEFAULT_OFF','UNQUALIFIED','ALL'] as const){const tag='t26-route-'+mode.toLowerCase(),item=await t26Group(context,tag),delivery=(await t26Deliveries(item.http,item.id)).find(r=>r.destination_type==='GROUP');assert.ok(delivery);const blocked=createWorkbenchGroupNotificationSender({pool:context.pool,...(mode==='DEFAULT_OFF'?{}:{enabled:true}),routes:[{botId:'bot-test',groupId:'group-'+tag,url:'https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=t26-blocked'}],resolveMentionUserId:mode==='UNQUALIFIED'?null:async()=>mode==='ALL'?'@all':'t26-verified-webhook-user',fetchImpl});await createCommunicationDeliveryWorker({pool:context.pool,enabled:true,sender:blocked}).deliver({deliveryId:String(delivery.delivery_id)});assert.equal((await t26Deliveries(item.http,item.id)).find(r=>r.delivery_id===delivery.delivery_id)?.status,'DEAD_LETTER');assert.equal(calls.length,2);}
  assert.throws(()=>createWorkbenchGroupNotificationSender({pool:context.pool,routes:Array.from({length:33},()=>routeA)}),/GROUP_PUSH_CONFIGURATION_INVALID/u);assert.throws(()=>createWorkbenchGroupNotificationSender({pool:context.pool,routes:[routeA,routeA]}),/GROUP_PUSH_CONFIGURATION_INVALID/u);assert.throws(()=>createWorkbenchGroupNotificationSender({pool:context.pool,routes:[{botId:'bot-test',groupId:'group-t26-name-a',url:'https://another.example.test/send?key=synthetic'}]}),/GROUP_PUSH_CONFIGURATION_INVALID/u);
 },{sourceGroups:true});
});
