import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {http,rows,text,version} from './helpers/t07-public-fixture.mjs';
import type {T07Fixture} from './helpers/t07-public-fixture.mjs';
test('takeover alone discovers canonical choices and atomically takes explicitly selected independently authorized communication, with replay reauthorization',async()=>{
 await withWeb01Fixture(async(f:T07Fixture)=>{
  const ticket=f.tickets[3],other=f.tickets[1],actor=f.principals[1],admin=f.principals[0],next=f.principals[2];assert.ok(ticket&&other&&actor&&admin&&next);
  await f.pool.query("INSERT INTO pilot_ticket.resolver_team(team_id,display_name) VALUES('T07_NETWORK','合成网络处理组')");const access=createPilotAccessService({pool:f.pool});assert.equal((await access.upsertPrincipal({wecomUserId:'web01-synthetic-1',displayName:'陈悦',roles:['HANDLER'],resolverTeamIds:['PILOT_IT','T07_NETWORK']})).id,actor.id);
  await f.runtime.coordinator.runOnce();const a=await http(f,0),b=await http(f,2),path='/api/tickets/'+ticket.ticket.id;
  const discovered=await b.get(path+'/related-conversations');assert.equal(discovered.status,200,JSON.stringify(discovered.value));const canonical=rows(discovered.value.items)[0];assert.ok(canonical);assert.equal(canonical.take_allowed,true);
  const disabledT05=await b.post(path+'/accept-for-later-with-conversations',{client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_SELF_HANDLING',resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]});assert.equal(disabledT05.status,503);
  const source='/api/conversations/'+text(canonical.session_id);assert.equal((await a.post(source+'/takeover',{client_command_id:randomUUID(),expected_row_version:Number(text(canonical.session_row_version)),reason_code:'T07_COMMUNICATOR_SETUP'})).status,200);
  const assigned=rows((await b.get(path+'/related-conversations')).value.items)[0];assert.ok(assigned);assert.equal(assigned.take_allowed,false);
  const before=(await b.get(path)).value,events=(await a.get(path+'/events')).value,responsibility=(await a.get(path+'/responsibility')).value,notices=(await a.get(path+'/deliveries')).value;
  const command=(sessions:unknown[])=>({client_command_id:randomUUID(),expected_version:version(before.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'T07_NETWORK',communication_choice:'TAKE_SELECTED',sessions});
  assert.equal((await b.post(path+'/takeover',command([{session_id:assigned.session_id,expected_row_version:Number(text(assigned.session_row_version))}]))).status,403,'Ticket scope never substitutes for independently denied Control');
  const foreign=rows((await a.get('/api/tickets/'+other.ticket.id+'/responsibility')).value.conversations)[0];assert.ok(foreign);assert.equal((await b.get('/api/conversations/'+text(foreign.session_id))).status,200);assert.equal((await b.post(path+'/takeover',command([{session_id:foreign.session_id,expected_row_version:Number(text(foreign.session_row_version))}]))).status,404,'arbitrary readable Session is not canonical');
  assert.equal((await a.post(source+'/release',{client_command_id:randomUUID(),expected_row_version:Number(text(assigned.session_row_version)),reason_code:'T07_COMMUNICATOR_SETUP'})).status,200);
  const released=rows((await b.get(path+'/related-conversations')).value.items)[0];assert.ok(released);assert.equal(released.take_allowed,true);const selected={session_id:text(released.session_id),expected_row_version:Number(text(released.session_row_version))};
  assert.equal((await b.post(path+'/takeover',command([selected,{...selected,session_id:selected.session_id.toUpperCase()}]))).status,400);assert.equal((await b.post(path+'/takeover',command([{...selected,expected_row_version:1}]))).status,409);assert.equal((await b.post(path+'/takeover',{...command([selected]),force:true})).status,400);assert.deepEqual((await b.get(path)).value,before);assert.deepEqual((await a.get(path+'/events')).value,events);
  const body=command([selected]),result=await b.post(path+'/takeover',body);assert.equal(result.status,200,JSON.stringify(result.value));assert.equal(result.value.communication_choice,'TAKE_SELECTED');assert.equal(result.value.handling_cycle,null);const changed=rows(result.value.conversations);assert.equal(changed.length,1);assert.equal(changed[0]?.session_id,selected.session_id);assert.equal(changed[0]?.session_row_version,selected.expected_row_version+1);assert.equal(changed[0]?.changed,true);
  const after=(await b.get(path)).value;assert.equal(after.status,'ACCEPTED');assert.equal(after.assignee_id,actor.id);assert.equal(after.resolver_team_id,'T07_NETWORK');assert.equal(after.version,version(before.version)+1);assert.equal(after.intake_id,before.intake_id);const conversations=rows((await a.get(path+'/responsibility')).value.conversations);assert.equal(conversations[0]?.conversation_principal_id,actor.id);assert.equal(conversations[0]?.session_row_version,String(selected.expected_row_version+1));assert.deepEqual((await a.get(path+'/deliveries')).value,notices);assert.equal(rows(responsibility.conversations)[0]?.conversation_principal_id,admin.id);
  const replay=await b.post(path+'/takeover',body);assert.equal(replay.status,200);assert.deepEqual(replay.value,{...result.value,replayed:true});
  assert.equal((await a.post(source+'/transfer',{client_command_id:randomUUID(),expected_row_version:selected.expected_row_version+1,reason_code:'T07_REPLAY_SCOPE_SETUP',target_principal_id:next.id})).status,200);await access.upsertPrincipal({wecomUserId:'web01-synthetic-1',displayName:'陈悦',roles:['HANDLER'],resolverTeamIds:[]});assert.equal((await b.get(path)).status,200,'current Ticket owner still has Ticket READ');assert.equal((await b.get(source)).status,404);assert.equal((await b.post(path+'/takeover',body)).status,404,'selected Session READ precedes even committed result replay');
 },{ticketTakeoverEnabled:true,ticketSelfHandlingWebSource:false,chronologicalTicketEvents:true});
});
