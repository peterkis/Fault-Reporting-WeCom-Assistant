  f.runtime.server.on('request',observe);const directory=join(tmpdir(),'t07-legacy-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+first.ticket.id,width:1280,height:900,cookies:[cookie]});assert.ok(browser);await browser.waitFor(`Boolean(document.querySelector('${selector}'))&&document.querySelector('[data-realtime-status]')?.dataset.realtimeStatus==='live'`);if(composite){const canonical=rows((await actor.get(path+'/related-conversations')).value.items)[0];assert.ok(canonical);assert.equal(canonical.take_allowed,true);await browser.waitFor(`document.querySelector('${selector} [data-session-choice="${text(canonical.session_id)}"]')?.disabled===false`);await browser.evaluate(`document.querySelector('${selector} [data-session-choice="${text(canonical.session_id)}"]').click()`);}await browser.waitFor(`document.querySelector('[data-action=${action}]')?.disabled===false`);await browser.evaluate(`document.querySelector('[data-action=${action}]').click()`);await browser.waitFor("document.querySelector('.properties')?.innerText.includes('处理中')");const posts=requests.filter(row=>row.method==='POST');assert.equal(posts.length,1);assert.equal(posts[0]?.path,path+'/'+action);assert.equal(posts[0]?.status,200);const original=object(posts[0]?.body),current=await actor.get(path);assert.equal(current.value.status,'IN_PROGRESS');assert.equal((current.value.allowed_actions as unknown[]).includes(action),false);
   if(composite){const copy=object(await browser.evaluate(stored));assert.deepEqual(copy.operations,[{commandId:original.client_command_id,purpose:'ticket-conversation-handling'}]);if(mode==='t05-expired'){await browser.command('Page.enable');await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:'(()=>{const now=Date.now;Date.now=()=>now()+86400001;})()'});}const origin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.enable');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${origin}&&document.readyState==='complete'`);const recovery=mode==='t05-expired'?'check-expired-conversation-handling':check;await browser.waitFor(`Boolean(document.querySelector('[data-action=${recovery}]'))&&document.querySelector('${selector}')?.innerText.includes('结果未知')`);assert.equal(requests.filter(row=>row.method==='POST').length,1);if(mode==='t05-expired')assert.deepEqual(object(await browser.evaluate(stored)).drafts,[]);await browser.evaluate(`document.querySelector('[data-action=${recovery}]').click()`);await browser.waitFor(`document.querySelector('${selector}')?.innerText.includes('${mode==='t05-expired'?'已核对原操作结果：已提交':'已开始处理'}')`);assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});if(mode==='t05-expired'){assert.equal(requests.filter(row=>row.method==='POST').length,1);assert.equal(requests.filter(row=>row.path===path+'/conversation-handling-commands/'+original.client_command_id&&row.method==='GET').length,1);}else{const replay=requests.filter(row=>row.method==='POST');assert.equal(replay.length,2);assert.deepEqual(replay[1]?.body,original);}}
   else{await browser.waitFor(`Boolean(document.querySelector('[data-action=${check}]'))&&document.querySelector('${selector}')?.innerText.includes('结果未知')`);assert.equal(await browser.evaluate("document.querySelector('[aria-label=\"关闭详情\"]').disabled"),true,'lost ACK retains the original in-memory navigation fence');assert.deepEqual(await browser.evaluate('indexedDB.databases().then(rows=>rows.map(row=>row.name))'),[]);await browser.evaluate(`document.querySelector('[data-action=${check}]').click()`);await browser.waitFor(`document.querySelector('${selector}')?.innerText.includes('已核对：原操作已开始处理')`);const replay=requests.filter(row=>row.method==='POST');assert.equal(replay.length,2);assert.deepEqual(replay[1]?.body,original);}
   assert.equal((await actor.get(path)).value.version,current.value.version);assert.equal(requests.some(row=>row.path===path+'/takeover'||row.path===path+'/takeover-and-start'),false);const image=Buffer.from(text(await browser.screenshot()),'base64'),file=join(directory,'legacy-terminal.png');await writeFile(file,image);const receipt=join(directory,'receipt.json');await writeFile(receipt,JSON.stringify({mode,requests,original_uuid:true,real_realtime_refresh:true,current_legacy_action:false,screenshot:{file:file.replaceAll('\\','/'),sha256:createHash('sha256').update(image).digest('hex')}}));console.log('T07_LEGACY_RECOVERY '+JSON.stringify({mode,receipt:receipt.replaceAll('\\','/'),original_uuid:true}));
  }catch(error){primary=error;console.error('T07_LEGACY_PRIMARY '+JSON.stringify({mode,message:error instanceof Error?error.message:String(error),directory:directory.replaceAll('\\','/')}));}
  await closeBrowserTestResources([async()=>{if(primary&&browser){await writeFile(join(directory,'failure.png'),Buffer.from(text(await browser.screenshot()),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify({requests,page:await browser.evaluate('({text:document.body.innerText,url:location.pathname})')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);}],primary);
 },{ticketTakeoverEnabled:true,ticketSelfHandlingEnabled:true,ticketConversationSelfHandlingEnabled:composite,ticketSelfHandlingWebSource:!composite,workbenchDraftRecoveryEnabled:composite,workbenchRealtimeEnabled:true,chronologicalTicketEvents:true});
