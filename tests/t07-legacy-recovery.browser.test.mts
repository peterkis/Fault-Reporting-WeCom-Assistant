const stored="new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result.filter(row=>row.purpose==='ticket-conversation-handling').map(row=>({purpose:row.purpose})),operations:operations.result.filter(row=>row.purpose==='ticket-conversation-handling').map(row=>({commandId:row.commandId,purpose:row.purpose}))});};};})";
for(const mode of ['t04-memory','t05-sensitive','t05-expired'] as const)test('mixed T07 '+mode+' retains the original legacy recovery controller after genuine realtime removes its new actions',async()=>{
 const composite=mode!=='t04-memory';await withWeb01Fixture(async(f:Fixture)=>{
  const first=f.tickets[0],cookie=f.browserCookies[2];assert.ok(first&&cookie);await f.runtime.coordinator.runOnce();const actor=await http(f,2),path='/api/tickets/'+first.ticket.id,action=composite?'take-and-start-with-conversations':'take-and-start',selector=composite?'.ticket-conversation-handling':'.ticket-self-handling',check=composite?'check-conversation-handling':'check-self-handling';const requests:{method:string;path:string;status:number|null;body:unknown}[]=[];let malformed=true;
