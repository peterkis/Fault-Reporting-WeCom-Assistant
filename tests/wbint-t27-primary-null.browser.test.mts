import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID} from 'node:crypto';
import {createP2012IncidentCommandService} from '../app/server/src/p2-012-incident-command-service.mjs';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
test('T27 requires an explicit primary choice and confirms an explicit null team with the selected real personal Ticket only as its independent reference',async()=>{
 await candidateBrowser({purpose:'t27primary',setup:async({pool,f,candidateId})=>{assert.equal((await createP2012IncidentCommandService({pool,enabled:true}).perform({authContext:{principal_id:text(record(f.admin).id)},command:{action:'START_REVIEW',candidate_review_id:candidateId,expected_row_version:'1',client_command_id:randomUUID(),reason_code:'OPERATOR_REVIEWED'}})).ok,true);}},async({pool,f,candidateId,browser,root,choose})=>{
  const personal=(await pool.query('SELECT id::text,status,version FROM pilot_ticket.ticket ORDER BY id')).rows,events=(await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM pilot_ticket.ticket_event')).rows[0]?.count,report=record(f.reports[0]),ticketId=text(report.ticketId);await choose('人工决定','CONFIRM_INCIDENT');await choose('决定原因','CONFIRMED_SHARED_FAULT');await choose('确认范围','LOCAL');await choose('故障负责人',text(record(f.handler).id));await choose('责任组','__NO_TEAM__');await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('input[data-report-ref="${text(report.decisionId)}"]').click()`);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="主工单"]').value`),'');assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').disabled`),true);await choose('主工单',ticketId);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);await browser.waitFor(`Boolean(document.querySelector(${JSON.stringify(root)})?.querySelector('[data-result-ref] [data-incident-id]'))`);
  const posts=await browser.evaluate('globalThis.__t27Posts');assert.ok(Array.isArray(posts)&&posts.length===1);const body=record(JSON.parse(text(record(posts[0]).body)));assert.equal(body.owner_team_id,null);assert.equal(body.primary_ticket_id,ticketId);assert.deepEqual(body.selected_report_refs,[report.decisionId]);const row=(await pool.query<{id:string;owner_team_id:string|null;primary_ticket_id:string}>('SELECT i.id::text,i.owner_team_id,i.primary_ticket_id::text FROM incident.incident i JOIN incident.candidate_review c ON c.confirmed_incident_id=i.id WHERE c.id=$1::uuid',[candidateId])).rows[0];assert.ok(row);assert.equal(row.owner_team_id,null);assert.equal(row.primary_ticket_id,ticketId);const current=record(await browser.evaluate(`fetch('/api/incidents/${row.id}').then(async response=>({status:response.status,body:await response.json()}))`));assert.equal(current.status,200);assert.equal(record(current.body).owner_team_id,null);assert.equal(record(current.body).primary_ticket_id,ticketId);assert.deepEqual((await pool.query('SELECT id::text,status,version FROM pilot_ticket.ticket ORDER BY id')).rows,personal);assert.equal((await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM pilot_ticket.ticket_event')).rows[0]?.count,events);for(const table of ['communication.message','communication.outbox','communication.delivery'])assert.equal((await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM '+table)).rows[0]?.count,0);
 });
});
