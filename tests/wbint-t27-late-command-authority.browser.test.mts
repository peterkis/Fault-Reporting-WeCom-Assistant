import assert from 'node:assert/strict';
import {test} from 'node:test';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';

test('T27 an old command transport failure after current purpose revocation cannot resurrect its discarded sensitive UNKNOWN body',async()=>{
 await candidateBrowser({purpose:'t27latecmd',recovery:true},async({pool,f,candidateId,browser,root,choose})=>{
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);
  await browser.evaluate(`(()=>{const send=fetch;globalThis.fetch=async(path,options)=>{const response=await send(path,options);if(options?.method==='POST'&&String(path)==='/api/incident-candidates/${candidateId}/start-review'){globalThis.__t27HeldCommand={status:response.status,body:await response.clone().json()};await new Promise(resolve=>{globalThis.__t27ReleaseCommand=resolve;});globalThis.__t27OldCommandReleased=true;throw new TypeError('T27_REAL_ACK_LOST_AFTER_CURRENT_REVOCATION');}return response;};})()`);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);await browser.waitFor('Boolean(globalThis.__t27HeldCommand)');const ack=record(await browser.evaluate('globalThis.__t27HeldCommand'));assert.equal(ack.status,200);assert.equal(record(ack.body).ok,true);
  const stored=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(stored.operations)&&stored.operations.length===1);const marker=record(stored.operations[0]);assert.equal(typeof marker.commandId,'string');
  const actor=record(f.admin);await createPilotAccessService({pool}).upsertPrincipal({wecomUserId:text(actor.wecom_user_id),displayName:text(actor.display_name),roles:['HANDLER'],resolverTeamIds:['PILOT_IT']});const fresh=record(await browser.evaluate('fetch("/api/lifecycle/bootstrap").then(response=>response.json())'));assert.equal(fresh.principal_id,actor.id);assert.deepEqual(fresh.roles,['HANDLER']);const current=record(await browser.evaluate(`fetch('/api/incident-candidates/${candidateId}').then(async response=>({status:response.status,body:await response.json()}))`));assert.equal(current.status,200);assert.deepEqual(record(current.body).allowed_scopes,[]);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=refresh-candidate]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.innerText.includes('没有人工决定权限')`);let cleared:Record<string,unknown>={};for(let i=0;i<100;i++){cleared=record(await browser.evaluate(candidateCopies));if(Array.isArray(cleared.drafts)&&cleared.drafts.length===0&&Array.isArray(cleared.operations)&&cleared.operations.length===0)break;await new Promise<void>(resolve=>setTimeout(resolve,50));}assert.deepEqual(cleared.drafts,[]);assert.deepEqual(cleared.operations,[]);
  await browser.evaluate('globalThis.__t27ReleaseCommand()');await browser.waitFor('globalThis.__t27OldCommandReleased===true');await browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('[data-candidate-outcome]'))`),false,'late callback must not restore the old full-body UNKNOWN after current authority clearedAfter it');assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="人工决定"]'))`),false);let clearedAfter:Record<string,unknown>={};for(let i=0;i<100;i++){clearedAfter=record(await browser.evaluate(candidateCopies));if(Array.isArray(clearedAfter.drafts)&&clearedAfter.drafts.length===0&&Array.isArray(clearedAfter.operations)&&clearedAfter.operations.length===0)break;await new Promise<void>(resolve=>setTimeout(resolve,50));}assert.deepEqual(clearedAfter.drafts,[]);assert.deepEqual(clearedAfter.operations,[]);assert.deepEqual(record(await browser.evaluate(candidateCopies)).operations,[]);assert.equal(await browser.evaluate('globalThis.__t27Posts.length'),1);assert.equal(await browser.evaluate(`fetch('/api/incident-candidates/${candidateId}/commands/${text(marker.commandId)}').then(response=>response.status)`),403);
 });
});
