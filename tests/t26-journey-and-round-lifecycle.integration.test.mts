import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID,createHash} from 'node:crypto';
import {withT26Fixture,t26Deliveries,t26Sender} from './helpers/t26-group-notification-fixture.mjs';
import {t11Http} from './helpers/t11-completion-fixture.mjs';
import {seedPersistedIntake} from './helpers/p2-015-postgres-harness.mjs';
import {createPilotTicketCore} from '../app/server/src/p1-005-pilot-ticket-core.mjs';
import {createContactJourneyStore,reporterIdentityHash} from '../app/server/src/p2-015-contact-journey.mjs';
import type {ContactJourneyInput} from '../app/server/src/p2-015-contact-journey.mjs';
import {createP2016GuidedJourneyStore} from '../app/server/src/p2-016-guided-journey.mjs';
import {transactionP2016} from '../app/server/src/p2-016-domain-contracts.mjs';
import {shanghaiLocalToEpochMs} from '../app/server/src/platform/time-contract.mjs';
import {createTicketRoundNotifications} from '../app/server/src/workbench-ticket-round-notifications.mjs';
import {createCommunicationDeliveryWorker} from '../app/server/src/p2-004-communication-delivery-worker.mjs';

test('an actual explicit Direct continuation preserves the original group across withdrawal, handoff, template replay and two real completed rounds',{timeout:240000},async()=>{
 await withT26Fixture(async context=>{
  const tag='t26-journey-rounds',origin=await seedPersistedIntake({pool:context.pool,text:'T26_FULL_PRIVATE_REPORT',chatType:'group',requestType:'INCIDENT',status:'RECEIVED',tag}),created=await createPilotTicketCore({pool:context.pool}).createForIntake({intakeId:origin.intakeId,occurredAt:origin.receivedAt,traceId:tag});assert.ok(created.ticket);
  const id=created.ticket.id,http=await t11Http(context),hash=reporterIdentityHash({provider:'WECOM_AIBOT',bot_id:'bot-test',reporter_external_id:'user-test',hmac_key:'t26-synthetic-identity-key'}),store=createContactJourneyStore();
  const originInput:ContactJourneyInput={entry_mode:'GROUP_MENTION_INLINE',origin_intake_id:origin.intakeId,linked_ticket_id:id,reporter_identity_hash:hash,profile_resolution_status:'NOT_FOUND',evaluation_due_at:origin.receivedAt,evaluation_due_epoch_ms:shanghaiLocalToEpochMs(origin.receivedAt),reported_at:origin.receivedAt,privacy_class:'INTERNAL',retention_until:origin.retentionUntil,retention_until_epoch_ms:shanghaiLocalToEpochMs(origin.retentionUntil)};
  const journey=await transactionP2016(context.pool,async tx=>{const result=await store.ensureJourney({transaction:tx,input:originInput});await store.ensureLeg({transaction:tx,input:{journey_id:result.id,source_intake_id:origin.intakeId,leg_type:'GROUP_ORIGIN',origin_channel_message_id:String(origin.messageId),provider_context_hash:createHash('sha256').update('t26-original-provider').digest('hex'),channel_identity_hash:createHash('sha256').update('group-'+tag).digest('hex'),reporter_identity_hash:hash,opened_at:origin.receivedAt}});return result;});
  const initial=await http.detail(id),target=context.principals[1]?.id;assert.ok(target);
  const assign={client_command_id:randomUUID(),expected_version:initial.version,reason_code:'T26_QUEUED_FIRST',target_principal_id:target,resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]};assert.equal((await http.post(id,'assign',assign)).status,200);await context.runtime.roundNotifications.runOnce();
  const first=await t26Deliveries(http,id);assert.equal(first.length,2);assert.deepEqual(first.map(r=>[r.node,r.cycle_no,r.destination_type]).sort(),[['FIRST_RESPONSIBILITY',1,'GROUP'],['FIRST_RESPONSIBILITY',1,'PERSON']]);
  const person=first.find(r=>r.destination_type==='PERSON');assert.ok(person);const binding=await context.runtime.reporterAccess.deliveryBinding({deliveryId:String(person.delivery_id)});
  const direct=await seedPersistedIntake({pool:context.pool,text:'续接工单 '+binding.public_ref+'：T26_PRIVATE_DIRECT_SUPPLEMENT',chatType:'single',requestType:'INCIDENT',status:'RECEIVED',tag:'t26-direct-continuation'}),guided=createP2016GuidedJourneyStore();
  const directInput:ContactJourneyInput={...originInput,entry_mode:'DIRECT_ORGANIC',origin_intake_id:direct.intakeId,linked_ticket_id:null,reported_at:direct.receivedAt,evaluation_due_at:direct.receivedAt,evaluation_due_epoch_ms:shanghaiLocalToEpochMs(direct.receivedAt),retention_until:direct.retentionUntil,retention_until_epoch_ms:shanghaiLocalToEpochMs(direct.retentionUntil)};
  const leg=await transactionP2016(context.pool,async tx=>{const resolved=await guided.ensureJourney({transaction:tx,input:directInput});assert.equal(resolved.id,journey.id);assert.equal(resolved.association_outcome,'EXPLICIT_REFERENCE');return guided.ensureLeg({transaction:tx,input:{journey_id:resolved.id,source_intake_id:direct.intakeId,leg_type:'DIRECT_ORGANIC',origin_channel_message_id:String(direct.messageId),provider_context_hash:createHash('sha256').update('t26-direct-provider').digest('hex'),channel_identity_hash:createHash('sha256').update('user-test').digest('hex'),reporter_identity_hash:hash,opened_at:direct.receivedAt}});});assert.equal(leg.leg_type,'DIRECT_GUIDED');
  const continued=await transactionP2016(context.pool,tx=>store.ensureJourney({transaction:tx,input:originInput}));assert.equal(continued.origin_channel,'WECOM_GROUP');assert.equal(continued.current_channel,'WECOM_DIRECT');assert.equal(continued.origin_intake_id,origin.intakeId);assert.equal(continued.linked_ticket_id,id);
  let current=await http.detail(id);const cycle=current.handling_cycle;assert.ok(cycle);assert.equal((await http.post(id,'unassign',{client_command_id:randomUUID(),expected_version:current.version,reason_code:'WORKBENCH_UNASSIGN',reason:'合成责任撤派',communication_choice:'RETAIN_CURRENT',communication_target_principal_id:null,sessions:[]})).status,200);
  current=await http.detail(id);assert.equal((await http.post(id,'accept-for-later',{client_command_id:randomUUID(),expected_version:current.version,reason_code:'T26_REACCEPT',resolver_team_id:'PILOT_IT'})).status,200);
  for(const principal of [target,context.principals[0]?.id]){assert.ok(principal);current=await http.detail(id);assert.equal((await http.post(id,'transfer',{client_command_id:randomUUID(),expected_version:current.version,reason_code:'T26_HANDOFF',target_principal_id:principal})).status,200);assert.deepEqual((await http.detail(id)).handling_cycle,cycle);}
  assert.equal((await http.post(id,'assign',assign)).status,200);
  const fresh=createTicketRoundNotifications({pool:context.pool,enabled:true,botId:'bot-test',reporterAccess:context.runtime.reporterAccess,templateVersion:'wbint-round-notification/2'});await fresh.runOnce();await fresh.runOnce();assert.deepEqual(await t26Deliveries(http,id),first);
  const started=await http.start(id),completion=http.command(started);assert.equal((await http.post(id,'complete',completion)).status,200);await fresh.runOnce();assert.equal((await http.post(id,'complete',completion)).status,200);await fresh.runOnce();
  const both=await t26Deliveries(http,id);assert.equal(both.length,4);for(const row of first)assert.deepEqual(both.find(r=>r.delivery_id===row.delivery_id),row);
  const closed=await http.detail(id);assert.equal(closed.status,'CLOSED');assert.equal((await http.post(id,'reopen',{client_command_id:randomUUID(),expected_version:closed.version,reason_code:'T26_STAFF_REOPEN',note:'T26_INTERNAL_REOPEN_CANARY',external_visible:false})).status,200);
  const reopened=await http.detail(id);assert.equal(reopened.status,'REOPENED');assert.equal(reopened.intake_id,origin.intakeId);assert.equal(reopened.ticket_no,closed.ticket_no);assert.equal(reopened.handling_cycle?.cycle_no,2);assert.notEqual(reopened.handling_cycle?.id,cycle.id);
  const started2=await http.start(id);await fresh.runOnce();assert.equal((await http.post(id,'complete',http.command(started2))).status,200);await fresh.runOnce();await fresh.runOnce();
  const all=(await t26Deliveries(http,id)).filter(r=>r.node!==null);assert.equal(all.length,8);assert.equal(new Set(all.map(r=>r.delivery_id)).size,8);for(const row of both)assert.deepEqual(all.find(r=>r.delivery_id===row.delivery_id),row);
  assert.deepEqual(all.map(r=>[r.cycle_no,r.node,r.destination_type]).sort(),[1,2].flatMap(n=>['FIRST_RESPONSIBILITY','STAFF_COMPLETED'].flatMap(node=>['GROUP','PERSON'].map(route=>[n,node,route]))).sort());
  let groupCalls=0,personCalls=0;const sender=t26Sender(context,tag,{onPerson:async(targetId,body)=>{assert.equal(targetId,'user-test');assert.equal(JSON.stringify(body).includes('T26_PRIVATE'),false);personCalls++;return {errcode:0};},fetchImpl:async(_url,options)=>{const payload=JSON.parse(String(options?.body)) as {text:{content:string;mentioned_list:string[]}};assert.deepEqual(payload.text.mentioned_list,['t26-verified-webhook-user']);assert.match(payload.text.content,/^工单尾号 [0-9]{4} (已有人员处理。|处理完成。)$/u);for(const marker of ['T26_PRIVATE','INTERNAL_T11_CANARY','user-test','bot-test',binding.public_ref])assert.equal(JSON.stringify(payload).includes(marker),false);groupCalls++;return new Response('{"errcode":0}');}}),worker=createCommunicationDeliveryWorker({pool:context.pool,enabled:true,sender});
  for(const row of all)await worker.deliver({deliveryId:String(row.delivery_id)});for(const row of all)assert.equal(await worker.deliver({deliveryId:String(row.delivery_id)}),null);assert.equal(groupCalls,4);assert.equal(personCalls,4);assert.equal((await t26Deliveries(http,id)).filter(r=>r.node!==null).every(r=>r.status==='SENT'),true);assert.equal((await http.detail(id)).status,'CLOSED');
 },{roundLifecycle:true});
});
