import {test} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {withT35Fixture} from './helpers/t35-read-fixture.mjs';
import {createChannelMessageInbox} from '../src/p1-003-channel-message-inbox.mjs';
import {createServiceIntakeProcessor} from '../src/p1-004-service-intake.mjs';
import {createP2G1HumanOnlyAssembly} from '../src/p2-g1-human-only-assembly.mjs';
import {createP2016OrchestrationWorker} from '../src/p2-016-orchestration-adapters.mjs';
import {createP2016TicketNotificationProjector} from '../src/p2-016-ticket-notification-projector.mjs';
import {createP2016RealtimeProjector} from '../src/p2-016-realtime-projector.mjs';
import {createP2016ManualReviewFacade} from '../src/p2-016-manual-review-facade.mjs';
import {appendReviewMaterial} from './helpers/wbint-t14-review-material.mjs';
import type {PersonalReadPage,PersonalReadAcknowledgement} from '../contracts/workbench_personal_read_contracts.js';

test('T35 real Bot group and direct Legs keep independent sequence anchors and concurrent personal positions',()=>withT35Fixture(async f=>{
  let clock=Date.now();const nonce=randomUUID(),inbox=createChannelMessageInbox({pool:f.pool});
  const assembly=createP2G1HumanOnlyAssembly({projectAfterCommit:false,privacyClass:'INTERNAL',now:()=>new Date(clock),operationalIntake:{accept:input=>inbox.accept(input,createServiceIntakeProcessor())}});
  const worker=createP2016OrchestrationWorker({pool:f.pool,identityHmacKey:'t35-synthetic-guided-key',now:()=>String(clock),notifications:createP2016TicketNotificationProjector({enabled:true}),realtime:createP2016RealtimeProjector({pool:f.pool,enabled:true})});
  const query=createP2016ManualReviewFacade({pool:f.pool,enabled:true});
  const process=async(chattype:'group'|'single',text:string)=>{
    const msgid='t35-'+randomUUID();assert.equal((await assembly.handleFrame({cmd:'aibot_msg_callback',headers:{req_id:msgid},body:{msgid,aibotid:'t35-bot-'+nonce,chattype,...(chattype==='group'?{chatid:'t35-group-'+nonce}:{}),from:{userid:'t35-reporter-'+nonce},msgtype:'text',text:{content:text}}})).ok,true);
    clock+=5000;await worker.processDueBatch({feature_flags:{RULE_FIRST_ORCHESTRATION_ENABLED:true,MANUAL_REVIEW_QUEUE_ENABLED:true},now_epoch_ms:String(clock)});
    const source=(await f.pool.query<{intake_id:string;message_id:string;journey_id:string}>(`SELECT rel.intake_id::text,m.id::text AS message_id,l.journey_id::text FROM channel.message_inbox m JOIN intake.service_intake_message rel ON rel.channel_message_id=m.id JOIN intake.channel_leg l ON l.source_intake_id=rel.intake_id WHERE m.msg_id=$1`,[msgid])).rows[0];assert.ok(source);return source;
  };
  const group=await process('group','@合成测试助手'),direct=await process('single','3楼护士站HIS登录报错');
  assert.equal(direct.journey_id,group.journey_id);
  const authContext={principal_id:f.principals[0]?.id};
  const journey=await query.journey({authContext,journeyId:group.journey_id});
  const legs=await query.journey({authContext,journeyId:group.journey_id,part:'legs'});
  assert.ok(Array.isArray(legs));assert.deepEqual(legs.map(leg=>{assert.ok('leg_type' in leg);return leg.leg_type;}),['GROUP_ORIGIN','DIRECT_GUIDED']);
  assert.ok(!Array.isArray(journey));const ticketId=journey.linked_ticket_id;assert.ok(typeof ticketId==='string');
  const path='/api/workbench/items/ticket/'+ticketId+'/read-position';
  const page=async(reader:0|1=0,query=''):Promise<PersonalReadPage>=>{const r=await f.get(path+query,reader);assert.equal(r.status,200,await r.clone().text());return await r.json() as PersonalReadPage;};
  const before=await page();assert.equal(before.sources.length,2,'two real Legs must produce two independent BOT anchors');
  assert.ok(before.sources.every(s=>s.source_kind==='BOT'&&s.last_read_position==='0'&&s.latest_position==='1'));
  assert.notEqual(before.sources[0]?.source_key,before.sources[1]?.source_key);
  const first=await page(0,'?limit=1');assert.equal(first.sources.length,1);assert.ok(first.next_cursor);
  const second=await page(0,'?limit=1&cursor='+encodeURIComponent(first.next_cursor));assert.equal(second.sources.length,1);assert.equal(second.next_cursor,null);assert.notEqual(first.sources[0]?.source_key,second.sources[0]?.source_key);
  const read=async(sourceRef:string,revision:string,reader:0|1=0,id=randomUUID()):Promise<PersonalReadAcknowledgement>=>{const r=await f.post(path,{client_command_id:id,source_ref:sourceRef,revision},reader);assert.equal(r.status,200,await r.clone().text());return await r.json() as PersonalReadAcknowledgement;};
  const g=await read('channel:'+group.message_id,'1');assert.equal(g.source_kind,'BOT');
  const afterGroup=await page();assert.equal(afterGroup.sources.find(s=>s.source_key===g.source_key)?.last_read_position,'1');assert.equal(afterGroup.sources.filter(s=>s.last_read_position==='0').length,1);
  await appendReviewMaterial(f.pool,direct.intake_id,'T35真实私聊补充，独立Intake序列2');
  const supplement=(await f.pool.query<{id:string}>(`SELECT channel_message_id::text AS id FROM intake.service_intake_message WHERE intake_id=$1::uuid AND sequence_no=2`,[direct.intake_id])).rows[0];assert.ok(supplement);
  const [newer,older]=await Promise.all([read('channel:'+supplement.id,'2'),read('channel:'+direct.message_id,'1')]);
  assert.equal(newer.source_key,older.source_key);assert.notEqual(newer.source_key,g.source_key);
  assert.equal((await page()).sources.find(s=>s.source_key===newer.source_key)?.last_read_position,'2');
  assert.ok((await page(1)).sources.every(s=>s.last_read_position==='0'));
  const own=await read('channel:'+direct.message_id,'1',1);assert.equal(own.last_read_position,'1');
  const commandId=randomUUID();await read('channel:'+direct.message_id,'1',0,commandId);
  const conflict=await f.post(path,{client_command_id:commandId,source_ref:'channel:'+supplement.id,revision:'2'});assert.equal(conflict.status,409);
  assert.equal((await page()).sources.find(s=>s.source_key===newer.source_key)?.last_read_position,'2');
  const forged=await f.post(path,{client_command_id:randomUUID(),source_ref:'channel:'+direct.message_id,revision:'2'});assert.equal(forged.status,404);
}));
