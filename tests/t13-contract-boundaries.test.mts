import assert from 'node:assert/strict';import{test}from'node:test';import{randomUUID}from'node:crypto';
import{decodeAssignmentHistory}from'../src/workbench-assignment-history-browser-contracts.mjs';
import{createP2016TicketQuery}from'../src/p2-016-ticket-query.mjs';
import{createP2016Runtime}from'../src/p2-016-runtime.mjs';
import{assertP2016Schema}from'./helpers/p2-016-schema-assert.mjs';
function page(){const id=randomUUID();return{schema_version:1,ticket_id:id,initial_basis:'UNKNOWN',items:[{ticket_event_id:randomUUID(),event_ordinal:2,kind:'RESPONSIBILITY_CHANGE',occurred_at:'2026-10-13 12:30:00',actor:{state:'KNOWN',name:'安全姓名'},handling_cycle:{state:'UNKNOWN'},previous:{person:{state:'UNKNOWN'},team:{state:'UNKNOWN'}},next:{person:{state:'NONE'},team:{state:'KNOWN',name:'安全处理组'}},communication:[]}],next_cursor:null};}
test('closed read contracts preserve missing evidence as UNKNOWN and proven unassignment as NONE without inventing an initial owner or round',async()=>{const value=page();await assertP2016Schema('p2_016_assignment_history_page',value);assert.deepEqual(decodeAssignmentHistory(value,value.ticket_id),value);await assertP2016Schema('p2_016_assignment_history_capability',{});await assertP2016Schema('p2_016_assignment_history_capability',{assignment_history_enabled:false});});
test('a history consumer refuses cross-Ticket, private extensions, impossible time, duplicate or reordered facts and oversized data',()=>{const source=page();const faults:unknown[]=[{...source,ticket_id:randomUUID()},{...source,private_receipt:'must-not-render'},{...source,items:[{...source.items[0],actor:{state:'UNKNOWN',name:'not-a-fact'}}]},{...source,items:[{...source.items[0],occurred_at:'2026-02-30 12:00:00'}]},{...source,items:[source.items[0],source.items[0]]},{...source,items:[source.items[0],{...source.items[0],ticket_event_id:randomUUID(),event_ordinal:1}]},{...source,items:Array.from({length:101},(_,index)=>({...source.items[0],ticket_event_id:randomUUID(),event_ordinal:index+1}))},{...source,items:[],next_cursor:'unproven-forward-page'},{...source,items:[{...source.items[0],actor:{state:'KNOWN',name:'x'.repeat(129)}}]}];for(const fault of faults)assert.throws(()=>decodeAssignmentHistory(fault,source.ticket_id),/ASSIGNMENT_HISTORY_INVALID_RESPONSE/u);});
test('the independent history option is false by default and rejects nonboolean activation before authority or database work',async()=>{let reads=0;const pool={query:async()=>{reads++;throw Error('UNEXPECTED_DATABASE_WORK');}};const query=createP2016TicketQuery({pool,enabled:true});await assert.rejects(()=>query.assignmentHistory({authContext:{},ticketId:randomUUID()}),error=>{assert.equal((error as{code?:unknown}).code,'P2_016_DISABLED');return true;});assert.equal(reads,0);assert.throws(()=>Reflect.apply(createP2016Runtime,undefined,[{pool,flags:{TICKET_LIFECYCLE_WORKBENCH_ENABLED:false},workbenchAssignmentHistoryEnabled:'true'}]),error=>{assert.equal((error as{code?:unknown}).code,'P2_016_FLAG_INVALID');return true;});assert.equal(reads,0);});