import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {normalizeTicketTakeoverCommand} from '../src/workbench-ticket-takeover.mjs';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {assertP2016Schema} from './helpers/p2-016-schema-assert.mjs';
import {acceptedSetup,acceptedOptions,http,object,rows,text,version} from './helpers/t07-public-fixture.mjs';
import type {T07Fixture} from './helpers/t07-public-fixture.mjs';
test('takeover closed normalization clones frozen explicit intent and rejects hidden authority, inexact versions and ambiguous selections',async()=>{
 const session={session_id:randomUUID(),expected_row_version:1},input={action:'takeover',ticket_id:randomUUID(),client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'PILOT_IT',communication_choice:'TAKE_SELECTED',sessions:[session]};const normalized=normalizeTicketTakeoverCommand(input);assert.deepEqual(normalized,input);session.expected_row_version=4;assert.equal(normalized.sessions[0]?.expected_row_version,1);assert.ok(Object.isFrozen(normalized)&&Object.isFrozen(normalized.sessions)&&Object.isFrozen(normalized.sessions[0]));const {action,ticket_id,...body}=normalized;void [action,ticket_id];await assertP2016Schema('p2_016_takeover_command',body);
 for(const invalid of [{...input,target_principal_id:randomUUID()},{...input,actor_principal_id:randomUUID()},{...input,force:true},{...input,status:'IN_PROGRESS'},{...input,expected_version:'2'},{...input,expected_version:0},{...input,expected_version:2147483648},{...input,sessions:[]},{...input,communication_choice:'RETAIN_CURRENT'},{...input,sessions:[session,{...session,session_id:session.session_id.toUpperCase()}]},{...input,sessions:[{...session,expected_row_version:'1'}]},{...input,sessions:Array.from({length:9},()=>({session_id:randomUUID(),expected_row_version:1}))}])assert.throws(()=>normalizeTicketTakeoverCommand(invalid),{code:'P2_016_INPUT_INVALID'});
});
test('default false and enabled-without039 refuse takeover before a receipt or business write',async()=>{
 for(const enabled of [false,true])await withWeb01Fixture(async(f:T07Fixture)=>{const ticket=f.tickets[0];assert.ok(ticket);const a=await http(f,0),path='/api/tickets/'+ticket.ticket.id,bootstrap=(await a.get('/api/lifecycle/bootstrap')).value;assert.equal(bootstrap.ticket_takeover_enabled,enabled);assert.equal(bootstrap.ticket_takeover_draft_recovery_enabled,false);assert.equal((await f.pool.query("SELECT to_regclass('pilot_ticket.ticket_handling_cycle') AS t")).rows[0]?.t,null);const before=(await f.pool.query('SELECT status,version,assignee_id FROM pilot_ticket.ticket WHERE id=$1::uuid',[ticket.ticket.id])).rows;for(const suffix of ['/takeover-targets','/takeover/commands/'+randomUUID()])assert.equal((await a.get(path+suffix)).status,503);for(const action of ['takeover','takeover-and-start'])assert.equal((await a.post(path+'/'+action,{client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]})).status,503);assert.equal((await f.pool.query("SELECT 1 FROM pilot_ticket.ticket_command_receipt WHERE command_type='WORKBENCH_TICKET_TAKEOVER'")).rowCount,0);assert.deepEqual((await f.pool.query('SELECT status,version,assignee_id FROM pilot_ticket.ticket WHERE id=$1::uuid',[ticket.ticket.id])).rows,before);},{ticketTakeoverEnabled:enabled,installTicketSelfHandlingSchema:false,ticketSelfHandlingWebSource:false});
});
test('public takeover closed body, Origin CSRF UUID exact If-Match and size fence reject without changing responsibility',async()=>{
 await withWeb01Fixture(async(f:T07Fixture)=>{const s=await acceptedSetup(f),cookie=f.cookies[2];assert.ok(cookie);const bootstrap=(await s.b.get('/api/lifecycle/bootstrap')).value,body={client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'T07_NETWORK',communication_choice:'RETAIN_CURRENT',sessions:[]};const snapshot=async()=>({ticket:(await s.b.get(s.path)).value,events:(await s.a.get(s.path+'/events')).value,conversations:(await s.a.get(s.path+'/responsibility')).value.conversations,notices:(await s.a.get(s.path+'/deliveries')).value}),before=await snapshot();
  const post=async(value:Record<string,unknown>,extra:Record<string,string>={})=>{const response=await fetch(f.origin+s.path+'/takeover',{method:'POST',headers:{cookie,origin:f.origin,'content-type':'application/json','x-csrf-token':text(bootstrap.csrf_token),'idempotency-key':text(value.client_command_id),'if-match':'"'+value.expected_version+'"',...extra},body:JSON.stringify(value)});await response.arrayBuffer();return response.status;};
  for(const invalid of [{...body,actor_principal_id:s.actor.id},{...body,target_principal_id:s.owner.id},{...body,force:true},{...body,expected_version:'3'},{...body,resolver_team_id:'arbitrary team'},{...body,communication_choice:'TAKE_SELECTED'},{...body,sessions:[{session_id:randomUUID(),expected_row_version:1}]}])assert.equal(await post(invalid),400);assert.equal(await post(body,{'if-match':'"2"'}),409);assert.equal(await post(body,{'idempotency-key':randomUUID()}),400);assert.equal(await post(body,{'x-csrf-token':'synthetic-wrong'}),403);assert.equal(await post(body,{origin:'https://foreign.invalid'}),403);assert.equal(await post({...body,reason_code:'X'.repeat(32769)}),413);assert.deepEqual(await snapshot(),before);assert.equal((await f.pool.query("SELECT 1 FROM pilot_ticket.ticket_command_receipt WHERE command_type='WORKBENCH_TICKET_TAKEOVER'")).rowCount,0);
 },acceptedOptions);
});
test('a legitimate self group beyond the hundred display limit remains explicitly selectable while orphan cycles fail closed',async()=>{
 await withWeb01Fixture(async(f:T07Fixture)=>{const s=await acceptedSetup(f),selected='Z_T07_EXPLICIT';await f.pool.query("INSERT INTO pilot_ticket.resolver_team(team_id,display_name) SELECT 'A_T07_'||lpad(n::text,3,'0'),'T07 有界合成组 '||n FROM generate_series(1,99) n");await f.pool.query('INSERT INTO pilot_ticket.resolver_team(team_id,display_name) VALUES($1,$2)',[selected,'T07 显式末页组']);await f.pool.query("INSERT INTO pilot_ticket.pilot_team_member(principal_id,team_id) SELECT $1::uuid,team_id FROM pilot_ticket.resolver_team WHERE team_id LIKE 'A_T07_%' OR team_id=$2",[s.actor.id,selected]);const targets=await s.b.get(s.path+'/takeover-targets?resolver_team_id='+selected);assert.equal(targets.status,200);await assertP2016Schema('p2_016_takeover_targets',targets.value);assert.equal(rows(targets.value.resolver_teams).length,100);assert.ok(rows(targets.value.resolver_teams).some(row=>row.team_id===selected));assert.equal(targets.value.resolver_team_id,selected);assert.deepEqual(targets.value.allowed_actions,['takeover','takeover-and-start']);
  const body={client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:selected,communication_choice:'RETAIN_CURRENT',sessions:[]},result=await s.b.post(s.path+'/takeover',body);assert.equal(result.status,200);await assertP2016Schema('p2_016_takeover_result',result.value);await assertP2016Schema('p2_016_ticket_detail',(await s.b.get(s.path)).value);assert.equal((await s.b.get(s.path)).value.resolver_team_id,selected);
  await f.pool.query('UPDATE pilot_ticket.ticket SET current_handling_cycle_id=NULL WHERE id=$1::uuid',[s.first.ticket.id]);const before=(await s.b.get(s.path)).value,events=(await s.a.get(s.path+'/events')).value;assert.deepEqual((await s.b.get(s.path+'/takeover-targets?resolver_team_id=T07_NETWORK')).value.allowed_actions,[]);for(const action of ['takeover','takeover-and-start'])assert.equal((await s.b.post(s.path+'/'+action,{...body,client_command_id:randomUUID(),expected_version:version(before.version),resolver_team_id:'T07_NETWORK'})).status,409);assert.deepEqual((await s.b.get(s.path)).value,before);assert.deepEqual((await s.a.get(s.path+'/events')).value,events);
 },acceptedOptions);
});
