import {test} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import type {IncomingMessage,ServerResponse} from 'node:http';
import type {PostgresPool} from '../src/platform/postgres-pool.mjs';
import type {P2016EnabledRuntime} from '../src/p2-016-runtime.mjs';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
type Fixture={pool:PostgresPool;runtime:P2016EnabledRuntime;origin:string;cookies:string[];browserCookies:{name:string;value:string;url:string}[];tickets:{ticket:{id:string}}[];principals:{id:string}[]};
function object(value:unknown):Record<string,unknown>{assert.ok(value&&typeof value==='object'&&!Array.isArray(value));return value as Record<string,unknown>;}
function rows(value:unknown):Record<string,unknown>[]{assert.ok(Array.isArray(value));return value.map(object);}
function string(value:unknown):string{assert.equal(typeof value,'string');return value as string;}
function select(label:string){return `Array.from(document.querySelectorAll('.ticket-assignment select')).find(input=>Array.from(input.labels??[]).some(label=>label.textContent?.includes(${JSON.stringify(label)})))`;}
async function choose(browser:Browser,label:string,value:string){const expression=select(label);await browser.waitFor(`Boolean((${expression})&&Array.from((${expression}).options).some(option=>option.value===${JSON.stringify(value)}))`);await browser.evaluate(`(()=>{const input=${expression};Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(input,${JSON.stringify(value)});input.dispatchEvent(new Event('change',{bubbles:true}));})()`);}
async function target(context:Fixture){const existing=context.principals[3];assert.ok(existing);const result=await createPilotAccessService({pool:context.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-3',displayName:'ZZZ T06 saved legal target',roles:['HANDLER'],resolverTeamIds:['PILOT_IT']});assert.equal(result.id,existing.id);return result;}
async function earlier(context:Fixture){const access=createPilotAccessService({pool:context.pool});for(let index=0;index<100;index++)await access.upsertPrincipal({wecomUserId:'t06-cap-'+randomUUID(),displayName:'AAA T06 candidate '+String(index).padStart(3,'0'),roles:['HANDLER'],resolverTeamIds:['PILOT_IT']});}
async function http(context:Fixture,index=2){const cookie=context.cookies[index];assert.ok(cookie);const get=async(path:string)=>{const response=await fetch(context.origin+path,{headers:{cookie}});return {status:response.status,value:object(await response.json())};};const bootstrap=(await get('/api/lifecycle/bootstrap')).value;const post=async(path:string,body:Record<string,unknown>)=>{const response=await fetch(context.origin+path,{method:'POST',headers:{cookie,origin:context.origin,'content-type':'application/json','x-csrf-token':String(bootstrap.csrf_token),'idempotency-key':String(body.client_command_id),'if-match':'"'+body.expected_version+'"'},body:JSON.stringify(body)});return {status:response.status,value:object(await response.json())};};return {get,post};}
const stored="new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result.map(row=>({purpose:row.purpose,revision:row.revision,ciphertext:Array.from(new Uint8Array(row.ciphertext))})),operations:operations.result});};};})";

test('explicit legal selected target is independently authorized and included in the bounded 100-person display',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{const first=context.tickets[0];assert.ok(first);const selected=await target(context);await earlier(context);const a=await http(context),path='/api/tickets/'+first.ticket.id+'/assignment-targets',ordinary=await a.get(path+'?resolver_team_id=PILOT_IT');assert.equal(ordinary.status,200);assert.equal(rows(ordinary.value.items).length,100);assert.equal(rows(ordinary.value.items).some(row=>row.principal_id===selected.id),false);
  const current=await a.get(path+'?resolver_team_id=PILOT_IT&target_principal_id='+selected.id);console.log('T06_SELECTED_TARGET_CAP '+JSON.stringify({ordinary_count:100,selected_missing_from_display:true,selected_query_status:current.status}));assert.equal(current.status,200,JSON.stringify(current.value));const candidates=rows(current.value.items);assert.equal(candidates.length,100);assert.equal(candidates.some(row=>row.principal_id===selected.id),true);assert.ok(candidates.every(row=>Object.keys(row).sort().join(',')==='display_name,principal_id'));
  assert.equal((await a.get(path+'?target_principal_id='+selected.id)).status,400);assert.equal((await a.get(path+'?resolver_team_id=PILOT_IT&target_principal_id='+randomUUID())).status,403);await context.pool.query("DELETE FROM pilot_ticket.pilot_team_member WHERE principal_id=$1::uuid AND team_id='PILOT_IT'",[selected.id]);assert.equal((await a.get(path+'?resolver_team_id=PILOT_IT&target_principal_id='+selected.id)).status,403);assert.equal((await a.get('/api/tickets/'+first.ticket.id)).value.version,2);
 },{ticketAssignmentEnabled:true});
});
test('production recovery preserves a saved legal target pushed beyond the display cap and clears only its actual later membership revocation',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{const first=context.tickets[0],owner=context.principals[2],browserCookie=context.browserCookies[2];assert.ok(first&&owner&&browserCookie);const selected=await target(context),path='/api/tickets/'+first.ticket.id,admin=await http(context,0),handler=await http(context);assert.equal((await admin.post(path+'/assign',{client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_ASSIGN',target_principal_id:owner.id,resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]})).status,200);
  const requests:{method:string;path:string;status:number|null}[]=[];const observe=(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(browserCookie.name+'='+browserCookie.value))return;const url=new URL(request.url??'/',context.origin);if(!url.pathname.startsWith('/api/'))return;const fact={method:request.method??'',path:url.pathname,status:null as number|null};requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});};context.runtime.server.on('request',observe);const directory=join(tmpdir(),'web01-ui-'+randomUUID());await mkdir(directory);const screenshots:{file:string;width:number;height:number;sha256:string}[]=[];let browser:Browser|undefined,primary:unknown;
  try{browser=await launchSystemBrowser({url:context.origin+'/workbench/app/items/ticket/'+first.ticket.id,width:1280,height:900,cookies:[browserCookie]});assert.ok(browser);const active=browser,reload=async()=>{const old=await active.evaluate('performance.timeOrigin');await active.command('Page.enable');await active.command('Page.reload');await active.waitFor(`performance.timeOrigin!==${old}&&document.readyState==='complete'&&Boolean(document.querySelector('.ticket-assignment'))`);},capture=async(name:string)=>{const bytes=Buffer.from(string(await active.screenshot()),'base64'),file=join(directory,name);await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),width:bytes.readUInt32BE(16),height:bytes.readUInt32BE(20),sha256:createHash('sha256').update(bytes).digest('hex')});};await browser.waitFor("Boolean(document.querySelector('.ticket-assignment'))&&document.querySelector('[data-realtime-status]')?.dataset.realtimeStatus==='live'");await choose(browser,'处理组','PILOT_IT');await choose(browser,'处理人',selected.id);await browser.evaluate("document.querySelector('.ticket-assignment input[value=RETAIN_CURRENT]').click()");await browser.waitFor("document.querySelector('[data-assignment-draft-status]')?.textContent.includes('已保存恢复副本')&&document.querySelector('[data-action=transfer-assignment]').disabled===false");const encrypted=object(await browser.evaluate(stored));assert.ok(Array.isArray(encrypted.drafts)&&encrypted.drafts.length===1);await earlier(context);const ordinary=await handler.get(path+'/assignment-targets?resolver_team_id=PILOT_IT');assert.equal(rows(ordinary.value.items).length,100);assert.equal(rows(ordinary.value.items).some(row=>row.principal_id===selected.id),false);assert.equal((await context.pool.query("SELECT 1 FROM pilot_ticket.pilot_principal p JOIN pilot_ticket.pilot_team_member m ON m.principal_id=p.id JOIN pilot_ticket.pilot_principal_role r ON r.principal_id=p.id WHERE p.id=$1::uuid AND p.is_active AND m.team_id='PILOT_IT' AND r.role='HANDLER'",[selected.id])).rowCount,1);
   await reload();await browser.waitFor(`document.querySelector('[data-assignment-draft-status]')?.textContent.includes('恢复副本已清理')||((${select('处理人')}).value===${JSON.stringify(selected.id)}&&document.querySelector('[data-action=transfer-assignment]').disabled===false)`);const after=object(await browser.evaluate(stored));console.log('T06_LEGAL_TARGET_RESTORE '+JSON.stringify({still_active_member:true,display_truncated:true,encrypted_before_count:1,encrypted_after_count:Array.isArray(after.drafts)?after.drafts.length:null}));assert.deepEqual(after,encrypted,'absence from a truncated display is not revocation authority');await browser.waitFor(`(${select('处理组')}).value==='PILOT_IT'&&(${select('处理人')}).value===${JSON.stringify(selected.id)}&&document.querySelector('[data-action=transfer-assignment]').disabled===false`);assert.equal(requests.filter(row=>row.method==='POST').length,0);await capture('new-detail-1280.png');await context.pool.query("DELETE FROM pilot_ticket.pilot_team_member WHERE principal_id=$1::uuid AND team_id='PILOT_IT'",[selected.id]);await reload();await browser.waitFor("document.querySelector('[data-assignment-draft-status]')?.textContent.includes('恢复副本已清理')");assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal(await browser.evaluate(`(${select('处理人')}).value`),'');assert.equal(requests.filter(row=>row.method==='POST').length,0);assert.equal((await handler.get(path)).value.version,3);await capture('new-detail-page-1280.png');const diagnostic=join(tmpdir(),'t06-target-cap-diagnostic-'+randomUUID()+'.json');await writeFile(diagnostic,JSON.stringify({requests,screenshots}));console.log('T06_BROWSER_DIAGNOSTIC '+JSON.stringify({file:diagnostic.replaceAll('\\','/')}));console.log('WEB01_BROWSER '+JSON.stringify({api:'REAL_LOOPBACK_HTTP_PG',staff_handler:true,display_limit_not_authority:true,actual_revocation_clears:true,screenshots}));
  }catch(error){primary=error;console.error('T06_BROWSER_PRIMARY '+JSON.stringify({message:error instanceof Error?error.message:String(error)}));console.error('T06_BROWSER_FAILURE_DIR '+JSON.stringify({directory:directory.replaceAll('\\','/')}));}
  await closeBrowserTestResources([async()=>{if(primary&&browser){await writeFile(join(directory,'failure.png'),Buffer.from(string(await browser.screenshot()),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify({primary:primary instanceof Error?primary.message:String(primary),requests,page:await browser.evaluate('({text:document.body.innerText,url:location.pathname})')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{context.runtime.server.removeListener('request',observe);assert.equal((await context.runtime.observability.metrics()).sse_clients,0);}],primary);
 },{ticketAssignmentEnabled:true,workbenchDraftRecoveryEnabled:true,workbenchRealtimeEnabled:true});
});
