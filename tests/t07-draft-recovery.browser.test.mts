  await closeBrowserTestResources([async()=>{if(primary&&browser){await writeFile(join(directory,'failure.png'),Buffer.from(text(await browser.screenshot()),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify({requests,page:await browser.evaluate("({text:document.body.innerText,url:location.pathname,form:{team:document.querySelector('.ticket-takeover select')?.value,teamDisabled:document.querySelector('.ticket-takeover select')?.disabled,fieldsetDisabled:document.querySelector('.ticket-takeover fieldset')?.disabled,choice:document.querySelector('.ticket-takeover input:checked')?.value,status:document.querySelector('[data-takeover-draft-status]')?.textContent}})")}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);f.runtime.server.removeListener('request',restoreUnavailable);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);}],primary);
