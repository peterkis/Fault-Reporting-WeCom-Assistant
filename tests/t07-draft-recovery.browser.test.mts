   await capture('restored-read-only-original.png');unavailable=false;await browser.evaluate("document.querySelector('[data-action=check-takeover-command]').click()");await browser.waitFor("document.querySelector('.ticket-takeover')?.innerText.includes('已核对原操作：已提交')");assert.equal(requests.filter(row=>row.method==='POST').length,1);assert.equal(requests.filter(row=>row.method==='GET'&&row.path===s.path+'/takeover/commands/'+original.client_command_id).length,1);assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal((await s.b.get(s.path)).value.version,version(s.before.version)+2);await capture('acknowledged-and-cleared.png');const diagnostic=join(directory,'receipt.json');await writeFile(diagnostic,JSON.stringify({mode,expired,faults,requests,screenshots,purpose:'ticket-takeover',original_uuid:true,read_only_ack:true}));console.log('T07_DRAFT_BROWSER '+JSON.stringify({file:diagnostic.replaceAll('\\','/'),mode,expired,faults,original_uuid:true,one_post:true,read_only_ack:true,screenshots}));
