import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import type {PostgresPoolClient} from '../src/platform/postgres-pool.mjs';
import {http,version} from './helpers/t07-public-fixture.mjs';
import type {T07Fixture} from './helpers/t07-public-fixture.mjs';
for(const kind of ['operator-role','original-visible-membership','operator-active','target-team-active'] as const)test('self takeover linearizes '+kind+' revocation at the actual Ticket write',async()=>{
 await withWeb01Fixture(async(f:T07Fixture)=>{
  const actor=f.principals[1],first=f.tickets[3];assert.ok(actor&&first);await f.pool.query("INSERT INTO pilot_ticket.resolver_team(team_id,display_name) VALUES('T07_NETWORK','合成网络处理组')");await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-1',displayName:'陈悦',roles:['HANDLER'],resolverTeamIds:['PILOT_IT','T07_NETWORK']});const a=await http(f,0),b=await http(f,2),path='/api/tickets/'+first.ticket.id;assert.equal((await b.get(path+'/takeover-targets?resolver_team_id=T07_NETWORK')).status,200);
  const snapshot=async()=>({ticket:(await a.get(path)).value,events:(await a.get(path+'/events')).value,communication:(await a.get(path+'/responsibility')).value,notices:(await a.get(path+'/deliveries')).value}),before=await snapshot(),command={client_command_id:randomUUID(),expected_version:version(before.ticket.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'T07_NETWORK',communication_choice:'RETAIN_CURRENT',sessions:[]};
  const gate=await f.pool.connect();let revoker:PostgresPoolClient|null=null,pending:ReturnType<typeof b.post>|null=null,revoke:Promise<void>|null=null,revoked=false,installed=false;
  try{
   const gatePid=(await gate.query<{pid:number}>('SELECT pg_backend_pid() AS pid')).rows[0]?.pid;assert.ok(gatePid);await gate.query('SELECT pg_advisory_lock(9050782)');await f.pool.query("CREATE FUNCTION platform.t07_authority_barrier() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN PERFORM pg_advisory_xact_lock(9050782); RETURN NEW; END $$");await f.pool.query(`CREATE TRIGGER t07_authority_barrier BEFORE UPDATE ON pilot_ticket.ticket FOR EACH ROW WHEN (NEW.id='${first.ticket.id}'::uuid AND NEW.assignee_id='${actor.id}'::uuid) EXECUTE FUNCTION platform.t07_authority_barrier()`);installed=true;pending=b.post(path+'/takeover',command);
   let commandPid:number|null=null;const boundaryUntil=Date.now()+5000;while(Date.now()<boundaryUntil){const activity=await f.pool.query<{pid:number}>("SELECT pid FROM pg_stat_activity WHERE datname=current_database() AND wait_event_type='Lock' AND $1::int=ANY(pg_blocking_pids(pid)) AND query LIKE 'UPDATE pilot_ticket.ticket SET assignee_id%'",[gatePid]);if(activity.rows.length===1){commandPid=activity.rows[0]?.pid??null;break;}await new Promise(resolve=>setTimeout(resolve,20));}assert.ok(commandPid!==null,'public HTTP must reach the actual authoritative write');
   revoker=await f.pool.connect();const authority=revoker,revokerPid=(await authority.query<{pid:number}>('SELECT pg_backend_pid() AS pid')).rows[0]?.pid;assert.ok(revokerPid);await authority.query('BEGIN');
   const operation=kind==='operator-role'?authority.query('DELETE FROM pilot_ticket.pilot_principal_role WHERE principal_id=$1::uuid',[actor.id]):kind==='original-visible-membership'?authority.query("DELETE FROM pilot_ticket.pilot_team_member WHERE principal_id=$1::uuid AND team_id='PILOT_IT'",[actor.id]):kind==='operator-active'?authority.query('UPDATE pilot_ticket.pilot_principal SET is_active=false WHERE id=$1::uuid',[actor.id]):authority.query("UPDATE pilot_ticket.resolver_team SET is_active=false WHERE team_id='T07_NETWORK'");revoke=operation.then(async()=>{await authority.query('COMMIT');revoked=true;});
   let heldUntilCommit=false;const until=Date.now()+5000;while(Date.now()<until&&!revoked){const activity=await f.pool.query<{blocking:number[]}>('SELECT pg_blocking_pids(pid) AS blocking FROM pg_stat_activity WHERE pid=$1::int AND wait_event_type=\'Lock\'',[revokerPid]);if(activity.rows[0]?.blocking.includes(commandPid)){heldUntilCommit=true;break;}await new Promise(resolve=>setTimeout(resolve,20));}assert.ok(revoked||heldUntilCommit);const revokedBefore=revoked;await gate.query('SELECT pg_advisory_unlock(9050782)');const result=await pending;await revoke;
   if(revokedBefore){assert.ok([401,403,404].includes(result.status));assert.deepEqual(await snapshot(),before);}else{assert.equal(result.status,200,JSON.stringify(result.value));const after=await snapshot();assert.equal(after.ticket.assignee_id,actor.id);assert.equal(after.ticket.resolver_team_id,'T07_NETWORK');assert.equal(after.ticket.version,version(before.ticket.version)+1);assert.equal(after.ticket.status,before.ticket.status);assert.deepEqual(after.communication.conversations,before.communication.conversations);assert.deepEqual(after.notices,before.notices);}
   console.log('T07_CURRENT_AUTHORITY_LINEARIZATION '+JSON.stringify({kind,actual_write_barrier:true,revoked_before_write:revokedBefore,held_until_commit:heldUntilCommit,status:result.status}));
  }finally{await gate.query('SELECT pg_advisory_unlock(9050782)');gate.release();await Promise.allSettled([...(pending?[pending]:[]),...(revoke?[revoke]:[])]);if(revoker){await revoker.query('ROLLBACK');revoker.release();}if(installed)await f.pool.query('DROP TRIGGER t07_authority_barrier ON pilot_ticket.ticket');await f.pool.query('DROP FUNCTION IF EXISTS platform.t07_authority_barrier()');}
 },{ticketTakeoverEnabled:true,chronologicalTicketEvents:true});
});
