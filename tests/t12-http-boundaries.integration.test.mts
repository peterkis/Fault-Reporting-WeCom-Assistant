test('public T12 trust, closed body, current authority and legal original cycle reject without partial facts, while exact text bounds can complete',async()=>{
 await withT12Fixture(async f=>{
  const s=await acceptedSetup(f),path=s.path+'/takeover-and-complete',cookie=f.cookies[2];assert.ok(cookie);
  const snapshot=async()=>({ticket:(await s.a.get(s.path)).value,events:(await s.a.get(s.path+'/events')).value,communication:(await s.a.get(s.path+'/responsibility')).value.conversations,deliveries:(await s.a.get(s.path+'/deliveries')).value,cycles:(await f.pool.query('SELECT * FROM pilot_ticket.ticket_handling_cycle WHERE ticket_id=$1::uuid ORDER BY cycle_no',[s.first.ticket.id])).rows,promises:(await f.pool.query('SELECT * FROM pilot_ticket.staff_completion_notification_commitment WHERE ticket_id=$1::uuid',[s.first.ticket.id])).rows});
  const accepted=await snapshot(),cycle=object(accepted.ticket.handling_cycle),capture=(expected:number)=>({client_command_id:randomUUID(),expected_version:expected,reason_code:'STAFF_COMPLETED',resolver_team_id:'T07_NETWORK',handling_cycle_id:text(cycle.id),communication_choice:'RETAIN_CURRENT',sessions:[],internal_process:'T12_HTTP_PRIVATE_CANARY',external_summary:'服务已恢复，请重新尝试。',external_summary_confirmed:true});
  assert.equal((await s.b.post(path,capture(version(accepted.ticket.version)))).status,409,'accepted work cannot implicitly start and close');assert.deepEqual(await snapshot(),accepted);
  assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(accepted.ticket.version),reason_code:'T12_HTTP_START'})).status,200);
  const before=await snapshot(),body=capture(version(before.ticket.version)),csrf=text((await s.b.get('/api/lifecycle/bootstrap')).value.csrf_token);
  const receiptCount=async()=>(await f.pool.query("SELECT count(*)::int AS n FROM pilot_ticket.ticket_command_receipt WHERE command_type='WORKBENCH_TICKET_TAKEOVER_COMPLETION'")).rows,receipts=await receiptCount();
  const post=async(value:Record<string,unknown>,extra:Record<string,string>={},query='')=>{const response=await fetch(f.origin+path+query,{method:'POST',headers:{cookie,origin:f.origin,'content-type':'application/json','x-csrf-token':csrf,'idempotency-key':text(value.client_command_id),'if-match':'"'+value.expected_version+'"',...extra},body:JSON.stringify(value)});await response.arrayBuffer();return response.status;};
  const selected={session_id:randomUUID(),expected_row_version:1};
  for(const patch of [{actor_principal_id:s.actor.id},{target_principal_id:s.owner.id},{ticket_id:s.first.ticket.id},{action:'complete'},{force:true},{status:'CLOSED'},{receipt_type:'WORKBENCH_STAFF_COMPLETION'},{reason_code:'REQUESTER_CONFIRMED'},{expected_version:'4'},{expected_version:0},{expected_version:2147483648},{handling_cycle_id:'cycle'},{resolver_team_id:'arbitrary team'},{internal_process:' '},{internal_process:'x'.repeat(2001)},{external_summary:' '},{external_summary:'x'.repeat(501)},{external_summary_confirmed:false},{communication_choice:'TAKE_SELECTED',sessions:[]},{sessions:[selected]},{communication_choice:'TAKE_SELECTED',sessions:[selected,{...selected,session_id:selected.session_id.toUpperCase()}]},{communication_choice:'TAKE_SELECTED',sessions:Array.from({length:9},()=>({session_id:randomUUID(),expected_row_version:1}))}])assert.equal(await post({...body,...patch}),400,JSON.stringify(patch));
  for(const match of ['',String(body.expected_version),'W/"'+body.expected_version+'"','"'+(body.expected_version-1)+'"'])assert.equal(await post(body,{'if-match':match}),409);
  assert.equal(await post(body,{'idempotency-key':randomUUID()}),400);assert.equal(await post(body,{'x-csrf-token':'synthetic-wrong'}),403);assert.equal(await post(body,{'x-csrf-token':''}),403);assert.equal(await post(body,{origin:'https://foreign.invalid'}),403);assert.equal(await post(body,{origin:''}),403);assert.equal(await post(body,{cookie:''}),401);assert.equal(await post(body,{'content-type':'text/plain'}),415);assert.equal(await post(body,{},'?actor=forged'),400);
  assert.equal(await post({...body,internal_process:'x'.repeat(32769)}),413);assert.equal((await s.b.get(s.path+'/takeover-completion-targets?resolver_team_id=T07_NETWORK&resolver_team_id=PILOT_IT')).status,400);assert.equal((await s.b.get(s.path+'/takeover-completion-targets?actor=forged')).status,400);
  assert.deepEqual(await snapshot(),before);assert.deepEqual(await receiptCount(),receipts,'trust and closed-shape rejection precede any new composite receipt');
  assert.equal((await s.a.post(path,capture(body.expected_version))).status,403,'ADMIN READ does not replace actual target SELF membership');
  const outsideCookie=f.cookies[1];assert.ok(outsideCookie);const outsideBootstrap=await fetch(f.origin+'/api/lifecycle/bootstrap',{headers:{cookie:outsideCookie}});assert.equal(outsideBootstrap.status,200);const outsideCsrf=text(object(await outsideBootstrap.json()).csrf_token);assert.equal(await post(body,{cookie:outsideCookie,'x-csrf-token':outsideCsrf}),404);
  await f.pool.query('DELETE FROM pilot_ticket.pilot_team_member WHERE principal_id=$1::uuid AND team_id=$2',[s.actor.id,'T07_NETWORK']);assert.equal((await s.b.get(s.path)).status,200);assert.equal((await s.b.post(path,capture(body.expected_version))).status,403);assert.deepEqual(await snapshot(),before);
  await f.pool.query('INSERT INTO pilot_ticket.pilot_team_member(principal_id,team_id) VALUES($1::uuid,$2)',[s.actor.id,'T07_NETWORK']);await f.pool.query("UPDATE pilot_ticket.resolver_team SET is_active=false WHERE team_id='T07_NETWORK'");assert.equal((await s.b.post(path,capture(body.expected_version))).status,403);assert.deepEqual(await snapshot(),before);await f.pool.query("UPDATE pilot_ticket.resolver_team SET is_active=true WHERE team_id='T07_NETWORK'");
  await f.pool.query('UPDATE pilot_ticket.pilot_principal SET is_active=false WHERE id=$1::uuid',[s.actor.id]);assert.equal((await s.b.post(path,capture(body.expected_version))).status,401);assert.deepEqual(await snapshot(),before);await f.pool.query('UPDATE pilot_ticket.pilot_principal SET is_active=true WHERE id=$1::uuid',[s.actor.id]);
  assert.equal((await s.b.post(path,{...capture(body.expected_version),handling_cycle_id:randomUUID()})).status,409);assert.equal((await s.b.post(path,capture(body.expected_version-1))).status,409);assert.deepEqual(await snapshot(),before);
  // A physical missing-current-cycle fault must fail closed, never repair a round or transfer responsibility.
  await f.pool.query('UPDATE pilot_ticket.ticket SET current_handling_cycle_id=NULL WHERE id=$1::uuid',[s.first.ticket.id]);const broken=await snapshot();assert.deepEqual((await s.b.get(s.path+'/takeover-completion-targets?resolver_team_id=T07_NETWORK')).value.allowed_actions,[]);assert.equal((await s.b.post(path,capture(body.expected_version))).status,409);assert.deepEqual(await snapshot(),broken);await f.pool.query('UPDATE pilot_ticket.ticket SET current_handling_cycle_id=$2::uuid WHERE id=$1::uuid',[s.first.ticket.id,cycle.id]);
  const bounded={...capture(body.expected_version),internal_process:'x'.repeat(2000),external_summary:'可'.repeat(500)},committed=await s.b.post(path,bounded);assert.equal(committed.status,200,JSON.stringify(committed.value));await assertP2016Schema('p2_016_takeover_completion_result',committed.value);const after=(await s.b.get(s.path)).value;assert.equal(after.status,'CLOSED');assert.equal(after.version,body.expected_version+2);assert.equal(object(after.handling_cycle).id,cycle.id);assert.equal((await f.pool.query('SELECT 1 FROM pilot_ticket.staff_completion_notification_commitment WHERE ticket_id=$1::uuid',[s.first.ticket.id])).rowCount,1);
 });
});

test('a legitimate SELF group beyond one hundred display entries and exactly eight explicitly authorized Sessions commit one bounded composite',async()=>{
 await withT12Fixture(async f=>{
  const s=await acceptedSetup(f);assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_EIGHT_START'})).status,200);const current=(await s.b.get(s.path)).value,cycle=object(current.handling_cycle),group='Z_T12_EXPLICIT';
  await f.pool.query("INSERT INTO pilot_ticket.resolver_team(team_id,display_name) SELECT 'A_T12_'||lpad(n::text,3,'0'),'T12 有界合成组 '||n FROM generate_series(1,99) n");await f.pool.query('INSERT INTO pilot_ticket.resolver_team(team_id,display_name) VALUES($1,$2)',[group,'T12 显式末页组']);await f.pool.query("INSERT INTO pilot_ticket.pilot_team_member(principal_id,team_id) SELECT $1::uuid,team_id FROM pilot_ticket.resolver_team WHERE team_id LIKE 'A_T12_%' OR team_id=$2",[s.actor.id,group]);
  const initial=await s.b.get(s.path+'/takeover-completion-targets');assert.equal(initial.status,200);assert.equal(initial.value.resolver_team_id,null);assert.equal(rows(initial.value.resolver_teams).length,100);assert.equal(rows(initial.value.resolver_teams).some(row=>row.team_id===group),false);
  const explicit=await s.b.get(s.path+'/takeover-completion-targets?resolver_team_id='+group);assert.equal(explicit.status,200);await assertP2016Schema('p2_016_takeover_completion_targets',explicit.value);assert.equal(rows(explicit.value.resolver_teams).length,100);assert.equal(explicit.value.resolver_team_id,group);assert.ok(rows(explicit.value.resolver_teams).some(row=>row.team_id===group));assert.deepEqual(explicit.value.allowed_actions,['takeover-and-complete']);
  const leg=(await f.pool.query<{journey_id:string;reporter_identity_hash:string;provider_context_hash:string;channel_identity_hash:string}>('SELECT journey_id::text,reporter_identity_hash,provider_context_hash,channel_identity_hash FROM intake.channel_leg WHERE source_intake_id=$1::uuid',[s.first.intake.intakeId])).rows[0];assert.ok(leg);const inputs:Record<string,unknown>[]=[];
  for(let n=0;n<8;n++){const source=object(await seedPersistedIntake({pool:f.pool,text:'T12 八会话合成来源 '+n,requestType:'INCIDENT',status:'RECEIVED'}));inputs.push(source);const admitted=await createPilotTicketCore({pool:f.pool}).createForIntake({intakeId:text(source.intakeId),occurredAt:assertLocalDateTime(text(source.receivedAt)),traceId:'t12-eight-public-admission'});assert.ok(admitted.ticket);assert.equal(admitted.ticket.resolver_team_id,'PILOT_IT');}
  for(let n=0;n<3;n++)await f.runtime.coordinator.runOnce();const selected:{session_id:string;expected_row_version:number}[]=[];
  for(const source of inputs){const session=(await f.pool.query<{id:string;thread_id:string;row_version:string}>('SELECT id::text,thread_id::text,row_version::text FROM conversation.session WHERE service_intake_id=$1::uuid',[source.intakeId])).rows[0];assert.ok(session);await createContactJourneyStore().ensureLeg({transaction:f.pool,input:{journey_id:leg.journey_id,leg_type:'GROUP_CONTINUATION',source_intake_id:text(source.intakeId),conversation_thread_id:session.thread_id,conversation_session_id:session.id,origin_channel_message_id:text(source.messageId),provider_context_hash:leg.provider_context_hash,channel_identity_hash:leg.channel_identity_hash,reporter_identity_hash:leg.reporter_identity_hash,opened_at:text(source.receivedAt)}});selected.push({session_id:session.id,expected_row_version:Number(session.row_version)});}
  selected.sort((a,b)=>a.session_id.localeCompare(b.session_id));const choices=rows((await s.b.get(s.path+'/related-conversations')).value.items);assert.equal(choices.length,9);assert.ok(selected.every(item=>choices.some(row=>row.session_id===item.session_id&&row.take_allowed===true&&row.session_row_version===String(item.expected_row_version))));
  const command={client_command_id:randomUUID(),expected_version:version(current.version),reason_code:'STAFF_COMPLETED',resolver_team_id:group,handling_cycle_id:text(cycle.id),communication_choice:'TAKE_SELECTED',sessions:selected,internal_process:'T12_EIGHT_PRIVATE_CANARY',external_summary:'服务已恢复，请重新尝试。',external_summary_confirmed:true};const result=await s.b.post(s.path+'/takeover-and-complete',command);assert.equal(result.status,200,JSON.stringify(result.value));await assertP2016Schema('p2_016_takeover_completion_result',result.value);assert.equal(rows(result.value.conversations).length,8);assert.ok(rows(result.value.conversations).every(row=>row.changed===true&&row.session_row_version===2));const after=(await s.b.get(s.path)).value;assert.equal(after.status,'CLOSED');assert.equal(after.version,command.expected_version+2);assert.equal(after.assignee_id,s.actor.id);assert.equal(after.resolver_team_id,group);assert.equal(object(after.handling_cycle).id,cycle.id);assert.equal((await f.pool.query('SELECT 1 FROM conversation.control_event WHERE client_command_id=$1::uuid',[command.client_command_id])).rowCount,8);assert.deepEqual((await f.pool.query('SELECT state,command_type FROM pilot_ticket.ticket_command_receipt WHERE client_command_id=$1::uuid',[command.client_command_id])).rows,[{state:'COMMITTED',command_type:'WORKBENCH_TICKET_TAKEOVER_COMPLETION'}]);assert.equal((await f.pool.query('SELECT 1 FROM pilot_ticket.staff_completion_notification_commitment WHERE ticket_id=$1::uuid',[s.first.ticket.id])).rowCount,1);
 });
});
