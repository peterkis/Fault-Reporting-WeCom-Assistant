  const cleanup=closeBrowserTestResources([async()=>{if(browser){await browser.evaluate("document.querySelector('.ticket-takeover-completion')?.scrollIntoView({block:'center'})");const bytes=Buffer.from(text(await browser.screenshot()),'base64'),file=join(directory,primary?'failure.png':'scope.png');await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),sha256:createHash('sha256').update(bytes).digest('hex')});await writeFile(join(directory,'page.json'),JSON.stringify(await browser.evaluate("({text:document.body.innerText,process:document.querySelector('#takeover-completion-process')?.value,summary:document.querySelector('#takeover-completion-summary')?.value})")));}},async()=>{await browser?.evaluate('globalThis.__t12ReleaseContext?.()');},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);const file=join(directory,'receipt.json');await writeFile(file,JSON.stringify({lostTicketRead,cleanupFailure,network,screenshots,primary_failure:primary instanceof Error?primary.message:null}));receiptWritten=true;console.log('T12_TARGETS_SCOPE_DIAGNOSTIC '+JSON.stringify({file:file.replaceAll('\\','/'),screenshots}));}],primary);if(cleanupFailure){let observed:unknown;await checkCleanupAndRescue(cleanup,async operation=>{await assert.rejects(()=>operation,error=>{observed=error;assert.ok(error instanceof AggregateError);assert.equal(error.errors.length,2);assert.equal(error.errors[0],primaryFault);assert.ok(error.errors[1] instanceof Error);assert.match(error.errors[1].message,/T12_EXPECTED_CONTEXT_RELEASE_FAILURE/u);return true;});assert.ok(browser);assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});assert.equal(receiptWritten,true);assert.equal(f.runtime.server.listeners('request').include