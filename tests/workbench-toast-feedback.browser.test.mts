import {clickWorkbenchControl,chooseWorkbenchSelect} from './helpers/heroui-workbench-controls.mjs';
import {test} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {tmpdir} from 'node:os';
import {withDetailRestructureFixture} from './helpers/detail-restructure-fixture.mjs';
import {t11Http} from './helpers/t11-completion-fixture.mjs';
import {createPilotAccessService} from '../app/server/src/p1-009-pilot-access-workbench.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';

test('production toast feedback preserves modal geometry, current commands, UNKNOWN recovery and read boundaries',{timeout:180_000},()=>withDetailRestructureFixture(async f=>{
  const first=f.tickets[0],target=f.principals[1],transfer=f.principals[2],actor=f.principals[0],cookie=f.browserCookies[0];assert.ok(first&&target&&transfer&&actor&&cookie?.url);
  const http=await t11Http(f),directory=join(tmpdir(),'web01-ui-'+randomUUID());await mkdir(directory);
  let browser:NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>|undefined,failure:unknown;
  const screenshots:{file:string;width:number;height:number;sha256:string}[]=[];
  try{
    browser=await launchSystemBrowser({url:f.origin+'/workbench/app/',width:1280,height:900,cookies:[{...cookie,url:cookie.url}]});assert.ok(browser);const active=browser;
    const click=(selector:string)=>clickWorkbenchControl(active,selector);
    const choose=(selector:string,value:string)=>chooseWorkbenchSelect(active,selector,value);
    const capture=async(name:string)=>{const bytes=Buffer.from(await active.screenshot(),'base64'),file=join(directory,name);await writeFile(file,bytes);screenshots.push({file,width:bytes.readUInt32BE(16),height:bytes.readUInt32BE(20),sha256:createHash('sha256').update(bytes).digest('hex')});};
    const closeToast=async()=>{const point=await active.evaluate("(()=>{const r=document.querySelector('[data-toast-source=ticket-assignment]').closest('.workbench-toast').querySelector('button').getBoundingClientRect();return {x:r.x+r.width/2,y:r.y+r.height/2};})()") as {x:number;y:number};await active.command('Input.dispatchMouseEvent',{type:'mousePressed',button:'left',clickCount:1,...point});await active.command('Input.dispatchMouseEvent',{type:'mouseReleased',button:'left',clickCount:1,...point});};
    const toast="[data-toast-source=ticket-assignment]",dialog='.detail-assignment-dialog',group=dialog+'>.workbench-select:nth-of-type(1)',person=dialog+'>.workbench-select:nth-of-type(2)';
    await browser.command('Page.enable');await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:`(()=>{globalThis.__toastCsp=[];addEventListener('securitypolicyviolation',event=>globalThis.__toastCsp.push(event.violatedDirective));globalThis.__toastPosts=[];globalThis.__toastReads=[];const original=fetch;globalThis.fetch=async(url,options)=>{const path=new URL(String(url),location.href).pathname;const row={path,body:options?.body?JSON.parse(options.body):null,status:null};if(options?.method==='POST')globalThis.__toastPosts.push(row);else globalThis.__toastReads.push(row);const response=await original(url,options);row.status=response.status;if(globalThis.__loseTransfer&&options?.method==='POST'&&path.endsWith('/transfer-assignment')&&response.ok){globalThis.__loseTransfer=false;await response.arrayBuffer();throw new TypeError('SYNTHETIC_COMMITTED_TRANSFER_RESPONSE_LOST');}return response;};})()`});
    await browser.command('Page.navigate',{url:f.origin+'/workbench/app/items/ticket/'+first.ticket.id});
    await browser.waitFor("document.querySelector('[data-action=open-assignment]')?.disabled===false&&document.querySelector('.media-empty')&&document.querySelector('.notification-empty')&&!document.querySelector('.report-materials .detail-loading')");
    const cspBaseline=await browser.evaluate('globalThis.__toastCsp');
    const actionGeometry=await browser.evaluate("[...document.querySelectorAll('.detail-common-actions>section>button')].map(button=>({text:button.textContent,y:button.getBoundingClientRect().y,height:button.getBoundingClientRect().height}))");
    await click('[data-action=open-assignment]');await choose(group,'PILOT_IT');await choose(person,target.id);await click(dialog+' input[value=RETAIN_CURRENT]');
    await browser.waitFor("document.querySelector('[data-action=assign]')?.disabled===false");
    const geometry=await browser.evaluate(`(()=>{const r=document.querySelector('${dialog}').getBoundingClientRect();return {width:r.width,height:r.height};})()`);
    const before=await http.detail(first.ticket.id),conflict=await http.post(first.ticket.id,'internal-notes',{client_command_id:randomUUID(),expected_version:before.version,reason_code:'TOAST_REAL_CONFLICT',note:'Synthetic concurrency note for toast layout.',external_visible:false});assert.equal(conflict.status,200);
    await click('[data-action=assign]');await browser.waitFor(`document.querySelector('${toast}')?.textContent.includes('操作冲突')`);
    assert.equal(await browser.evaluate(`document.querySelectorAll('${toast}').length`),1);
    assert.deepEqual(await browser.evaluate(`(()=>{const r=document.querySelector('${dialog}').getBoundingClientRect();return {width:r.width,height:r.height};})()`),geometry,'toast does not reflow the HeroUI modal');
    assert.equal(await browser.evaluate(`(()=>{const button=document.querySelector('${dialog} [aria-label=关闭派单窗口]'),r=button.getBoundingClientRect();return button.contains(document.elementFromPoint(r.x+r.width/2,r.y+r.height/2));})()`),true,'feedback must leave the modal close action visible and clickable');
    assert.equal(await browser.evaluate(`(()=>{const button=document.querySelector('${toast}').closest('.workbench-toast').querySelector('button'),r=button.getBoundingClientRect();return button.contains(document.elementFromPoint(r.x+r.width/2,r.y+r.height/2))&&Boolean(button.closest('[data-workbench-overlay]'));})()`),true,'toast is clickable in the HeroUI modal focus scope');
    assert.equal(await browser.evaluate(`document.querySelector('${person} select').value`),target.id);
    assert.equal(await browser.evaluate("Boolean(document.activeElement?.closest('[data-workbench-overlay]'))"),true);
    await capture('new-detail-1280.png');
    await browser.command('Emulation.setDeviceMetricsOverride',{width:390,height:844,deviceScaleFactor:1,mobile:false});
    assert.equal(await browser.evaluate(`(()=>{const r=document.querySelector('${toast}').closest('.workbench-toast').getBoundingClientRect();return r.x>=0&&r.right<=innerWidth&&r.bottom<=innerHeight;})()`),true);
    await browser.command('Emulation.setDeviceMetricsOverride',{width:600,height:844,deviceScaleFactor:1,mobile:false});
    await capture('new-detail-600.png');await browser.command('Emulation.setDeviceMetricsOverride',{width:1280,height:900,deviceScaleFactor:1,mobile:false});
    await closeToast();await browser.waitFor(`!document.querySelector('${toast}')`);assert.equal((await http.detail(first.ticket.id)).version,before.version+1);
    await click('[aria-label="关闭派单窗口"]');await browser.waitFor(`!document.querySelector('${dialog}')`);
    assert.deepEqual(await browser.evaluate("[...document.querySelectorAll('.detail-common-actions>section>button')].map(button=>({text:button.textContent,y:button.getBoundingClientRect().y,height:button.getBoundingClientRect().height}))"),actionGeometry);
    await click('[data-action=open-assignment]');await browser.waitFor(`Boolean(document.querySelector('${person} select'))`);assert.equal(await browser.evaluate(`document.querySelector('${person} select').value`),target.id);
    const repeated=await http.post(first.ticket.id,'internal-notes',{client_command_id:randomUUID(),expected_version:before.version+1,reason_code:'TOAST_REPEAT_CONFLICT',note:'Synthetic second concurrent change.',external_visible:false});assert.equal(repeated.status,200);
    await click('[data-action=assign]');await browser.waitFor(`document.querySelector('${toast}')?.textContent.includes('操作冲突')`);assert.equal(await browser.evaluate(`document.querySelectorAll('${toast}').length`),1,'identical feedback reappears after a distinct explicit attempt');await closeToast();await browser.waitFor(`!document.querySelector('${toast}')`);await click('[data-action=assign]');
    await browser.waitFor(`document.querySelector('${toast}')?.textContent.includes('责任已交接')&&!document.querySelector('${dialog}')`);
    const assigned=await http.detail(first.ticket.id);assert.equal(assigned.assignee_id,target.id);assert.equal(assigned.status,before.status);
    const posts=await browser.evaluate('globalThis.__toastPosts.filter(row=>row.path.endsWith("/assign"))') as {body:{client_command_id:string;expected_version:number};status:number}[];assert.deepEqual(posts.map(row=>row.status),[409,409,200]);assert.equal(new Set(posts.map(row=>row.body.client_command_id)).size,3);assert.equal(posts[2]?.body.expected_version,before.version+2);
    await capture('new-detail-page-1280.png');
    await click('[data-action=open-assignment]');await choose(group,'PILOT_IT');await choose(person,transfer.id);await click(dialog+' input[value=RETAIN_CURRENT]');await browser.evaluate('globalThis.__loseTransfer=true');await click('[data-action=transfer-assignment]');
    await browser.waitFor(`document.querySelector('${toast}')?.dataset.toastState==='unknown'&&Boolean(document.querySelector('[data-action=check-assignment-command]'))`);
    const committed=await http.detail(first.ticket.id);assert.equal(committed.assignee_id,transfer.id);const unknown=await browser.evaluate('globalThis.__toastPosts.filter(row=>row.path.endsWith("/transfer-assignment"))') as {body:{client_command_id:string}}[];assert.equal(unknown.length,1);assert.ok(unknown[0]);
    await browser.evaluate('new Promise(resolve=>setTimeout(resolve,9000))');assert.equal(await browser.evaluate(`document.querySelector('${toast}')?.closest('.workbench-toast').dataset.visible`),'true');
    await closeToast();await browser.waitFor(`!document.querySelector('${toast}')`);assert.equal(await browser.evaluate("document.querySelector('[data-action=transfer-assignment]').disabled"),true);assert.equal(await browser.evaluate(`document.querySelector('${person} select').value`),transfer.id);
    await click('[aria-label="关闭派单窗口"]');await click('[data-action=open-assignment]');await click('[data-action=check-assignment-command]');await browser.waitFor(`document.querySelector('${toast}')?.textContent.includes('已核对原操作结果：已提交')&&!document.querySelector('${dialog}')`);
    assert.equal(await browser.evaluate('globalThis.__toastPosts.filter(row=>row.path.endsWith("/transfer-assignment")).length'),1);assert.equal(await browser.evaluate(`globalThis.__toastReads.filter(row=>row.path.endsWith('/assignment/commands/${unknown[0].body.client_command_id}')).length`),1);assert.equal((await http.detail(first.ticket.id)).version,committed.version);
    assert.equal(await browser.evaluate("[...document.querySelectorAll('[data-assignment-draft-status]')].every(node=>node.getBoundingClientRect().height<=20)"),true);
    // Revoke the actual actor's current read authority while success feedback is still visible.
    const identity=(await f.pool.query<{wecom_user_id:string;display_name:string}>('SELECT wecom_user_id,display_name FROM pilot_ticket.pilot_principal WHERE id=$1::uuid',[actor.id])).rows[0];assert.ok(identity);
    await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:identity.wecom_user_id,displayName:identity.display_name,roles:['HANDLER'],resolverTeamIds:[]});
    await browser.evaluate("[...document.querySelectorAll('button')].find(button=>button.textContent==='重新读取工单动作').click()");
    await browser.waitFor("!document.querySelector('#detail-title')&&!document.querySelector('[data-toast-source=ticket-assignment]')");
    assert.deepEqual(await browser.evaluate('globalThis.__toastCsp'),cspBaseline,'toast lifecycle must not add CSP violations to the settled page baseline');
    console.log('WEB01_BROWSER '+JSON.stringify({api:'REAL_LOOPBACK_HTTP_PG',purpose:'toast-feedback',screenshots}));
    console.log('WORKBENCH_TOAST '+JSON.stringify({actualConflict:true,modalGeometry:true,modalTopLayer:true,narrowViewport:true,explicitCurrentVersionRetry:true,unknownOriginalUuid:true,closeDoesNotSettle:true,currentReadRevocationClears:true,cspBaseline,newCspViolations:0,screenshots}));
  }catch(error){failure=error;try{if(browser){await writeFile(join(directory,'failure.png'),Buffer.from(await browser.screenshot(),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify(await browser.evaluate('({text:document.body.innerText,posts:globalThis.__toastPosts,reads:globalThis.__toastReads,csp:globalThis.__toastCsp})')));}}catch(diagnostic){failure=new AggregateError([error,diagnostic]);}}
  await closeBrowserTestResources([async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});}],failure);
}));
