 await withT13Profile(async f=>{const s=await acceptedSetup(f);await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-1',displayName:'陈悦',roles:['ADMIN'],resolverTeamIds:['PILOT_IT','T07_NETWORK']});assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T13_T12_STARTED_SETUP'})).status,200);const current=(await s.b.get(s.path)).value;assert.equal(current.status,'IN_PROGRESS');const selected=rows((await s.b.get(s.path+'/related-conversations')).value.items)[0];assert.ok(selected);const result=await s.b.post(s.path+'/takeover-and-complete',{client_command_id:randomUUID(),expected_version:version(current.version),reason_code:'STAFF_COMPLETED',resolver_team_id:'T07_NETWORK',handling_cycle_id:text(object(s.before.handling_cycle).id),communication_choice:'TAKE_SELECTED',sessions:[{session_id:text(selected.session_id),expected_row_version:Number(text(selected.session_row_version))}],internal_process:'T13_PRIVATE_COMPOUND_COMPLETION',external_summary:'合成故障已修复。',external_summary_confirmed:true});assert.equal(result.status,200,JSON.stringify(result.value));const receipt=rows(result.value.conversations)[0];assert.equal(receipt?.changed,true);const page=(await s.a.get(s.path+'/assignment-history')).value,items=rows(page.items);assert.equal(items.length,2);const transferred=items[1];assert.ok(transferred);assert.equal(transferred.kind,'RESPONSIBILITY_CHANGE');assert.notEqual(transferred.ticket_event_id,result.value.ticket_event_id);assert.deepEqual(object(transferred.previous).person,{state:'KNOWN',name:'林舟'});assert.deepEqual(object(transferred.next).person,{state:'KNOWN',name:'陈悦'});assert.equal(rows(transferred.communication)[0]?.control_event_id,receipt?.control_event_id);assert.ok(!JSON.stringify(page).includes('T13_PRIVATE_COMPOUND_COMPLETION'));});
});

