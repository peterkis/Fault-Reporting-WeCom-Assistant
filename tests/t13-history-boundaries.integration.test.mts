test('real history pages enforce closed queries, current Ticket READ and Ticket, subject and current group scoped cursors',async()=>{
 await withT13Profile(async f=>{const s=await acceptedSetup(f),changed=await s.b.post(s.path+'/takeover',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T13_SCOPE',resolver_team_id:'T07_NETWORK',communication_choice:'RETAIN_CURRENT',sessions:[]});assert.equal(changed.status,200);const page=await s.a.get(s.path+'/assignment-history?limit=1');assert.equal(page.status,200);await assertP2016Schema('p2_016_assignment_history_page',page.value);const cursor=text(page.value.next_cursor),outsider=await http(f,1);assert.equal((await outsider.get(s.path+'/assignment-history')).status,404);assert.equal((await fetch(f.origin+s.path+'/assignment-history')).status,401);
  for(const query of ['limit=0','limit=101','limit=1.5','limit=1&limit=2','cursor=invalid','limit=1&actor=forged'])assert.equal((await s.a.get(s.path+'/assignment-history?'+query)).status,400,query);
  assert.equal((await s.b.get(s.path+'/assignment-history?cursor='+encodeURIComponent(cursor))).status,400);const other=f.tickets[3];assert.ok(other);assert.equal((await s.a.get('/api/tickets/'+other.ticket.id+'/assignment-history?cursor='+encodeURIComponent(cursor))).status,400);
  await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-0',displayName:'林舟',roles:['HANDLER'],resolverTeamIds:['PILOT_IT']});assert.equal((await s.a.get(s.path+'/assignment-history?cursor='+encodeURIComponent(cursor))).status,404);assert.equal((await s.b.get(s.path+'/assignment-history')).status,200);
 });
});

test('missing initial and predecessor evidence stays UNKNOWN and current safe names do not invent an older spelling or a cycle',async()=>{
 await withT13Profile(async f=>{const a=await http(f,0),legacy=f.tickets[3];assert.ok(legacy);const unknown=await a.get('/api/tickets/'+legacy.ticket.id+'/assignment-history');assert.equal(unknown.status,200);assert.equal(unknown.value.initial_basis,'UNKNOWN');const old=rows(unknown.value.items)[0];assert.ok(old);assert.deepEqual(old.handling_cycle,{state:'UNKNOWN'});assert.deepEqual(object(old.previous).person,{state:'UNKNOWN'});
  const s=await acceptedSetup(f),cycle=object(s.before.handling_cycle);await f.pool.query(`DELETE FROM pilot_ticket.ticket_event WHERE ticket_id=$1::uuid AND event_ordinal<(SELECT event_ordinal FROM pilot_ticket.ticket_event WHERE event_id=$2::uuid)`,[s.first.ticket.id,text(cycle.first_responsibility_event_id)]);const partial=await s.a.get(s.path+'/assignment-history');assert.equal(partial.status,200);const first=rows(partial.value.items)[0];assert.ok(first);assert.deepEqual(first.previous,{person:{state:'UNKNOWN'},team:{state:'UNKNOWN'}});assert.deepEqual(object(first.next).person,{state:'KNOWN',name:'林舟'});
  await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-0',displayName:'林舟（当前安全名称）',roles:['ADMIN'],resolverTeamIds:['PILOT_IT']});const renamed=rows((await s.a.get(s.path+'/assignment-history')).value.items)[0];assert.ok(renamed);assert.deepEqual(renamed.actor,{state:'KNOWN',name:'林舟（当前安全名称）'});assert.equal(renamed.ticket_event_id,first.ticket_event_id);assert.deepEqual(renamed.handling_cycle,first.handling_cycle);
 });
});

test('independent Session READ and retained source scope filter actual child Control facts, and an unlinked later communication never rewrites the recorded coupling',async()=>{
 await withT13Profile(async f=>{const s=await acceptedSetup(f),leg=(await f.pool.query<{journey_id:string;reporter_identity_hash:string;provider_context_hash:string;channel_identity_hash:string}>('SELECT journey_id::text,reporter_identity_hash,provider_context_hash,channel_identity_hash FROM intake.channel_leg WHERE source_intake_id=$1::uuid',[s.first.intake.intakeId])).rows[0];assert.ok(leg);
  const source=object(await seedPersistedIntake({pool:f.pool,text:'T13 isolated linked child '+randomUUID(),requestType:'INCIDENT',status:'RECEIVED'}));const childTicket=await createPilotTicketCore({pool:f.pool}).createForIntake({intakeId:text(source.intakeId),occurredAt:assertLocalDateTime(source.receivedAt),traceId:'t13-linked-source'});assert.ok(childTicket.ticket);for(let i=0;i<3;i++)await f.runtime.coordinator.runOnce();const child=(await f.pool.query<{id:string;thread_id:string;row_version:string}>('SELECT id::text,thread_id::text,row_version::text FROM conversation.session WHERE service_intake_id=$1::uuid',[source.intakeId])).rows[0];assert.ok(child);
  await createContactJourneyStore().ensureLeg({transaction:f.pool,input:{journey_id:leg.journey_id,leg_type:'GROUP_CONTINUATION',source_intake_id:text(source.intakeId),conversation_thread_id:child.thread_id,conversation_session_id:child.id,origin_channel_message_id:text(source.messageId),provider_context_hash:leg.provider_context_hash,channel_identity_hash:leg.channel_identity_hash,reporter_identity_hash:leg.reporter_identity_hash,opened_at:text(source.receivedAt)}});
  // A synthetic legacy assignment snapshot has no predecessor Control audit. It must not become a guessed historical person.
  await f.pool.query(`INSERT INTO conversation.assignment(session_id,assignment_status,assigned_principal_id,assigned_by_principal_id,assignment_version,assigned_at,updated_at) VALUES($1::uuid,'ASSIGNED',$2::uuid,$2::uuid,1,platform.local_now(),platform.local_now()) ON CONFLICT(session_id) DO UPDATE SET assignment_status='ASSIGNED',assigned_principal_id=$2::uuid,assigned_by_principal_id=$2::uuid,assigned_at=platform.local_now(),released_at=NULL`,[child.id,f.principals[3]?.id]);
  await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-1',displayName:'陈悦',roles:['ADMIN'],resolverTeamIds:['PILOT_IT','T07_NETWORK']});const selected=rows((await s.b.get(s.path+'/related-conversations')).value.items).find(row=>row.session_id===child.id);assert.ok(selected);const transfer=await s.b.post(s.path+'/takeover-and-start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T13_CHILD',resolver_team_id:'T07_NETWORK',communication_choice:'TAKE_SELECTED',sessions:[{session_id:child.id,expected_row_version:Number(text(selected.session_row_version))}]});assert.equal(transfer.status,200,JSON.stringify(transfer.value));
  const full=await s.a.get(s.path+'/assignment-history'),changed=rows(full.value.items).find(row=>row.kind==='RESPONSIBILITY_CHANGE');assert.ok(changed);const controls=rows(changed.communication);assert.equal(controls.length,1);assert.equal(controls[0]?.session_id,child.id);assert.deepEqual(controls[0]?.previous,{state:'UNKNOWN'});assert.deepEqual(controls[0]?.next,{state:'KNOWN',name:'陈悦'});
  await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-outsider',displayName:'获权只读同事',roles:['HANDLER'],resolverTeamIds:['T07_NETWORK']});const reader=await http(f,1),safe=await reader.get(s.path+'/assignment-history');assert.equal(safe.status,200);assert.ok(!JSON.stringify(safe.value).includes(child.id));const masked=rows(safe.value.items).find(row=>row.ticket_event_id===changed.ticket_event_id);assert.ok(masked);assert.deepEqual(masked.communication,[]);
  const current=rows((await s.a.get(s.path+'/related-conversations')).value.items).find(row=>row.session_id===child.id);assert.ok(current);assert.equal((await s.a.post('/api/conversations/'+child.id+'/transfer',{client_command_id:randomUUID(),expected_row_version:Number(text(current.session_row_version)),target_principal_id:f.principals[3]?.id,force:true,reason_code:'T13_UNLINKED_CONTROL'})).status,200);const still=rows((await s.a.get(s.path+'/assignment-history')).value.items).find(row=>row.ticket_event_id===changed.ticket_event_id);assert.deepEqual(still?.communication,changed.communication);
  await f.pool.query('UPDATE intake.service_intake SET retention_until_epoch_ms=$2::bigint WHERE id=$1::uuid',[source.intakeId,String(BigInt(Date.now())-1000n)]);const retained=rows((await s.a.get(s.path+'/assignment-history')).value.items).find(row=>row.ticket_event_id===changed.ticket_event_id);assert.deepEqual(retained?.communication,[]);
 });
});

for(const action of ['unassign','return-to-dispatch'] as const)test('actual '+action+' preserves its selected communication change and original round in read history',async()=>{
 await withT13Profile(async f=>{const s=await acceptedSetup(f);let before=s.before;if(action==='return-to-dispatch'){assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(before.version),reason_code:'T13_RETURN_START'})).status,200);before=(await s.a.get(s.path)).value;}
  const session=rows((await s.a.get(s.path+'/related-conversations')).value.items)[0];assert.ok(session);const result=await s.a.post(s.path+'/'+action,{client_command_id:randomUUID(),expected_version:version(before.version),reason_code:'T13_ACTUAL_CLEAR',reason:'T13 private clear reason',...(action==='return-to-dispatch'?{unfinished_work:'T13 private unfinished'}:{}),communication_choice:'TRANSFER_SELECTED',communication_target_principal_id:s.actor.id,sessions:[{session_id:text(session.session_id),expected_row_version:Number(text(session.session_row_version))}]});assert.equal(result.status,200,JSON.stringify(result.value));const receiptControls=rows(result.value.conversations);assert.equal(receiptControls[0]?.changed,true);
  const page=await s.a.get(s.path+'/assignment-history');assert.equal(page.status,200);const changed=rows(page.value.items).find(row=>row.ticket_event_id===result.value.ticket_event_id);assert.ok(changed);assert.deepEqual(object(changed.next).person,{state:'NONE'});assert.deepEqual(changed.handling_cycle,{state:'KNOWN',cycle_no:1});const controls=rows(changed.communication);assert.equal(controls.length,1,'actual selected '+action+' Control must not disappear merely because its trace prefix differs from takeover');assert.equal(controls[0]?.control_event_id,receiptControls[0]?.control_event_id);assert.deepEqual(controls[0]?.previous,{state:'KNOWN',name:'林舟'});assert.deepEqual(controls[0]?.next,{state:'KNOWN',name:'陈悦'});assert.ok(!JSON.stringify(page.value).includes('T13 private'));
  if(action==='return-to-dispatch'){const returned=(await s.b.get(s.path)).value,first=object(returned.handling_cycle).first_responsibility_event_id,reaccepted=await s.b.post(s.path+'/accept-for-later-with-conversations',{client_command_id:randomUUID(),expected_version:version(returned.version),reason_code:'T13_SAME_ROUND_ACCEPT',resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]});assert.equal(reaccepted.status,200,JSON.stringify(reaccepted.value));const history=(await s.a.get(s.path+'/assignment-history')).value,later=rows(history.items).find(row=>row.ticket_event_id===reaccepted.value.ticket_event_id);assert.ok(later);assert.equal(later.kind,'RESPONSIBILITY_CHANGE');assert.deepEqual(object(later.next).person,{state:'KNOWN',name:'陈悦'});assert.deepEqual(object(later.previous).person,{state:'NONE'});assert.deepEqual(object(later.previous).team,{state:'KNOWN',name:'Pilot 信息保障组'});assert.deepEqual(object(later.next).team,{state:'KNOWN',name:'Pilot 信息保障组'});assert.deepEqual(later.handling_cycle,{state:'KNOWN',cycle_no:1});assert.deepEqual(later.communication,[]);assert.equal(object((await s.a.get(s.path)).value.handling_cycle).first_responsibility_event_id,first);assert.deepEqual(rows(history.items).slice(0,2),rows(page.value.items));}
 });
});

test('history remains an independent read capability with every write and recovery option false, and closing it leaves ordinary current reads and facts intact',async()=>{
 for(const enabled of [true,false])await withT13Profile(async f=>{const a=await http(f,0),first=f.tickets[3];assert.ok(first);const path='/api/tickets/'+first.ticket.id,bootstrap=(await a.get('/api/lifecycle/bootstrap')).value;assert.equal(bootstrap.assignment_history_enabled,enabled);for(const key of ['ticket_self_handling_enabled','ticket_assignment_enabled','ticket_takeover_enabled','ticket_takeover_completion_enabled','ticket_return_to_dispatch_enabled','ticket_unassign_enabled','ticket_waiting_actions_enabled','draft_recovery_enabled'])assert.equal(bootstrap[key],false);const before=(await a.get(path+'/events')).value;assert.equal((await a.get(path+'/assignment-history')).status,enabled?200:503);assert.equal((await a.get(path)).status,200);assert.deepEqual((await a.get(path+'/events')).value,before);},{historyEnabled:enabled,writeEnabled:false});
});
test('waiting and closure preserve the old chain, while an explicit reopened round starts unassigned and retains prior round history',async()=>{
 await withT13Profile(async f=>{const s=await acceptedSetup(f),original=(await s.a.get(s.path+'/assignment-history')).value;assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T13_CYCLE_START'})).status,200);
  for(const action of ['wait-vendor','resume','request-information','resume']){const current=(await s.a.get(s.path)).value;assert.equal((await s.a.post(s.path+'/'+action,{client_command_id:randomUUID(),expected_version:version(current.version),reason_code:'T13_HISTORY_WAIT',note:'T13 internal waiting material',external_visible:false})).status,200);assert.deepEqual((await s.a.get(s.path+'/assignment-history')).value,original);}
  const current=(await s.a.get(s.path)).value,cycle=object(current.handling_cycle);assert.equal((await s.a.post(s.path+'/complete',{client_command_id:randomUUID(),expected_version:version(current.version),reason_code:'STAFF_COMPLETED',handling_cycle_id:text(cycle.id),internal_process:'T13 private completion',external_summary:'合成故障已修复。',external_summary_confirmed:true})).status,200);assert.deepEqual((await s.a.get(s.path+'/assignment-history')).value,original);
  const closed=(await s.a.get(s.path)).value,reopened=await s.a.post(s.path+'/reopen',{client_command_id:randomUUID(),expected_version:version(closed.version),reason_code:'STAFF_REOPEN',note:'合成回访发现故障仍在。'});assert.equal(reopened.status,200,JSON.stringify(reopened.value));assert.deepEqual((await s.a.get(s.path+'/assignment-history')).value,original);const second=(await s.a.get(s.path)).value;assert.equal(object(second.handling_cycle).cycle_no,2);assert.equal(second.assignee_id,null);
  assert.equal((await s.a.post(s.path+'/accept-for-later-with-conversations',{client_command_id:randomUUID(),expected_version:version(second.version),reason_code:'T13_SECOND_ACCEPT',resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]})).status,200);const history=(await s.a.get(s.path+'/assignment-history')).value,items=rows(history.items);assert.equal(items.length,2);assert.deepEqual(items[0],rows(original.items)[0]);assert.deepEqual(items[1]?.handling_cycle,{state:'KNOWN',cycle_no:2});assert.equal(items[1]?.kind,'FIRST_RESPONSIBILITY');assert.deepEqual(object(items[1]?.previous).person,{state:'NONE'},'the recorded explicit reopened unassigned round is stronger evidence than a generic unknown prefix');assert.deepEqual(object(items[1]?.next).person,{state:'KNOWN',name:'林舟'});assert.ok(!JSON.stringify(history).includes('T13 private')&&!JSON.stringify(history).includes('T13 internal'));
 });
});
test('a dispatchers real first assignment to another person is a recorded initial basis proven by target metadata rather than the operator identity',async()=>{
  await withT13Profile(async f=>{const first=f.tickets[0],target=f.principals[1],owner=f.principals[0];assert.ok(first&&target&&owner);const a=await http(f,0),path='/api/tickets/'+first.ticket.id,current=(await a.get(path)).value;assert.equal(current.assignee_id,null);const empty=await a.get(path+'/assignment-history');assert.equal(empty.status,200);assert.deepEqual(empty.value.items,[]);assert.equal(empty.value.next_cursor,null);assert.equal(empty.value.initial_basis,'UNKNOWN');const assigned=await a.post(path+'/assign',{client_command_id:randomUUID(),expected_version:version(current.version),reason_code:'T13_DISPATCH_FIRST',target_principal_id:target.id,resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]});assert.equal(assigned.status,200,JSON.stringify(assigned.value));const history=await a.get(path+'/assignment-history');assert.equal(history.status,200);assert.equal(history.value.initial_basis,'RECORDED');const row=rows(history.value.items)[0];assert.ok(row);assert.equal(row.kind,'FIRST_RESPONSIBILITY');assert.deepEqual(row.actor,{state:'KNOWN',name:'林舟'});assert.deepEqual(object(row.next).person,{state:'KNOWN',name:'陈悦'});assert.deepEqual(object(row.previous).person,{state:'NONE'});assert.deepEqual(row.handling_cycle,{state:'KNOWN',cycle_no:1});assert.deepEqual(row.communication,[]);
  for(let batch=0;batch<3;batch++)await f.runtime.coordinator.runOnce();const selected=rows((await a.get(path+'/related-conversations')).value.items)[0];assert.ok(selected);const moved=await a.post(path+'/transfer-assignment',{client_command_id:randomUUID(),expected_version:version(assigned.value.ticket_version),reason_code:'T13_DISPATCH_CONTROL',target_principal_id:owner.id,resolver_team_id:'PILOT_IT',communication_choice:'TRANSFER_SELECTED',sessions:[{session_id:text(selected.session_id),expected_row_version:Number(text(selected.session_row_version))}]});assert.equal(moved.status,200,JSON.stringify(moved.value));const receipt=rows(moved.value.conversations)[0];assert.equal(receipt?.changed,true);const later=rows((await a.get(path+'/assignment-history')).value.items).find(item=>item.ticket_event_id===moved.value.ticket_event_id);assert.ok(later);assert.equal(rows(later.communication)[0]?.control_event_id,receipt?.control_event_id,'a real selected T06 Control must stay linked to its actual responsibility event');
  await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-1',displayName:'陈悦',roles:['ADMIN'],resolverTeamIds:['PILOT_IT']});const b=await http(f,2),related=rows((await b.get(path+'/related-conversations')).value.items)[0];assert.ok(related);const started=await b.post(path+'/takeover-and-start',{client_command_id:randomUUID(),expected_version:version(moved.value.ticket_version),reason_code:'T13_QUEUED_COMPOUND',resolver_team_id:'PILOT_IT',communication_choice:'TAKE_SELECTED',sessions:[{session_id:text(related.session_id),expected_row_version:Number(text(related.session_row_version))}]});assert.equal(started.status,200,JSON.stringify(started.value));const after=rows((await a.get(path+'/assignment-history')).value.items);assert.equal(after.length,4);const transfer=after[2],accepted=after[3];assert.ok(transfer&&accepted);assert.equal(rows(transfer.communication)[0]?.control_event_id,rows(started.value.conversations)[0]?.control_event_id);assert.deepEqual(accepted.communication,[],'the one real compound Control belongs to the transfer, not again to its later acceptance');assert.deepEqual(object(accepted.previous).person,{state:'KNOWN',name:'陈悦'});assert.deepEqual(object(accepted.next).person,{state:'KNOWN',name:'陈悦'});assert.deepEqual(object(accepted.previous).team,{state:'KNOWN',name:'Pilot 信息保障组'});assert.deepEqual(object(accepted.next).team,{state:'KNOWN',name:'Pilot 信息保障组'});assert.deepEqual(accepted.handling_cycle,{state:'KNOWN',cycle_no:1});
 });
});

