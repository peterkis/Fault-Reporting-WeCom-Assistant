import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import type {IncomingMessage,ServerResponse} from 'node:http';
import {withT12Profile} from './helpers/t12-profile-fixture.mjs';
import {acceptedSetup,object,text,version} from './helpers/t07-public-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';

type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
async function checkCleanupAndRescue(cleanup:Promise<void>,validate:(operation:Promise<void>)=>Promise<void>,rescue:()=>Promise<void>){
 let original:unknown;const operation=cleanup.catch(error=>{original=error;throw error;});
 await closeBrowserTestResources([async()=>{try{await validate(operation);}catch(error){if(original!==undefined&&original!==error)throw new AggregateError([original,error],'T12_NEGATIVE_ORIGINAL_AND_VALIDATION_FAILED');throw error;}},rescue]);
}
type RequestFact={order:number;method:string;path:string;status:number|null;body:unknown;idempotency:unknown;if_match:unknown;csrf:boolean;origin:boolean};
async function textarea(browser:Browser,selector:string,value:string){await browser.evaluate(`(()=>{const input=document.querySelector(${JSON.stringify(selector)});Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(input,${JSON.stringify(value)});input.dispatchEvent(new Event('input',{bubbles:true}));})()`);}

async function productionForm(cleanupFailure=false){
 await withT12Profile(async f=>{
  const s=await acceptedSetup(f);assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_BROWSER_START'})).status,200);
  const current=(await s.b.get(s.path)).value,cycle=object(current.handling_cycle),cookie=f.browserCookies[2];assert.ok(cookie);assert.equal(typeof cookie.url,'string');
  const capability=(await s.b.get('/api/lifecycle/bootstrap')).value;assert.equal(capability.ticket_takeover_completion_enabled,true);assert.equal(capability.ticket_takeover_completion_draft_recovery_enabled,false);
  const requests:RequestFact[]=[],observe=(request:IncomingMessage,response:ServerResponse)=>{
   if(!request.headers.cookie?.includes(cookie.name+'='+cookie.value))return;const path=new URL(request.url??'/',f.origin).pathname;if(!path.startsWith('/api/'))return;
   const fact:RequestFact={order:requests.length,method:request.method??'',path,status:null,body:null,idempotency:request.headers['idempotency-key'],if_match:request.headers['if-match'],csrf:typeof request.headers['x-csrf-token']==='string',origin:request.headers.origin===f.origin};requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});
   if(fact.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});}
  };
  const directory=join(tmpdir(),'t12-ui-'+randomUUID());await mkdir(directory);const screenshots:{file:string;width:number;height:number;sha256:string}[]=[];let browser:Browser|undefined,primary:unknown;const primaryFault=new Error('T12_EXPECTED_FORM_BODY_FAILURE');let receiptWritten=false;
  f.runtime.server.on('request',observe);
  const capture=async(name:string)=>{assert.ok(browser);if(cleanupFailure)await browser.command('Page.captureScreenshot',{format:'T12_INVALID_DIAGNOSTIC_FORMAT'});await browser.evaluate("document.querySelector('.ticket-takeover-completion')?.scrollIntoView({block:'center'})");const bytes=Buffer.from(text(await browser.screenshot()),'base64'),file=join(directory,name);await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),width:bytes.readUInt32BE(16),height:bytes.readUInt32BE(20),sha256:createHash('sha256').update(bytes).digest('hex')});};
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[{...cookie,url:text(cookie.url)}]});assert.ok(browser);
   await browser.waitFor("Boolean(document.querySelector('#detail-title'))");if(cleanupFailure)throw primaryFault;assert.equal(await browser.evaluate("Math.round(document.querySelector('.detail-dialog').getBoundingClientRect().width)"),600);
   assert.equal(await browser.evaluate("Boolean(document.querySelector('.ticket-takeover-completion'))"),true,'the formal production bundle must expose the independent composite form');
   await browser.waitFor("document.querySelector('.ticket-takeover-completion select')?.options.length>2&&document.querySelector('.ticket-takeover-completion select').disabled===false");
   assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover-completion select').value"),'');assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover-completion input[value=TAKE_SELECTED]').checked"),true);
   assert.equal(await browser.evaluate("document.querySelectorAll('.ticket-takeover-completion [data-session-choice]:checked').length"),0);
   await textarea(browser,'#takeover-completion-process','T12_FORM_INTERNAL_CANARY：独立排查过程');assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-summary').value"),'');
   await browser.evaluate("(()=>{const input=document.querySelector('.ticket-takeover-completion select');Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(input,'T07_NETWORK');input.dispatchEvent(new Event('change',{bubbles:true}));})()");
   await browser.waitFor("document.querySelector('.ticket-takeover-completion select')?.value==='T07_NETWORK'&&document.querySelector('.ticket-takeover-completion fieldset')?.disabled===false");
   await browser.evaluate("document.querySelector('.ticket-takeover-completion input[value=RETAIN_CURRENT]').click()");assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover-completion input[value=RETAIN_CURRENT]').checked"),true);
   await textarea(browser,'#takeover-completion-summary','合成服务已恢复。');assert.equal(await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').disabled"),true);
   assert.equal(await browser.evaluate("document.querySelector('[data-takeover-completion-preview]').textContent"),'合成服务已恢复。');await browser.waitFor("document.querySelector('#takeover-completion-confirmed').disabled===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-confirmed').checked"),true);
   await textarea(browser,'#takeover-completion-summary','合成服务已恢复，请重新尝试。');assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-confirmed').checked"),false);
   await browser.waitFor("document.querySelector('#takeover-completion-confirmed').disabled===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-confirmed').checked"),true);await browser.waitFor("document.querySelector('[data-action=takeover-and-complete]').disabled===false");assert.equal(requests.filter(row=>row.method==='POST').length,0);await capture('independent-preview-600px.png');
   await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').click()");await browser.waitFor("document.querySelector('.ticket-takeover-completion')?.innerText.includes('已接管并完工')&&document.querySelector('.properties')?.innerText.includes('已关闭')");
   const posts=requests.filter(row=>row.method==='POST');assert.equal(posts.length,1);const post=posts[0];assert.ok(post);const body=object(post.body),id=text(body.client_command_id);assert.equal(post.status,200);assert.equal(post.path,s.path+'/takeover-and-complete');assert.equal(post.idempotency,id);assert.equal(post.if_match,'"'+version(current.version)+'"');assert.equal(post.csrf,true);assert.equal(post.origin,true);
   assert.deepEqual(body,{client_command_id:id,expected_version:version(current.version),reason_code:'STAFF_COMPLETED',resolver_team_id:'T07_NETWORK',handling_cycle_id:text(cycle.id),communication_choice:'RETAIN_CURRENT',sessions:[],internal_process:'T12_FORM_INTERNAL_CANARY：独立排查过程',external_summary:'合成服务已恢复，请重新尝试。',external_summary_confirmed:true});
   assert.ok(requests.some(row=>row.order>post.order&&row.method==='GET'&&[s.path,'/api/workbench/items/ticket/'+s.first.ticket.id].includes(row.path)&&row.status===200));const after=(await s.b.get(s.path)).value;assert.equal(after.status,'CLOSED');assert.equal(after.assignee_id,s.actor.id);assert.equal(after.version,version(current.version)+2);assert.equal(object(after.handling_cycle).id,cycle.id);await capture('committed-current-facts-600px.png');
   await browser.command('Emulation.setDeviceMetricsOverride',{width:390,height:844,deviceScaleFactor:1,mobile:true});assert.ok(await browser.evaluate('document.documentElement.scrollWidth<=window.innerWidth+1'));await capture('committed-narrow-390px.png');
  }catch(error){primary=error;}
  const cleanup=closeBrowserTestResources([async()=>{if(primary&&browser){await capture('failure.png');await writeFile(join(directory,'failure.json'),JSON.stringify({requests,page:await browser.evaluate('({text:document.body.innerText,path:location.pathname})')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);},async()=>{const diagnostic=join(directory,'receipt.json');await writeFile(diagnostic,JSON.stringify({formal_production_bundle:true,real_http_pg:true,requests,screenshots,primary_failure:primary instanceof Error?primary.message:null}));receiptWritten=true;console.log('T12_BROWSER_DIAGNOSTIC '+JSON.stringify({file:diagnostic.replaceAll('\\','/'),screenshots}));}],primary);if(cleanupFailure){let observed:unknown;await checkCleanupAndRescue(cleanup,async operation=>{await assert.rejects(()=>operation,error=>{observed=error;assert.ok(error instanceof AggregateError);assert.equal(error.errors.length,2);assert.equal(error.errors[0],primaryFault);assert.ok(error.errors[1] instanceof Error);assert.match(error.errors[1].message,/format/iu);return true;});assert.ok(browser);assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});assert.equal(receiptWritten,true);assert.equal(f.runtime.server.listeners('request').includes(observe),false);assert.equal(requests.filter(row=>row.method==='POST').length,0);},async()=>{await browser?.close();});await assert.rejects(()=>checkCleanupAndRescue(cleanup,async operation=>{await assert.rejects(()=>operation);assert.fail('T12_EXPECTED_POST_CLEANUP_VALIDATION_FAILURE');},async()=>{assert.ok(browser);await browser.command('Runtime.evaluate',{expression:'0'});}),error=>{assert.ok(error instanceof AggregateError);assert.equal(error.errors.length,2);const chain=error.errors[0];assert.ok(chain instanceof AggregateError);assert.equal(chain.errors.length,2);assert.equal(chain.errors[0],observed);assert.ok(chain.errors[1] instanceof assert.AssertionError);assert.match(chain.errors[1].message,/T12_EXPECTED_POST_CLEANUP_VALIDATION_FAILURE/u);assert.ok(error.errors[1] instanceof Error);assert.equal(error.errors[1].message,'P2_006_BROWSER_DISCONNECTED');return true;});console.log('T12_NEGATIVE_CLEANUP_CHAIN '+JSON.stringify({preserved_actual_original_cleanup:true,validation_and_closed_cdp_rescue_errors_retained:true,owned:browser?.ownedResourceState()}));}else await cleanup;
 },{recoveryEnabled:false});
}

test('formal production detail requires explicit SELF group, separate blank public summary and preview confirmation before one atomic takeover-completion POST',()=>productionForm());
test('real production-form diagnostic CDP failure retains the primary error and still closes browser, removes observer and writes its receipt',()=>productionForm(true));
