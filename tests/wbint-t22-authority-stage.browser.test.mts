import {test} from 'node:test';
import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {tmpdir} from 'node:os';
import {randomUUID} from 'node:crypto';
import {withT22Fixture} from './helpers/wbint-t22-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
const ready="document.querySelectorAll('[data-conversation-draft]').length===2&&Array.from(document.querySelectorAll('[data-conversation-draft]')).every(e=>e.textContent.includes('草稿仅在当前浏览器'))";
const input=(purpose:string,value:string)=>`(()=>{const input=document.querySelector('textarea[data-purpose="${purpose}"]');Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(input,${JSON.stringify(value)});input.dispatchEvent(new Event('input',{bubbles:true}));})()`;
async function saved(browser:Browser,purpose='internal-notes'){await browser.waitFor(`document.querySelector('[data-conversation-draft="${purpose}"]').textContent.includes('已保存恢复副本')`);}
async function select(browser:Browser,id:string){await browser.evaluate(`document.querySelector('[data-conversation-id="${id}"] a').click()`);await browser.waitFor(`location.pathname.endsWith('/${id}')&&Boolean(document.querySelector('[data-conversation-ready]'))`);}
function snapshot(principal:string,id:string){const key=JSON.stringify([principal,'conversation',id,'conversation-note']);return `new Promise((resolve,reject)=>{const request=indexedDB.open('wecom-workbench-drafts-v1',2);request.onerror=()=>reject(request.error);request.onsuccess=()=>{const db=request.result,tx=db.transaction(['drafts','operations'],'readonly'),record=tx.objectStore('drafts').get(${JSON.stringify(key)}),op=tx.objectStore('operations').get(${JSON.stringify(key)});tx.oncomplete=()=>{resolve({revision:record.result?.revision??null,operation:op.result?.commandId??null});db.close();};};})`;}
function principalCounts(principal:string){return `new Promise((resolve,reject)=>{const request=indexedDB.open('wecom-workbench-drafts-v1',2);request.onerror=()=>reject(request.error);request.onsuccess=()=>{const db=request.result,tx=db.transaction(['drafts','operations'],'readonly'),records=tx.objectStore('drafts').getAll(),ops=tx.objectStore('operations').getAll();tx.oncomplete=()=>{resolve({drafts:records.result.filter(r=>r.principal===${JSON.stringify(principal)}).length,operations:ops.result.filter(r=>r.principal===${JSON.stringify(principal)}).length});db.close();};};})`;}
async function reload(browser:Browser){const before=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${before}&&document.readyState==='complete'`);}
// Delayed original fetch only: no replacement status/body. Background denials cannot mask the adapter stage under test.
function holdAuthority(session:string,mode:'blank'|'stored'){return `(()=>{const original=fetch;globalThis.__authorityHeld=0;globalThis.__authorityStatus=null;globalThis.__objectStatus=null;globalThis.__stageReads=[];globalThis.__background=[];globalThis.__workspaceGate=${mode==='stored'};globalThis.__holdNextAuthority=${mode==='stored'};globalThis.__allowObject=false;globalThis.__releaseBackground=()=>{const rows=globalThis.__background.splice(0);globalThis.__workspaceGate=false;for(const run of rows)run();};globalThis.fetch=(path,init)=>{const url=String(path);if(url==='/api/lifecycle/bootstrap'&&globalThis.__holdNextAuthority){globalThis.__holdNextAuthority=false;globalThis.__authorityHeld++;return new Promise((resolve,reject)=>{globalThis.__releaseAuthority=()=>original(path,init).then(response=>{globalThis.__authorityStatus=response.status;globalThis.__stageReads.push({path:url,status:response.status});if(response.status===200)globalThis.__allowObject=true;resolve(response);},reject);});}if(globalThis.__workspaceGate&&(!init?.method||init.method==='GET')&&url.startsWith('/api/workbench/')){if(globalThis.__allowObject&&url===${JSON.stringify('/api/workbench/conversations/'+session)}){globalThis.__allowObject=false;return original(path,init).then(response=>{globalThis.__objectStatus=response.status;globalThis.__stageReads.push({path:url,status:response.status});return response;});}return new Promise((resolve,reject)=>globalThis.__background.push(()=>original(path,init).then(resolve,reject)));}return original(path,init).then(response=>{if(url.endsWith('/messages')&&init?.method==='POST'&&response.status===202){globalThis.__workspaceGate=true;globalThis.__holdNextAuthority=true;}return response;});};})()`;}
async function settle(browser:Browser,text:string){await browser.evaluate(input('messages',text));await saved(browser,'messages');await browser.evaluate("document.querySelector('[data-action=send-conversation-reply]').click()");await browser.waitFor("document.querySelector('[data-reply-outcome]').textContent.includes('已受理发送')");}

test('independent bootstrap403 revokes the whole principal including another real saved Session draft',async()=>{
 await withT22Fixture(async({origin,browserCookie,cookie,pool,runtime,sessions,principals,bootstrapAuthenticationBoundary})=>{
  const a=sessions[0],b=sessions[1],p=principals[0];assert.ok(a);assert.ok(b);assert.ok(p);const directory=join(tmpdir(),'web01-ui-'+randomUUID()),responses:{path:string;status:number}[]=[];let browser:Browser|undefined,failure:unknown;
  runtime.server.on('request',(request,response)=>{const path=request.url??'';if(request.method==='GET'&&(path==='/api/lifecycle/bootstrap'||path.startsWith('/api/workbench/conversations')))response.once('finish',()=>responses.push({path,status:response.statusCode}));});
  try{
   browser=await launchSystemBrowser({url:origin+'/workbench/app/conversations/'+b.id,width:900,height:900,cookies:[{...browserCookie,url:origin+'/'}]});assert.ok(browser);await browser.waitFor(ready);await browser.evaluate(input('internal-notes','T22 private other Session before bootstrap denial'));await saved(browser);const before=await browser.evaluate(snapshot(p.id,b.id)) as {revision:string|null;operation:string|null};assert.ok(before.revision);assert.equal(before.operation,null);
   await select(browser,a.id);await browser.waitFor(ready);assert.equal(await browser.evaluate("document.querySelector('textarea[data-purpose=internal-notes]').value"),'');assert.deepEqual(await browser.evaluate(snapshot(p.id,b.id)),before);
   await browser.evaluate(holdAuthority(a.id,'blank'));await settle(browser,'T22 real reply before independent bootstrap denial');await browser.waitFor('globalThis.__authorityHeld===1');assert.deepEqual(await browser.evaluate(snapshot(p.id,b.id)),before);await browser.evaluate(input('internal-notes','T22 denied queued input must not persist'));
   const identity=(await pool.query<{wecom_user_id:string;display_name:string}>('SELECT wecom_user_id,display_name FROM pilot_ticket.pilot_principal WHERE id=$1::uuid',[p.id])).rows[0];assert.ok(identity);const access=createPilotAccessService({pool});assert.ok(bootstrapAuthenticationBoundary);let roleLossCalls=0;
   bootstrapAuthenticationBoundary.armNext(async()=>{roleLossCalls++;await access.upsertPrincipal({wecomUserId:identity.wecom_user_id,displayName:identity.display_name,roles:['REPORTER'],resolverTeamIds:[]});});const mark=responses.length;
   await browser.evaluate('globalThis.__releaseAuthority()');await browser.waitFor('globalThis.__authorityStatus===403');assert.equal(roleLossCalls,1);assert.equal(bootstrapAuthenticationBoundary.calls,1);assert.equal(bootstrapAuthenticationBoundary.authenticatedPrincipalId,p.id);assert.deepEqual(await browser.evaluate('globalThis.__stageReads'),[{path:'/api/lifecycle/bootstrap',status:403}]);assert.deepEqual(responses.slice(mark).filter(r=>r.status===401||r.status===403||r.status===404),[{path:'/api/lifecycle/bootstrap',status:403}]);
   await browser.waitFor(`(async()=>{const rows=await (${principalCounts(p.id)});return rows.drafts===0&&rows.operations===0;})()`);assert.equal(await browser.evaluate("Boolean(document.querySelector('textarea'))"),false);assert.deepEqual(await browser.evaluate(snapshot(p.id,b.id)),{revision:null,operation:null});
   assert.equal(Number((await pool.query<{count:string}>('SELECT count(*)::text AS count FROM communication.message WHERE session_id=$1::uuid AND purpose=\'INTERNAL_NOTE\'',[a.id])).rows[0]?.count),0);assert.equal(Number((await pool.query<{count:string}>('SELECT count(*)::text AS count FROM communication.message WHERE session_id=$1::uuid AND purpose=\'HUMAN_REPLY\'',[a.id])).rows[0]?.count),1);
   await access.upsertPrincipal({wecomUserId:identity.wecom_user_id,displayName:identity.display_name,roles:['ADMIN'],resolverTeamIds:['PILOT_IT']});assert.equal((await fetch(origin+'/api/lifecycle/bootstrap',{headers:{cookie}})).status,200);await reload(browser);await browser.waitFor(ready);await select(browser,b.id);await browser.waitFor(ready);assert.equal(await browser.evaluate("document.querySelector('textarea[data-purpose=internal-notes]').value"),'');assert.deepEqual(await browser.evaluate(principalCounts(p.id)),{drafts:0,operations:0});
  }catch(error){failure=error;if(browser){await mkdir(directory);await writeFile(join(directory,'failure.png'),Buffer.from(await browser.screenshot(),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify(await browser.evaluate(`(async()=>({text:document.body.innerText,stageReads:globalThis.__stageReads,rows:await (${principalCounts(p.id)}),other:await (${snapshot(p.id,b.id)})}))()`)));}}
  await closeBrowserTestResources([async()=>{if(browser)await browser.evaluate('globalThis.__releaseBackground?.()');},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});}],failure);
 },{bootstrapRoleRace:true});
});

test('independent object404 after current bootstrap200 purges only that Session and preserves an assigned readable Session draft',async()=>{
 await withT22Fixture(async({origin,browserCookie,cookie,pool,sessions,principals})=>{
  const a=sessions[0],b=sessions[1],p=principals[0];assert.ok(a);assert.ok(b);assert.ok(p);const directory=join(tmpdir(),'web01-ui-'+randomUUID());let browser:Browser|undefined,failure:unknown;
  try{
   const bootstrap=await fetch(origin+'/api/lifecycle/bootstrap',{headers:{cookie}});assert.equal(bootstrap.status,200);const authority=await bootstrap.json() as {csrf_token:string},command={client_command_id:randomUUID(),expected_row_version:b.rowVersion};const takeover=await fetch(origin+'/api/workbench/conversations/'+b.id+'/takeover',{method:'POST',headers:{cookie,origin,'x-csrf-token':authority.csrf_token,'content-type':'application/json','idempotency-key':command.client_command_id,'if-match':'"'+command.expected_row_version+'"'},body:JSON.stringify(command)});assert.equal(takeover.status,200);const ticketBefore=(await pool.query('SELECT assignee_id::text,version FROM pilot_ticket.ticket WHERE id=$1::uuid',[b.ticketId])).rows[0];
   browser=await launchSystemBrowser({url:origin+'/workbench/app/conversations/'+b.id,width:900,height:900,cookies:[{...browserCookie,url:origin+'/'}]});assert.ok(browser);await browser.waitFor(ready);await browser.evaluate(input('internal-notes','T22 still authorized assigned Session draft'));await saved(browser);const before=await browser.evaluate(snapshot(p.id,b.id));
   await select(browser,a.id);await browser.waitFor(ready);await browser.evaluate(input('internal-notes','T22 Session draft to revoke'));await saved(browser);await settle(browser,'T22 settle before object authority rebase');await browser.evaluate(holdAuthority(a.id,'stored'));await browser.evaluate(input('internal-notes','T22 forbidden edit must not persist'));await browser.waitFor('globalThis.__authorityHeld===1');
   const identity=(await pool.query<{wecom_user_id:string;display_name:string}>('SELECT wecom_user_id,display_name FROM pilot_ticket.pilot_principal WHERE id=$1::uuid',[p.id])).rows[0];assert.ok(identity);await createPilotAccessService({pool}).upsertPrincipal({wecomUserId:identity.wecom_user_id,displayName:identity.display_name,roles:['HANDLER'],resolverTeamIds:[]});
   await browser.evaluate('globalThis.__releaseAuthority()');await browser.waitFor('globalThis.__authorityStatus===200&&globalThis.__objectStatus===404');assert.deepEqual(await browser.evaluate('globalThis.__stageReads'),[{path:'/api/lifecycle/bootstrap',status:200},{path:'/api/workbench/conversations/'+a.id,status:404}]);
   assert.equal((await fetch(origin+'/api/lifecycle/bootstrap',{headers:{cookie}})).status,200);const retained=await fetch(origin+'/api/workbench/conversations/'+b.id,{headers:{cookie}});assert.equal(retained.status,200);assert.equal((await retained.json() as {assignment:{assigned_to_me:boolean}}).assignment.assigned_to_me,true);
   await browser.waitFor(`(async()=>{const rows=await (${snapshot(p.id,a.id)});return rows.revision===null&&rows.operation===null;})()`);assert.deepEqual(await browser.evaluate(snapshot(p.id,b.id)),before);assert.equal(await browser.evaluate("document.body.innerText.includes('T22 Session draft to revoke')"),false);
   await browser.command('Page.navigate',{url:origin+'/workbench/app/conversations/'+b.id});await browser.waitFor("document.querySelector('textarea[data-purpose=internal-notes]')?.value==='T22 still authorized assigned Session draft'");assert.deepEqual(await browser.evaluate(snapshot(p.id,b.id)),before);assert.deepEqual((await pool.query('SELECT assignee_id::text,version FROM pilot_ticket.ticket WHERE id=$1::uuid',[b.ticketId])).rows[0],ticketBefore);assert.equal(Number((await pool.query<{count:string}>('SELECT count(*)::text AS count FROM communication.message WHERE session_id=ANY($1::uuid[]) AND purpose=\'INTERNAL_NOTE\'',[sessions.map(s=>s.id)])).rows[0]?.count),0);
  }catch(error){failure=error;if(browser){await mkdir(directory);await writeFile(join(directory,'failure.png'),Buffer.from(await browser.screenshot(),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify(await browser.evaluate(`(async()=>({text:document.body.innerText,stageReads:globalThis.__stageReads,current:await (${snapshot(p.id,a.id)}),other:await (${snapshot(p.id,b.id)})}))()`)));}}
  await closeBrowserTestResources([async()=>{if(browser)await browser.evaluate('globalThis.__releaseBackground?.()');},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});}],failure);
 });
});
