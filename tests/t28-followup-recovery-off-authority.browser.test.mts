import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {createP2016TicketCommandFacade} from '../src/p2-016-ticket-command-facade.mjs';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {prepareFollowup,navigateFollowup,chooseFollowup,rows} from './helpers/t28-followup-source-fixture.mjs';

test('T28 recovery-off business purpose403 preserves the same valid session and parent READ after a real current-assignee transfer',{timeout:240000},async()=>{
  await candidateBrowser({purpose:'t28offauth',reporters:3,recovery:false},async context=>{
    const {http,id,path}=await prepareFollowup(context),actor=text(record(context.f.admin).id),ticket=text(record(context.f.reports[0]).ticketId),tickets=createP2016TicketCommandFacade({pool:context.pool,enabled:true});const assign=async(target:string)=>{const current=await http.get('/api/tickets/'+ticket);assert.equal((await tickets.perform({authContext:{principal_id:text(record(context.f.dispatcher).id)},command:{action:'transfer-assignment',ticket_id:ticket,client_command_id:randomUUID(),expected_version:current.version,reason_code:'WORKBENCH_ASSIGN',target_principal_id:target,resolver_team_id:'PILOT_IT'}})).ok,true);};await assign(actor);const target=rows((await http.get(path+'/reports?limit=30')).items).find(row=>row.ticket_id===ticket);assert.ok(target);await createPilotAccessService({pool:context.pool}).upsertPrincipal({wecomUserId:'synthetic-incident-admin',displayName:'合成管理员',roles:['HANDLER'],resolverTeamIds:['PILOT_IT']});await navigateFollowup(context,id);assert.equal(await context.browser.evaluate('Boolean(document.querySelector("[data-incident-draft]"))'),false);await chooseFollowup(context.browser,'公共故障操作','MARK_REPORTER_RECOVERED');await chooseFollowup(context.browser,'决定原因','RECOVERY_CONFIRMED');await chooseFollowup(context.browser,'关联报修',text(target.id));
    await context.browser.evaluate(`(()=>{const send=fetch;globalThis.fetch=async(input,options)=>{if(options?.method==='POST'&&String(input)===${JSON.stringify(path+'/reports/'+text(target.id)+'/mark-recovered')}){await new Promise(resolve=>{globalThis.__t28ReleaseSend=resolve;});const response=await send(input,options);globalThis.__t28Refusal={status:response.status,body:await response.clone().json()};return response;}return send(input,options);};})()`);await context.browser.waitFor('document.querySelector("[data-action=submit-incident]")?.disabled===false');await context.browser.evaluate('document.querySelector("[data-action=submit-incident]").click()');await context.browser.waitFor('typeof globalThis.__t28ReleaseSend==="function"');await assign(text(record(context.f.handler).id));await context.browser.evaluate('globalThis.__t28ReleaseSend()');await context.browser.waitFor('Boolean(globalThis.__t28Refusal)');assert.equal(record(await context.browser.evaluate('globalThis.__t28Refusal')).status,403);assert.equal((await http.get('/api/lifecycle/bootstrap')).principal_id,actor);assert.equal((await http.read(path)).status,200);await context.browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');
    assert.equal(await context.browser.evaluate('document.body.innerText.includes("会话已失效")||document.body.innerText.includes("会话需要重新核验")'),false,'business purpose denial must not be promoted to global session rejection');await context.browser.waitFor(`Boolean(document.querySelector('[data-incident-id="${id}"]'))`);assert.equal(await context.browser.evaluate('document.querySelector("select[aria-label=公共故障操作]").value'),'');assert.equal((await http.get(path)).row_version,'1');assert.equal(rows((await http.get(path+'/reports?limit=30')).items).find(row=>row.id===target.id)?.impact_state,'IMPACTED');assert.equal(await context.browser.evaluate('indexedDB.databases().then(rows=>rows.some(row=>row.name==="wecom-workbench-drafts-v1"))'),false);
  });
});
