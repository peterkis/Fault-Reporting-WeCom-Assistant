import {test} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import type {IncomingMessage,ServerResponse} from 'node:http';
import type {PostgresPool} from '../app/server/src/platform/postgres-pool.mjs';
import type {P2016EnabledRuntime} from '../app/server/src/p2-016-runtime.mjs';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
type Fixture={pool:PostgresPool;runtime:P2016EnabledRuntime;origin:string;cookies:string[];browserCookies:{name:string;value:string;url:string}[];tickets:{ticket:{id:string}}[];principals:{id:string}[]};
function object(value:unknown):Record<string,unknown>{assert.ok(value&&typeof value==='object'&&!Array.isArray(value));return value as Record<string,unknown>;}
function string(value:unknown):string{assert.equal(typeof value,'string');return value as string;}
async function choose(browser:Browser,label:string,value:string){await browser.waitFor("document.querySelector('[data-action=open-assignment]')?.disabled===false");await browser.evaluate("(()=>{if(!document.querySelector('.detail-assignment-dialog'))document.querySelector('[data-action=open-assignment]').click();})()");await browser.waitFor("Boolean(document.querySelector('.detail-assignment-dialog'))");const select=`Array.from(document.querySelectorAll('.detail-assignment-dialog select')).find(input=>(input.closest('.workbench-select')?[input.closest('.workbench-select').querySelector('[data-slot=label]')]:Array.from(input.labels??[])).some(label=>label.textContent?.includes(${JSON.stringify(label)})))`;await browser.waitFor(`Boolean((${select})&&Array.from((${select}).options).some(option=>option.value===${JSON.stringify(value)}))`);await browser.evaluate(`(()=>{const input=${select};Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(input,${JSON.stringify(value)});input.dispatchEvent(new Event('change',{bubbles:true}));})()`);}
test('disabled persistent recovery keeps UNKNOWN in memory and only explicit reconciliation replays the original assignment UUID and version',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{
  const first=context.tickets[0],owner=context.principals[2],target=context.principals[3],admin=context.cookies[0],cookie=context.cookies[2],browserCookie=context.browserCookies[2];assert.ok(first&&owner&&target&&admin&&cookie&&browserCookie);const path='/api/tickets/'+first.ticket.id;
  const get=async(url:string,current=cookie)=>{const response=await fetch(context.origin+url,{headers:{cookie:current}});return {status:response.status,value:object(await response.json())};};const bootstrap=(await get('/api/lifecycle/bootstrap',admin)).value;assert.equal(bootstrap.ticket_assignment_draft_recovery_enabled,false);const initial={client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_ASSIGN',target_principal_id:owner.id,resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]};assert.equal((await fetch(context.origin+path+'/assign',{method:'POST',headers:{cookie:admin,origin:context.origin,'content-type':'application/json','x-csrf-token':String(bootstrap.csrf_token),'idempotency-key':initial.client_command_id,'if-match':'"2"'},body:JSON.stringify(initial)})).status,200);
  const requests:{method:string;path:string;status:number|null;body:unknown}[]=[];let malformed=true;
  const observe=(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(browserCookie.name+'='+browserCookie.value))return;const url=new URL(request.url??'/',context.origin);if(!url.pathname.startsWith('/api/'))return;const fact={method:request.method??'',path:url.pathname,status:null as number|null,body:null as unknown};requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(fact.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});if(fact.path===path+'/transfer-assignment'){const end=response.end.bind(response);response.end=((...args:Parameters<ServerResponse['end']>)=>malformed&&response.statusCode===200?end('{"ok":true}'):end(...args)) as ServerResponse['end'];}}};
  context.runtime.server.on('request',observe);const directory=join(tmpdir(),'web01-ui-'+randomUUID());await mkdir(directory);const screenshots:{file:string;width:number;height:number;sha256:string}[]=[];let browser:Browser|undefined,primary:unknown;
  try{browser=await launchSystemBrowser({url:context.origin+'/workbench/app/items/ticket/'+first.ticket.id,width:1280,height:900,cookies:[browserCookie]});assert.ok(browser);const active=browser,capture=async(name:string)=>{const bytes=Buffer.from(string(await active.screenshot()),'base64'),file=join(directory,name);await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),width:bytes.readUInt32BE(16),height:bytes.readUInt32BE(20),sha256:createHash('sha256').update(bytes).digest('hex')});};await browser.waitFor("Boolean(document.querySelector('.ticket-assignment'))&&document.querySelector('[data-realtime-status]')?.dataset.realtimeStatus==='live'");assert.equal(await browser.evaluate("Boolean(document.querySelector('[data-assignment-draft-status]'))"),false);assert.deepEqual(await browser.evaluate('indexedDB.databases().then(rows=>rows.map(row=>row.name))'),[]);await choose(browser,'处理组','PILOT_IT');await choose(browser,'处理人',target.id);await browser.evaluate("document.querySelector('.detail-assignment-dialog input[value=RETAIN_CURRENT]').click()");await browser.waitFor("document.querySelector('[data-action=transfer-assignment]').disabled===false");await browser.evaluate("document.querySelector('[data-action=transfer-assignment]').click()");await browser.waitFor("document.querySelector('[data-toast-source=ticket-assignment]')?.innerText.includes('结果未知')&&Boolean(document.querySelector('[data-action=check-assignment-command]'))");assert.equal(requests.filter(row=>row.method==='POST').length,1);const original=object(requests.find(row=>row.method==='POST')?.body);assert.equal(original.expected_version,3);assert.equal((await get(path)).value.version,4);assert.equal((await get(path)).value.assignee_id,target.id);assert.equal(await browser.evaluate("document.querySelector('[data-action=transfer-assignment]').disabled"),true);assert.deepEqual(await browser.evaluate('indexedDB.databases().then(rows=>rows.map(row=>row.name))'),[]);await capture('new-detail-1280.png');malformed=false;await browser.evaluate("document.querySelector('[data-action=check-assignment-command]').click()");await browser.waitFor("document.querySelector('[data-toast-source=ticket-assignment]')?.innerText.includes('责任已交接')");const posts=requests.filter(row=>row.method==='POST');assert.equal(posts.length,2);assert.deepEqual(posts[1]?.body,original);assert.equal(posts[1]?.status,200);assert.equal(requests.some(row=>row.path.includes('/assignment/commands/')),false);assert.equal((await get(path)).value.version,4);assert.equal((await context.pool.query("SELECT count(*)::int AS n FROM pilot_ticket.ticket_event WHERE ticket_id=$1::uuid AND event_type='ticket.assignment_transferred'",[first.ticket.id])).rows[0]?.n,2);assert.deepEqual(await browser.evaluate('indexedDB.databases().then(rows=>rows.map(row=>row.name))'),[]);await capture('new-detail-page-1280.png');const diagnostic=join(tmpdir(),'t06-memory-browser-diagnostic-'+randomUUID()+'.json');await writeFile(diagnostic,JSON.stringify({requests,screenshots}));console.log('T06_BROWSER_DIAGNOSTIC '+JSON.stringify({file:diagnostic.replaceAll('\\','/')}));console.log('WEB01_BROWSER '+JSON.stringify({api:'REAL_LOOPBACK_HTTP_PG',staff_handler:true,persistent_recovery_disabled:true,original_uuid_explicit_replay:true,screenshots}));
  }catch(error){primary=error;console.error('T06_BROWSER_PRIMARY '+JSON.stringify({message:error instanceof Error?error.message:String(error)}));console.error('T06_BROWSER_FAILURE_DIR '+JSON.stringify({directory:directory.replaceAll('\\','/')}));}
  await closeBrowserTestResources([async()=>{if(primary&&browser){await writeFile(join(directory,'failure.png'),Buffer.from(string(await browser.screenshot()),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify({primary:primary instanceof Error?primary.message:String(primary),requests,page:await browser.evaluate('({text:document.body.innerText,url:location.pathname})')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{context.runtime.server.removeListener('request',observe);assert.equal((await context.runtime.observability.metrics()).sse_clients,0);}],primary);
 },{ticketAssignmentEnabled:true,workbenchDraftRecoveryEnabled:false,workbenchRealtimeEnabled:true});
});
