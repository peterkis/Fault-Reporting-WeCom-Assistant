  const directory=join(tmpdir(),'t12-opaque-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;const screenshots:{file:string;sha256:string}[]=[];f.runtime.server.on('request',observe);
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[{...cookie,url:text(cookie.url)}]});assert.ok(browser);await browser.waitFor("document.querySelector('.ticket-takeover-completion select')?.options.length>2&&document.querySelector('.ticket-takeover-completion select').disabled===false");await browser.evaluate("(()=>{const element=document.querySelector('.ticket-takeover-completion select');Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(element,'T07_NETWORK');element.dispatchEvent(new Event('change',{bubbles:true}));})()");await browser.waitFor("document.querySelector('.ticket-takeover-completion fieldset').disabled===false");await browser.evaluate("document.querySelector('.ticket-takeover-completion input[value=RETAIN_CURRENT]').click()");await input(browser,'#takeover-completion-process','T12_OPAQUE_PRIVATE_CANARY');await input(browser,'#takeover-completion-summary','服务恢复，独立合成摘要。');await browser.waitFor("document.querySelector('#takeover-completion-confirmed').disabled===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");await browser.waitFor("document.querySelector('[data-action=takeover-and-complete]').disabled===false");await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').click()");await browser.waitFor("document.querySelector('.ticket-takeover-completion')?.innerText.includes('结果未知')");
   const posts=network.filter(row=>row.method==='POST');assert.equal(posts.length,1);const original=object(posts[0]?.body),before=object(await browser.evaluate(stored));assert.equal(rows(before.drafts).length,1);assert.equal(rows(before.operations)[0]?.commandId,original.client_command_id);assert.equal((await s.b.get(s.path)).value.status,'CLOSED');assert.equal((await s.b.get(s.path)).value.version,version(initial.version)+2);
   unavailable=mode==='context-503';await browser.command('Page.enable');if(mode==='expired')await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:'(()=>{const now=Date.now;Date.now=()=>now()+86400001;})()'});const timeOrigin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${timeOrigin}&&document.readyState==='complete'`);await browser.waitFor("document.querySelector('[data-action=check-takeover-completion]')?.disabled===false&&document.querySelector('.ticket-takeover-completion')?.innerText.includes('结果未知')");
   const after=object(await browser.evaluate(stored));assert.equal(rows(after.operations).length,1);assert.equal(rows(after.operations)[0]?.commandId,original.client_command_id);assert.deepEqual(Object.keys(rows(after.operations)[0]??{}).sort(),['commandId','createdAt','id','kind','principal','purpose','scope']);assert.equal(await browser.evaluate("Boolean(document.querySelector('#takeover-completion-process')?.value)||Boolean(document.querySelector('#takeover-completion-summary')?.value)"),false);assert.equal(network.filter(row=>row.method==='POST').length,1);assert.equal(network.some(row=>row.path.includes('/takeover-completion/commands/')),false);
   if(mode==='expired'){assert.deepEqual(after.drafts,[]);assert.ok(await browser.evaluate("['过期','敏感恢复内容不可用'].some(text=>document.querySelector('[data-takeover-completion-draft-status]').textContent.includes(text))"));}else{assert.ok(faults>0);assert.deepEqual(after,before,'temporary read outage preserves byte-identical cipher and original opaque operation');assert.ok(await browser.evaluate("document.querySelector('[data-takeover-completion-draft-status]').textContent.includes('核验暂时不可用')"));}
   unavailable=false;await browser.evaluate("document.querySelector('[data-action=check-takeover-completion]').click()");await browser.waitFor("document.querySelector('.ticket-takeover-completion')?.innerText.includes('已核对原操作')");assert.equal(network.filter(row=>row.method==='POST').length,1);assert.equal(network.filter(row=>row.method==='GET'&&row.path===s.path+'/takeover-completion/commands/'+original.client_command_id).length,1);assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal((await s.b.get(s.path)).value.version,version(initial.version)+2);
  }catch(error){primary=error;}
  await closeBrowserTestResources([async()=>{if(browser){await browser.evaluate("document.querySelector('.ticket-takeover-completion')?.scrollIntoView({block:'center'})");const bytes=Buffer.from(text(await browser.screenshot()),'base64'),file=join(directory,primary?'failure.png':'opaque-reconciled.png');await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),sha256:createHash('sha256').update(bytes).digest('hex')});await writeFile(join(directory,'page.json'),JSON.stringify(await browser.evaluate('({text:document.body.innerText})')));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);const file=join(directory,'receipt.json');await writeFile(file,JSON.stringify({mode,faults,network,screenshots,primary_failure:primary instanceof Error?primary.message:null}));console.log('T12_OPAQUE_DIAGNOSTIC '+JSON.stringify({file:file.replaceAll('\\','/'),screenshots}));}],primary);
 },{recoveryEnabled:true,notesEnabled:false});
