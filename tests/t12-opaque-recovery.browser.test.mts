async function input(browser:Browser,selector:string,value:string){await browser.evaluate(`(()=>{const element=document.querySelector(${JSON.stringify(selector)});Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(element,${JSON.stringify(value)});element.dispatchEvent(new Event('input',{bubbles:true}));})()`);}
const stored="new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result.filter(row=>row.purpose==='ticket-takeover-completion').map(row=>({purpose:row.purpose,revision:row.revision,cipher:Array.from(new Uint8Array(row.ciphertext))})),operations:operations.result.filter(row=>row.purpose==='ticket-takeover-completion')});};};})";
for(const mode of ['expired','context-503'] as const)test('T12 original UNKNOWN remains manually readable through '+mode+' without exposing unverified sensitive input or replacing its UUID',async()=>{
 await withT12Profile(async f=>{
  const s=await acceptedSetup(f);assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_OPAQUE_START'})).status,200);const initial=(await s.b.get(s.path)).value,cookie=f.browserCookies[2];assert.ok(cookie);
  let unavailable=false,faults=0;const network:{method:string;path:string;status:number|null;body:unknown}[]= [];
