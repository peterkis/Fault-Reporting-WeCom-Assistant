import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID} from 'node:crypto';
import {t31Http,record,text} from './helpers/t31-public-progress-fixture.mjs';
import {createP2012IncidentCommandService} from '../src/p2-012-incident-command-service.mjs';
const input=(version:string,summary='合成独立公开摘要')=>({client_command_id:randomUUID(),expected_row_version:version,reason_code:'WORKBENCH_PUBLIC_PROGRESS' as const,summary,preview_confirmed:true as const});
test('T31 exact HTTP input, current purpose, scope, version, UUID competition and stable safe pages use the original ledger',async()=>{
  await t31Http({purpose:'t31http'},async({pool,f,confirm,get,post})=>{
    const incident=await confirm(),path='/api/incidents/'+incident,publish=path+'/publish-update';
    for(const changes of [{summary:''},{summary:' \n\t'},{summary:'x\u0001'},{summary:'x'.repeat(1001)},{summary:'x\ud800'},{preview_confirmed:false},{audience:'GROUP'},{actor_principal_id:text(record(f.admin).id)},{expected_row_version:1}])assert.ok([400,409].includes((await post(publish,{...input('1'),...changes})).status));
    assert.equal((await post(publish,input('1'),0,{'if-match':'W/"1"'})).status,409);assert.equal((await post(publish,input('1'),0,{'idempotency-key':randomUUID()})).status,400);assert.equal((await post(publish,input('1'),0,{'origin':'http://outside.invalid'})).status,403);assert.equal((await post(publish,input('1'),0,{'x-csrf-token':'invalid'})).status,403);
    for(const actor of [2,3]){assert.ok([403,404].includes((await get(path+'/public-progress',actor)).status));assert.ok([403,404].includes((await post(publish,input('1'),actor)).status));}
    const command=input('1'),same=await Promise.all([post(publish,command,1),post(publish,command,1),post(publish,command,1)]);assert.ok(same.every(r=>r.status===200));assert.equal(same.filter(r=>r.body.replayed===false).length,1);assert.ok(same.every(r=>r.body.result_event_id===same[0]?.body.result_event_id));assert.equal((await post(publish,{...command,summary:'异正文'},1)).status,409);
    const receipt=await get(path+'/commands/'+command.client_command_id,1);assert.equal(receipt.status,200);assert.equal(receipt.body.state,'COMMITTED');assert.equal(JSON.stringify(receipt.body).includes(command.summary),false);const foreign=await get(path+'/commands/'+command.client_command_id,0);assert.equal(foreign.status,200);assert.equal(foreign.body.state,'UNKNOWN');assert.ok(!Object.hasOwn(foreign.body,'acknowledgement'));
    const race=await Promise.all([post(publish,input('2','第二条')),post(publish,input('2','竞争正文'))]);assert.deepEqual(race.map(r=>r.status).sort(),[200,409]);
    const first=(await get(path+'/public-progress?limit=1')).body;assert.ok(Array.isArray(first.items));assert.equal(first.items.length,1);assert.equal(record(first.items[0]).incident_row_version,'2');const cursor=text(first.next_cursor),second=(await get(path+'/public-progress?limit=1&cursor='+encodeURIComponent(cursor))).body;assert.ok(Array.isArray(second.items));assert.equal(second.items.length,1);assert.equal(second.next_cursor,null);assert.equal(record(second.items[0]).incident_row_version,'3');assert.equal((await get(path+'/public-progress?cursor='+encodeURIComponent(cursor),1)).status,400);
    for(const query of ['limit=31','limit=1&limit=2','state=ACTIVE'])assert.equal((await get(path+'/public-progress?'+query)).status,400);
    const publication=text(record(first.items[0]).id),routes=(await get(path+'/public-progress/'+publication+'/deliveries?limit=1')).body;assert.ok(Array.isArray(routes.items));assert.equal(routes.items.length,1);const next=(await get(path+'/public-progress/'+publication+'/deliveries?limit=1&cursor='+encodeURIComponent(text(routes.next_cursor)))).body;assert.ok(Array.isArray(next.items));assert.equal(next.items.length,1);assert.equal(next.next_cursor,null);assert.notEqual(record(routes.items[0]).id,record(next.items[0]).id);assert.equal((await get(path+'/public-progress/'+publication+'/deliveries?cursor='+encodeURIComponent(text(routes.next_cursor)),1)).status,400);
    const service=createP2012IncidentCommandService({pool,enabled:true,publicProgressEnabled:true}),result=await service.perform({authContext:{principal_id:text(record(f.admin).id)},command:{...input('3','默认公开Port'),action:'PUBLISH_PUBLIC_PROGRESS',incident_id:incident}});assert.equal(result.ok,true);
    assert.equal((await post(path+'/correct-scope',{client_command_id:randomUUID(),expected_row_version:'4',reason_code:'SCOPE_CORRECTION',confirmed_scope:'CAMPUS'})).status,200);assert.equal((await post(publish,input('5'),1)).status,403);assert.equal((await get(path+'/commands/'+command.client_command_id,1)).status,403);
    const count=(await pool.query<{count:string}>("SELECT count(*)::text AS count FROM incident.incident_event WHERE incident_id=$1::uuid AND event_type='incident.public_progress_published'",[incident])).rows[0];assert.equal(count?.count,'3');
  });
});
test('T31 default-off host refuses the new routes and advertises no recovery capability',async()=>{
  await t31Http({purpose:'t31off',publication:false},async({confirm,get,post})=>{const incident=await confirm();const bootstrap=(await get('/api/lifecycle/bootstrap')).body;assert.equal(bootstrap.incident_public_progress_enabled,false);assert.equal(bootstrap.incident_public_progress_draft_recovery_enabled,false);assert.equal((await get('/api/incidents/'+incident+'/public-progress')).status,404);assert.equal((await post('/api/incidents/'+incident+'/publish-update',input('1'))).status,404);});
});
