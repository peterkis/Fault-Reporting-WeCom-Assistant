import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';
import {enabledIncidentBrowser} from './helpers/t28-enabled-browser-fixture.mjs';
import {prepareFollowup,navigateFollowup,chooseFollowup,rows} from './helpers/t28-followup-source-fixture.mjs';
import {record,text} from './helpers/wbint-t27-browser-fixture.mjs';

test('T28 one genuine SSE stream refreshes all active Incident children without replacing captured input or emitting a command',{timeout:240000},async()=>{
  await enabledIncidentBrowser({purpose:'t28realtime',realtime:true,reporters:3},async context=>{
    const {http,id,path}=await prepareFollowup(context);let live=0,total=0;context.server.on('request',(request,response)=>{if(new URL(request.url??'/',context.origin).pathname==='/api/realtime/events'){live++;total++;response.on('close',()=>live--);}});
    await navigateFollowup(context,id);await context.browser.waitFor('document.querySelector("[data-realtime-status]")?.dataset.realtimeStatus==="live"');assert.equal(live,1);await chooseFollowup(context.browser,'公共故障操作','CORRECT_SCOPE');await chooseFollowup(context.browser,'决定原因','SCOPE_CORRECTION');await chooseFollowup(context.browser,'确认范围','BUILDING');const before=rows((await http.get(path+'/events?limit=30')).items),reads=await context.browser.evaluate('globalThis.__t27DomainReads');assert.ok(Array.isArray(reads));const counts=(part:string)=>reads.filter(value=>typeof value==='string'&&new URL(value,context.origin).pathname===path+'/'+part).length;
    const start={client_command_id:randomUUID(),expected_row_version:'1',reason_code:'OPERATOR_REVIEWED'};await http.post(path+'/start-investigating',start);await context.browser.waitFor('document.body.innerText.includes("已捕获公共故障版本 1；当前版本 2")');
    const after=await context.browser.evaluate('globalThis.__t27DomainReads');assert.ok(Array.isArray(after));for(const part of ['reports','events','subscriptions','linkable-reports'])assert.ok(after.filter(value=>typeof value==='string'&&new URL(value,context.origin).pathname===path+'/'+part).length>counts(part),'shared controller refreshes '+part);
    assert.equal(await context.browser.evaluate('document.querySelector("select[aria-label=公共故障操作]").value'),'CORRECT_SCOPE');assert.equal(await context.browser.evaluate('document.querySelector("select[aria-label=确认范围]").value'),'BUILDING');assert.equal(await context.browser.evaluate('document.querySelector("[data-action=submit-incident]").disabled'),true);assert.equal(rows(await context.browser.evaluate('globalThis.__t27Posts')).filter(row=>String(row.path).startsWith(path+'/')).length,1);const events=rows((await http.get(path+'/events?limit=30')).items);assert.equal(events.length,before.length+1);assert.equal(events.filter(row=>row.event_type==='incident.investigating').length,1);assert.equal(total,1);assert.equal(live,1);
    // The fixture closes the native browser and runtime; the outer PG wrapper verifies clients/pools/extras0.
    console.log('T28_SSE '+JSON.stringify({actual_streams:total,live_streams:live,automatic_posts:0,max_sse_clients:32}));
  });
});

test('T28 genuine realtime reauthorization fences a held committed POST after purpose-only role loss without reviving input or UNKNOWN',{timeout:240000},async()=>{
  await enabledIncidentBrowser({purpose:'t28latepost',realtime:true,recovery:true,reporters:3},async context=>{
    const {http,id,path}=await prepareFollowup(context);await navigateFollowup(context,id);await context.browser.waitFor('document.querySelector("[data-realtime-status]")?.dataset.realtimeStatus==="live"&&document.querySelector("[data-incident-draft]")?.textContent.includes("最长24小时")');await chooseFollowup(context.browser,'公共故障操作','CORRECT_SCOPE');await chooseFollowup(context.browser,'决定原因','SCOPE_CORRECTION');await chooseFollowup(context.browser,'确认范围','BUILDING');
    await context.browser.evaluate(`(()=>{const send=fetch;globalThis.fetch=async(input,options)=>{const response=await send(input,options);if(options?.method==='POST'&&String(input)===${JSON.stringify(path+'/correct-scope')}){globalThis.__t28HeldCommit={status:response.status,body:await response.clone().json()};await new Promise(resolve=>{globalThis.__t28ReleaseCommit=resolve;});globalThis.__t28CommitReleased=true;}return response;};})()`);await context.browser.waitFor('document.querySelector("[data-action=submit-incident]")?.disabled===false');await context.browser.evaluate('document.querySelector("[data-action=submit-incident]").click()');await context.browser.waitFor('Boolean(globalThis.__t28HeldCommit)');assert.equal(record(await context.browser.evaluate('globalThis.__t28HeldCommit')).status,200);const post=rows(await context.browser.evaluate('globalThis.__t27Posts')).find(row=>String(row.path)===path+'/correct-scope');assert.ok(post);const command=record(JSON.parse(text(post.body)));
    await createPilotAccessService({pool:context.pool}).upsertPrincipal({wecomUserId:'synthetic-incident-admin',displayName:'合成管理员',roles:['DISPATCHER'],resolverTeamIds:['PILOT_IT']});assert.equal((await http.read(path+'/commands/'+text(command.client_command_id))).status,403);assert.equal((await http.read(path)).status,200);await context.browser.waitFor('document.querySelector("[data-incident-outcome]")?.textContent.includes("权限不可用")');let copies:Record<string,unknown>={};for(let i=0;i<100;i++){copies=record(await context.browser.evaluate(candidateCopies));if(rows(copies.drafts).filter(row=>row.kind==='incident'&&row.id===id).length===0&&rows(copies.operations).filter(row=>row.kind==='incident'&&row.id===id).length===0)break;await new Promise<void>(resolve=>setTimeout(resolve,50));}assert.equal(rows(copies.drafts).filter(row=>row.kind==='incident'&&row.id===id).length,0);assert.equal(rows(copies.operations).filter(row=>row.kind==='incident'&&row.id===id).length,0);
    await context.browser.evaluate('globalThis.__t28ReleaseCommit()');await context.browser.waitFor('globalThis.__t28CommitReleased===true');await context.browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await context.browser.evaluate('Boolean(document.querySelector("[data-incident-unknown]"))'),false);assert.equal(await context.browser.evaluate('document.querySelector("[data-incident-outcome]")?.textContent.includes("已提交")'),false);assert.equal(await context.browser.evaluate('document.querySelector("select[aria-label=公共故障操作]").value'),'');assert.equal(await context.browser.evaluate('Boolean(document.querySelector(".entry-state"))'),false);assert.equal(rows(await context.browser.evaluate('globalThis.__t27Posts')).filter(row=>String(row.path).startsWith(path+'/')).length,1);assert.equal((await http.get(path)).row_version,'2');const final=record(await context.browser.evaluate(candidateCopies));assert.equal(rows(final.drafts).filter(row=>row.kind==='incident'&&row.id===id).length,0);assert.equal(rows(final.operations).filter(row=>row.kind==='incident'&&row.id===id).length,0);
  });
});
