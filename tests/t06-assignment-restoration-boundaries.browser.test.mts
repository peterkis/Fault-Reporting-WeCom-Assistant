for(const mode of modes)test('production assignment preserves safe explicit choices at '+mode,async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{
  const first=context.tickets[0],actor=context.principals[1],target=context.principals[3],admin=context.cookies[0],cookie=context.cookies[2],browserCookie=context.browserCookies[2];assert.ok(first&&actor&&target&&admin&&cookie&&browserCookie);const path='/api/tickets/'+first.ticket.id;
  const get=async(url:string,current=cookie)=>{const response=await fetch(context.origin+url,{headers:{cookie:current}});return {status:response.status,value:object(await response.json())};};
  const bootstrap=(await get('/api/lifecycle/bootstrap',admin)).value,initial={client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_ASSIGN',target_principal_id:actor.id,resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]};assert.equal((await fetch(context.origin+path+'/assign',{method:'POST',headers:{cookie:admin,origin:context.origin,'content-type':'application/json','x-csrf-token':String(bootstrap.csrf_token),'idempotency-key':initial.client_command_id,'if-match':'"2"'},body:JSON.stringify(initial)})).status,200);
  await context.runtime.coordinator.runOnce();const source=rows((await get(path+'/related-conversations')).value.items)[0];assert.ok(source);const sessionId=string(source.session_id);
  const requests:{method:string;path:string;status:number|null;body:unknown}[]=[];let unavailable=false,faults=0;
  const observe=(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(browserCookie.name+'='+browserCookie.value))return;const url=new URL(request.url??'/',context.origin);if(!url.pathname.startsWith('/api/'))return;const fact={method:request.method??'',path:url.pathname,status:null as number|null,body:null as unknown};requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(fact.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});}
   if(unavailable&&fact.method==='GET'&&fact.path===path+'/assignment-targets'&&url.searchParams.get('resolver_team_id')==='PILOT_IT'){const end=response.end.bind(response);response.end=((...args:Parameters<ServerResponse['end']>)=>{if(response.statusCode!==200)return end(...args);faults++;response.statusCode=503;return end(JSON.stringify({error:{code:'P2_016_ACTION_FAILED',retryable:false}}));}) as ServerResponse['end'];}
  };context.runtime.server.on('request',observe);const directory=join(tmpdir(),'web01-ui-'+randomUUID());await mkdir(directory);const screenshots:{file:string;width:number;height:number;sha256:string}[]=[];let browser:Browser|undefined,primary:unknown,gate:PostgresPoolClient|null=null;
  try{
   browser=await launchSystemBrowser({url:context.origin+'/workbench/app/items/ticket/'+first.ticket.id,width:1280,height:900,cookies:[browserCookie]});assert.ok(browser);const active=browser,capture=async(name:string)=>{const bytes=Buffer.from(string(await active.screenshot()),'base64'),file=join(directory,name);await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),width:bytes.readUInt32BE(16),height:bytes.readUInt32BE(20),sha256:createHash('sha256').update(bytes).digest('hex')});};
   const reload=async()=>{const timeOrigin=await active.evaluate('performance.timeOrigin');await active.command('Page.enable');await active.command('Page.reload');await active.waitFor(`performance.timeOrigin!==${timeOrigin}&&document.readyState==='complete'&&Boolean(document.querySelector('.ticket-assignment'))`);};
   await browser.waitFor("Boolean(document.querySelector('.ticket-assignment'))&&document.querySelector('[data-realtime-status]')?.dataset.realtimeStatus==='live'");await choose(browser,'处理组','PILOT_IT');await choose(browser,'处理人',target.id);await browser.evaluate("document.querySelector('.ticket-assignment input[value=TRANSFER_SELECTED]').click()");await browser.waitFor(`Boolean(document.querySelector('.ticket-assignment [data-session-choice="${sessionId}"]'))`);await browser.evaluate(`document.querySelector('.ticket-assignment [data-session-choice="${sessionId}"]').click()`);await browser.waitFor("document.querySelector('[data-assignment-draft-status]')?.textContent.includes('已保存恢复副本')&&document.querySelector('[data-action=transfer-assignment]').disabled===false");const encrypted=object(await browser.evaluate(stored));assert.ok(Array.isArray(encrypted.drafts)&&encrypted.drafts.length===1);assert.equal(requests.filter(row=>row.method==='POST').length,0);
   if(mode==='version-conflict'){
    gate=await context.pool.connect();await gate.query('BEGIN');await gate.query('SELECT id FROM pilot_ticket.ticket WHERE id=$1::uuid FOR NO KEY UPDATE',[first.ticket.id]);const pid=(await gate.query<{pid:number}>('SELECT pg_backend_pid() AS pid')).rows[0]?.pid;assert.ok(pid);await browser.evaluate("document.querySelector('[data-action=transfer-assignment]').click()");let reached=false;const until=Date.now()+5000;while(Date.now()<until){const waiting=await context.pool.query("SELECT 1 FROM pg_stat_activity WHERE datname=current_database() AND wait_event_type='Lock' AND $1::int=ANY(pg_blocking_pids(pid)) AND query LIKE '%FOR UPDATE OF t%'",[pid]);if(waiting.rowCount){reached=true;break;}await new Promise(resolve=>setTimeout(resolve,20));}assert.ok(reached,'the original production command must freeze v3 and reach the real Ticket lock');
    const authorization=createPilotWorkbenchAuthorizationAdapter({pool:context.pool});await createTicketActionService({authorize:async input=>{const current=await authorization.resolvePrincipal({principal_id:actor.id},{queryable:input.transaction});return ticketActionAllowedP2016(current,input.ticket,input.action);}}).performInTransaction({ticketId:first.ticket.id,action:'add-note',actor:{type:'PILOT_USER',id:actor.id},expectedVersion:3,reasonCode:'T06_CONFLICT_NOTE',note:'Synthetic internal note establishes a real concurrent v4.',externalVisible:false,traceId:'t06-conflict'},gate);await gate.query('COMMIT');gate.release();gate=null;await browser.waitFor("document.querySelector('.ticket-assignment')?.innerText.includes('操作冲突')");assert.equal(requests.filter(row=>row.method==='POST').length,1);assert.equal(requests.find(row=>row.method==='POST')?.status,409);assert.equal(await browser.evaluate(`(${select('处理组')}).value`),'PILOT_IT');assert.equal(await browser.evaluate(`(${select('处理人')}).value`),target.id);assert.equal(await browser.evaluate(`document.querySelector('[data-session-choice="${sessionId}"]').checked`),true);await capture('new-detail-1280.png');await browser.waitFor("document.querySelector('[data-action=transfer-assignment]').disabled===false");await browser.evaluate("document.querySelector('[data-action=transfer-assignment]').click()");await browser.waitFor("document.querySelector('.ticket-assignment')?.innerText.includes('责任已交接')");const posts=requests.filter(row=>row.method==='POST');assert.equal(posts.length,2);const original=object(posts[0]?.body),retry=object(posts[1]?.body);assert.equal(original.expected_version,3);assert.equal(retry.expected_version,4);assert.notEqual(retry.client_command_id,original.client_command_id);assert.deepEqual(retry.sessions,original.sessions);assert.equal(posts[1]?.status,200);assert.equal((await get(path)).value.version,5);
   }else if(mode==='selected-session-revoked'){
    await context.pool.query("DELETE FROM pilot_ticket.pilot_team_member WHERE principal_id=$1::uuid AND team_id='PILOT_IT'",[actor.id]);assert.equal((await get(path)).status,200,'Ticket remains readable through the actual current owner');assert.equal((await get('/api/conversations/'+sessionId)).status,404);await reload();await browser.waitFor("document.querySelector('[data-assignment-draft-status]')?.textContent.includes('恢复副本已清理')");assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal(await browser.evaluate(`(${select('处理组')}).value`),'');assert.equal(await browser.evaluate("Boolean(document.querySelector('.ticket-assignment input[value=TRANSFER_SELECTED]:checked'))"),false);assert.equal(requests.filter(row=>row.method==='POST').length,0);assert.equal((await get(path)).value.version,3);await capture('new-detail-1280.png');
   }else{
    unavailable=true;await reload();await browser.waitFor("document.querySelector('[data-assignment-draft-status]')&&!document.querySelector('[data-assignment-draft-status]').textContent.includes('正在核对')&&document.querySelector('.ticket-assignment [role=alert]')");assert.ok(faults>0);assert.equal(await browser.evaluate(`(${select('处理组')}).value`),'');assert.equal(requests.filter(row=>row.method==='POST').length,0);const during=object(await browser.evaluate(stored));console.log('T06_TEMPORARY_RESTORE '+JSON.stringify({actual_503:faults>0,encrypted_before:encrypted.drafts,encrypted_after:during.drafts}));assert.deepEqual(during,encrypted,'temporary selection lookup failure must keep the exact encrypted copy without showing or posting it');await capture('new-detail-1280.png');unavailable=false;await reload();await browser.waitFor(`(${select('处理组')}).value==='PILOT_IT'&&(${select('处理人')}).value===${JSON.stringify(target.id)}&&document.querySelector('[data-session-choice="${sessionId}"]')?.checked===true`);assert.equal(requests.filter(row=>row.method==='POST').length,0);assert.deepEqual(object(await browser.evaluate(stored)),encrypted);await browser.waitFor("document.querySelector('[data-action=transfer-assignment]').disabled===false");await browser.evaluate("document.querySelector('[data-action=transfer-assignment]').click()");await browser.waitFor("document.querySelector('.ticket-assignment')?.innerText.includes('责任已交接')");assert.equal(requests.filter(row=>row.method==='POST').length,1);assert.equal((await get(path)).value.assignee_id,target.id);
   }
   await capture('new-detail-page-1280.png');const diagnostic=join(tmpdir(),'t06-restoration-boundary-diagnostic-'+randomUUID()+'.json');await writeFile(diagnostic,JSON.stringify({mode,requests,faults,screenshots},null,2));console.log('T06_BROWSER_DIAGNOSTIC '+JSON.stringify({file:diagnostic.replaceAll('\\','/')}));console.log('WEB01_BROWSER '+JSON.stringify({api:'REAL_LOOPBACK_HTTP_PG',staff_handler:true,safe_explicit_choices:true,screenshots}));
  }catch(error){primary=error;console.error('T06_BROWSER_PRIMARY '+JSON.stringify(failure(error)));console.error('T06_BROWSER_FAILURE_DIR '+JSON.stringify({directory:directory.replaceAll('\\','/')}));}
  await closeBrowserTestResources([async()=>{if(gate){await gate.query('ROLLBACK');gate.release();gate=null;}},async()=>{if(primary&&browser){await writeFile(join(directory,'failure.png'),Buffer.from(string(await browser.screenshot()),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify({primary:failure(primary),requests,page:await browser.evaluate('({text:document.body.innerText,url:location.pathname})')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{context.runtime.server.removeListener('request',observe);assert.equal((await context.runtime.observability.metrics()).sse_clients,0);}],primary);
 },{ticketAssignmentEnabled:true,ticketSelfHandlingWebSource:false,workbenchDraftRecoveryEnabled:true,workbenchRealtimeEnabled:true});
});
