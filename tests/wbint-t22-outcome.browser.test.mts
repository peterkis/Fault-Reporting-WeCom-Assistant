import {test} from 'node:test';
import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {tmpdir} from 'node:os';
import {randomUUID} from 'node:crypto';
import {withT22Fixture,appendT22LiveItem} from './helpers/wbint-t22-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
import {createCommunicationDeliveryWorker} from '../app/server/src/p2-004-communication-delivery-worker.mjs';
import type {ConversationTextCommand} from '../contracts/workbench_conversation_workspace_contracts.js';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
const ready="document.querySelectorAll('[data-conversation-draft]').length===2&&Array.from(document.querySelectorAll('[data-conversation-draft]')).every(e=>e.textContent.includes('草稿仅在当前浏览器'))";
const input=(purpose:string,value:string)=>`(()=>{const input=document.querySelector('textarea[data-purpose="${purpose}"]');Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(input,${JSON.stringify(value)});input.dispatchEvent(new Event('input',{bubbles:true}));})()`;
const recordPosts="(()=>{globalThis.__t22Commands=[];const original=fetch;globalThis.fetch=(path,options)=>{if(String(path).endsWith('/messages')&&options?.method==='POST')globalThis.__t22Commands.push(JSON.parse(options.body));return original(path,options);};})()";
async function reload(browser:Browser){const before=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${before}&&document.readyState==='complete'`);}
async function saved(browser:Browser,purpose:string){await browser.waitFor(`document.querySelector('[data-conversation-draft="${purpose}"]').textContent.includes('已保存恢复副本')`);}
function snapshot(principal:string,id:string){const scope=JSON.stringify([principal,'conversation',id,'conversation-reply']);return `new Promise((resolve,reject)=>{const request=indexedDB.open('wecom-workbench-drafts-v1',2);request.onerror=()=>reject(request.error);request.onsuccess=()=>{const db=request.result,tx=db.transaction(['drafts','operations'],'readonly'),record=tx.objectStore('drafts').get(${JSON.stringify(scope)}),operation=tx.objectStore('operations').get(${JSON.stringify(scope)});tx.oncomplete=()=>{resolve({record:record.result?{extractable:record.result.key.extractable,algorithm:record.result.key.algorithm.name,ttl:record.result.expiresAt-record.result.firstSavedAt,cipherBytes:record.result.ciphertext.byteLength}:null,operation:operation.result?.commandId??null});db.close();};};})`;}

test('the real reply draft keeps its original unknown command after new material, isolates session and purpose, and expires to GET-only receipt recovery',async()=>{
 await withT22Fixture(async({origin,browserCookie,pool,sessions,principals,restoreResponses,runtime})=>{
  const session=sessions[0],other=sessions[1],principal=principals[0];assert.ok(session);assert.ok(other);assert.ok(principal);let browser:Browser|undefined,failure:unknown,posts=0;const directory=join(tmpdir(),'web01-ui-'+randomUUID());
  runtime.server.on('request',request=>{if(request.method==='POST'&&request.url?.endsWith('/messages'))posts++;});
  try{browser=await launchSystemBrowser({url:origin+'/workbench/app/conversations/'+session.id,width:900,height:900,cookies:[{...browserCookie,url:origin+'/'}]});assert.ok(browser);await browser.waitFor(ready);await browser.evaluate(recordPosts);
   const capability=await browser.evaluate("fetch('/api/lifecycle/bootstrap').then(r=>r.json())") as Record<string,unknown>;assert.equal(capability.internal_notes_enabled,false);assert.equal(capability.draft_recovery_enabled,false);assert.equal(capability.conversation_workspace_enabled,true);assert.equal(capability.conversation_draft_recovery_enabled,true);
   await browser.evaluate(input('internal-notes','T22 isolated note recovery'));await saved(browser,'internal-notes');await browser.evaluate(input('messages',' T22 immutable unknown reply '));await saved(browser,'messages');await browser.evaluate("document.querySelector('[data-action=send-conversation-reply]').click()");await browser.waitFor("document.querySelector('[data-reply-outcome]').textContent.includes('结果未知')");
   const original=await browser.evaluate('globalThis.__t22Commands[0]') as ConversationTextCommand;assert.equal(original.text,'T22 immutable unknown reply');assert.equal(original.expected_row_version,session.rowVersion);
   const encrypted=await browser.evaluate(snapshot(principal.id,session.id)) as {record:{extractable:boolean;algorithm:string;ttl:number;cipherBytes:number}|null;operation:string|null};assert.ok(encrypted.record);assert.equal(encrypted.record.extractable,false);assert.equal(encrypted.record.algorithm,'AES-GCM');assert.equal(encrypted.record.ttl,86400000);assert.ok(encrypted.record.cipherBytes>16&&encrypted.record.cipherBytes<=16400);assert.equal(encrypted.operation,original.client_command_id);
   await appendT22LiveItem(pool,session.id,'T22 later authoritative material');await pool.query('UPDATE conversation.session SET row_version=row_version+1,generation_version=generation_version+1 WHERE id=$1::uuid',[session.id]);
   await browser.command('Page.enable');await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:recordPosts});await browser.command('Page.navigate',{url:origin+'/workbench/app/conversations/'+other.id});await browser.waitFor(ready);assert.equal(await browser.evaluate("document.querySelector('textarea[data-purpose=messages]').value"),'');assert.equal(await browser.evaluate("document.querySelector('textarea[data-purpose=internal-notes]').value"),'');
   await browser.command('Page.navigate',{url:origin+'/workbench/app/conversations/'+session.id});await browser.waitFor("document.querySelector('[data-reply-outcome]').textContent.includes('结果未知')&&document.querySelector('textarea[data-purpose=messages]').value===' T22 immutable unknown reply '");assert.equal(await browser.evaluate("document.querySelector('textarea[data-purpose=internal-notes]').value"),'T22 isolated note recovery');assert.equal(await browser.evaluate('globalThis.__t22Commands.length'),0);
   const beforeExpiry=posts;await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:'(()=>{const now=Date.now;Date.now=()=>now()+86400001;})()'});await reload(browser);await browser.waitFor("document.querySelector('[data-action=check-messages]')&&document.querySelector('[data-conversation-draft=messages]').textContent.includes('草稿已过期')");assert.equal(await browser.evaluate("document.querySelector('textarea[data-purpose=messages]').value"),'');assert.equal(await browser.evaluate("document.querySelector('[data-action=send-conversation-reply]').disabled"),true);
   assert.deepEqual(await browser.evaluate(snapshot(principal.id,session.id)),{record:null,operation:original.client_command_id});restoreResponses();await browser.evaluate("document.querySelector('[data-action=check-messages]').click()");await browser.waitFor("document.querySelector('[data-reply-outcome]').textContent.includes('已受理发送')");assert.equal(posts,beforeExpiry);assert.equal(await browser.evaluate('globalThis.__t22Commands.length'),0);
   const messages=await pool.query<{id:string;client_command_id:string;plain_text:string}>('SELECT id::text,client_command_id::text,content->>\'text\' AS plain_text FROM communication.message WHERE session_id=$1::uuid AND purpose=\'HUMAN_REPLY\'',[session.id]);assert.equal(messages.rows.length,1);assert.equal(messages.rows[0]?.client_command_id,original.client_command_id);assert.equal(messages.rows[0]?.plain_text,original.text);
  }catch(error){failure=error;try{if(browser){await mkdir(directory);await writeFile(join(directory,'failure.png'),Buffer.from(await browser.screenshot(),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify(await browser.evaluate('({text:document.body.innerText,commands:globalThis.__t22Commands})')));}}catch(diagnosticFailure){failure=new AggregateError([failure,diagnosticFailure],'BROWSER_FAILURE_DIAGNOSTICS');}}
  await closeBrowserTestResources([async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});}],failure);
 },{dropResponses:true});
});

test('real communication controls and an internal note retain separate Ticket facts, and each synthetic Sender Port delivery displays its own final result',async()=>{
 await withT22Fixture(async({origin,browserCookie,pool,sessions})=>{
  const session=sessions[0];assert.ok(session);let browser:Browser|undefined,failure:unknown;const directory=join(tmpdir(),'web01-ui-'+randomUUID());
  try{const ticketBefore=(await pool.query('SELECT assignee_id::text,version FROM pilot_ticket.ticket WHERE id=$1::uuid',[session.ticketId])).rows[0];browser=await launchSystemBrowser({url:origin+'/workbench/app/conversations/'+session.id,width:1920,height:1080,cookies:[{...browserCookie,url:origin+'/'}]});assert.ok(browser);await browser.waitFor(ready);await browser.evaluate("document.querySelector('[data-action=takeover-conversation]').click()");await browser.waitFor("document.querySelector('[aria-label=沟通责任]').textContent.includes('我负责沟通')");assert.deepEqual((await pool.query('SELECT assignee_id::text,version FROM pilot_ticket.ticket WHERE id=$1::uuid',[session.ticketId])).rows[0],ticketBefore);
   await browser.evaluate(input('internal-notes','T22 internal note never delivered'));await saved(browser,'internal-notes');await browser.evaluate("document.querySelector('[data-action=save-conversation-note]').click()");await browser.waitFor("document.querySelector('[data-note-outcome]').textContent.includes('已保存内部备注')");
   const note=(await pool.query<{id:string}>('SELECT id::text FROM communication.message WHERE session_id=$1::uuid AND purpose=\'INTERNAL_NOTE\'',[session.id])).rows[0];assert.ok(note);assert.equal(Number((await pool.query<{count:string}>('SELECT count(*)::text AS count FROM communication.outbox WHERE message_id=$1::uuid',[note.id])).rows[0]?.count),0);
   const states=['SENT','RECONCILIATION_REQUIRED','DEAD_LETTER'] as const,replies:{message:string;delivery:string;text:string;state:string}[]=[];
   for(const [index,state] of states.entries()){
    const text='T22 exact reply '+(index+1);await browser.evaluate(input('messages',text));await saved(browser,'messages');await browser.evaluate("document.querySelector('[data-action=send-conversation-reply]').click()");await browser.waitFor("document.querySelector('[data-reply-outcome]').textContent.includes('已受理发送')&&document.querySelector('textarea[data-purpose=messages]').value===''");
    const row:{message:string;delivery:string}|undefined=(await pool.query<{message:string;delivery:string}>('SELECT m.id::text AS message,d.id::text AS delivery FROM communication.message m JOIN communication.outbox o ON o.message_id=m.id JOIN communication.delivery d ON d.outbox_id=o.id WHERE m.session_id=$1::uuid AND m.content->>\'text\'=$2',[session.id,text])).rows[0];assert.ok(row);replies.push({...row,text,state});
    const worker=createCommunicationDeliveryWorker({pool,enabled:true,sender:{send:async()=>state==='SENT'?{outcome:'ACKNOWLEDGED',provider_message_id:'t22-synthetic-ack',error_code:null,retryable:false}:state==='RECONCILIATION_REQUIRED'?{outcome:'UNKNOWN',provider_message_id:null,error_code:'T22_SYNTHETIC_UNKNOWN',retryable:false}:{outcome:'REJECTED_NOT_APPLIED',provider_message_id:null,error_code:'T22_SYNTHETIC_REJECTED',retryable:false}}});await worker.deliver({deliveryId:row.delivery});assert.equal((await pool.query<{status:string}>('SELECT status FROM communication.delivery WHERE id=$1::uuid',[row.delivery])).rows[0]?.status,state);
   }
   for(const row of replies){const label=row.state==='SENT'?'已发送':row.state==='DEAD_LETTER'?'发送失败':'发送结果未知';await browser.waitFor(`document.querySelector('[data-delivery-message="${row.message}"] [data-delivery-id="${row.delivery}"]').textContent.includes(${JSON.stringify(label)})`);}
   assert.equal(await browser.evaluate("document.querySelectorAll('[data-conversation-deliveries] [data-delivery-message]').length"),3);assert.deepEqual((await pool.query('SELECT assignee_id::text,version FROM pilot_ticket.ticket WHERE id=$1::uuid',[session.ticketId])).rows[0],ticketBefore);
  }catch(error){failure=error;try{if(browser){await mkdir(directory);await writeFile(join(directory,'failure.png'),Buffer.from(await browser.screenshot(),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify(await browser.evaluate('({text:document.body.innerText})')));}}catch(diagnosticFailure){failure=new AggregateError([failure,diagnosticFailure],'BROWSER_FAILURE_DIAGNOSTICS');}}
  await closeBrowserTestResources([async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});}],failure);
 });
});



