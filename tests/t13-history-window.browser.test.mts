import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {tmpdir} from 'node:os';
import type {IncomingMessage,ServerResponse} from 'node:http';
import type {P2016EnabledRuntime} from '../src/p2-016-runtime.mjs';
import {withT13Profile} from './helpers/t13-profile-fixture.mjs';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {acceptedSetup,object,rows,text,version} from './helpers/t07-public-fixture.mjs';
import type {T07Fixture} from './helpers/t07-public-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';

const section='[aria-label="接单与交接链"]';
const clickHistory=(label:string)=>`Array.from(document.querySelectorAll(${JSON.stringify(section+' button')})).find(button=>button.textContent===${JSON.stringify(label)}).click()`;
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
type RequestFact={method:string;path:string;status:number|null};
async function screenshot(browser:Browser,directory:string){const bytes=Buffer.from(await browser.screenshot(),'base64'),file=join(directory,randomUUID()+'.png');await writeFile(file,bytes);return {file:file.replaceAll('\\','/'),width:bytes.readUInt32BE(16),height:bytes.readUInt32BE(20),sha256:createHash('sha256').update(bytes).digest('hex')};}

test('production keyset pages retain at most 200 of 205 real serial responsibility facts and explicitly reload the current first page',async()=>{
 await withT13Profile(async f=>{
  const s=await acceptedSetup(f);let current=version(s.before.version);
  for(let index=0;index<204;index++){const target=index%2===0?s.actor.id:s.owner.id,result=await s.a.post(s.path+'/transfer-assignment',{client_command_id:randomUUID(),expected_version:current,reason_code:'T13_REAL_PAGING',target_principal_id:target,resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]});assert.equal(result.status,200,JSON.stringify({index,value:result.value}));current=version(result.value.ticket_version);}
  assert.equal((await f.pool.query("SELECT count(*)::integer AS n FROM pilot_ticket.ticket_event WHERE ticket_id=$1::uuid AND event_type IN ('ticket.accepted','ticket.assignment_transferred')",[s.first.ticket.id])).rows[0]?.n,205);
  const cookie=f.browserCookies[0];assert.ok(cookie?.url);const requests:RequestFact[]=[];
  const observe=(request:IncomingMessage,response:ServerResponse)=>{const fact={method:request.method??'',path:request.url??'',status:null as number|null};if(fact.path.startsWith('/api/'))requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});};f.runtime.server.on('request',observe);
  const directory=join(tmpdir(),'ss010-ui-'+randomUUID()),diagnostics=join(tmpdir(),'t13-diag-'+randomUUID());await mkdir(directory);await mkdir(diagnostics);const screenshots:Awaited<ReturnType<typeof screenshot>>[]=[];let browser:Browser|undefined,primary:unknown;
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1920,height:1080,cookies:[{...cookie,url:cookie.url}]});assert.ok(browser);await browser.waitFor('document.querySelectorAll("[data-assignment-history-row]").length===20');
   for(let page=1;page<=10;page++){await browser.waitFor(`Array.from(document.querySelectorAll(${JSON.stringify(section+' button')})).some(button=>button.textContent==='加载后续记录'&&!button.disabled)`);await browser.evaluate(clickHistory('加载后续记录'));const loaded=page<10?(page+1)*20:185;await browser.waitFor(`document.querySelectorAll('[data-assignment-history-row]').length===${loaded}`);assert.equal(await browser.evaluate('document.querySelectorAll("[data-assignment-history-row]").length'),loaded);}
   const shown=text(await browser.evaluate(`document.querySelector(${JSON.stringify(section)}).innerText`));assert.ok(shown.includes('已加载 185 条责任记录')&&shown.includes('仅为当前已读取范围'));assert.ok(!shown.includes('首次接单'));assert.equal(await browser.evaluate(`Array.from(document.querySelectorAll(${JSON.stringify(section+' button')})).some(button=>button.textContent==='加载后续记录')`),false);
   const pages=requests.filter(row=>row.method==='GET'&&row.path.startsWith(s.path+'/assignment-history')&&row.status===200);assert.equal(pages.length,11);assert.ok(pages.every(row=>new URL(row.path,f.origin).searchParams.get('limit')==='20'));assert.equal(new Set(pages.map(row=>row.path)).size,11);assert.equal(requests.filter(row=>row.method==='POST').length,0);
   await browser.evaluate(clickHistory('重新读取接单链'));await browser.waitFor(`document.querySelectorAll('[data-assignment-history-row]').length===20&&document.querySelector(${JSON.stringify(section)}).innerText.includes('首次接单')`);assert.ok(text(await browser.evaluate(`document.querySelector(${JSON.stringify(section)}).innerText`)).includes('已加载 20 条责任记录'));
   screenshots.push(await screenshot(browser,directory));
  }catch(error){primary=error||new Error('T13_PAGING_NON_ERROR',{cause:error});}
  await closeBrowserTestResources([async()=>{if(primary&&browser){screenshots.push(await screenshot(browser,directory));await writeFile(join(diagnostics,'failure.json'),JSON.stringify({requests,page:await browser.evaluate('document.body.innerText')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);},async()=>{const receipt=join(diagnostics,'receipt.json');await writeFile(receipt,JSON.stringify({realSerialResponsibilityFacts:205,retainedRows:185,reloadRows:20,requests,screenshots,primary:primary instanceof Error?primary.message:null}));console.log('SS010_BROWSER '+JSON.stringify({task:'WBINT-T13_PAGING',file:receipt.replaceAll('\\','/'),screenshots}));}],primary);
 });
});

interface RealFixture extends Omit<T07Fixture,'runtime'>{runtime:P2016EnabledRuntime;backendOrigin:string;certificateSpki:string;sessionId:string;browserCookies:{name:string;value:string;url:string;httpOnly:boolean;secure:boolean;sameSite:string}[]}
test('a held actual history 200 cannot restore rows after the current real synthetic session cookie is revoked through production logout',async()=>{
 await withWeb01Fixture(async(f:RealFixture)=>{
  const first=f.tickets[0],cookie=f.cookies[0];assert.ok(first&&cookie);const path='/api/tickets/'+first.ticket.id,historyPath=path+'/assignment-history',get=async(route:string)=>fetch(f.backendOrigin+route,{headers:{cookie,connection:'close'}});
  const bootstrapResponse=await get('/api/lifecycle/bootstrap');assert.equal(bootstrapResponse.status,200);const bootstrap=object(await bootstrapResponse.json());assert.equal(bootstrap.assignment_history_enabled,true);
  const initialResponse=await get(path);assert.equal(initialResponse.status,200);const initial=object(await initialResponse.json()),command=randomUUID(),start=await fetch(f.backendOrigin+path+'/take-and-start',{method:'POST',headers:{cookie,connection:'close',origin:f.origin,'content-type':'application/json','x-csrf-token':text(bootstrap.csrf_token),'idempotency-key':command,'if-match':'"'+version(initial.version)+'"'},body:JSON.stringify({client_command_id:command,expected_version:initial.version,reason_code:'T13_CURRENT_SESSION_SETUP',resolver_team_id:initial.resolver_team_id})});assert.equal(start.status,200);assert.equal(rows(object(await (await get(historyPath)).json()).items).length,1);
  const requests:RequestFact[]=[],hold:{enabled:boolean;reached:boolean;release:(()=>void)|null}={enabled:false,reached:false,release:null};
  const observe=(request:IncomingMessage,response:ServerResponse)=>{const fact={method:request.method??'',path:request.url??'',status:null as number|null};if(fact.path.startsWith('/api/')||fact.path==='/workbench/logout')requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(hold.enabled&&fact.method==='GET'&&new URL(fact.path,f.backendOrigin).pathname===historyPath){const end=response.end.bind(response);response.end=((...args:Parameters<ServerResponse['end']>)=>{if(response.statusCode!==200)return end(...args);hold.enabled=false;hold.reached=true;hold.release=()=>{hold.release=null;end(...args);};return response;}) as ServerResponse['end'];}};f.runtime.server.on('request',observe);
  const directory=join(tmpdir(),'ss010-ui-'+randomUUID()),diagnostics=join(tmpdir(),'t13-diag-'+randomUUID());await mkdir(directory);await mkdir(diagnostics);const screenshots:Awaited<ReturnType<typeof screenshot>>[]=[];let browser:Browser|undefined,primary:unknown;
  try{
   browser=await launchSystemBrowser({url:f.origin+'/synthetic-start',certificateSpki:f.certificateSpki,width:1280,height:900,cookies:f.browserCookies});assert.ok(browser);await browser.command('Page.navigate',{url:f.origin+'/workbench/app/items/ticket/'+first.ticket.id});await browser.waitFor('document.querySelectorAll("[data-assignment-history-row]").length===1');
   await browser.evaluate(`(()=>{const original=fetch;globalThis.__t13LateFinished=false;globalThis.__t13Logout=[];globalThis.fetch=async(route,options)=>{try{const response=await original(route,options);if(String(route)==='/workbench/logout')globalThis.__t13Logout.push({status:response.status,body:await response.clone().json()});return response;}finally{if(String(route).startsWith(${JSON.stringify(historyPath)}))globalThis.__t13LateFinished=true;}};})()`);hold.enabled=true;await browser.evaluate(clickHistory('重新读取接单链'));
   for(let attempt=0;attempt<100&&!hold.reached;attempt++)await new Promise(resolve=>setTimeout(resolve,20));assert.equal(hold.reached,true,'explicit production reload reached and held its actual current-authorized HTTP 200');assert.equal((await get(historyPath)).status,200);
   await browser.evaluate("document.querySelector('[data-action=logout-workbench]').click()");await browser.waitFor("globalThis.__t13Logout.length===1&&!document.querySelector('[data-assignment-history-row]')");assert.deepEqual(await browser.evaluate('globalThis.__t13Logout'),[{status:200,body:{logged_out:true}}]);hold.release?.();await browser.waitFor('globalThis.__t13LateFinished===true');await browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(section)}))||Boolean(document.querySelector('[data-assignment-history-row]'))`),false);
   for(const route of ['/api/lifecycle/bootstrap',path,historyPath])assert.equal((await get(route)).status,401);assert.equal((await f.pool.query('SELECT state FROM pilot_ticket.workbench_auth_session WHERE session_id=$1::uuid',[f.sessionId])).rows[0]?.state,'REVOKED');assert.equal(requests.filter(row=>row.method==='POST'&&row.path.startsWith('/api/tickets/')).length,0);assert.equal(requests.filter(row=>row.path==='/workbench/logout'&&row.status===200).length,1);screenshots.push(await screenshot(browser,directory));
  }catch(error){primary=error||new Error('T13_CURRENT_SESSION_NON_ERROR',{cause:error});}
  await closeBrowserTestResources([async()=>{hold.release?.();},async()=>{if(primary&&browser){screenshots.push(await screenshot(browser,directory));await writeFile(join(diagnostics,'failure.json'),JSON.stringify({heldActual200:hold.reached,requests,page:await browser.evaluate('document.body.innerText')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);},async()=>{const receipt=join(diagnostics,'receipt.json');await writeFile(receipt,JSON.stringify({heldActual200:hold.reached,realSyntheticSessionCookie:true,requests,screenshots,primary:primary instanceof Error?primary.message:null}));console.log('SS010_BROWSER '+JSON.stringify({task:'WBINT-T13_CURRENT_SESSION',file:receipt.replaceAll('\\','/'),screenshots}));}],primary);
 },{realWorkbenchAuthentication:true,ticketSelfHandlingEnabled:true,chronologicalTicketEvents:true,workbenchAssignmentHistoryEnabled:true});
});
