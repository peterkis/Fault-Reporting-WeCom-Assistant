import assert from 'node:assert/strict';
import {test} from 'node:test';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';

test('T27 a direct real success settles its original recovery and keeps its committed UUID known when local settlement fails',async()=>{
 for(const failure of [false,true])await candidateBrowser({purpose:failure?'t27ackfault':'t27ack',recovery:true},async({candidateId,browser,root,choose})=>{
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);
  await browser.evaluate(`(()=>{const send=fetch;globalThis.fetch=async(path,options)=>{const response=await send(path,options);if(options?.method==='POST'&&String(path)==='/api/incident-candidates/${candidateId}/start-review')globalThis.__t27ActualAck={status:response.status,body:await response.clone().json(),command:JSON.parse(options.body)};return response;};})()`);
  if(failure)await browser.evaluate("(()=>{globalThis.__t27SettlementFaults=0;globalThis.__t27Delete=IDBObjectStore.prototype.delete;IDBObjectStore.prototype.delete=function(...args){if(this.name==='operations'){globalThis.__t27SettlementFaults++;throw new DOMException('T27_DIRECT_ACK_SETTLEMENT_FAILURE','UnknownError');}return globalThis.__t27Delete.apply(this,args);};})()");
  await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('候选决定已提交')`);const ack=record(await browser.evaluate('globalThis.__t27ActualAck'));assert.equal(ack.status,200);assert.equal(record(ack.body).ok,true);const id=text(record(ack.command).client_command_id),copies=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(copies.operations));
  if(!failure){assert.deepEqual(copies.operations,[],'direct successful acknowledgements must settle the original operation');}
  else{assert.ok(Number(await browser.evaluate('globalThis.__t27SettlementFaults'))>0);assert.equal(copies.operations.length,1);assert.equal(record(copies.operations[0]).commandId,id);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-candidate-outcome]').innerText.includes('清理失败')`),true);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-candidate-outcome]').innerText.includes('结果未知')`),false);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').disabled`),true);await browser.evaluate('IDBObjectStore.prototype.delete=globalThis.__t27Delete');await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('原操作已确认提交')`);assert.deepEqual(record(await browser.evaluate(candidateCopies)).operations,[]);}
  const posts=await browser.evaluate('globalThis.__t27Posts');assert.ok(Array.isArray(posts));assert.equal(posts.length,1);assert.equal(record(JSON.parse(text(record(posts[0]).body))).client_command_id,id);
 });
});
