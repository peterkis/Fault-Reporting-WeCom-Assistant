  const source=rows((await get(path+'/related-conversations')).value.items)[0];assert.ok(source);assert.equal((await post(path+'/accept-for-later-with-conversations',{client_command_id:randomUUID(),expected_version:2,reason_code:'T07_LATE_SETUP',resolver_team_id:'PILOT_IT',communication_choice:'TAKE_SELECTED',sessions:[{session_id:source.session_id,expected_row_version:Number(text(source.session_row_version))}]})).status,200);const before=(await get(path)).value;assert.equal(before.version,3);
  const requests:{method:string;path:string;status:number|null;body:unknown}[]=[];let malformed=mode==='memory-only'||mode==='late-ack';const hold:{release:(()=>void)|null;reached:boolean}={release:null,reached:false};
  const observe=(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(cookie.name+'='+cookie.value))return;const url=new URL(request.url??'/',f.origin).pathname;if(!url.startsWith('/api/')&&url!=='/workbench/logout')return;const fact={method:request.method??'',path:url,status:null as number|null,body:null as unknown};requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(fact.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});}if(url===path+'/takeover-and-start'||url.startsWith(path+'/takeover/commands/')){const end=response.end.bind(response);response.end=((...args:Parameters<ServerResponse['end']>)=>{if(response.statusCode!==200)return end(...args);if(mode==='late-post'&&url===path+'/takeover-and-start'||mode==='late-ack'&&url.startsWith(path+'/takeover/commands/')){hold.reached=true;hold.release=()=>{hold.release=null;end(...args);};return response;}if(malformed&&url===path+'/takeover-and-start'){malformed=false;return end('{"ok":true}');}return end(...args);}) as ServerResponse['end'];}};
  f.runtime.server.on('request',observe);const directory=join(tmpdir(),'t07-late-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;
