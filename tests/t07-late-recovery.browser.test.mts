   }
   if(mode==='memory-only'){
    assert.deepEqual(await browser.evaluate('indexedDB.databases().then(rows=>rows.map(row=>row.name))'),[]);const posts=requests.filter(row=>row.path===path+'/takeover-and-start'&&row.method==='POST');assert.equal(posts.length,1);const original=object(posts[0]?.body);await browser.evaluate("document.querySelector('[data-action=check-takeover-command]').click()");await browser.waitFor("document.querySelector('.ticket-takeover')?.innerText.includes('已接管并开始处理')");const afterPosts=requests.filter(row=>row.path===path+'/takeover-and-start'&&row.method==='POST');assert.equal(afterPosts.length,2);assert.deepEqual(afterPosts[1]?.body,original);assert.equal(requests.some(row=>row.path.includes('/takeover/commands/')),false);assert.equal((await get(path)).value.version,5);assert.deepEqual(await browser.evaluate('indexedDB.databases().then(rows=>rows.map(row=>row.name))'),[]);
   }else{
    assert.equal((await get(path)).value.version,mode==='late-decrypt'?3:5);await browser.evaluate("document.querySelector('[data-action=logout-workbench]').click()");await browser.waitFor("document.body.innerText.includes('已退出，当前浏览器的恢复副本已清理')&&!document.querySelector('.ticket-takeover')");if(mode==='late-decrypt'){await browser.evaluate('globalThis.__releaseTakeoverDecrypt()');await browser.waitFor('globalThis.__takeoverDecryptFinished===true');}else hold.release?.();await browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await browser.evaluate("Boolean(document.querySelector('.ticket-takeover'))||Boolean(document.querySelector('#internal-note'))||document.body.innerText.includes('T07 purpose-safe unsent note')"),false);assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal((await get('/api/lifecycle/bootstrap')).status,401);assert.equal((await f.pool.query('SELECT state FROM pilot_ticket.workbench_auth_session WHERE session_id=$1::uuid',[f.sessionId])).rows[0]?.state,'REVOKED');assert.equal(requests.filter(row=>row.path===path+'/takeover-and-start'&&row.method==='POST').length,mode==='late-decrypt'?0:1);assert.equal(requests.filter(row=>row.path==='/workbench/logout'&&row.status===200).length,1);
   }
   const image=Buffer.from(text(await browser.screenshot()),'base64'),file=join(directory,'terminal.png');await writeFile(file,image);const receipt=join(directory,'receipt.json');await writeFile(receipt,JSON.stringify({mode,requests,formal_production_bundle:true,held_actual_response:hold.reached,screenshot:{file:file.replaceAll('\\','/'),sha256:createHash('sha256').update(image).digest('hex')}}));console.log('T07_LATE_RECOVERY '+JSON.stringify({mode,receipt:receipt.replaceAll('\\','/'),held_actual_response:hold.reached}));
  }catch(error){primary=error;console.error('T07_LATE_PRIMARY '+JSON.stringify({mode,message:error instanceof Error?error.message:String(error),directory:directory.replaceAll('\\','/')}));}
  await closeBrowserTestResources([async()=>{hold.release?.();},async()=>{if(primary&&browser){await writeFile(join(directory,'failure.png'),Buffer.from(text(await browser.screenshot()),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify({requests,page:await browser.evaluate('({text:document.body.innerText,url:location.pathname})')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);}],primary);
