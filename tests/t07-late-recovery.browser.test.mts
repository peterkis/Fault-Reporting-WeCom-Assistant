   await choose();if(raw){const saved=object(await browser.evaluate(stored)),note=rows(saved.drafts).filter(row=>row.purpose==='internal-note');assert.equal(note.length,1);await browser.evaluate("document.querySelector('[data-action=discard-takeover-draft]').click()");await browser.waitFor("document.querySelector('[data-takeover-draft-status]')?.textContent.includes('恢复副本已清理')");const cleared=object(await browser.evaluate(stored));assert.deepEqual(rows(cleared.drafts).filter(row=>row.purpose==='internal-note'),note);assert.equal(rows(cleared.drafts).some(row=>row.purpose==='ticket-takeover'),false);assert.equal(await browser.evaluate("document.querySelector('#internal-note').value"),'T07 purpose-safe unsent note');await choose();}
   if(mode==='late-decrypt'){
    await browser.command('Page.enable');await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:"(()=>{const decrypt=crypto.subtle.decrypt.bind(crypto.subtle);crypto.subtle.decrypt=(...args)=>new TextDecoder().decode(args[0].additionalData).includes('ticket-takeover')?new Promise((resolve,reject)=>{globalThis.__releaseTakeoverDecrypt=()=>decrypt(...args).then(value=>{globalThis.__takeoverDecryptFinished=true;resolve(value);},reject);}):decrypt(...args);})()"});const origin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${origin}&&typeof globalThis.__releaseTakeoverDecrypt==='function'&&Boolean(document.querySelector('[data-action=logout-workbench]'))`);
   }else{
