  const first=f.tickets[0],actor=f.principals[0],cookie=f.browserCookies[0],cookieHeader=f.cookies[0];assert.ok(first&&actor&&cookie&&cookieHeader);await f.pool.query("INSERT INTO pilot_ticket.resolver_team(team_id,display_name) VALUES('T07_NETWORK','合成网络处理组')");assert.equal((await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-0',displayName:'林舟',roles:['ADMIN','HANDLER'],resolverTeamIds:['PILOT_IT','T07_NETWORK']})).id,actor.id);await f.runtime.coordinator.runOnce();const backend=f.backendOrigin??f.origin,path='/api/tickets/'+first.ticket.id;
