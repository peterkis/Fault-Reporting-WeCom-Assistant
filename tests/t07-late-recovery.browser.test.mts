   browser=await launchSystemBrowser({url:f.origin+'/synthetic-start',width:1280,height:900,certificateSpki:f.certificateSpki??null,cookies:raw?f.browserCookies:[cookie]});assert.ok(browser);await browser.command('Page.navigate',{url:f.origin+'/workbench/app/items/ticket/'+first.ticket.id});const active=browser,choose=async()=>{await active.waitFor("document.querySelector('.ticket-takeover select')?.options.length>2&&document.querySelector('.ticket-takeover select').disabled===false");await active.evaluate("(()=>{const input=document.querySelector('.ticket-takeover select');Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(input,'T07_NETWORK');input.dispatchEvent(new Event('change',{bubbles:true}));})()");await active.waitFor("document.querySelector('.ticket-takeover select')?.value==='T07_NETWORK'&&document.querySelector('.ticket-takeover select').disabled===false&&document.querySelector('.ticket-takeover fieldset').disabled===false");await active.evaluate("document.querySelector('.ticket-takeover input[value=RETAIN_CURRENT]').click()");await active.waitFor("document.querySelector('.ticket-takeover [data-action=takeover-and-start]').disabled===false");if(raw)await active.waitFor("document.querySelector('[data-takeover-draft-status]')?.textContent.includes('已保存恢复副本')");};
