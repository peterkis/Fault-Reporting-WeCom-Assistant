import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {http,rows,version} from './helpers/t07-public-fixture.mjs';
import type {T07Fixture} from './helpers/t07-public-fixture.mjs';
test('concurrent original UUIDs have one commit and distinct self takeovers have exactly one legal version without replacing responsibility history',async()=>{
 await withWeb01Fixture(async(f:T07Fixture)=>{
  const actor=f.principals[1],admin=f.principals[0],first=f.tickets[3],second=f.tickets[5];assert.ok(actor&&admin&&first&&second);await f.pool.query("INSERT INTO pilot_ticket.resolver_team(team_id,display_name) VALUES('T07_NETWORK','合成网络处理组')");await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-1',displayName:'陈悦',roles:['HANDLER'],resolverTeamIds:['PILOT_IT','T07_NETWORK']});const a=await http(f,0),b=await http(f,2),path='/api/tickets/'+first.ticket.id,before=(await b.get(path)).value,eventsBefore=(await a.get(path+'/events')).value;
  const original={client_command_id:randomUUID(),expected_version:version(before.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'T07_NETWORK',communication_choice:'RETAIN_CURRENT',sessions:[]};
  const replies=await Promise.all(Array.from({length:3},()=>b.post(path+'/takeover',original)));assert.ok(replies.every(row=>row.status===200));assert.equal(replies.filter(row=>row.value.replayed===false).length,1);assert.equal(new Set(replies.map(row=>row.value.ticket_event_id)).size,1);const stable=(await b.get(path)).value,stableEvents=(await a.get(path+'/events')).value;assert.equal(stable.version,version(before.version)+1);assert.equal(stable.assignee_id,actor.id);assert.equal(stable.resolver_team_id,'T07_NETWORK');assert.equal(stable.status,before.status);const prior=rows(eventsBefore.items),all=rows(stableEvents.items);assert.deepEqual(all.slice(0,prior.length),prior);assert.equal(all.length,prior.length+1);
  assert.equal((await b.post(path+'/takeover',{...original,resolver_team_id:'PILOT_IT'})).status,409);assert.equal((await b.post(path+'/takeover-and-start',original)).status,409);assert.equal((await b.post(path+'/takeover',{...original,client_command_id:randomUUID()})).status,409);assert.deepEqual((await b.get(path)).value,stable);assert.deepEqual((await a.get(path+'/events')).value,stableEvents);
  const competingPath='/api/tickets/'+second.ticket.id,otherBefore=(await a.get(competingPath)).value,otherEvents=(await a.get(competingPath+'/events')).value;
  const competing=await Promise.all([a.post(competingPath+'/takeover',{...original,client_command_id:randomUUID(),expected_version:version(otherBefore.version),resolver_team_id:'PILOT_IT'}),b.post(competingPath+'/takeover',{...original,client_command_id:randomUUID(),expected_version:version(otherBefore.version)})]);assert.deepEqual(competing.map(row=>row.status).sort(),[200,409]);const winner=competing.find(row=>row.status===200);assert.ok(winner);const after=(await a.get(competingPath)).value;assert.equal(after.version,version(otherBefore.version)+1);assert.equal(after.status,'IN_PROGRESS');assert.ok([actor.id,admin.id].includes(String(after.assignee_id)));assert.equal(after.resolver_team_id,after.assignee_id===actor.id?'T07_NETWORK':'PILOT_IT');assert.equal(after.intake_id,otherBefore.intake_id);const otherAll=rows((await a.get(competingPath+'/events')).value.items),otherPrior=rows(otherEvents.items);assert.deepEqual(otherAll.slice(0,otherPrior.length),otherPrior);assert.equal(otherAll.length,otherPrior.length+1);assert.equal(otherAll.at(-1)?.event_id,winner.value.ticket_event_id);assert.equal((await f.pool.query("SELECT count(*)::int AS count FROM pilot_ticket.ticket_command_receipt WHERE ticket_id=$1::uuid AND command_type='WORKBENCH_TICKET_TAKEOVER' AND state='COMMITTED'",[second.ticket.id])).rows[0]?.count,1);console.log('T07_COMMAND_CONCURRENCY '+JSON.stringify({same_uuid_requests:3,same_uuid_commits:1,distinct_uuid_requests:2,distinct_uuid_commits:1,history_appended_once:true}));
 },{ticketTakeoverEnabled:true,chronologicalTicketEvents:true});
});
