import assert from 'node:assert/strict';
import {test} from 'node:test';
import {candidateBrowser,text} from './helpers/wbint-t27-browser-fixture.mjs';
test('T27 real candidate paging keeps only its latest three 30-item pages with honest loaded counts and preserves explicit input across blocked narrow navigation',async()=>{
 await candidateBrowser({purpose:'t27pages',reporters:93,setup:async({f})=>{for(let index=1;index<93;index++)await f.newCandidate(index);}},async({browser,origin})=>{
  await browser.evaluate('document.querySelector("[aria-label=\"返回候选队列\"]").click()');await browser.waitFor('document.querySelectorAll("tbody tr[data-candidate-id]").length===30');assert.equal(await browser.evaluate('document.body.innerText.includes("当前加载 30 个候选；此数量不表示全量公共故障或受影响人数")'),true);
  for(const count of [60,90,63]){await browser.evaluate('Array.from(document.querySelectorAll("button")).find(button=>button.textContent.startsWith("读取下一页")).click()');await browser.waitFor(`document.querySelectorAll('tbody tr[data-candidate-id]').length===${count}`);assert.equal(await browser.evaluate(`document.body.innerText.includes('当前加载 ${count} 个候选；此数量不表示全量公共故障或受影响人数')`),true);}assert.equal(await browser.evaluate('Array.from(document.querySelectorAll("button")).some(button=>button.textContent.startsWith("读取下一页"))'),false);
  await browser.command('Emulation.setDeviceMetricsOverride',{width:600,height:1080,deviceScaleFactor:1,mobile:false});const path=text(await browser.evaluate('document.querySelector("tbody tr[data-candidate-id] a").pathname'));await browser.evaluate('document.querySelector("tbody tr[data-candidate-id] a").click()');await browser.waitFor('Boolean(document.querySelector("select[aria-label=\"人工决定\"]"))');assert.equal(await browser.evaluate('location.pathname'),path);assert.equal(await browser.evaluate('document.activeElement===document.querySelector(".detail-heading h1")'),true);await browser.evaluate('(()=>{const select=document.querySelector("select[aria-label=\"人工决定\"]");select.value="START_REVIEW";select.dispatchEvent(new Event("change",{bubbles:true}));})()');await browser.evaluate('document.querySelector("[aria-label=\"返回候选队列\"]").click()');assert.equal(await browser.evaluate('location.pathname'),path);await browser.evaluate('history.back()');await browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await browser.evaluate('location.pathname'),path);assert.equal(await browser.evaluate('document.querySelector("select[aria-label=\"人工决定\"]").value'),'START_REVIEW');assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);assert.equal(await browser.evaluate('location.origin'),origin);await browser.evaluate('document.querySelector("[data-action=clear-candidate-input]").click()');await browser.evaluate('document.querySelector("[aria-label=\"返回候选队列\"]").click()');await browser.waitFor('document.querySelectorAll("tbody tr[data-candidate-id]").length>0');assert.ok(Number(await browser.evaluate('document.querySelectorAll("tbody tr[data-candidate-id]").length'))<=90);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);
 });
});
