import assert from 'node:assert/strict';
import {test} from 'node:test';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
test('T27 native START then REJECT preserves personal Tickets and Handler reads escaped facts at 600px',async()=>{
 const marker='<img src=x onerror="globalThis.__t27Xss=1">';
 await candidateBrowser({purpose:'t27reject',setup:async({pool,f})=>{const handler=record(f.handler);await createPilotAccessService({pool}).upsertPrincipal({wecomUserId:text(handler.wecom_user_id),displayName:marker,roles:['HANDLER'],resolverTeamIds:['PILOT_IT']});}},async({pool,candidateId,browser,root,choose,started,f,capture,origin})=>{
  const personal=(await pool.query('SELECT id::text,status,version FROM pilot_ticket.ticket ORDER BY id')).rows,events=(await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM pilot_ticket.ticket_event')).rows[0]?.count;
  await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);
  await browser.waitFor(`Array.from(document.querySelector(${JSON.stringify(root)})?.querySelector('select[aria-label="人工决定"]')?.options??[]).some(option=>option.value==='CONFIRM_INCIDENT'&&!option.disabled)`);
  await choose('人工决定','CONFIRM_INCIDENT');assert.equal(await browser.evaluate(`Array.from(document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="故障负责人"]').options).find(option=>option.value===${JSON.stringify(text(record(f.handler).id))})?.textContent`),marker);assert.equal(await browser.evaluate('globalThis.__t27Xss===undefined && document.querySelectorAll("img[src=x]").length===0'),true);
  await choose('人工决定','REJECT_CANDIDATE');await choose('决定原因','INCORRECT_ASSOCIATION');await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('.context-line')?.innerText.includes('已拒绝')`);
  const row=(await pool.query<{status:string;row_version:string;confirmed_incident_id:string|null}>('SELECT status,row_version::text,confirmed_incident_id::text FROM incident.candidate_review WHERE id=$1::uuid',[candidateId])).rows[0];assert.equal(row?.status,'REJECTED');assert.equal(row?.row_version,'3');assert.equal(row?.confirmed_incident_id,null);assert.equal((await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM incident.incident')).rows[0]?.count,0);assert.deepEqual((await pool.query('SELECT id::text,status,version FROM pilot_ticket.ticket ORDER BY id')).rows,personal);assert.equal((await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM pilot_ticket.ticket_event')).rows[0]?.count,events);for(const table of ['communication.message','communication.outbox','communication.delivery'])assert.equal((await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM '+table)).rows[0]?.count,0);
  assert.ok(Array.isArray(started.cookies));const handlerCookie=record(started.cookies[1]);await browser.command('Network.deleteCookies',{name:text(record(started.cookie).name),url:origin});await browser.command('Network.setCookies',{cookies:[handlerCookie]});const fresh=record(await browser.evaluate('fetch("/api/lifecycle/bootstrap").then(response=>response.json())'));assert.equal(fresh.principal_id,text(record(f.handler).id));assert.deepEqual(fresh.roles,['HANDLER']);await browser.command('Page.reload');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.innerText.includes('当前可读取候选，没有人工决定权限。')`);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelectorAll('select[aria-label="人工决定"]').length`),0);assert.equal(await browser.evaluate('globalThis.__t27Xss===undefined && document.querySelectorAll("img[src=x]").length===0'),true);
  await browser.command('Emulation.setDeviceMetricsOverride',{width:600,height:1080,deviceScaleFactor:1,mobile:false});assert.equal(await browser.evaluate('innerWidth'),600);assert.equal(await browser.evaluate('document.documentElement.scrollWidth>innerWidth'),false);await capture();await browser.command('Emulation.setDeviceMetricsOverride',{width:900,height:1080,deviceScaleFactor:1,mobile:false});
 });
});
