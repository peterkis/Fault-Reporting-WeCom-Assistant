import assert from 'node:assert/strict';
import {test} from 'node:test';
import type {IncomingMessage,ServerResponse} from 'node:http';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';

test('T27 a delayed independent restoration authorization cannot replace a newer same-principal public authority or restore its old privileged input',async()=>{
 await candidateBrowser({purpose:'t27restoreauth',recovery:true},async({pool,f,candidateId,browser,root,server,choose})=>{
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);await choose('人工决定','CONFIRM_INCIDENT');await choose('决定原因','CONFIRMED_SHARED_FAULT');await choose('确认范围','HOSPITAL_WIDE');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);const before=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(before.drafts)&&before.drafts.length===1);
  let reads=0,held:Record<string,unknown>|undefined,current:Record<string,unknown>|undefined,release:(()=>void)|undefined;
  const observe=(request:IncomingMessage,response:ServerResponse)=>{if(request.method!=='GET'||request.url!=='/api/incident-candidates/'+candidateId)return;const index=++reads,end=response.end;response.end=(...args:unknown[])=>{if(response.statusCode===200){const raw=args[0];assert.ok(typeof raw==='string'||Buffer.isBuffer(raw));const body=record(JSON.parse(typeof raw==='string'?raw:raw.toString()));if(index===2){held=body;release=()=>{Reflect.apply(end,response,args);};return response;}if(index>2)current=body;}Reflect.apply(end,response,args);return response;};};
  server.on('request',observe);
  try{
   const previous=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${previous}&&Boolean(document.querySelector(${JSON.stringify(root)})?.querySelector('select[aria-label="人工决定"]'))`);for(let i=0;i<100&&!release;i++)await new Promise<void>(resolve=>setTimeout(resolve,50));assert.ok(release&&held,'the independent recovery authorization must be held after the initial public Query has completed');assert.deepEqual(held.roles,['ADMIN']);assert.ok(Array.isArray(held.allowed_scopes)&&held.allowed_scopes.includes('HOSPITAL_WIDE'));assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="人工决定"]').value`),'');
   const admin=record(f.admin);await createPilotAccessService({pool}).upsertPrincipal({wecomUserId:text(admin.wecom_user_id),displayName:text(admin.display_name),roles:['DISPATCHER'],resolverTeamIds:['PILOT_IT']});const fresh=record(await browser.evaluate('fetch("/api/lifecycle/bootstrap").then(response=>response.json())'));assert.equal(fresh.principal_id,admin.id);assert.deepEqual(fresh.roles,['DISPATCHER']);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=refresh-candidate]').click()`);for(let i=0;i<100&&!current;i++)await new Promise<void>(resolve=>setTimeout(resolve,50));assert.ok(current);assert.deepEqual(current.roles,['DISPATCHER']);assert.ok(Array.isArray(current.allowed_scopes)&&!current.allowed_scopes.includes('HOSPITAL_WIDE'));
   release();release=undefined;await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.length>0`);await browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="人工决定"]').value`),'','old privileged recovery input must not be restored after a newer current-authority GET');assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="确认范围"]')?.value??''`),'');assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);console.log('T27_RESTORATION_AUTHORITY '+JSON.stringify({held_roles:held.roles,current_roles:current.roles,same_principal:true,independent_restore_get:true}));
  }finally{release?.();server.off('request',observe);}
 });
});
