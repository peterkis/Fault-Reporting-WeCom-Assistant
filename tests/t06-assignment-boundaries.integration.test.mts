import {test} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import type {PostgresPool} from '../app/server/src/platform/postgres-pool.mjs';
import type {P2016EnabledRuntime} from '../app/server/src/p2-016-runtime.mjs';
type Fixture={pool:PostgresPool;runtime:P2016EnabledRuntime;origin:string;cookies:string[];tickets:{ticket:{id:string}}[];principals:{id:string}[]};
function object(value:unknown):Record<string,unknown>{assert.ok(value&&typeof value==='object'&&!Array.isArray(value));return value as Record<string,unknown>;}
function rows(value:unknown):Record<string,unknown>[]{assert.ok(Array.isArray(value));return value.map(object);}
async function http(context:Fixture,index=0){const cookie=context.cookies[index];assert.ok(cookie);const get=async(path:string)=>{const response=await fetch(context.origin+path,{headers:{cookie}});return {status:response.status,value:object(await response.json())};};const bootstrap=(await get('/api/lifecycle/bootstrap')).value;const post=async(path:string,body:Record<string,unknown>,headers:Record<string,string>={})=>{const response=await fetch(context.origin+path,{method:'POST',headers:{cookie,origin:context.origin,'content-type':'application/json','x-csrf-token':String(bootstrap.csrf_token),'idempotency-key':String(body.client_command_id),'if-match':'"'+body.expected_version+'"',...headers},body:JSON.stringify(body)});return {status:response.status,value:object(await response.json())};};return {get,post,bootstrap};}
function command(target:string,version=2,extra:Record<string,unknown>={}){return {client_command_id:randomUUID(),expected_version:version,reason_code:'WORKBENCH_ASSIGN',target_principal_id:target,resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[],...extra};}
async function facts(context:Fixture,id:string){return {
 ticket:(await context.pool.query('SELECT assignee_id::text,resolver_team_id,status,version,current_handling_cycle_id::text,source_intake_id::text FROM pilot_ticket.ticket WHERE id=$1::uuid',[id])).rows,
 events:(await context.pool.query('SELECT event_id::text,event_type FROM pilot_ticket.ticket_event WHERE ticket_id=$1::uuid ORDER BY event_id',[id])).rows,
 cycles:(await context.pool.query('SELECT id::text,cycle_no,first_responsibility_event_id::text FROM pilot_ticket.ticket_handling_cycle WHERE ticket_id=$1::uuid ORDER BY id',[id])).rows,
 communication:(await context.pool.query('SELECT s.id::text,s.row_version::text,a.assigned_principal_id::text,a.assignment_version::text FROM conversation.session s LEFT JOIN conversation.assignment a ON a.session_id=s.id WHERE s.service_intake_id=(SELECT source_intake_id FROM pilot_ticket.ticket WHERE id=$1::uuid) ORDER BY s.id',[id])).rows,
 controlEvents:(await context.pool.query('SELECT e.id::text FROM conversation.control_event e JOIN conversation.session s ON s.id=e.session_id WHERE s.service_intake_id=(SELECT source_intake_id FROM pilot_ticket.ticket WHERE id=$1::uuid) ORDER BY e.id',[id])).rows,
 bindings:(await context.pool.query('SELECT id::text FROM communication.ticket_notification_binding WHERE ticket_id=$1::uuid ORDER BY id',[id])).rows,
};}

test('default false avoids039 and preserves the independently authorized legacy accept profile',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{const ticket=context.tickets[0],target=context.principals[1];assert.ok(ticket&&target);const a=await http(context),path='/api/tickets/'+ticket.ticket.id;assert.equal(a.bootstrap.ticket_assignment_enabled,false);assert.equal((await context.pool.query("SELECT to_regclass('pilot_ticket.ticket_handling_cycle') AS t")).rows[0]?.t,null);assert.equal(Object.hasOwn((await a.get(path)).value,'handling_cycle'),false);assert.equal((await a.get(path+'/assignment-targets')).status,503);assert.equal((await a.post(path+'/assign',command(target.id))).status,503);assert.equal((await a.post(path+'/accept',{client_command_id:randomUUID(),expected_version:2,reason_code:'T06_LEGACY'})).status,200);});
});
test('explicitly enabled assignment fails closed when039 is missing',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{const ticket=context.tickets[0],target=context.principals[1];assert.ok(ticket&&target);const a=await http(context),path='/api/tickets/'+ticket.ticket.id;assert.equal((await a.get(path+'/assignment-targets')).status,503);assert.equal((await a.post(path+'/assign',command(target.id))).status,503);assert.equal((await context.pool.query('SELECT version,assignee_id FROM pilot_ticket.ticket WHERE id=$1::uuid',[ticket.ticket.id])).rows[0]?.version,2);},{ticketAssignmentEnabled:true,installTicketSelfHandlingSchema:false});
});
test('closed payload and current Origin CSRF UUID and exact Ticket version reject without business writes',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{const ticket=context.tickets[0],target=context.principals[1];assert.ok(ticket&&target);const a=await http(context),path='/api/tickets/'+ticket.ticket.id,before=await facts(context,ticket.ticket.id),valid=command(target.id);
  const invalid=[{...valid,external_visible:true},{...valid,target_principal_id:'vendor-login'},{...valid,expected_version:0},{...valid,resolver_team_id:'unknown team'},{...valid,sessions:[{session_id:randomUUID(),expected_row_version:1}]},{...valid,communication_choice:'TRANSFER_SELECTED',sessions:[]}];
  for(const body of invalid)assert.equal((await a.post(path+'/assign',body)).status,400);
  assert.equal((await a.post(path+'/assign',valid,{'if-match':'"1"'})).status,409);assert.equal((await a.post(path+'/assign',valid,{'idempotency-key':randomUUID()})).status,400);assert.equal((await a.post(path+'/assign',valid,{'x-csrf-token':'invalid'})).status,403);assert.equal((await a.post(path+'/assign',valid,{origin:'https://foreign.invalid'})).status,403);assert.deepEqual(await facts(context,ticket.ticket.id),before);
 },{ticketAssignmentEnabled:true});
});
test('removed target membership role active person or effective group is rejected after discovery',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{const ticket=context.tickets[0],target=context.principals[1];assert.ok(ticket&&target);const a=await http(context),path='/api/tickets/'+ticket.ticket.id,before=await facts(context,ticket.ticket.id);assert.equal((await a.get(path+'/assignment-targets?resolver_team_id=PILOT_IT')).status,200);
  await context.pool.query("DELETE FROM pilot_ticket.pilot_team_member WHERE principal_id=$1::uuid AND team_id='PILOT_IT'",[target.id]);const removed=await a.post(path+'/assign',command(target.id));assert.equal(removed.status,403,JSON.stringify(removed.value));assert.deepEqual(await facts(context,ticket.ticket.id),before);
  await context.pool.query("INSERT INTO pilot_ticket.pilot_team_member(principal_id,team_id) VALUES($1::uuid,'PILOT_IT')",[target.id]);await context.pool.query('DELETE FROM pilot_ticket.pilot_principal_role WHERE principal_id=$1::uuid',[target.id]);assert.equal((await a.post(path+'/assign',command(target.id))).status,403);await context.pool.query("INSERT INTO pilot_ticket.pilot_principal_role(principal_id,role) VALUES($1::uuid,'HANDLER')",[target.id]);
  await context.pool.query('UPDATE pilot_ticket.pilot_principal SET is_active=false WHERE id=$1::uuid',[target.id]);assert.equal((await a.post(path+'/assign',command(target.id))).status,403);await context.pool.query('UPDATE pilot_ticket.pilot_principal SET is_active=true WHERE id=$1::uuid',[target.id]);
  await context.pool.query("UPDATE pilot_ticket.resolver_team SET is_active=false WHERE team_id='PILOT_IT'");assert.equal((await a.post(path+'/assign',command(target.id))).status,403);await context.pool.query("UPDATE pilot_ticket.resolver_team SET is_active=true WHERE team_id='PILOT_IT'");assert.equal((await a.post(path+'/assign',command(target.id,2,{resolver_team_id:'NON_MEMBER_TEAM'}))).status,403);assert.deepEqual(await facts(context,ticket.ticket.id),before);
 },{ticketAssignmentEnabled:true});
});
test('same UUID has one commit, changed intent and stale versions conflict, and two competing assignments have one winner',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{const first=context.tickets[0],other=context.tickets[1],target=context.principals[1],next=context.principals[2];assert.ok(first&&other&&target&&next);const a=await http(context),path='/api/tickets/'+first.ticket.id,original=command(target.id);
  const repeated=await Promise.all(Array.from({length:3},()=>a.post(path+'/assign',original)));assert.ok(repeated.every(row=>row.status===200));assert.equal(repeated.filter(row=>row.value.replayed===false).length,1);assert.equal(new Set(repeated.map(row=>row.value.ticket_event_id)).size,1);const stable=await facts(context,first.ticket.id);
  assert.equal((await a.post(path+'/assign',{...original,target_principal_id:next.id})).status,409);assert.equal((await a.post(path+'/transfer-assignment',command(next.id,2))).status,409);assert.deepEqual(await facts(context,first.ticket.id),stable);
  const winners=await Promise.all([target,next].map(principal=>a.post('/api/tickets/'+other.ticket.id+'/assign',command(principal.id))));assert.deepEqual(winners.map(row=>row.status).sort(),[200,409]);const after=(await a.get('/api/tickets/'+other.ticket.id)).value;assert.equal(after.status,'QUEUED');assert.equal(after.version,4);assert.ok([target.id,next.id].includes(String(after.assignee_id)));assert.equal((await context.pool.query('SELECT count(*)::int AS n FROM pilot_ticket.ticket_handling_cycle WHERE ticket_id=$1::uuid',[other.ticket.id])).rows[0]?.n,1);assert.equal(rows((await a.get('/api/tickets/'+other.ticket.id+'/events')).value.items).filter(row=>row.event_type==='ticket.assignment_transferred').length,1);
 },{ticketAssignmentEnabled:true});
});
test('terminal Ticket neither advertises nor accepts arbitrary transfers through either public assignment path',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{const ticket=context.tickets[9],target=context.principals[1];assert.ok(ticket&&target);const a=await http(context),path='/api/tickets/'+ticket.ticket.id,before=await facts(context,ticket.ticket.id),detail=(await a.get(path)).value;assert.equal(detail.status,'CLOSED');
  const modern=await a.post(path+'/transfer-assignment',command(target.id));const legacy=await a.post(path+'/transfer',{client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_TRANSFER',target_principal_id:target.id,resolver_team_id:'PILOT_IT'});
  console.log('T06_TERMINAL_PUBLIC '+JSON.stringify({new_status:modern.status,legacy_status:legacy.status,allowed_actions:detail.allowed_actions}));assert.deepEqual({advertised:Array.isArray(detail.allowed_actions)&&detail.allowed_actions.includes('transfer-assignment'),new_status:modern.status,legacy_status:legacy.status},{advertised:false,new_status:409,legacy_status:409});assert.deepEqual(await facts(context,ticket.ticket.id),before);
 },{ticketAssignmentEnabled:true});
});
test('external assistance preserves a real internal owner and original WAITING_VENDOR source without creating a cycle',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{const ticket=context.tickets[6],target=context.principals[1];assert.ok(ticket&&target);const a=await http(context),path='/api/tickets/'+ticket.ticket.id,before=(await a.get(path)).value;assert.equal(before.status,'WAITING_VENDOR');assert.notEqual(before.assignee_id,target.id);assert.equal((await a.post(path+'/transfer-assignment',command(target.id))).status,200);const after=(await a.get(path)).value;assert.equal(after.status,'WAITING_VENDOR');assert.equal(after.assignee_id,target.id);assert.equal(after.intake_id,before.intake_id);assert.equal(after.handling_cycle,null);assert.equal((await context.pool.query("SELECT 1 FROM pilot_ticket.pilot_principal_role WHERE principal_id=$1::uuid AND role='HANDLER'",[after.assignee_id])).rowCount,1);assert.equal((await context.pool.query('SELECT count(*)::int AS n FROM pilot_ticket.ticket_handling_cycle WHERE ticket_id=$1::uuid',[ticket.ticket.id])).rows[0]?.n,0);assert.equal(rows((await a.get(path+'/events')).value.items).at(-1)?.event_type,'ticket.assignment_transferred');
 },{ticketAssignmentEnabled:true});
});
test('failure at Ticket responsibility event cycle or COMMITTED receipt rolls all selected communication and Ticket facts back',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{await context.runtime.coordinator.runOnce();const ticket=context.tickets[0],target=context.principals[1];assert.ok(ticket&&target);const a=await http(context),path='/api/tickets/'+ticket.ticket.id,session=rows((await a.get(path+'/related-conversations')).value.items)[0];assert.ok(session);const before=await facts(context,ticket.ticket.id);
  for(const [table,operation,when] of [['pilot_ticket.ticket','UPDATE',`NEW.id='${ticket.ticket.id}'::uuid`],['pilot_ticket.ticket_event','INSERT',`NEW.ticket_id='${ticket.ticket.id}'::uuid AND NEW.event_type='ticket.assignment_transferred'`],['pilot_ticket.ticket_handling_cycle','INSERT',`NEW.ticket_id='${ticket.ticket.id}'::uuid`],['pilot_ticket.ticket_command_receipt','UPDATE',`NEW.ticket_id='${ticket.ticket.id}'::uuid AND NEW.state='COMMITTED'`]] as const){let installed=false;const body=command(target.id,2,{communication_choice:'TRANSFER_SELECTED',sessions:[{session_id:session.session_id,expected_row_version:Number(session.session_row_version)}]});
   try{await context.pool.query("CREATE FUNCTION platform.t06_fail_boundary() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'T06_SYNTHETIC_WRITE_FAILURE'; END $$");await context.pool.query(`CREATE TRIGGER t06_fail_boundary BEFORE ${operation} ON ${table} FOR EACH ROW WHEN (${when}) EXECUTE FUNCTION platform.t06_fail_boundary()`);installed=true;const result=await a.post(path+'/assign',body);assert.equal(result.status,503,JSON.stringify(result.value));assert.equal(object(result.value.error).retryable,false);assert.deepEqual(await facts(context,ticket.ticket.id),before);assert.deepEqual((await context.pool.query('SELECT state FROM pilot_ticket.ticket_command_receipt WHERE client_command_id=$1::uuid',[body.client_command_id])).rows,[{state:'FAILED'}]);assert.equal((await context.pool.query('SELECT 1 FROM conversation.control_event WHERE client_command_id=$1::uuid',[body.client_command_id])).rowCount,0);
   }finally{if(installed)await context.pool.query(`DROP TRIGGER t06_fail_boundary ON ${table}`);await context.pool.query('DROP FUNCTION IF EXISTS platform.t06_fail_boundary()');}
  }
 },{ticketAssignmentEnabled:true,ticketSelfHandlingWebSource:false});
});
