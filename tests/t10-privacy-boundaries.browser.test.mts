import assert from 'node:assert/strict';
import {test} from 'node:test';
import type {IncomingMessage,ServerResponse} from 'node:http';
import {createPilotAccessService} from '../app/server/src/p1-009-pilot-access-workbench.mjs';
import {withT10Fixture} from './helpers/t10-waiting-fixture.mjs';
import {t11Http} from './helpers/t11-completion-fixture.mjs';
import {withT10Browser,fillWaiting} from './helpers/t10-browser-fixture.mjs';

for(const mode of ['cold-raw-off','current-read-revoked'] as const)test('T10 production '+mode+' keeps original UNKNOWN reconciliation within its current read and storage boundary',async()=>{
  await withT10Fixture(async context=>{
    const handler=await t11Http(context,2,{closeConnections:true}),admin=await t11Http(context,0,{closeConnections:true}),target=context.tickets[0];assert.ok(target);await handler.start(target.ticket.id);
    const path='/api/tickets/'+target.ticket.id+'/request-information',requests:{method:string;path:string;status:number|null}[]=[];
    const observe=(request:IncomingMessage,response:ServerResponse)=>{const url=request.url??'';if(url===path||url.startsWith(path+'/commands/')||url==='/api/tickets/'+target.ticket.id){const row={method:request.method??'',path:url,status:null as number|null};requests.push(row);response.once('finish',()=>{row.status=response.statusCode;});}};context.runtime.server.on('request',observe);
    try{await withT10Browser(context,target.ticket.id,0,'T10_PRIVACY_'+mode,async(browser,capture)=>{
      if(mode==='cold-raw-off')assert.deepEqual(await browser.evaluate('indexedDB.databases().then(rows=>rows.map(row=>row.name))'),[]);
      await browser.evaluate(`(()=>{const original=fetch;globalThis.__t10Posts=[];globalThis.__t10Reads=[];globalThis.fetch=async(route,options)=>{const response=await original(route,options);if(!options?.method||options.method==='GET')globalThis.__t10Reads.push({path:String(route),status:response.status});if(String(route)===${JSON.stringify(path)}&&options?.method==='POST'&&response.status===200){globalThis.__t10Posts.push(JSON.parse(options.body));throw new TypeError('T10_ACTUAL_COMMITTED_RESPONSE_LOST');}return response;};})()`);
      await browser.waitFor("document.querySelector('[data-action=request-information]')?.disabled===false");await browser.evaluate("document.querySelector('[data-action=request-information]').click()");const form='form[aria-label="等待补充"]',input=form+' textarea';await browser.waitFor(`Boolean(document.querySelector(${JSON.stringify(input)}))`);await browser.evaluate(fillWaiting(input,'INTERNAL_T10_PRIVACY_CANARY：当前读权边界。'));
      if(mode==='current-read-revoked')await browser.waitFor("document.querySelector('[data-waiting-purpose=request-information] [data-waiting-draft-status]')?.textContent.includes('已保存恢复副本')");
      await browser.waitFor(`!document.querySelector(${JSON.stringify(form+' button[type="submit"]')}).disabled`);await browser.evaluate(`document.querySelector(${JSON.stringify(form+' button[type="submit"]')}).click()`);await browser.waitFor("globalThis.__t10Posts.length===1&&document.body.innerText.includes('结果未知')&&Boolean(document.querySelector('[data-action=check-request-information-command]'))");
      const original=await browser.evaluate('globalThis.__t10Posts[0]') as {client_command_id:string};assert.ok(original.client_command_id);assert.equal(requests.filter(row=>row.method==='POST').length,1);assert.equal(requests.filter(row=>row.path.startsWith(path+'/commands/')).length,0,'UNKNOWN does not automatically reconcile');assert.equal((await admin.detail(target.ticket.id)).status,'WAITING_REQUESTER');
      if(mode==='cold-raw-off'){
        assert.deepEqual(await browser.evaluate('indexedDB.databases().then(rows=>rows.map(row=>row.name))'),[]);await browser.evaluate("document.querySelector('[data-action=check-request-information-command]').click()");await browser.waitFor("document.querySelector('[data-toast-source=ticket-waiting-request-information]')?.innerText.includes('原操作已核对为提交')");assert.deepEqual(requests.filter(row=>row.path.startsWith(path+'/commands/')).map(row=>({method:row.method,path:row.path,status:row.status})),[{method:'GET',path:path+'/commands/'+original.client_command_id,status:200}]);assert.deepEqual(await browser.evaluate('indexedDB.databases().then(rows=>rows.map(row=>row.name))'),[]);
      }else{
        const actor=context.principals[0];assert.ok(actor);const identity=(await context.pool.query<{wecom_user_id:string;display_name:string}>('SELECT wecom_user_id,display_name FROM pilot_ticket.pilot_principal WHERE id=$1::uuid',[actor.id])).rows[0];assert.ok(identity);await createPilotAccessService({pool:context.pool}).upsertPrincipal({wecomUserId:identity.wecom_user_id,displayName:identity.display_name,roles:['HANDLER'],resolverTeamIds:[]});assert.equal((await admin.get('/api/tickets/'+target.ticket.id)).status,404);
        await browser.evaluate("Array.from(document.querySelectorAll('button')).find(button=>button.textContent==='重新读取工单动作').click()");await browser.waitFor(`globalThis.__t10Reads.some(row=>row.path===${JSON.stringify('/api/tickets/'+target.ticket.id)}&&row.status===404)`);await browser.waitFor("!document.querySelector('[data-waiting-purpose]')&&!document.querySelector('#detail-title')");
        const copies="new Promise((resolve,reject)=>{const request=indexedDB.open('wecom-workbench-drafts-v1');request.onerror=()=>reject(request.error);request.onsuccess=()=>{const db=request.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result.filter(row=>row.id==="+JSON.stringify(target.ticket.id)+").length,operations:operations.result.filter(row=>row.id==="+JSON.stringify(target.ticket.id)+").length});};};})";
        await browser.waitFor(`(async()=>{const rows=await (${copies});return rows.drafts===0&&rows.operations===0;})()`);assert.deepEqual(await browser.evaluate(copies),{drafts:0,operations:0});assert.equal(await browser.evaluate("document.body.innerText.includes('INTERNAL_T10_PRIVACY_CANARY')"),false);assert.ok(requests.some(row=>row.path==='/api/tickets/'+target.ticket.id&&row.status===404),'actual current Ticket denial reached the production consumer');
      }
      assert.equal(requests.filter(row=>row.method==='POST').length,1);console.log('T10_PRIVACY_BOUNDARY '+JSON.stringify({mode,originalUuid:original.client_command_id,requests}));await capture('new-detail-1920.png');
    });}finally{context.runtime.server.removeListener('request',observe);}
  },{recoveryEnabled:mode==='current-read-revoked'});
});
