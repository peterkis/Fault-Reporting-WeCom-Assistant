   assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-summary').value"),'服务恢复，独立合成结果。');assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-confirmed').checked"),false,'restored draft requires a new preview confirmation');assert.equal(network.filter(row=>row.method==='POST').length,0);
   await browser.waitFor("document.querySelector('#takeover-completion-confirmed').disabled===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");await browser.waitFor("document.querySelector('[data-action=takeover-and-complete]').disabled===false");obscure=true;await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').click()");await browser.waitFor("document.querySelector('[data-toast-source=ticket-takeover-completion]')?.innerText.includes('结果未确认')");
