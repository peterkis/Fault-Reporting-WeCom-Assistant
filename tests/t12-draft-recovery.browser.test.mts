import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {tmpdir} from 'node:os';
import type {IncomingMessage,ServerResponse} from 'node:http';
import {withT12Profile} from './helpers/t12-profile-fixture.mjs';
import {acceptedSetup,object,rows,text,version} from './helpers/t07-public-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';

type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
async function input(browser:Browser,selector:string,value:string){await browser.evaluate(`(()=>{const element=document.querySelector(${JSON.stringify(selector)});Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(element,${JSON.stringify(value)});element.dispatchEvent(new Event('input',{bubbles:true}));})()`);}
const stored="new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result.filter(row=>row.purpose==='ticket-takeover-completion').map(row=>({purpose:row.purpose,keys:Object.keys(row)})),operations:operations.result.filter(row=>row.purpose==='ticket-takeover-completion')});};};})";

test('independent encrypted T12 recovery reauthorizes saved input, resets preview confirmation, and preserves the original UNKNOWN through closed actions for manual GET only',async()=>{
 await withT12Profile(async f=>{
  const s=await acceptedSetup(f);assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_RECOVERY_START'})).status,200);
  const initial=(await s.b.get(s.path)).value,cookie=f.browserCookies[2];assert.ok(cookie);const bootstrap=(await s.b.get('/api/lifecycle/bootstrap')).value;assert.equal(bootstrap.internal_notes_enabled,false);assert.equal(bootstrap.ticket_takeover_completion_draft_recovery_enabled,true);
  const network:{method:string;path:string;status:number|null;body:unknown}[]= [];let obscure=false;
  const observe=(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(cookie.name+'='+cookie.value))return;const path=new URL(request.url??'/',f.origin).pathname;if(!path.startsWith('/api/'))return;const fact={method:request.method??'',path,status:null as number|null,body:null as unknown};network.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(fact.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});if(obscure&&path===s.path+'/takeover-and-complete'){const end=response.end.bind(response);response.end=((...args:Parameters<ServerResponse['end']>)=>response.statusCode===200?end('{"ok":true}'):end(...args)) as ServerResponse['end'];}}};
  const directory=join(tmpdir(),'t12-recovery-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;const screenshots:{file:string;sha256:string}[]=[];
  f.runtime.server.on('request',observe);
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[{...cookie,url:text(cookie.url)}]});assert.ok(browser);
   await browser.waitFor("document.querySelector('.ticket-takeover-completion select')?.options.length>2&&document.querySelector('.ticket-takeover-completion select').disabled===false");
   assert.equal(await browser.evaluate("Boolean(document.querySelector('[data-takeover-completion-draft-status]'))"),true,'raw-on T12 must expose its own encrypted purpose, independently from Notes');
   await browser.evaluate("(()=>{const element=document.querySelector('.ticket-takeover-completion select');Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(element,'T07_NETWORK');element.dispatchEvent(new Event('change',{bubbles:true}));})()");
   await browser.waitFor("document.querySelector('.ticket-takeover-completion input[value=RETAIN_CURRENT]').disabled===false");await browser.evaluate("document.querySelector('.ticket-takeover-completion input[value=RETAIN_CURRENT]').click()");
   await input(browser,'#takeover-completion-process','T12_ENCRYPTED_PROCESS_CANARY');assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-summary').value"),'','public summary never derives from the private process');await input(browser,'#takeover-completion-summary','服务恢复，独立合成结果。');await browser.waitFor("document.querySelector('#takeover-completion-confirmed').disabled===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");
   await browser.waitFor("document.querySelector('[data-takeover-completion-draft-status]')?.textContent.includes('已保存恢复副本')&&document.querySelector('[data-action=takeover-and-complete]').disabled===false");
   const crypto=object(await browser.evaluate("(async()=>{const row=await new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,read=db.transaction('drafts').objectStore('drafts').getAll();read.onsuccess=()=>{db.close();resolve(read.result.find(row=>row.purpose==='ticket-takeover-completion'));};};});let exportError=null;try{await globalThis.crypto.subtle.exportKey('raw',row.key);}catch(error){exportError=error.name;}return {purpose:row.purpose,extractable:row.key.extractable,algorithm:row.key.algorithm.name,exportError,ttl:row.expiresAt-row.firstSavedAt,bytes:row.ciphertext.byteLength,plaintext:JSON.stringify(row).includes('T12_ENCRYPTED_PROCESS_CANARY')};})()"));
   assert.deepEqual({...crypto,bytes:undefined},{purpose:'ticket-takeover-completion',extractable:false,algorithm:'AES-GCM',exportError:'InvalidAccessError',ttl:86400000,plaintext:false,bytes:undefined});assert.ok(Number(crypto.bytes)<=16400);
   await browser.command('Page.enable');let timeOrigin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${timeOrigin}&&document.readyState==='complete'`);await browser.waitFor("document.querySelector('#takeover-completion-process')?.value==='T12_ENCRYPTED_PROCESS_CANARY'&&document.querySelector('.ticket-takeover-completion input[value=RETAIN_CURRENT]').disabled===false");
   assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-summary').value"),'服务恢复，独立合成结果。');assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-confirmed').checked"),false,'restored draft requires a new preview confirmation');assert.equal(network.filter(row=>row.method==='POST').length,0);
   await browser.waitFor("document.querySelector('#takeover-completion-confirmed').disabled===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");await browser.waitFor("document.querySelector('[data-action=takeover-and-complete]').disabled===false");obscure=true;await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').click()");await browser.waitFor("document.querySelector('[data-toast-source=ticket-takeover-completion]')?.innerText.includes('结果未知')");
   const posts=network.filter(row=>row.method==='POST');assert.equal(posts.length,1);const original=object(posts[0]?.body);assert.equal(original.expected_version,initial.version);assert.equal(original.handling_cycle_id,object(initial.handling_cycle).id);assert.equal(original.internal_process,'T12_ENCRYPTED_PROCESS_CANARY');
   const closed=(await s.b.get(s.path)).value;assert.equal(closed.status,'CLOSED');assert.equal(closed.version,version(initial.version)+2);obscure=false;timeOrigin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${timeOrigin}&&document.readyState==='complete'`);await browser.waitFor("document.querySelector('[data-action=check-takeover-completion]')?.disabled===false&&document.querySelector('[data-toast-source=ticket-takeover-completion]')?.innerText.includes('结果未知')");
   assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-process').value"),'T12_ENCRYPTED_PROCESS_CANARY');assert.equal(await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').disabled"),true);const copy=object(await browser.evaluate(stored)),operations=rows(copy.operations);assert.equal(operations.length,1);assert.equal(operations[0]?.commandId,original.client_command_id);assert.deepEqual(Object.keys(operations[0]??{}).sort(),['commandId','createdAt','id','kind','principal','purpose','scope']);assert.equal(JSON.stringify(operations).includes('T12_ENCRYPTED_PROCESS_CANARY'),false);assert.equal(network.filter(row=>row.method==='POST').length,1);assert.equal(network.some(row=>row.path.includes('/takeover-completion/commands/')),false,'reload is never an automatic command or ACK');
   await browser.evaluate("document.querySelector('[data-action=check-takeover-completion]').click()");await browser.waitFor("document.querySelector('[data-toast-source=ticket-takeover-completion]')?.innerText.includes('已核对原操作')");assert.equal(network.filter(row=>row.method==='POST').length,1);assert.equal(network.filter(row=>row.method==='GET'&&row.path===s.path+'/takeover-completion/commands/'+original.client_command_id).length,1);assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.deepEqual((await s.b.get(s.path)).value,closed);
  }catch(error){primary=error;}
  await closeBrowserTestResources([async()=>{if(browser){await browser.evaluate("document.querySelector('.ticket-takeover-completion')?.scrollIntoView({block:'center'})");const bytes=Buffer.from(text(await browser.screenshot()),'base64'),file=join(directory,primary?'failure.png':'reconciled.png');await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),sha256:createHash('sha256').update(bytes).digest('hex')});await writeFile(join(directory,'page.json'),JSON.stringify(await browser.evaluate('({text:document.body.innerText})')));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);const file=join(directory,'receipt.json');await writeFile(file,JSON.stringify({network,screenshots,primary_failure:primary instanceof Error?primary.message:null}));console.log('T12_RECOVERY_DIAGNOSTIC '+JSON.stringify({file:file.replaceAll('\\','/'),screenshots}));}],primary);
 },{recoveryEnabled:true,notesEnabled:false});
});
