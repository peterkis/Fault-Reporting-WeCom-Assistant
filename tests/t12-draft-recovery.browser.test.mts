   const closed=(await s.b.get(s.path)).value;assert.equal(closed.status,'COMPLETED');assert.equal(closed.version,version(initial.version)+2);obscure=false;timeOrigin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${timeOrigin}&&document.readyState==='complete'`);await browser.waitFor("document.querySelector('[data-action=check-takeover-completion]')?.disabled===false&&document.querySelector('[data-toast-source=ticket-takeover-completion]')?.innerText.includes('结果未确认')");
