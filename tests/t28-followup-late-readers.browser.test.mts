import assert from 'node:assert/strict';
import {test} from 'node:test';
import {createPilotAccessService} from '../app/server/src/p1-009-pilot-access-workbench.mjs';
import {candidateBrowser,record} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';
import {prepareFollowup,navigateFollowup,chooseFollowup,rows} from './helpers/t28-followup-source-fixture.mjs';

async function scopeInput(context:Parameters<typeof navigateFollowup>[0],id:string){await navigateFollowup(context,id);await context.browser.waitFor('document.querySelector("[data-incident-draft]")?.textContent.includes("最长24小时")');await chooseFollowup(context.browser,'公共故障操作','CORRECT_SCOPE');await chooseFollowup(context.browser,'决定原因','SCOPE_CORRECTION');await chooseFollowup(context.browser,'确认范围','BUILDING');await context.browser.waitFor('document.querySelector("[data-incident-draft]")?.textContent.includes("已保存恢复副本")');}
async function zeroCopy(context:Parameters<typeof navigateFollowup>[0],id:string){let value:Record<string,unknown>={};for(let i=0;i<100;i++){value=record(await context.browser.evaluate(candidateCopies));if(rows(value.drafts).filter(row=>row.kind==='incident'&&row.id===id).length===0&&rows(value.operations).filter(row=>row.kind==='incident'&&row.id===id).length===0)break;await new Promise<void>(resolve=>setTimeout(resolve,50));}assert.equal(rows(value.drafts).filter(row=>row.kind==='incident'&&row.id===id).length,0);assert.equal(rows(value.operations).filter(row=>row.kind==='incident'&&row.id===id).length,0);}

test('T28 a held native decrypt restores no admin-only input after a fresh original-purpose authorization denies it',{timeout:240000},async()=>{
  await candidateBrowser({purpose:'t28lateopen',reporters:3,recovery:true},async context=>{
    const {http,id,path}=await prepareFollowup(context);await scopeInput(context,id);const previous=await context.browser.evaluate('performance.timeOrigin');await context.browser.command('Page.addScriptToEvaluateOnNewDocument',{source:'(()=>{const decrypt=crypto.subtle.decrypt.bind(crypto.subtle);let held=false;crypto.subtle.decrypt=(...args)=>{if(held)return decrypt(...args);held=true;return new Promise((resolve,reject)=>{globalThis.__t28ReleaseDecrypt=()=>decrypt(...args).then(value=>{globalThis.__t28DecryptReleased=true;resolve(value);},reject);});};})()'});await context.browser.command('Page.reload');await context.browser.waitFor(`performance.timeOrigin!==${previous}&&typeof globalThis.__t28ReleaseDecrypt==='function'`);
    await createPilotAccessService({pool:context.pool}).upsertPrincipal({wecomUserId:'synthetic-incident-admin',displayName:'合成管理员',roles:['DISPATCHER'],resolverTeamIds:['PILOT_IT']});assert.deepEqual((await http.get(path)).roles,['DISPATCHER']);await context.browser.evaluate('document.querySelector("[data-action=refresh-incident]").click()');assert.equal(await context.browser.evaluate('document.querySelector(".workbench-select[data-field-label=公共故障操作] select")?.value??""'),'');await context.browser.evaluate('globalThis.__t28ReleaseDecrypt()');await context.browser.waitFor('globalThis.__t28DecryptReleased===true');await context.browser.waitFor('document.querySelector("[data-incident-draft]")?.textContent.includes("权限已变化")');await zeroCopy(context,id);assert.equal(await context.browser.evaluate('document.querySelector(".workbench-select[data-field-label=公共故障操作] select").value'),'');assert.equal(rows(await context.browser.evaluate('globalThis.__t27Posts')).length,0);assert.equal((await http.get(path)).row_version,'1');
  });
});

test('T28 a held real broad detail cannot restore owner projection or sensitive recovery after current Incident READ is lost',{timeout:240000},async()=>{
  await candidateBrowser({purpose:'t28latequery',reporters:3,recovery:true},async context=>{
    const {http,id,path}=await prepareFollowup(context);await scopeInput(context,id);await context.browser.evaluate(`(()=>{const send=fetch;let held=false;globalThis.fetch=async(input,options)=>{const response=await send(input,options);if(!held&&String(input)===${JSON.stringify(path)}&&options?.method!=='POST'){held=true;globalThis.__t28HeldDetail={status:response.status,body:await response.clone().json()};await new Promise(resolve=>{globalThis.__t28ReleaseDetail=resolve;});globalThis.__t28DetailReleased=true;}return response;};})()`);await context.browser.evaluate('document.querySelector("[data-action=refresh-incident]").click()');await context.browser.waitFor('Boolean(globalThis.__t28HeldDetail)');const held=record(await context.browser.evaluate('globalThis.__t28HeldDetail'));assert.equal(held.status,200);assert.equal(typeof record(held.body).owner_principal_id,'string');
    await createPilotAccessService({pool:context.pool}).upsertPrincipal({wecomUserId:'synthetic-incident-admin',displayName:'合成管理员',roles:['HANDLER'],resolverTeamIds:[]});assert.equal((await http.read(path)).status,404);await context.browser.evaluate('document.querySelector("[data-action=refresh-incident]").click()');await context.browser.waitFor('document.querySelector("[data-incident-outcome]")?.textContent.includes("权限不可用")');await zeroCopy(context,id);await context.browser.evaluate('globalThis.__t28ReleaseDetail()');await context.browser.waitFor('globalThis.__t28DetailReleased===true');await context.browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await context.browser.evaluate('Boolean(document.querySelector("[data-incident-id]"))'),false);assert.equal(await context.browser.evaluate('Boolean(document.querySelector(".workbench-select[data-field-label=公共故障操作] select"))'),false);await zeroCopy(context,id);assert.equal(rows(await context.browser.evaluate('globalThis.__t27Posts')).length,0);
  });
});
