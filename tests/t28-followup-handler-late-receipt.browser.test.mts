import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {createP2016TicketCommandFacade} from '../src/p2-016-ticket-command-facade.mjs';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';
import {prepareFollowup,navigateFollowup,chooseFollowup,rows} from './helpers/t28-followup-source-fixture.mjs';

test('T28 a held HANDLER receipt is fenced and its Incident recovery purged when the real selected Ticket assignee moves away',{timeout:240000},async()=>{
  await candidateBrowser({purpose:'t28lateowner',reporters:3,recovery:true},async context=>{
    const {http,id,path}=await prepareFollowup(context),actor=text(record(context.f.admin).id),other=text(record(context.f.handler).id),ticket=text(record(context.f.reports[0]).ticketId),tickets=createP2016TicketCommandFacade({pool:context.pool,enabled:true});
    const assign=async(target:string)=>{const detail=await http.get('/api/tickets/'+ticket);const result=await tickets.perform({authContext:{principal_id:text(record(context.f.dispatcher).id)},command:{action:'transfer-assignment',ticket_id:ticket,client_command_id:randomUUID(),expected_version:detail.version,reason_code:'WORKBENCH_ASSIGN',target_principal_id:target,resolver_team_id:'PILOT_IT'}});assert.equal(result.ok,true);};await assign(actor);
    const report=rows((await http.get(path+'/reports?limit=30')).items).find(row=>row.ticket_id===ticket);assert.ok(report);await createPilotAccessService({pool:context.pool}).upsertPrincipal({wecomUserId:'synthetic-incident-admin',displayName:'合成管理员',roles:['HANDLER'],resolverTeamIds:['PILOT_IT']});await navigateFollowup(context,id);await context.browser.waitFor('document.querySelector("[data-incident-draft]")?.textContent.includes("最长24小时")');await chooseFollowup(context.browser,'公共故障操作','MARK_REPORTER_RECOVERED');await chooseFollowup(context.browser,'决定原因','RECOVERY_CONFIRMED');await chooseFollowup(context.browser,'关联报修',text(report.id));
    await context.browser.evaluate(`(()=>{const send=fetch;globalThis.fetch=async(input,options)=>{const response=await send(input,options);if(options?.method==='POST'&&String(input)===${JSON.stringify(path+'/reports/'+text(report.id)+'/mark-recovered')}){globalThis.__t28Actual={status:response.status,body:await response.clone().json()};throw new TypeError('T28_LOST_ACK');}if(!globalThis.__t28HeldUsed&&String(input).startsWith(${JSON.stringify(path+'/commands/')})){globalThis.__t28HeldUsed=true;globalThis.__t28Held={status:response.status,body:await response.clone().json()};await new Promise(resolve=>{globalThis.__t28Release=resolve;});globalThis.__t28Released=true;}return response;};})()`);await context.browser.waitFor('document.querySelector("[data-action=submit-incident]")?.disabled===false');await context.browser.evaluate('document.querySelector("[data-action=submit-incident]").click()');await context.browser.waitFor('Boolean(document.querySelector("[data-incident-unknown]"))');assert.equal(record(await context.browser.evaluate('globalThis.__t28Actual')).status,200);const copy=record(await context.browser.evaluate(candidateCopies)),operation=rows(copy.operations)[0];assert.ok(operation);const commandId=text(operation.commandId);
    await context.browser.evaluate('document.querySelector("[data-action=check-incident-operation]").click()');await context.browser.waitFor('Boolean(globalThis.__t28Held)');assert.equal(record(await context.browser.evaluate('globalThis.__t28Held')).status,200);await assign(other);assert.equal((await http.read(path+'/commands/'+commandId)).status,403);assert.equal((await http.get('/api/tickets/'+ticket)).assignee_id,other);await context.browser.evaluate('document.querySelector("[data-action=refresh-incident]").click()');await context.browser.waitFor('document.body.innerText.includes("仅当前本人负责")||document.querySelector("[data-incident-outcome]")?.textContent.includes("权限不可用")');
    assert.equal(await context.browser.evaluate('document.querySelector("[data-incident-outcome]")?.textContent.includes("权限不可用")'),true,'current assignee loss must revoke this purpose even though HANDLER role and parent READ remain valid');
    let cleared:Record<string,unknown>={};for(let i=0;i<100;i++){cleared=record(await context.browser.evaluate(candidateCopies));if(rows(cleared.drafts).filter(row=>row.kind==='incident'&&row.id===id).length===0&&rows(cleared.operations).filter(row=>row.kind==='incident'&&row.id===id).length===0)break;await new Promise<void>(resolve=>setTimeout(resolve,50));}assert.equal(rows(cleared.drafts).filter(row=>row.kind==='incident'&&row.id===id).length,0);assert.equal(rows(cleared.operations).filter(row=>row.kind==='incident'&&row.id===id).length,0);
    await context.browser.evaluate('globalThis.__t28Release()');await context.browser.waitFor('globalThis.__t28Released===true');await context.browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await context.browser.evaluate('Boolean(document.querySelector("[data-incident-unknown]"))'),false);assert.equal(await context.browser.evaluate('document.querySelector("[data-incident-outcome]")?.textContent.includes("已确认提交")'),false);assert.deepEqual(record(await context.browser.evaluate(candidateCopies)).operations,[]);assert.equal(rows(await context.browser.evaluate('globalThis.__t27Posts')).filter(row=>String(row.path).startsWith(path+'/')).length,1);assert.equal((await http.get(path)).row_version,'2');
  });
});
