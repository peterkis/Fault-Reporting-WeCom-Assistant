import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {tmpdir} from 'node:os';
import type {IncomingMessage,ServerResponse} from 'node:http';
import {withT12Profile} from './helpers/t12-profile-fixture.mjs';
import {seedPersistedIntake} from './helpers/p2-015-postgres-harness.mjs';
import {createContactJourneyStore} from '../app/server/src/p2-015-contact-journey.mjs';
import {createPilotTicketCore} from '../app/server/src/p1-005-pilot-ticket-core.mjs';
import {assertLocalDateTime} from '../app/server/src/platform/time-contract.mjs';
import {acceptedSetup,object,rows,text,version} from './helpers/t07-public-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
async function input(browser:Browser,selector:string,value:string){await browser.evaluate(`(()=>{const element=document.querySelector(${JSON.stringify(selector)});Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(element,${JSON.stringify(value)});element.dispatchEvent(new Event('input',{bubbles:true}));})()`);}
test('two genuine currently authorized Sessions on different public pages retain their original versions and commit one T12 selection',async()=>{
 await withT12Profile(async f=>{
  const s=await acceptedSetup(f);assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_CROSSPAGE_START'})).status,200);const current=(await s.b.get(s.path)).value,leg=(await f.pool.query<{journey_id:string;reporter_identity_hash:string;provider_context_hash:string;channel_identity_hash:string}>('SELECT journey_id::text,reporter_identity_hash,provider_context_hash,channel_identity_hash FROM intake.channel_leg WHERE source_intake_id=$1::uuid',[s.first.intake.intakeId])).rows[0];assert.ok(leg);
  const inputs:Record<string,unknown>[]=[];for(let n=0;n<20;n++)inputs.push(object(await seedPersistedIntake({pool:f.pool,text:'T12跨页合成实际关联会话 '+n,requestType:'INCIDENT',status:'RECEIVED'})));for(const source of inputs){const created=await createPilotTicketCore({pool:f.pool}).createForIntake({intakeId:text(source.intakeId),occurredAt:assertLocalDateTime(text(source.receivedAt)),traceId:'t12-crosspage-source-admission'});assert.ok(created.ticket);assert.equal(created.ticket.resolver_team_id,'PILOT_IT');}for(let n=0;n<3;n++)await f.runtime.coordinator.runOnce();
  for(const source of inputs){const session=(await f.pool.query<{id:string;thread_id:string}>('SELECT id::text,thread_id::text FROM conversation.session WHERE service_intake_id=$1::uuid',[source.intakeId])).rows[0];assert.ok(session);await createContactJourneyStore().ensureLeg({transaction:f.pool,input:{journey_id:leg.journey_id,leg_type:'GROUP_CONTINUATION',source_intake_id:text(source.intakeId),conversation_thread_id:session.thread_id,conversation_session_id:session.id,origin_channel_message_id:text(source.messageId),provider_context_hash:leg.provider_context_hash,channel_identity_hash:leg.channel_identity_hash,reporter_identity_hash:leg.reporter_identity_hash,opened_at:text(source.receivedAt)}});}
  const first=(await s.b.get(s.path+'/related-conversations')).value;assert.equal(rows(first.items).length,20);const cursor=text(first.next_cursor),last=(await s.b.get(s.path+'/related-conversations?cursor='+encodeURIComponent(cursor))).value;assert.equal(rows(last.items).length,1);assert.equal(last.next_cursor,null);const a=rows(first.items).find(row=>row.take_allowed===true),b=rows(last.items)[0];assert.ok(a&&b);assert.equal(b.take_allowed,true);const chosen=[a,b].map(row=>({session_id:text(row.session_id),expected_row_version:Number(text(row.session_row_version))}));
  const cookie=f.browserCookies[2];assert.ok(cookie);const facts:{method:string;path:string;status:number|null;body:unknown}[]=[],listener=(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(cookie.name+'='+cookie.value))return;const fact={method:request.method??'',path:request.url??'',status:null as number|null,body:null as unknown};facts.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(request.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});}};
  const directory=join(tmpdir(),'t12-crosspage-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;f.runtime.server.on('request',listener);
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[{...cookie,url:text(cookie.url)}]});assert.ok(browser);await browser.waitFor("document.querySelector('.ticket-takeover-completion select')?.options.length>2&&document.querySelector('.ticket-takeover-completion select').disabled===false");await browser.evaluate("(()=>{const element=document.querySelector('.ticket-takeover-completion select');Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(element,'T07_NETWORK');element.dispatchEvent(new Event('change',{bubbles:true}));})()");await browser.waitFor(`document.querySelector('.ticket-takeover-completion [data-session-choice="${text(a.session_id)}"]')?.disabled===false`);await browser.evaluate(`document.querySelector('.ticket-takeover-completion [data-session-choice="${text(a.session_id)}"]').click()`);await browser.waitFor("document.querySelector('.ticket-takeover-completion').innerText.includes('已选择 1 个会话')");await browser.evaluate("Array.from(document.querySelectorAll('.ticket-takeover-completion button')).find(button=>button.innerText==='下一批关联会话').click()");await browser.waitFor(`document.querySelector('.ticket-takeover-completion [data-session-choice="${text(b.session_id)}"]')?.disabled===false`);assert.ok(await browser.evaluate("document.querySelector('.ticket-takeover-completion').innerText.includes('已选择 1 个会话')"),'changing the visible page never revokes a legitimate selected ID on another page');await browser.evaluate(`document.querySelector('.ticket-takeover-completion [data-session-choice="${text(b.session_id)}"]').click()`);await browser.waitFor("document.querySelector('.ticket-takeover-completion').innerText.includes('已选择 2 个会话')&&!document.querySelector('.ticket-takeover-completion').innerText.includes('正在核对已选会话')");
   await input(browser,'#takeover-completion-process','T12_CROSSPAGE_PRIVATE_CANARY');await input(browser,'#takeover-completion-summary','服务恢复，独立合成跨页摘要。');await browser.waitFor("document.querySelector('#takeover-completion-confirmed').disabled===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");await browser.waitFor("document.querySelector('[data-action=takeover-and-complete]').disabled===false");assert.equal(facts.filter(row=>row.method==='POST').length,0);assert.ok(facts.some(row=>row.method==='GET'&&row.path.includes('related-conversations')&&row.path.includes('cursor=')));
   await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').click()");await browser.waitFor("document.querySelector('.ticket-takeover-completion')?.innerText.includes('已接管并完工')");const posts=facts.filter(row=>row.method==='POST');assert.equal(posts.length,1);const body=object(posts[0]?.body);assert.equal(posts[0]?.status,200);assert.equal(body.communication_choice,'TAKE_SELECTED');assert.deepEqual(body.sessions,chosen);assert.equal((await s.b.get(s.path)).value.status,'CLOSED');assert.equal((await s.b.get(s.path)).value.version,version(current.version)+2);assert.equal((await f.pool.query('SELECT 1 FROM conversation.control_event WHERE client_command_id=$1::uuid',[body.client_command_id])).rowCount,2);assert.deepEqual((await f.pool.query('SELECT state,command_type FROM pilot_ticket.ticket_command_receipt WHERE client_command_id=$1::uuid',[body.client_command_id])).rows,[{state:'COMMITTED',command_type:'WORKBENCH_TICKET_TAKEOVER_COMPLETION'}]);
  }catch(error){primary=error;}
  await closeBrowserTestResources([async()=>{if(browser){const bytes=Buffer.from(text(await browser.screenshot()),'base64'),file=join(directory,primary?'failure.png':'crosspage-committed.png');await writeFile(file,bytes);await writeFile(join(directory,'receipt.json'),JSON.stringify({chosen,facts,primary_failure:primary instanceof Error?primary.message:null,screenshot:{file:file.replaceAll('\\','/'),sha256:createHash('sha256').update(bytes).digest('hex')}}));await writeFile(join(directory,'page.json'),JSON.stringify(await browser.evaluate('({text:document.body.innerText})')));console.log('T12_CROSSPAGE_DIAGNOSTIC '+JSON.stringify({file:join(directory,'receipt.json').replaceAll('\\','/')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',listener);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);}],primary);
 },{recoveryEnabled:false,notesEnabled:false});
});
