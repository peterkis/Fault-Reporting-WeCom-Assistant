import assert from 'node:assert/strict';
import {test} from 'node:test';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';

test('T27 a genuinely unknown receipt permits only an explicit immutable original replay and no automatic new intent',async()=>{
 await candidateBrowser({purpose:'t27replay',recovery:true},async({pool,candidateId,browser,root,choose})=>{
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);await browser.evaluate(`(()=>{const send=fetch;globalThis.__t27Attempts=[];globalThis.fetch=async(path,options)=>{if(options?.method==='POST'&&String(path)==='/api/incident-candidates/${candidateId}/start-review'){globalThis.__t27Attempts.push({path:String(path),body:JSON.parse(options.body),headers:options.headers});if(globalThis.__t27Attempts.length===1)throw new TypeError('T27_TRANSPORT_UNAVAILABLE_BEFORE_DISPATCH');}return send(path,options);};})()`);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('结果未知')`);const attempts=await browser.evaluate('globalThis.__t27Attempts');assert.ok(Array.isArray(attempts)&&attempts.length===1);const original=record(attempts[0]),body=record(original.body),id=text(body.client_command_id);assert.equal((await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM incident.command_receipt WHERE client_command_id=$1::uuid',[id])).rows[0]?.count,0);const stored=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(stored.operations));assert.equal(record(stored.operations[0]).commandId,id);
  await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('结果仍未知')`);assert.equal(await browser.evaluate('globalThis.__t27Attempts.length'),1);assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=replay-candidate-operation]'))`),true,'UNKNOWN must offer a separate explicit original replay, never a new submit');assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').disabled`),true);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=replay-candidate-operation]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('候选决定已提交')`);const sent=await browser.evaluate('globalThis.__t27Attempts');assert.ok(Array.isArray(sent)&&sent.length===2);assert.deepEqual(sent[1],original);assert.equal((await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM incident.command_receipt WHERE client_command_id=$1::uuid',[id])).rows[0]?.count,1);assert.deepEqual(record(await browser.evaluate(candidateCopies)).operations,[]);
 });
});
