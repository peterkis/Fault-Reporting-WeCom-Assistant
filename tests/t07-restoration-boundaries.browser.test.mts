import type {T07Fixture} from './helpers/t07-public-fixture.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
type Fixture=T07Fixture&{browserCookies:{name:string;value:string;url:string}[];runtime:T07Fixture['runtime']&{server:Server;observability:{metrics:()=>Promise<{sse_clients:number}>}}};
const stored="new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result.filter(row=>row.purpose==='ticket-takeover').map(row=>({scope:row.scope,revision:row.revision,cipher:Array.from(new Uint8Array(row.ciphertext)),iv:Array.from(row.iv),expires:row.expiresAt})),operations:operations.result.filter(row=>row.purpose==='ticket-takeover')});};};})";
for(const mode of ['temporary-target-503','target-membership-revoked','discard-selected'] as const)test('production selected takeover draft '+mode+' preserves current authority and never implicitly submits',async()=>{
 await withWeb01Fixture(async(f:Fixture)=>{
  const s=await acceptedSetup(f),cookie=f.browserCookies[2];assert.ok(cookie);const source=rows((await s.a.get(s.path+'/related-conversations')).value.items)[0];assert.ok(source);const sessionId=text(source.session_id);assert.equal((await s.a.post('/api/conversations/'+sessionId+'/release',{client_command_id:randomUUID(),expected_row_version:Number(text(source.session_row_version)),reason_code:'T07_BROWSER_SETUP'})).status,200);const released=rows((await s.b.get(s.path+'/related-conversations')).value.items)[0];assert.ok(released);assert.equal(released.take_allowed,true);
  const requests:{method:string;path:string;status:number|null;body:unknown}[]=[];let unavailable=false,faults=0;
  const observe=(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(cookie.name+'='+cookie.value))return;const url=new URL(request.url??'/',f.origin);if(!url.pathname.startsWith('/api/'))return;const fact={method:request.method??'',path:url.pathname,status:null as number|null,body:null as unknown};requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(fact.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});}if(unavailable&&fact.method==='GET'&&url.pathname===s.path+'/takeover-targets'&&url.searchParams.get('resolver_team_id')==='T07_NETWORK'){const head=response.writeHead.bind(response),end=response.end.bind(response);response.writeHead=((...args:Parameters<ServerResponse['writeHead']>)=>{if(args[0]===200){args[0]=503;faults++;}return head(...args);}) as ServerResponse['writeHead'];response.end=((...args:Parameters<ServerResponse['end']>)=>response.statusCode===503?end(JSON.stringify({error:{code:'P2_016_ACTION_FAILED',retryable:false}})):end(...args)) as ServerResponse['end'];}};
  f.runtime.server.on('request',observe);const directory=join(tmpdir(),'t07-restoration-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;const screenshots:{file:string;sha256:string}[]=[];
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[cookie]});assert.ok(browser);const active=browser,capture=async(name:string)=>{await active.evaluate("document.querySelector('.ticket-takeover')?.scrollIntoView({block:'center'})");const bytes=Buffer.from(text(await active.screenshot()),'base64'),file=join(directory,name);await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),sha256:createHash('sha256').update(bytes).digest('hex')});};const reload=async()=>{const origin=await active.evaluate('performance.timeOrigin');await active.command('Page.enable');await active.command('Page.reload');await active.waitFor(`performance.timeOrigin!==${origin}&&document.readyState==='complete'&&Boolean(document.querySelector('.ticket-takeover'))`);};
   await browser.waitFor("document.querySelector('.ticket-takeover select')?.options.length>2&&document.querySelector('.ticket-takeover select').disabled===false");assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover input[value=TAKE_SELECTED]').checked"),true);await browser.evaluate("(()=>{const input=document.querySelector('.ticket-takeover select');Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(input,'T07_NETWORK');input.dispatchEvent(new Event('change',{bubbles:true}));})()");await browser.waitFor(`document.querySelector('.ticket-takeover select')?.value==='T07_NETWORK'&&document.querySelector('.ticket-takeover input[value=RETAIN_CURRENT]').disabled===false&&document.querySelector('.ticket-takeover [data-session-choice="${sessionId}"] input[type=checkbox]')?.disabled===false`);await browser.evaluate(`document.querySelector('.ticket-takeover [data-session-choice="${sessionId}"] input[type=checkbox]').click()`);await browser.waitFor("document.querySelector('[data-takeover-draft-status]')?.textContent.includes('已保存恢复副本')&&document.querySelector('.ticket-takeover [data-action=takeover]').disabled===false");const before=object(await browser.evaluate(stored));assert.equal(rows(before.drafts).length,1);assert.deepEqual(before.operations,[]);assert.equal(requests.filter(row=>row.method==='POST').length,0);
   if(mode==='temporary-target-503'){
    unavailable=true;await reload();await browser.waitFor("document.querySelector('[data-takeover-draft-status]')?.textContent.includes('核验暂时不可用')");assert.ok(faults>0);assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover select').value"),'');assert.equal(await browser.evaluate("document.querySelectorAll('.ticket-takeover [data-session-choice] input[type=checkbox]:checked').length"),0);assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover [data-action=takeover]').disabled"),true);assert.deepEqual(object(await browser.evaluate(stored)),before,'actual 503 retains identical ciphertext without restoring unchecked private input');await capture('temporary-503-hidden.png');unavailable=false;await reload();await browser.waitFor(`document.querySelector('.ticket-takeover select')?.value==='T07_NETWORK'&&document.querySelector('.ticket-takeover [data-session-choice="${sessionId}"] input[type=checkbox]')?.checked===true&&document.querySelector('.ticket-takeover [data-action=takeover]').disabled===false`);assert.deepEqual(object(await browser.evaluate(stored)),before);
   }else if(mode==='target-membership-revoked'){
    await f.pool.query("DELETE FROM pilot_ticket.pilot_team_member WHERE principal_id=$1::uuid AND team_id='T07_NETWORK'",[s.actor.id]);assert.equal((await s.b.get(s.path)).status,200);assert.equal((await s.b.get(s.path+'/takeover-targets?resolver_team_id=T07_NETWORK')).status,403);await reload();await browser.waitFor("document.querySelector('[data-takeover-draft-status]')?.textContent.includes('恢复副本已清理')");assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover select').value"),'');assert.equal(await browser.evaluate("document.querySelectorAll('.ticket-takeover [data-session-choice] input[type=checkbox]:checked').length"),0);assert.equal(requests.filter(row=>row.method==='POST').length,0);assert.equal((await s.b.get(s.path)).value.version,s.before.version);await capture('actual-target-revoked.png');
   }else{
    await browser.evaluate("document.querySelector('[data-action=discard-takeover-draft]').click()");await browser.waitFor("document.querySelector('[data-takeover-draft-status]')?.textContent.includes('恢复副本已清理')");assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover select').value"),'');assert.equal(await browser.evaluate("document.querySelectorAll('.ticket-takeover [data-session-choice] input[type=checkbox]:checked').length"),0);assert.equal(requests.filter(row=>row.method==='POST').length,0);assert.equal((await s.b.get(s.path)).value.version,s.before.version);await capture('explicit-discard-empty.png');
   }
   if(mode==='temporary-target-503'){
    assert.equal(requests.filter(row=>row.method==='POST').length,0);await browser.evaluate("document.querySelector('.ticket-takeover [data-action=takeover]').click()");await browser.waitFor("document.querySelector('[data-toast-source=ticket-takeover]')?.innerText.includes('已接管处理责任')");const posts=requests.filter(row=>row.method==='POST');assert.equal(posts.length,1);assert.equal(posts[0]?.path,s.path+'/takeover');assert.equal(posts[0]?.status,200);const body=object(posts[0]?.body);assert.equal(body.communication_choice,'TAKE_SELECTED');assert.equal(body.expected_version,s.before.version);assert.deepEqual(body.sessions,[{session_id:sessionId,expected_row_version:Number(text(released.session_row_version))}]);assert.equal((await s.b.get(s.path)).value.version,version(s.before.version)+1);assert.equal((await s.b.get(s.path)).value.status,'ACCEPTED');assert.deepEqual((await s.b.get(s.path)).value.handling_cycle,s.before.handling_cycle);assert.equal(rows((await s.a.get(s.path+'/responsibility')).value.conversations)[0]?.conversation_principal_id,s.actor.id);await browser.waitFor("document.querySelector('[data-takeover-draft-status]')?.textContent.includes('已清理')");assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});await capture('one-selected-post-committed.png');
   }
   const receipt=join(directory,'receipt.json');await writeFile(receipt,JSON.stringify({mode,requests,faults,screenshots,formal_production_bundle:true}));console.log('T07_RESTORATION_BOUNDARY '+JSON.stringify({mode,receipt:receipt.replaceAll('\\','/'),faults,posts:requests.filter(row=>row.method==='POST').length,screenshots}));
  }catch(error){primary=error;console.error('T07_RESTORATION_PRIMARY '+JSON.stringify({mode,message:error instanceof Error?error.message:String(error),directory:directory.replaceAll('\\','/')}));}
  await closeBrowserTestResources([async()=>{if(primary&&browser){await writeFile(join(directory,'failure.png'),Buffer.from(text(await browser.screenshot()),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify({requests,page:await browser.evaluate('({text:document.body.innerText,url:location.pathname})')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);}],primary);
 },{...acceptedOptions,workbenchDraftRecoveryEnabled:true});
});
