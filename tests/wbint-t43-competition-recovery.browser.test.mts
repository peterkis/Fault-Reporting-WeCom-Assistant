import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {setTimeout as delay} from 'node:timers/promises';
import type {IncomingMessage,ServerResponse} from 'node:http';
import {test} from 'node:test';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {withT43Fixture,text,object,version} from './helpers/t43-full-service-fixture.mjs';
import {get,post,start,complete,launch,screenshot,close} from './helpers/t43-service-actions.mjs';
import type {Browser,Screenshot} from './helpers/t43-service-actions.mjs';

async function peerEvaluate(browser:Browser,session:string,expression:string):Promise<unknown>{const result=object(await browser.command('Runtime.evaluate',{expression,awaitPromise:true,returnByValue:true},session));assert.equal(result.exceptionDetails,undefined,JSON.stringify(result.exceptionDetails));return object(result.result).value;}
async function peerWait(browser:Browser,session:string,expression:string){const until=performance.now()+30000;while(performance.now()<until){if(await peerEvaluate(browser,session,expression))return;await delay(25);}throw Error('T43_PEER_TIMEOUT: '+expression);}
async function choose(browser:Browser,label:string,value:string){const query='Array.from(document.querySelectorAll(".ticket-assignment select")).find(input=>Array.from(input.labels??[]).some(label=>label.textContent.includes('+JSON.stringify(label)+')))';await browser.waitFor('Boolean(('+query+')&&Array.from(('+query+').options).some(option=>option.value==='+JSON.stringify(value)+'))');await browser.evaluate('(()=>{const input='+query+';Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,"value").set.call(input,'+JSON.stringify(value)+');input.dispatchEvent(new Event("change",{bubbles:true}));})()');}

test('T43 two authorized actors compete on one real reopened round; same-profile tabs preserve offline choice and reconcile a genuine lost ACK by its original UUID before current READ loss clears the formal UI',{timeout:240000},()=>withT43Fixture(async f=>{
 const admin=f.staff[0],handler=f.staff[1];assert.ok(admin&&handler);const source=await f.manualReport('合成电话设备打印不了，需要人工检查。'),active=await start(f,source),id=text(active.id),path='/api/tickets/'+id,canary='T43_READ_LOSS_PRIVATE_'+randomUUID();
 const completed=await complete(admin,active,canary);await post(admin,path+'/reopen',{client_command_id:randomUUID(),expected_version:version(completed.version),reason_code:'STAFF_REOPEN',note:'明确核对后需要重新承接。'});const reopened=await get(admin,path);assert.equal(reopened.assignee_id,null);
 const command={client_command_id:randomUUID(),expected_version:version(reopened.version),reason_code:'T43_TWO_ACTOR_COMPETITION',resolver_team_id:'PILOT_IT'};
 assert.ok((await get(handler,path)).allowed_actions&&Array.isArray(reopened.allowed_actions)&&reopened.allowed_actions.includes('take-and-start'));
 const contenders=await Promise.all([admin.post(path+'/take-and-start',command),handler.post(path+'/take-and-start',{...command,client_command_id:randomUUID()})]);assert.deepEqual(contenders.map(result=>result.status).sort(),[200,409],JSON.stringify(contenders.map(result=>result.body)));
 let current=await get(admin,path);assert.equal(object(current.handling_cycle).id,object(reopened.handling_cycle).id);assert.ok(object(current.handling_cycle).first_responsibility_event_id);
 if(current.assignee_id!==f.principals[0]){await post(admin,path+'/transfer-assignment',{client_command_id:randomUUID(),expected_version:version(current.version),reason_code:'WORKBENCH_ASSIGN',target_principal_id:text(f.principals[0]),resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]});current=await get(admin,path);}
 const transferredBefore=(await f.pool.query<{n:number}>("SELECT count(*)::int AS n FROM pilot_ticket.ticket_event WHERE ticket_id=$1::uuid AND event_type='ticket.assignment_transferred'",[id])).rows[0]?.n;assert.equal(typeof transferredBefore,'number');
 let browser:Browser|undefined,peerId:string|undefined,error:unknown,lost=0;const screenshots:Screenshot[]=[];
 const loseAck=(request:IncomingMessage,response:ServerResponse)=>{if(request.method!=='POST'||request.url!==path+'/transfer-assignment')return;const end=response.end.bind(response);response.end=((...args:Parameters<ServerResponse['end']>)=>{if(response.statusCode===200&&lost===0){lost++;response.destroy();return response;}return end(...args);}) as ServerResponse['end'];};
 try{
  browser=await launch(f,'/workbench/app/items/ticket/'+id);await browser.waitFor('Boolean(document.querySelector(".ticket-assignment [data-assignment-draft-status]"))');
  const observer='(()=>{const original=globalThis.fetch;globalThis.__t43Posts=[];globalThis.fetch=function(input,options){const url=new URL(input instanceof Request?input.url:String(input),location.href);if(url.origin===location.origin&&url.pathname==='+JSON.stringify(path+'/transfer-assignment')+'&&options?.method==="POST")globalThis.__t43Posts.push(JSON.parse(options.body));return Reflect.apply(original,this,[input,options]);};})()';
  await browser.command('Page.enable');await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:observer});await browser.command('Page.reload',{ignoreCache:true});await browser.waitFor('Boolean(document.querySelector(".ticket-assignment"))&&document.querySelector("[data-realtime-status]")?.dataset.realtimeStatus==="live"');
  await choose(browser,'处理组','PILOT_IT');await choose(browser,'处理人',text(f.principals[1]));await browser.evaluate('document.querySelector(".ticket-assignment input[value=RETAIN_CURRENT]").click()');await browser.waitFor('document.querySelector(".ticket-assignment [data-action=transfer-assignment]")?.disabled===false&&document.querySelector("[data-assignment-draft-status]")?.textContent.includes("已保存恢复副本")');
  await browser.command('Network.enable');await browser.command('Network.emulateNetworkConditions',{offline:true,latency:0,downloadThroughput:-1,uploadThroughput:-1});await browser.waitFor('document.querySelector("[data-realtime-status]")?.dataset.realtimeStatus!=="live"');
  await browser.evaluate('document.querySelector(".ticket-assignment [data-action=transfer-assignment]").click()');assert.equal(await browser.evaluate('__t43Posts.length'),0);assert.equal(await browser.evaluate('Array.from(document.querySelectorAll(".ticket-assignment select")).some(input=>input.value==='+JSON.stringify(f.principals[1])+')'),true,'a real network disconnect preserves the selected target');
  await browser.command('Network.emulateNetworkConditions',{offline:false,latency:0,downloadThroughput:-1,uploadThroughput:-1});await browser.waitFor('document.querySelector("[data-realtime-status]")?.dataset.realtimeStatus==="live"');f.runtime.server.prependListener('request',loseAck);
  await browser.evaluate('document.querySelector(".ticket-assignment [data-action=transfer-assignment]").click()');await browser.waitFor('document.querySelector(".ticket-assignment")?.textContent.includes("结果未知")');assert.equal(lost,1);
  const original=object(await browser.evaluate('__t43Posts[0]'));assert.equal(original.expected_version,current.version);assert.equal(original.target_principal_id,f.principals[1]);assert.equal((await get(admin,path)).assignee_id,f.principals[1]);f.runtime.server.removeListener('request',loseAck);
  peerId=text(object(await browser.command('Target.createTarget',{url:'about:blank'})).targetId);const session=text(object(await browser.command('Target.attachToTarget',{targetId:peerId,flatten:true})).sessionId);await browser.command('Page.enable',{},session);await browser.command('Runtime.enable',{},session);await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:observer},session);await browser.command('Page.navigate',{url:f.origin+'/workbench/app/items/ticket/'+id},session);
  await peerWait(browser,session,'document.querySelector(".ticket-assignment")?.textContent.includes("结果未知")');assert.equal(await peerEvaluate(browser,session,'__t43Posts.length'),0,'the second real target in the same profile never automatically replays a shared operation');
  const receipt=await get(admin,path+'/assignment/commands/'+text(original.client_command_id));assert.equal(receipt.state,'COMMITTED');
  await browser.evaluate('document.querySelector("[data-action=check-assignment-command]").click()');await browser.waitFor('document.querySelector(".ticket-assignment")?.textContent.includes("已核对原操作结果：已提交")');assert.equal(await browser.evaluate('__t43Posts.length'),1);assert.equal(await peerEvaluate(browser,session,'__t43Posts.length'),0);
  assert.equal((await f.pool.query<{n:number}>("SELECT count(*)::int AS n FROM pilot_ticket.ticket_event WHERE ticket_id=$1::uuid AND event_type='ticket.assignment_transferred'",[id])).rows[0]?.n,Number(transferredBefore)+1);
  const replay=await post(admin,path+'/transfer-assignment',original);assert.equal(replay.ticket_event_id,object(receipt).ticket_event_id,'explicit same UUID/full body replay returns its original effect');
  screenshots.push(await screenshot(browser,'new-detail-1280.png'));
  await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'t43-staff-0',displayName:'T43当前已失去范围的人员',roles:['HANDLER'],resolverTeamIds:[]});assert.equal((await admin.get(path)).status,404);
  await browser.command('Page.reload',{ignoreCache:true});await browser.waitFor('Boolean(document.querySelector("[role=alert]"))||!document.querySelector(".detail-body")');assert.equal(await browser.evaluate('document.body.innerText.includes('+JSON.stringify(canary)+')'),false);assert.equal(await browser.evaluate('Boolean(document.querySelector(".ticket-assignment"))'),false);
  console.log('T43_COMPETITION_RECOVERY '+JSON.stringify({ticket:id,two_people_statuses:contenders.map(r=>r.status),same_profile_targets:2,native_network_offline:true,lost_committed_ack:lost,original_uuid:original.client_command_id,original_full_body:original,recovery:'OFFICIAL_READ_ONLY_ACK_THEN_EXPLICIT_IDENTICAL_REPLAY',browser_posts:1,second_target_auto_posts:0,current_read_after_revoke:404,live_send:false}));
 }catch(failure){error=failure;if(browser)console.log('T43_RECOVERY_DIAGNOSTIC '+JSON.stringify(await browser.evaluate('({text:document.body.innerText,url:location.href,posts:globalThis.__t43Posts})')));}
 f.runtime.server.removeListener('request',loseAck);await close(browser,error);console.log('WEB01_BROWSER '+JSON.stringify({api:'REAL_LOOPBACK_HTTP_PG',purpose:'t43-two-person-two-target-offline-unknown-authority',screenshots}));
}));
