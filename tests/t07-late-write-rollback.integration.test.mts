import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {acceptedSetup,acceptedOptions,object,rows,text,version} from './helpers/t07-public-fixture.mjs';
import type {T07Fixture} from './helpers/t07-public-fixture.mjs';
test('actual later start event cycle link and COMMITTED receipt failures roll back earlier real selected Control and every takeover fact',async()=>{
 await withWeb01Fixture(async(f:T07Fixture)=>{
  const s=await acceptedSetup(f),source=rows((await s.a.get(s.path+'/related-conversations')).value.items)[0];assert.ok(source);const sessionId=text(source.session_id);assert.equal((await s.a.post('/api/conversations/'+sessionId+'/release',{client_command_id:randomUUID(),expected_row_version:Number(text(source.session_row_version)),reason_code:'T07_ROLLBACK_SETUP'})).status,200);const selected=rows((await s.b.get(s.path+'/related-conversations')).value.items)[0];assert.ok(selected);assert.equal(selected.take_allowed,true);
  let drained=false;for(let n=0;n<3;n++)if((await f.runtime.realtimeProjector.runOnce({limit:100})).processed===0){drained=true;break;}assert.equal(drained,true);
  const snapshot=async()=>({ticket:(await s.b.get(s.path)).value,events:(await s.a.get(s.path+'/events')).value,communication:(await s.a.get(s.path+'/responsibility')).value.conversations,notices:(await s.a.get(s.path+'/deliveries')).value,session:(await f.pool.query('SELECT s.row_version::text,s.generation_version::text,s.control_mode,a.assigned_principal_id::text,a.assignment_version::text FROM conversation.session s LEFT JOIN conversation.assignment a ON a.session_id=s.id WHERE s.id=$1::uuid',[sessionId])).rows,control:(await f.pool.query('SELECT id::text,client_command_id::text FROM conversation.control_event WHERE session_id=$1::uuid ORDER BY id',[sessionId])).rows,counts:(await f.pool.query('SELECT (SELECT count(*) FROM conversation.realtime_event)::int AS realtime,(SELECT count(*) FROM pilot_ticket.ticket_handling_cycle_event)::int AS links')).rows}),before=await snapshot();
  const boundaries=[{table:'pilot_ticket.ticket_event',operation:'INSERT',predicate:`NEW.ticket_id='${s.first.ticket.id}'::uuid AND NEW.event_type='ticket.started'`,name:'start-event'},{table:'pilot_ticket.ticket_handling_cycle_event',operation:'INSERT',predicate:`NEW.ticket_id='${s.first.ticket.id}'::uuid`,name:'cycle-link'},{table:'pilot_ticket.ticket_command_receipt',operation:'UPDATE',predicate:`NEW.ticket_id='${s.first.ticket.id}'::uuid AND NEW.command_type='WORKBENCH_TICKET_TAKEOVER' AND NEW.state='COMMITTED'`,name:'committed-receipt'}] as const;
  for(const boundary of boundaries){const command={client_command_id:randomUUID(),expected_version:version(before.ticket.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'T07_NETWORK',communication_choice:'TAKE_SELECTED',sessions:[{session_id:sessionId,expected_row_version:Number(text(selected.session_row_version))}]};let installed=false;
   try{
    await f.pool.query('CREATE SEQUENCE platform.t07_later_write_observed');await f.pool.query(`CREATE FUNCTION platform.t07_later_write_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NOT EXISTS(SELECT 1 FROM conversation.control_event WHERE session_id='${sessionId}'::uuid AND client_command_id='${command.client_command_id}'::uuid) OR NOT EXISTS(SELECT 1 FROM pilot_ticket.ticket WHERE id='${s.first.ticket.id}'::uuid AND assignee_id='${s.actor.id}'::uuid AND resolver_team_id='T07_NETWORK' AND version>${version(before.ticket.version)}) THEN RAISE EXCEPTION 'T07_EARLIER_REAL_WRITES_NOT_REACHED'; END IF; PERFORM nextval('platform.t07_later_write_observed'); RAISE EXCEPTION 'T07_SYNTHETIC_LATER_WRITE_FAILURE'; END $$`);await f.pool.query(`CREATE TRIGGER t07_later_write_failure BEFORE ${boundary.operation} ON ${boundary.table} FOR EACH ROW WHEN (${boundary.predicate}) EXECUTE FUNCTION platform.t07_later_write_failure()`);installed=true;
    const failed=await s.b.post(s.path+'/takeover-and-start',command);assert.equal(failed.status,503,JSON.stringify(failed.value));assert.equal(object(failed.value.error).retryable,false);assert.equal((await f.pool.query('SELECT is_called FROM platform.t07_later_write_observed')).rows[0]?.is_called,true,'the fault must follow actual earlier Control and Ticket writes');assert.deepEqual(await snapshot(),before);assert.deepEqual((await f.pool.query('SELECT state,command_type FROM pilot_ticket.ticket_command_receipt WHERE client_command_id=$1::uuid',[command.client_command_id])).rows,[{state:'FAILED',command_type:'WORKBENCH_TICKET_TAKEOVER'}]);assert.equal((await f.pool.query('SELECT 1 FROM conversation.control_event WHERE client_command_id=$1::uuid',[command.client_command_id])).rowCount,0);console.log('T07_LATER_ATOMIC_ROLLBACK '+JSON.stringify({boundary:boundary.name,actual_earlier_control_and_ticket:true,status:failed.status,all_facts_unchanged:true}));
   }finally{if(installed)await f.pool.query(`DROP TRIGGER t07_later_write_failure ON ${boundary.table}`);await f.pool.query('DROP FUNCTION IF EXISTS platform.t07_later_write_failure()');await f.pool.query('DROP SEQUENCE IF EXISTS platform.t07_later_write_observed');}
  }
  const committed=await s.b.post(s.path+'/takeover-and-start',{client_command_id:randomUUID(),expected_version:version(before.ticket.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'T07_NETWORK',communication_choice:'TAKE_SELECTED',sessions:[{session_id:sessionId,expected_row_version:Number(text(selected.session_row_version))}]});assert.equal(committed.status,200,JSON.stringify(committed.value));const after=await snapshot();assert.equal(after.ticket.status,'IN_PROGRESS');assert.equal(after.ticket.version,version(before.ticket.version)+2);assert.deepEqual(after.ticket.handling_cycle,before.ticket.handling_cycle);assert.deepEqual(after.notices,before.notices);assert.equal(rows(after.communication)[0]?.conversation_principal_id,s.actor.id);const prior=rows(before.events.items),events=rows(after.events.items);assert.deepEqual(events.slice(0,prior.length),prior);assert.deepEqual(events.slice(prior.length).map(row=>row.event_type),['ticket.assignment_transferred','ticket.started']);assert.equal((await f.pool.query('SELECT 1 FROM pilot_ticket.ticket_handling_cycle_event WHERE cycle_id=$1::uuid AND ticket_event_id=ANY($2::uuid[])',[object(after.ticket.handling_cycle).id,events.slice(prior.length).map(row=>row.event_id)])).rowCount,2);
 },{...acceptedOptions,manualProjection:true});
});
