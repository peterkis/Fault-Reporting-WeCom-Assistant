import assert from 'node:assert/strict';
import {test} from 'node:test';
import type {IncomingMessage} from 'node:http';
import {withT10Fixture} from './helpers/t10-waiting-fixture.mjs';
import {t11Http,t11NewTicket} from './helpers/t11-completion-fixture.mjs';
import {withT10Browser,fillWaiting} from './helpers/t10-browser-fixture.mjs';

const stored="new Promise((resolve,reject)=>{const request=indexedDB.open('wecom-workbench-drafts-v1');request.onerror=()=>reject(request.error);request.onsuccess=()=>{const db=request.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result.filter(row=>row.purpose.startsWith('waiting-')).map(row=>({id:row.id,purpose:row.purpose,revision:row.revision,firstSavedAt:row.firstSavedAt,expiresAt:row.expiresAt,extractable:row.key.extractable,algorithm:row.key.algorithm.name,cipherBytes:row.ciphertext.byteLength,plainCanary:JSON.stringify(row).includes('INTERNAL_T10_PURPOSE')})),operations:operations.result.filter(row=>row.purpose.startsWith('waiting-')).map(row=>({id:row.id,purpose:row.purpose,commandId:row.commandId}))});};};})";
interface Snapshot {drafts:{id:string;purpose:string;revision:string;firstSavedAt:number;expiresAt:number;extractable:boolean;algorithm:string;cipherBytes:number;plainCanary:boolean}[];operations:{id:string;purpose:string;commandId:string}[]}
interface Original {action:string;purpose:string;ticketId:string;uuid:string;version:number}

test('four production waiting purposes retain independent original UNKNOWN operations, fixed encrypted expiry and explicit action-bound safe GET without new POST',async()=>{
  await withT10Fixture(async context=>{
    const http=await t11Http(context,0,{closeConnections:true}),target=context.tickets[0];assert.ok(target);const before=await http.start(target.ticket.id),cancelId=await t11NewTicket(context);
    const responsibility=await (await http.get('/api/tickets/'+target.ticket.id+'/responsibility')).json() as unknown,deliveries=await (await http.get('/api/tickets/'+target.ticket.id+'/deliveries')).json() as unknown;
    const requests:{method:string;path:string;uuid:string|null}[]=[];const observe=(request:IncomingMessage)=>{const path=request.url??'';if(!/\/tickets\/[^/]+\/(request-information|wait-vendor|resume|cancel)(\/commands\/[^/]+)?$/u.test(path))return;requests.push({method:request.method??'',path,uuid:typeof request.headers['idempotency-key']==='string'?request.headers['idempotency-key']:null});};context.runtime.server.on('request',observe);
    try{await withT10Browser(context,target.ticket.id,0,'T10_FOUR_PURPOSE_FIXED_EXPIRY',async(browser,capture)=>{
      const drop="(()=>{const original=fetch;globalThis.__t10Posts=[];globalThis.fetch=async(path,options)=>{const response=await original(path,options);if(options?.method==='POST'&&/\\/tickets\\/[^/]+\\/(request-information|wait-vendor|resume|cancel)$/.test(String(path))&&response.status===200){globalThis.__t10Posts.push({path:String(path),body:JSON.parse(options.body)});throw new TypeError('T10_ACTUAL_COMMITTED_RESPONSE_LOST');}return response;};})()";
      await browser.command('Page.enable');await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:drop});await browser.evaluate(drop);
      const originals:Original[]=[];
      for(const [action,purpose,label,ticketId] of [['request-information','waiting-requester','等待报修人',target.ticket.id],['resume','waiting-resume','恢复处理',target.ticket.id],['wait-vendor','waiting-vendor','等待厂商',target.ticket.id],['cancel','waiting-cancel','取消工单',cancelId]] as const){
        if(action==='cancel')await browser.command('Page.navigate',{url:context.origin+'/workbench/app/items/ticket/'+ticketId});
        const form='form[aria-label="'+label+'"]',section='[data-waiting-purpose="'+action+'"]',input=form+' textarea',note='INTERNAL_T10_PURPOSE：'+purpose+'独立原意图。';
        await browser.waitFor(`Boolean(document.querySelector('[data-action=${action}]'))&&!document.querySelector('[data-action=${action}]').disabled`);await browser.evaluate(`document.querySelector('[data-action=${action}]').click()`);await browser.waitFor(`Boolean(document.querySelector(${JSON.stringify(input)}))`);await browser.evaluate(fillWaiting(input,note));
        await browser.waitFor(`document.querySelector(${JSON.stringify(section)})?.innerText.includes('已保存恢复副本')`);const first=(await browser.evaluate(stored) as Snapshot).drafts.find(row=>row.id===ticketId&&row.purpose===purpose);assert.ok(first);assert.equal(first.expiresAt-first.firstSavedAt,86400000);assert.equal(first.extractable,false);assert.equal(first.algorithm,'AES-GCM');assert.equal(first.plainCanary,false);assert.ok(first.cipherBytes>16&&first.cipherBytes<=16400);
        if(action==='cancel'){
          await browser.evaluate(fillWaiting(input,note+'明确取消原因。'));await browser.waitFor(`document.querySelector(${JSON.stringify(section)})?.innerText.includes('已保存恢复副本')`);let saved:Snapshot|undefined;for(let attempt=0;attempt<100;attempt++){saved=await browser.evaluate(stored) as Snapshot;if(saved.drafts.some(row=>row.purpose===purpose&&row.revision!==first.revision))break;await new Promise(resolve=>setTimeout(resolve,20));}const newer=saved?.drafts.find(row=>row.id===ticketId&&row.purpose===purpose);assert.ok(newer);assert.notEqual(newer.revision,first.revision);assert.equal(newer.firstSavedAt,first.firstSavedAt);assert.equal(newer.expiresAt,first.expiresAt,'editing never renews the original 24h lifetime');await browser.evaluate(`document.querySelector(${JSON.stringify(form+' input[type="checkbox"]')}).click()`);
        }
        const current=await http.detail(ticketId);await browser.waitFor(`!document.querySelector(${JSON.stringify(form+' button[type="submit"]')}).disabled`);await browser.evaluate(`document.querySelector(${JSON.stringify(form+' button[type="submit"]')}).click()`);await browser.waitFor(`globalThis.__t10Posts.length===1&&document.querySelector(${JSON.stringify(section)})?.innerText.includes('结果未知')`);
        const original=await browser.evaluate('globalThis.__t10Posts[0]') as {path:string;body:{client_command_id:string;expected_version:number;note:string;external_visible:boolean}};assert.equal(original.path,'/api/tickets/'+ticketId+'/'+action);assert.equal(original.body.expected_version,current.version);assert.equal(original.body.external_visible,false);assert.ok(original.body.note.startsWith(note));originals.push({action,purpose,ticketId,uuid:original.body.client_command_id,version:current.version});
        assert.equal(requests.filter(row=>row.method==='GET').length,0,'saving or switching context does not automatically reconcile');
        if(action!=='cancel'){const origin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${origin}&&Boolean(document.querySelector('[data-action=check-${action}-command]'))`);}
      }
      const unresolved=await browser.evaluate(stored) as Snapshot;assert.deepEqual(unresolved.operations.map(row=>({id:row.id,purpose:row.purpose,commandId:row.commandId})).sort((a,b)=>a.purpose.localeCompare(b.purpose)),originals.map(row=>({id:row.ticketId,purpose:row.purpose,commandId:row.uuid})).sort((a,b)=>a.purpose.localeCompare(b.purpose)));
      assert.equal(requests.filter(row=>row.method==='POST').length,4);assert.equal(new Set(originals.map(row=>row.uuid)).size,4);
      await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:"(()=>{const now=Date.now;Date.now=()=>now()+86400001;})()"});const origin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${origin}&&Boolean(document.querySelector('[data-action=check-cancel-command]'))`);
      const expired=await browser.evaluate(stored) as Snapshot;assert.equal(expired.drafts.length,0);assert.deepEqual(expired.operations,unresolved.operations,'expiry clears only sensitive bytes and preserves all original operation IDs');assert.equal(await browser.evaluate("document.querySelector('[data-waiting-purpose=cancel] textarea')?.value??''"),'');assert.equal(requests.filter(row=>row.method==='GET').length,0);
      for(const original of [...originals].reverse()){
        if(original.ticketId===target.ticket.id&&await browser.evaluate('location.pathname')!==('/workbench/app/items/ticket/'+target.ticket.id))await browser.command('Page.navigate',{url:context.origin+'/workbench/app/items/ticket/'+target.ticket.id});
        await browser.waitFor(`Boolean(document.querySelector('[data-action=check-${original.action}-command]'))`);await browser.evaluate(`document.querySelector('[data-action=check-${original.action}-command]').click()`);await browser.waitFor(`document.querySelector('[data-waiting-purpose=${original.action}]')?.innerText.includes('原操作已核对为提交')`);
      }
      assert.deepEqual(requests.filter(row=>row.method==='POST').map(row=>row.uuid),originals.map(row=>row.uuid));assert.deepEqual(requests.filter(row=>row.method==='GET').map(row=>row.path),[...originals].reverse().map(row=>'/api/tickets/'+row.ticketId+'/'+row.action+'/commands/'+row.uuid));assert.equal((await browser.evaluate(stored) as Snapshot).operations.length,0);
      const after=await http.detail(target.ticket.id);assert.equal(after.status,'WAITING_VENDOR');assert.equal(after.version,before.version+3);assert.equal(after.assignee_id,before.assignee_id);assert.equal(after.resolver_team_id,before.resolver_team_id);assert.deepEqual(after.handling_cycle,before.handling_cycle);assert.deepEqual(await (await http.get('/api/tickets/'+target.ticket.id+'/responsibility')).json(),responsibility);assert.deepEqual(await (await http.get('/api/tickets/'+target.ticket.id+'/deliveries')).json(),deliveries);assert.equal((await http.detail(cancelId)).status,'CANCELLED');await capture('new-detail-1920.png');
    });}finally{context.runtime.server.removeListener('request',observe);}
  });
});
