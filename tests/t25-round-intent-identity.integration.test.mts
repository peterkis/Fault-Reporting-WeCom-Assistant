import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID} from 'node:crypto';
import {withT24Fixture} from './helpers/t24-round-notification-fixture.mjs';
import {t25WebOrigin,t25Deliveries} from './helpers/t25-web-origin-fixture.mjs';
import {t11Http} from './helpers/t11-completion-fixture.mjs';
import {createTicketRoundNotifications} from '../app/server/src/workbench-ticket-round-notifications.mjs';
import {entryConfig} from './helpers/p2-g2-yixiaoxiu-fixture.mjs';

test('App FIRST and completion identities survive same-round withdrawal, reacceptance, handoffs, waiting and replay while a new round adds exactly its own two intents',{timeout:240000},async()=>{
 await withT24Fixture(async context=>{
  const source=await t25WebOrigin(context,{start:false}),http=source.http,id=source.ticketId,target=context.principals[1]?.id,admin=context.principals[0]?.id;assert.ok(target&&admin);
  const initial=await http.detail(id),assignment={client_command_id:randomUUID(),expected_version:initial.version,reason_code:'T25_ORIGINAL_ASSIGN',target_principal_id:target,resolver_team_id:initial.resolver_team_id,communication_choice:'RETAIN_CURRENT',sessions:[]};
  assert.equal((await http.post(id,'assign',assignment)).status,200);const assigned=await http.detail(id),c1=assigned.handling_cycle;assert.ok(c1?.first_responsibility_event_id);assert.equal(assigned.status,'QUEUED');await source.round.runOnce();const first=await t25Deliveries(http,id);assert.equal(first.length,1);assert.equal(first[0]?.node,'FIRST_RESPONSIBILITY');assert.equal(first[0]?.route_kind,'YIXIAOXIU_APP');
  assert.equal((await http.post(id,'assign',assignment)).status,200);
  assert.equal((await http.post(id,'unassign',{client_command_id:randomUUID(),expected_version:assigned.version,reason_code:'WORKBENCH_UNASSIGN',reason:'尚未开始，交回重新安排。',communication_choice:'RETAIN_CURRENT',communication_target_principal_id:null,sessions:[]})).status,200);
  const withdrawn=await http.detail(id);assert.equal(withdrawn.assignee_id,null);assert.deepEqual(withdrawn.handling_cycle,c1);await source.round.runOnce();assert.deepEqual(await t25Deliveries(http,id),first);
  const handler=await t11Http(context,2),accept={client_command_id:randomUUID(),expected_version:withdrawn.version,reason_code:'WORKBENCH_SELF_HANDLING',resolver_team_id:withdrawn.resolver_team_id};
  assert.equal((await handler.post(id,'accept-for-later',accept)).status,200);const accepted=await http.detail(id);assert.equal(accepted.status,'ACCEPTED');assert.equal(accepted.assignee_id,target);assert.deepEqual(accepted.handling_cycle,c1);await source.round.runOnce();assert.deepEqual(await t25Deliveries(http,id),first);
  for(const next of [admin,target]){const current=await http.detail(id);assert.equal((await http.post(id,'transfer-assignment',{client_command_id:randomUUID(),expected_version:current.version,reason_code:'T25_SAME_ROUND_HANDOFF',target_principal_id:next,resolver_team_id:current.resolver_team_id,communication_choice:'RETAIN_CURRENT',sessions:[]})).status,200);assert.deepEqual((await http.detail(id)).handling_cycle,c1);await source.round.runOnce();assert.deepEqual(await t25Deliveries(http,id),first);}
  const ready=await handler.detail(id);assert.equal((await handler.post(id,'take-and-start',{client_command_id:randomUUID(),expected_version:ready.version,reason_code:'WORKBENCH_SELF_HANDLING',resolver_team_id:ready.resolver_team_id})).status,200);
  const started=await handler.detail(id);assert.equal((await handler.post(id,'wait-vendor',{client_command_id:randomUUID(),expected_version:started.version,reason_code:'T25_VENDOR_WAIT',note:'INTERNAL_T25_VENDOR_CANARY',external_visible:false})).status,200);const waiting=await http.detail(id);assert.equal(waiting.status,'WAITING_VENDOR');assert.deepEqual(waiting.handling_cycle,c1);
  const completion=handler.command(waiting);assert.equal((await handler.post(id,'complete',completion)).status,200);await source.round.runOnce();const closed=await http.detail(id),both=await t25Deliveries(http,id);assert.equal(closed.status,'CLOSED');assert.equal(both.length,2);assert.equal(both.find(row=>row.node==='FIRST_RESPONSIBILITY')?.delivery_id,first[0]?.delivery_id);assert.deepEqual(both.map(row=>row.node).sort(),['FIRST_RESPONSIBILITY','STAFF_COMPLETED']);
  assert.equal((await handler.post(id,'complete',completion)).status,200);
  const fresh=()=>createTicketRoundNotifications({pool:context.pool,enabled:true,botId:entryConfig.botId,templateVersion:'wbint-round-notification/25',reporterAccess:context.runtime.reporterAccess,appNotifications:source.appNotifications});
  await fresh().runOnce();await fresh().runOnce();assert.deepEqual(await t25Deliveries(http,id),both);assert.deepEqual(await http.detail(id),closed);
  assert.equal((await http.post(id,'reopen',{client_command_id:randomUUID(),expected_version:closed.version,reason_code:'STAFF_REOPEN',note:'INTERNAL_T25_REOPEN_CANARY',external_visible:false})).status,200);const reopened=await http.detail(id);assert.equal(reopened.status,'REOPENED');assert.equal(reopened.handling_cycle?.cycle_no,2);assert.equal(reopened.handling_cycle?.first_responsibility_event_id,null);await fresh().runOnce();assert.deepEqual(await t25Deliveries(http,id),both);
  const newFirst={client_command_id:randomUUID(),expected_version:reopened.version,reason_code:'WORKBENCH_SELF_HANDLING',resolver_team_id:reopened.resolver_team_id};assert.equal((await handler.post(id,'take-and-start',newFirst)).status,200);const nextStarted=await handler.detail(id);assert.equal(nextStarted.handling_cycle?.cycle_no,2);assert.notEqual(nextStarted.handling_cycle?.id,c1.id);await fresh().runOnce();const three=await t25Deliveries(http,id);assert.equal(three.length,3);assert.deepEqual(three.filter(row=>row.cycle_no===1),both);
  const newCompletion=handler.command(nextStarted);assert.equal((await handler.post(id,'complete',newCompletion)).status,200);await fresh().runOnce();const all=await t25Deliveries(http,id);assert.equal(all.length,4);assert.deepEqual(all.filter(row=>row.cycle_no===1),both);assert.deepEqual(all.filter(row=>row.cycle_no===2).map(row=>row.node).sort(),['FIRST_RESPONSIBILITY','STAFF_COMPLETED']);assert.equal(new Set(all.map(row=>row.delivery_id)).size,4);
  assert.equal((await handler.post(id,'take-and-start',newFirst)).status,200);assert.equal((await handler.post(id,'complete',newCompletion)).status,200);await fresh().runOnce();assert.deepEqual(await t25Deliveries(http,id),all);
  for(const row of all){assert.equal(row.status,'PENDING');assert.equal(row.side_effect_state,'NOT_ATTEMPTED');assert.equal(row.attempt_count,0);assert.equal(row.destination_type,'PERSON');assert.equal(row.route_kind,'YIXIAOXIU_APP');}
  const events=await http.get('/api/tickets/'+id+'/events');assert.equal(events.status,200);const history=JSON.stringify(await events.json());assert.ok(history.includes('ticket.unassigned'));assert.ok(history.includes('ticket.resumed'));assert.ok(history.includes('ticket.reopened'));for(const privateValue of ['INTERNAL_T25_VENDOR_CANARY','INTERNAL_T25_REOPEN_CANARY',source.memberId,source.scope.scopeHash])assert.equal(JSON.stringify(all).includes(privateValue),false);
  const physical=(await context.pool.query<{messages:number;outboxes:number;deliveries:number}>(`SELECT count(DISTINCT b.message_id)::int AS messages,count(DISTINCT b.outbox_id)::int AS outboxes,count(DISTINCT b.delivery_id)::int AS deliveries FROM communication.ticket_notification_binding b JOIN communication.ticket_round_notification_binding r ON r.notification_binding_id=b.id WHERE b.ticket_id=$1::uuid`,[id])).rows[0];assert.deepEqual(physical,{messages:4,outboxes:4,deliveries:4});
  console.log('T25_ROUND_IDENTITY_TRACE '+JSON.stringify({same_ticket:id,cycles:2,app_intents:all.length,physical}));
 },{ticketAssignmentEnabled:true,ticketUnassignEnabled:true,ticketReopenRoundsEnabled:true,manualRoundConsumption:true});
});
