import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {tmpdir} from 'node:os';
import {test} from 'node:test';
import type {Server,IncomingMessage,ServerResponse} from 'node:http';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
import {acceptedSetup,acceptedOptions,object,rows,text,version} from './helpers/t07-public-fixture.mjs';
import type {T07Fixture} from './helpers/t07-public-fixture.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
type Fixture=T07Fixture&{browserCookies:{name:string;value:string;url:string}[];runtime:T07Fixture['runtime']&{server:Server;observability:{metrics:()=>Promise<{sse_clients:number}>}}};
type RequestFact={order:number;method:string;path:string;status:number|null;body:unknown;idempotency:unknown;if_match:unknown;csrf:boolean;origin:boolean};
test('formal production detail requires explicit actual self team and retain communication, then sends one atomic takeover-start POST and really rereads current facts at 600px and narrow width',async()=>{
 await withWeb01Fixture(async(f:Fixture)=>{
  const s=await acceptedSetup(f),cookie=f.browserCookies[2];assert.ok(cookie);assert.equal((await s.b.get(s.path+'/takeover-targets?resolver_team_id=T07_NETWORK')).status,200);const bootstrap=await s.b.get('/api/lifecycle/bootstrap');assert.equal(bootstrap.value.ticket_takeover_enabled,true);assert.equal(bootstrap.value.ticket_takeover_draft_recovery_enabled,false);
  const requests:RequestFact[]=[];const observe=(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(cookie.name+'='+cookie.value))return;const path=new URL(request.url??'/',f.origin).pathname;if(!path.startsWith('/api/'))return;const fact:RequestFact={order:requests.length,method:request.method??'',path,status:null,body:null,idempotency:request.headers['idempotency-key'],if_match:request.headers['if-match'],csrf:typeof request.headers['x-csrf-token']==='string',origin:request.headers.origin===f.origin};requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(fact.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});}};
  f.runtime.server.on('request',observe);const directory=join(tmpdir(),'t07-ui-'+randomUUID());await mkdir(directory);const screenshots:{file:string;width:number;height:number;sha256:string}[]=[];let browser:Browser|undefined,primary:unknown;
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[cookie]});assert.ok(browser);const active=browser,capture=async(name:string)=>{await active.evaluate("document.querySelector('.ticket-takeover')?.scrollIntoView({block:'center'})");const bytes=Buffer.from(text(await active.screenshot()),'base64'),file=join(directory,name);await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),width:bytes.readUInt32BE(16),height:bytes.readUInt32BE(20),sha256:createHash('sha256').update(bytes).digest('hex')});};
   await browser.waitFor("Boolean(document.querySelector('#detail-title'))");assert.equal(await browser.evaluate("Math.round(document.querySelector('.detail-dialog').getBoundingClientRect().width)"),600);assert.equal(await browser.evaluate("Boolean(document.querySelector('.ticket-takeover'))"),true,'the production self takeover form must exist');
   await browser.waitFor("document.querySelector('.ticket-takeover select')?.options.length>2&&document.querySelector('.ticket-takeover select').disabled===false");assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover select').value"),'');assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover [data-action=takeover-and-start]').disabled"),true);assert.equal(await browser.evaluate("document.querySelectorAll('.ticket-takeover select').length"),1,'the server derives self, no person directory is shown');assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover input[value=TAKE_SELECTED]').checked"),true,'ADR0031 defaults to explicit communication takeover without preselecting Sessions');assert.equal(await browser.evaluate("document.querySelectorAll('.ticket-takeover [data-session-choice]:checked').length"),0);assert.equal(await browser.evaluate("Boolean(document.querySelector('.ticket-conversation-handling'))"),false,'an ineligible old self-handling choice must not compete with the current takeover form');assert.equal(await browser.evaluate("document.querySelector('.ticket-takeover legend').textContent"),'本次接管的沟通责任');
   await browser.evaluate("(()=>{const input=document.querySelector('.ticket-takeover select');Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(input,'T07_NETWORK');input.dispatchEvent(new Event('change',{bubbles:true}));document.querySelector('.ticket-takeover input[value=RETAIN_CURRENT]').click();})()");await browser.waitFor("document.querySelector('.ticket-takeover [data-action=takeover-and-start]').disabled===false");assert.equal(requests.filter(row=>row.method==='POST').length,0);await capture('explicit-team-600px.png');await browser.evaluate("document.querySelector('.ticket-takeover [data-action=takeover-and-start]').click()");
   await browser.waitFor("document.querySelector('.ticket-takeover')?.innerText.includes('已接管并开始处理')");const posts=requests.filter(row=>row.method==='POST');assert.equal(posts.length,1);const post=posts[0];assert.ok(post);const body=object(post.body),id=text(body.client_command_id);assert.equal(post.path,s.path+'/takeover-and-start');assert.equal(post.status,200);assert.equal(post.idempotency,id);assert.equal(post.if_match,'"'+version(s.before.version)+'"');assert.equal(post.csrf,true);assert.equal(post.origin,true);assert.deepEqual(body,{client_command_id:id,expected_version:version(s.before.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'T07_NETWORK',communication_choice:'RETAIN_CURRENT',sessions:[]});
   await browser.waitFor(`document.querySelector('.properties')?.innerText.includes('陈悦')&&document.querySelector('.properties')?.innerText.includes('处理中')`);assert.ok(requests.some(row=>row.order>post.order&&row.method==='GET'&&[s.path,'/api/workbench/items/ticket/'+s.first.ticket.id].includes(row.path)&&row.status===200),'the production client must actually reread current authorized Ticket facts');const after=await s.b.get(s.path);assert.equal(after.value.status,'IN_PROGRESS');assert.equal(after.value.assignee_id,s.actor.id);assert.equal(after.value.resolver_team_id,'T07_NETWORK');assert.equal(after.value.version,version(s.before.version)+2);assert.deepEqual(after.value.handling_cycle,s.before.handling_cycle);assert.deepEqual((await s.a.get(s.path+'/responsibility')).value.conversations,s.communication.conversations);assert.deepEqual((await s.a.get(s.path+'/deliveries')).value,s.notices);const prior=rows(s.events.items),events=rows((await s.a.get(s.path+'/events')).value.items);assert.deepEqual(events.slice(0,prior.length),prior);assert.deepEqual(events.slice(prior.length).map(row=>row.event_type),['ticket.assignment_transferred','ticket.started']);await capture('committed-current-facts-600px.png');
   await browser.command('Emulation.setDeviceMetricsOverride',{width:390,height:844,deviceScaleFactor:1,mobile:true});assert.ok(await browser.evaluate('document.documentElement.scrollWidth<=window.innerWidth+1'));await capture('committed-narrow-390px.png');const diagnostic=join(directory,'receipt.json');await writeFile(diagnostic,JSON.stringify({requests,screenshots,formal_production_bundle:true,real_http_pg:true,one_post:true,current_read:true}));console.log('T07_BROWSER_DIAGNOSTIC '+JSON.stringify({file:diagnostic.replaceAll('\\','/')}));console.log('T07_BROWSER_ATOMIC_START '+JSON.stringify({formal_production_bundle:true,staff_handler:true,one_post:true,current_read:true,original_cycle:true,screenshots}));
  }catch(error){primary=error;console.error('T07_BROWSER_PRIMARY '+JSON.stringify({message:error instanceof Error?error.message:String(error),directory:directory.replaceAll('\\','/')}));}
  await closeBrowserTestResources([async()=>{if(primary&&browser){await writeFile(join(directory,'failure.png'),Buffer.from(text(await browser.screenshot()),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify({requests,page:await browser.evaluate('({text:document.body.innerText,url:location.pathname})')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',observe);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);}],primary);
 },{...acceptedOptions,workbenchDraftRecoveryEnabled:false});
});
