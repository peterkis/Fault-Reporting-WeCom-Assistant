import assert from 'node:assert/strict';
import {test} from 'node:test';
import {candidateBrowser,record} from './helpers/wbint-t27-browser-fixture.mjs';
export const inspectDrafts="(async()=>{const names=await indexedDB.databases();if(!names.some(db=>db.name==='wecom-workbench-drafts-v1'))return {drafts:[],operations:[]};const db=await new Promise((resolve,reject)=>{const r=indexedDB.open('wecom-workbench-drafts-v1');r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);});try{return await new Promise((resolve,reject)=>{const t=db.transaction(['drafts','operations'],'readonly'),r=t.objectStore('drafts').getAll(),o=t.objectStore('operations').getAll();t.oncomplete=()=>resolve({drafts:r.result.map(row=>({kind:row.kind,id:row.id,purpose:row.purpose,firstSavedAt:row.firstSavedAt,expiresAt:row.expiresAt,extractable:row.key.extractable,algorithm:row.key.algorithm.name,ciphertextBytes:row.ciphertext.byteLength,keys:Object.keys(row)})),operations:o.result});t.onabort=()=>reject(t.error);});}finally{db.close();}})()";
test('T27 canonical encrypted candidate recovery restores its original capture and expires after the original 24h',async()=>{
 await candidateBrowser({purpose:'t27draft',recovery:true},async({candidateId,browser,root,choose})=>{
  assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelectorAll('[data-candidate-draft]').length`),1,'the independently enabled purpose must provide its real consumer');
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);
  await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);
  const saved=record(await browser.evaluate(inspectDrafts));assert.ok(Array.isArray(saved.drafts)&&Array.isArray(saved.operations));assert.equal(saved.drafts.length,1);assert.equal(saved.operations.length,0);const draft=record(saved.drafts[0]);assert.equal(draft.kind,'incident-candidate');assert.equal(draft.id,candidateId);assert.equal(draft.purpose,'incident-review');assert.equal(typeof draft.firstSavedAt,'number');assert.equal(typeof draft.expiresAt,'number');if(typeof draft.firstSavedAt!=='number'||typeof draft.expiresAt!=='number')throw Error('DRAFT_TIME_REQUIRED');assert.equal(draft.expiresAt-draft.firstSavedAt,86_400_000);assert.equal(draft.extractable,false);assert.equal(draft.algorithm,'AES-GCM');assert.ok(typeof draft.ciphertextBytes==='number'&&draft.ciphertextBytes>16);assert.ok(Array.isArray(draft.keys));assert.equal(draft.keys.some(key=>['value','body','text','refs'].includes(key)),false);
  const captured=await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-captured-basis]').innerText`);await browser.command('Page.reload');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已恢复')`);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="人工决定"]').value`),'START_REVIEW');assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-captured-basis]').innerText`),captured);const restored=record(await browser.evaluate(inspectDrafts));assert.ok(Array.isArray(restored.drafts));assert.equal(record(restored.drafts[0]).firstSavedAt,draft.firstSavedAt);
  await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:`Date.now=()=>${draft.expiresAt+1};`});await browser.command('Page.reload');await browser.waitFor(`Boolean(document.querySelector(${JSON.stringify(root)})?.querySelector('select[aria-label="人工决定"]'))`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="人工决定"]').value===''`);const expired=record(await browser.evaluate(inspectDrafts));assert.deepEqual(expired.drafts,[]);assert.deepEqual(expired.operations,[]);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);
 });
});
