import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {tmpdir} from 'node:os';
import type {IncomingMessage,ServerResponse} from 'node:http';
import {withT12Profile} from './helpers/t12-profile-fixture.mjs';
import type {T11Fixture} from './helpers/t11-completion-fixture.mjs';
import {acceptedSetup,object,rows,text,version} from './helpers/t07-public-fixture.mjs';
import {createPilotAccessService} from '../app/server/src/p1-009-pilot-access-workbench.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';

type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
type Fact={method:string;path:string;status:number|null;body:unknown};
const stored="new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result,operations:operations.result});};};})";
async function input(browser:Browser,selector:string,value:string){await browser.evaluate(`(()=>{const element=document.querySelector(${JSON.stringify(selector)});Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(element,${JSON.stringify(value)});element.dispatchEvent(new Event('input',{bubbles:true}));})()`);}
async function fill(browser:Browser){await browser.waitFor("document.querySelector('.ticket-takeover-completion select')?.options.length>2&&document.querySelector('.ticket-takeover-completion select').disabled===false");await browser.evaluate("(()=>{const element=document.querySelector('.ticket-takeover-completion select');Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(element,'T07_NETWORK');element.dispatchEvent(new Event('change',{bubbles:true}));})()");await browser.waitFor("document.querySelector('.ticket-takeover-completion input[value=RETAIN_CURRENT]').disabled===false");await browser.evaluate("document.querySelector('.ticket-takeover-completion input[value=RETAIN_CURRENT]').click()");await input(browser,'#takeover-completion-process','T12_PURPOSE_PRIVATE_CANARY');await input(browser,'#takeover-completion-summary','服务恢复，单独确认的公开摘要。');await browser.waitFor("document.querySelector('#takeover-completion-confirmed').disabled===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-confirmed').checked"),true);await browser.waitFor("document.querySelector('[data-action=takeover-and-complete]').disabled===false&&document.querySelector('[data-takeover-completion-draft-status]').textContent.includes('已保存恢复副本')");}
function observer(cookie:{name:string;value:string},origin:string,facts:Fact[]){return(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(cookie.name+'='+cookie.value))return;const path=new URL(request.url??'/',origin).pathname;if(!path.startsWith('/api/'))return;const row:Fact={method:request.method??'',path,status:null,body:null};facts.push(row);response.once('finish',()=>{row.status=response.statusCode;});if(row.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{row.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{row.body=null;}});}};}
async function finish(f:T11Fixture,browser:Browser|undefined,directory:string,facts:Fact[],listener:(request:IncomingMessage,response:ServerResponse)=>void,primary:unknown,release?:()=>Promise<unknown>){await closeBrowserTestResources([async()=>{await release?.();if(browser){const bytes=Buffer.from(text(await browser.screenshot()),'base64'),file=join(directory,primary?'failure.png':'terminal.png');await writeFile(file,bytes);await writeFile(join(directory,'receipt.json'),JSON.stringify({facts,primary_failure:primary instanceof Error?primary.message:null,screenshot:{file:file.replaceAll('\\','/'),sha256:createHash('sha256').update(bytes).digest('hex')}}));await writeFile(join(directory,'page.json'),JSON.stringify(await browser.evaluate('({text:document.body.innerText})')));console.log('T12_PURPOSE_STORAGE_DIAGNOSTIC '+JSON.stringify({file:join(directory,'receipt.json').replaceAll('\\','/')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',listener);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);}],primary);}

test('T12 discard and committed local cleanup failure preserve another purpose, and manual original GET plus successful cleanup release the navigation guard without another POST',async()=>{
 await withT12Profile(async f=>{
  const s=await acceptedSetup(f);assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_PURPOSE_START'})).status,200);assert.equal((await createPilotAccessService({pool:f.pool}).upsertPrincipal({wecomUserId:'web01-synthetic-0',displayName:'林舟',roles:['ADMIN'],resolverTeamIds:['PILOT_IT','T07_NETWORK']})).id,s.owner.id);const initial=(await s.a.get(s.path)).value;assert.ok(Array.isArray(initial.allowed_actions)&&initial.allowed_actions.includes('add-note'));assert.deepEqual((await s.a.get(s.path+'/takeover-completion-targets?resolver_team_id=T07_NETWORK')).value.allowed_actions,['takeover-and-complete']);const cookie=f.browserCookies[0];assert.ok(cookie);const facts:Fact[]=[],listener=observer(cookie,f.origin,facts),directory=join(tmpdir(),'t12-purpose-settlement-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;f.runtime.server.on('request',listener);
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[{...cookie,url:text(cookie.url)}]});assert.ok(browser);await browser.waitFor("Boolean(document.querySelector('#internal-note'))");await input(browser,'#internal-note','T12_INDEPENDENT_UNSENT_NOTE');await browser.waitFor("document.querySelector('[data-draft-status]')?.textContent.includes('已保存恢复副本')");await fill(browser);
   const before=object(await browser.evaluate(stored)),note=rows(before.drafts).filter(row=>row.purpose==='internal-note');assert.equal(note.length,1);assert.equal(rows(before.drafts).filter(row=>row.purpose==='ticket-takeover-completion').length,1);assert.equal(JSON.stringify(before).includes('T12_PURPOSE_PRIVATE_CANARY'),false);assert.equal(JSON.stringify(before).includes('T12_INDEPENDENT_UNSENT_NOTE'),false);
   await browser.evaluate("document.querySelector('[data-action=discard-takeover-completion]').click()");await browser.waitFor("document.querySelector('[data-takeover-completion-draft-status]')?.textContent.includes('恢复副本已清理')");const discarded=object(await browser.evaluate(stored));assert.deepEqual(rows(discarded.drafts).filter(row=>row.purpose==='internal-note'),note);assert.equal(rows(discarded.drafts).some(row=>row.purpose==='ticket-takeover-completion'),false);assert.equal(await browser.evaluate("document.querySelector('#internal-note').value"),'T12_INDEPENDENT_UNSENT_NOTE');assert.equal(facts.filter(row=>row.method==='POST').length,0);
   await fill(browser);await browser.evaluate("(()=>{const remove=IDBObjectStore.prototype.delete;globalThis.__failT12Settlement=true;globalThis.__t12SettlementFailures=0;IDBObjectStore.prototype.delete=function(key){if(this.name==='operations'&&String(key).includes('ticket-takeover-completion')&&globalThis.__failT12Settlement){globalThis.__t12SettlementFailures++;throw new DOMException('synthetic local settlement failure','UnknownError');}return remove.call(this,key);};})()");
   await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').click()");await browser.waitFor("document.querySelector('[data-toast-source=ticket-takeover-completion]')?.innerText.includes('清理尚未确认')&&Boolean(document.querySelector('[data-action=check-takeover-completion]'))");assert.ok(Number(await browser.evaluate('globalThis.__t12SettlementFailures'))>0);const posts=facts.filter(row=>row.method==='POST');assert.equal(posts.length,1);assert.equal(posts[0]?.status,200);const original=object(posts[0]?.body);assert.equal((await s.b.get(s.path)).value.status,'CLOSED');assert.equal((await s.b.get(s.path)).value.version,version(initial.version)+2);
   const retained=object(await browser.evaluate(stored));assert.equal(rows(retained.operations).find(row=>row.purpose==='ticket-takeover-completion')?.commandId,original.client_command_id);assert.deepEqual(rows(retained.drafts).filter(row=>row.purpose==='internal-note'),note);assert.equal(await browser.evaluate("(()=>{const event=new Event('beforeunload',{cancelable:true});window.dispatchEvent(event);return event.defaultPrevented;})()"),true,'unconfirmed local settlement keeps the guard and original operation');
   await browser.evaluate('globalThis.__failT12Settlement=false');await browser.evaluate("document.querySelector('[data-action=check-takeover-completion]').click()");await browser.waitFor("document.querySelector('[data-toast-source=ticket-takeover-completion]')?.innerText.includes('已核对原操作')&&!document.querySelector('[data-action=check-takeover-completion]')");
   const settled=object(await browser.evaluate(stored));assert.equal(rows(settled.drafts).some(row=>row.purpose==='ticket-takeover-completion'),false);assert.equal(rows(settled.operations).some(row=>row.purpose==='ticket-takeover-completion'),false);assert.deepEqual(rows(settled.drafts).filter(row=>row.purpose==='internal-note'),note);assert.equal(await browser.evaluate("document.querySelector('#internal-note').value"),'T12_INDEPENDENT_UNSENT_NOTE');assert.equal(facts.filter(row=>row.method==='POST').length,1);assert.equal(facts.filter(row=>row.method==='GET'&&row.path===s.path+'/takeover-completion/commands/'+text(original.client_command_id)&&row.status===200).length,1);
   await browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await browser.evaluate("(()=>{const event=new Event('beforeunload',{cancelable:true});window.dispatchEvent(event);return event.defaultPrevented;})()"),false,'known terminal and successful local cleanup release the T12 guard; the other purpose is safely saved');assert.equal((await f.pool.query('SELECT 1 FROM pilot_ticket.staff_completion_notification_commitment WHERE ticket_id=$1::uuid',[s.first.ticket.id])).rowCount,1);
  }catch(error){primary=error;}await finish(f,browser,directory,facts,listener,primary);
 });
});

test('late actual T12 WebCrypto decryption cannot revive a saved private draft after current principal401 clears the scope',async()=>{
 await withT12Profile(async f=>{
  const s=await acceptedSetup(f);assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_DECRYPT_START'})).status,200);const initial=(await s.b.get(s.path)).value,cookie=f.browserCookies[2];assert.ok(cookie);const facts:Fact[]=[],listener=observer(cookie,f.origin,facts),directory=join(tmpdir(),'t12-late-decrypt-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;f.runtime.server.on('request',listener);
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[{...cookie,url:text(cookie.url)}]});assert.ok(browser);await fill(browser);assert.equal(rows(object(await browser.evaluate(stored)).drafts).filter(row=>row.purpose==='ticket-takeover-completion').length,1);
   await browser.command('Page.enable');await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:"(()=>{const decrypt=crypto.subtle.decrypt.bind(crypto.subtle);crypto.subtle.decrypt=(...args)=>new TextDecoder().decode(args[0].additionalData).includes('ticket-takeover-completion')?new Promise((resolve,reject)=>{globalThis.__releaseT12Decrypt=()=>decrypt(...args).then(value=>{globalThis.__t12DecryptFinished=true;resolve(value);},reject);}):decrypt(...args);})()"});const origin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${origin}&&typeof globalThis.__releaseT12Decrypt==='function'&&Boolean(document.querySelector('[data-action=refresh-takeover-completion]'))`);assert.equal(await browser.evaluate("document.body.innerText.includes('T12_PURPOSE_PRIVATE_CANARY')||document.querySelector('#takeover-completion-process')?.value==='T12_PURPOSE_PRIVATE_CANARY'"),false);
   await f.pool.query('UPDATE pilot_ticket.pilot_principal SET is_active=false WHERE id=$1::uuid',[s.actor.id]);assert.equal((await s.b.get('/api/lifecycle/bootstrap')).status,401);await browser.evaluate("document.querySelector('[data-action=refresh-takeover-completion]').click()");await browser.waitFor("!document.querySelector('.ticket-takeover-completion')&&!document.querySelector('#detail-title')");await browser.evaluate('globalThis.__releaseT12Decrypt()');await browser.waitFor('globalThis.__t12DecryptFinished===true');await browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await browser.evaluate("Boolean(document.querySelector('.ticket-takeover-completion'))||document.body.innerText.includes('T12_PURPOSE_PRIVATE_CANARY')"),false);assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal(facts.filter(row=>row.method==='POST').length,0);assert.equal((await s.a.get(s.path)).value.version,version(initial.version));assert.equal((await f.pool.query('SELECT 1 FROM pilot_ticket.staff_completion_notification_commitment WHERE ticket_id=$1::uuid',[s.first.ticket.id])).rowCount,0);
  }catch(error){primary=error;}const active=browser;await finish(f,browser,directory,facts,listener,primary,async()=>{if(active)await active.evaluate("typeof globalThis.__releaseT12Decrypt==='function'?globalThis.__releaseT12Decrypt():null");});
 },{notesEnabled:false});
});
