import {test} from 'node:test';
import assert from 'node:assert/strict';
import {writeFile,mkdir} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {randomUUID} from 'node:crypto';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
import {withT20FeedbackFixture,t20Object} from './helpers/t20-feedback-fixture.mjs';
import {browser} from './helpers/yxx-ss-009-http-fixture.mjs';
import {createP2016Runtime} from '../src/p2-016-runtime.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
function errorFacts(error:unknown):unknown{return error instanceof Error?{name:error.name,message:error.message,stack:error.stack,...(error instanceof AggregateError?{errors:error.errors.map(errorFacts)}:{})}:error===null?null:String(error);}
test('production PC consumes the authorized previous completion actor hint from real own-Reporter feedback and hides it on lost authentication',{timeout:240_000},async()=>{
 await withT20FeedbackFixture(async f=>{
  const directory=join(tmpdir(),'t20-member-origin-hint-'+randomUUID());await mkdir(directory);
  const response=await f.send();assert.equal(response.status,200);await writeFile(join(directory,'original-feedback-post-observation.json'),JSON.stringify({path:f.path+'/feedback',status:response.status,body:response.json()}));const member=t20Object((await f.member.request(f.path)).json());assert.equal(Object.hasOwn(member,'reopen_follow_up'),false,'M never receives internal staff follow-up metadata');
  await f.app.stop();const runtime=createP2016Runtime({pool:f.context.pool,flags:{TICKET_LIFECYCLE_WORKBENCH_ENABLED:true},publicOrigin:f.context.origin,listenPort:Number(new URL(f.context.origin).port),principalIds:[f.context.principals[0]?.id??''],externalSendEnabled:false,ticketSelfHandlingEnabled:true,ticketStaffCompletionEnabled:true,ticketReopenRoundsEnabled:true,workbenchDraftRecoveryEnabled:false});
  if('disabled' in runtime)throw Error('T20_MEMBER_HINT_RUNTIME_DISABLED');let tab:Browser|undefined,error:unknown;
  try{
   const started=await runtime.start();assert.ok(started.cookies);const cookie=started.cookies[0];assert.ok(cookie);const reader=browser(runtime.server);reader.cookies.set(cookie.name,cookie.value);const bootstrap=await reader.request('/api/lifecycle/bootstrap');assert.equal(bootstrap.status,200);const authority=t20Object(bootstrap.json());assert.deepEqual(authority.roles,['ADMIN']);assert.equal(authority.principal_id,f.context.principals[0]?.id,'the actor really performed the original public T04/T11 completion');assert.equal(authority.ticket_reopen_draft_recovery_enabled,false);
   const path='/api/tickets/'+f.ticketId,detail=await reader.request(path);assert.equal(detail.status,200);const current=t20Object(detail.json());assert.deepEqual(current.reopen_follow_up,{origin:'WEB_REPORTER',is_previous_handler:true,awaiting_acceptance:true});assert.equal(current.assignee_id,null);assert.equal(current.resolver_team_id,f.completed.resolver_team_id);assert.equal(current.version,f.completed.version+1);
   assert.equal(typeof cookie.url,'string');tab=await launchSystemBrowser({url:f.context.origin+'/workbench/app/items/ticket/'+f.ticketId,width:1920,height:1080,cookies:[{...cookie,url:cookie.url as string}]});assert.ok(tab);
   await tab.waitFor("document.querySelector('.properties')?.textContent.includes('重新')&&document.querySelector('.ticket-reopen')?.textContent.includes('工单版本')&&!document.querySelector('.ticket-reopen')?.textContent.includes('正在读取重开权限')");assert.equal(await tab.evaluate("Boolean(document.querySelector('[data-reopen-follow-up]'))"),true);assert.equal(await tab.evaluate("document.querySelector('[data-reopen-follow-up]')?.textContent.includes('上轮由您处理')&&document.querySelector('[data-reopen-follow-up]')?.textContent.includes('报修人反馈仍未解决')&&document.querySelector('[data-reopen-follow-up]')?.textContent.includes('等待重新承接')"),true);assert.deepEqual(await tab.evaluate('indexedDB.databases().then(values=>values.map(value=>value.name))'),[],'cold raw OFF allocates no journal');await writeFile(join(directory,'authorized-member-origin-hint-1920.png'),Buffer.from(await tab.screenshot(),'base64'));
   await f.context.pool.query('UPDATE pilot_ticket.pilot_principal SET is_active=false WHERE id=$1::uuid',[f.context.principals[0]?.id]);const denied=await reader.request(path);assert.equal(denied.status,401);assert.deepEqual(denied.json(),{error:{code:'WORKBENCH_UNAUTHENTICATED',retryable:false}});
   await tab.command('Page.enable');const previous=await tab.evaluate('performance.timeOrigin');await tab.command('Page.reload');await tab.waitFor(`performance.timeOrigin!==${previous}&&document.readyState==='complete'`);await tab.waitFor("document.body.innerText.includes('会话已失效，请重新进入已授权工作台。')&&!document.querySelector('[data-reopen-follow-up]')&&!document.querySelector('#reopen-reason')");assert.equal(await tab.evaluate("document.body.innerText.includes('报修人反馈仍未解决')"),false);const fact=(await f.context.pool.query<{status:string;version:number;assignee_id:string|null}>('SELECT status,version,assignee_id::text FROM pilot_ticket.ticket WHERE id=$1::uuid',[f.ticketId])).rows[0];assert.deepEqual(fact,{status:'REOPENED',version:f.completed.version+1,assignee_id:null});await writeFile(join(directory,'terminal-denied-and-facts.json'),JSON.stringify({status:denied.status,body:denied.json(),fact}));await writeFile(join(directory,'lost-authority-1920.png'),Buffer.from(await tab.screenshot(),'base64'));console.log('T20_MEMBER_ORIGIN_HINT '+JSON.stringify({directory,previous_actor_role:'ADMIN',production_asset:true,real_http_pg:true,external_calls:0}));
  }catch(failure){error=failure;await writeFile(join(directory,'primary-error.json'),JSON.stringify(errorFacts(failure)));if(tab){try{await writeFile(join(directory,'failure.png'),Buffer.from(await tab.screenshot(),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify(await tab.evaluate('({text:document.body.innerText,path:location.pathname})')));}catch(observation){error=new AggregateError([failure,observation],'T20_MEMBER_HINT_OBSERVATION_FAILED');await writeFile(join(directory,'observer-error.json'),JSON.stringify(errorFacts(observation)));}}}
  try{await closeBrowserTestResources([async()=>{await tab?.close();if(tab)assert.deepEqual(tab.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{await runtime.stop();assert.equal(runtime.server.listening,false);}],error);}catch(failure){await writeFile(join(directory,'terminal-error-and-cleanup.json'),JSON.stringify({primary:errorFacts(error??null),terminal:errorFacts(failure),browser:tab?.ownedResourceState()??null,listener:runtime.server.listening}));console.error('T20_MEMBER_HINT_FAILURE_POINTER '+directory);throw failure;}
 });
});
