import assert from 'node:assert/strict';
import {test} from 'node:test';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';

test('T27 persists its immutable original intent before real POST and a lost committed acknowledgement recovers only its original receipt',async()=>{
 await candidateBrowser({purpose:'t27unknown',recovery:true},async({pool,candidateId,browser,root,choose})=>{
  const personal=(await pool.query('SELECT id::text,status,version FROM pilot_ticket.ticket ORDER BY id')).rows;
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);
  await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);
  const original=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(original.drafts));const saved=record(original.drafts[0]);
  await browser.evaluate(`(()=>{const send=fetch;globalThis.fetch=async(path,options)=>{if(options?.method==='POST'&&String(path)==='/api/incident-candidates/${candidateId}/start-review'){globalThis.__t27BeforePost=await ${candidateCopies};globalThis.__t27Original={path:String(path),body:JSON.parse(options.body),headers:options.headers};const response=await send(path,options);globalThis.__t27CommittedTransport={status:response.status,body:await response.clone().json()};throw new TypeError('T27_REAL_ACKNOWLEDGEMENT_LOST');}return send(path,options);};})()`);
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-action=submit-candidate]')?.disabled===false`);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('结果未知')`);
  const transport=record(await browser.evaluate('globalThis.__t27CommittedTransport'));assert.equal(transport.status,200);assert.equal(record(transport.body).ok,true);
  const sent=record(await browser.evaluate('globalThis.__t27Original')),body=record(sent.body),id=text(body.client_command_id);assert.equal(body.expected_row_version,'1');assert.equal(record(sent.headers)['idempotency-key'],id);assert.equal(record(sent.headers)['if-match'],'"1"');
  const boundary=record(await browser.evaluate('globalThis.__t27BeforePost'));assert.ok(Array.isArray(boundary.operations));assert.equal(boundary.operations.length,1,'the original operation must be durable before HTTP dispatch');assert.ok(Array.isArray(boundary.drafts));const copy=record(boundary.drafts[0]),intent=record(copy.value);assert.deepEqual(intent.pending,{candidateId,action:'START_REVIEW',body});assert.equal(copy.firstSavedAt,saved.firstSavedAt);assert.equal(copy.expiresAt,saved.expiresAt);
  const previous=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${previous}&&Boolean(document.querySelector(${JSON.stringify(root)})?.querySelector('[data-action=check-candidate-operation]'))`);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').disabled`),true);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);
  const restored=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(restored.drafts));assert.deepEqual(record(record(restored.drafts[0]).value).pending,{candidateId,action:'START_REVIEW',body});assert.equal(record(restored.drafts[0]).firstSavedAt,saved.firstSavedAt);
  await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('原操作已确认提交')`);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);const settled=record(await browser.evaluate(candidateCopies));assert.deepEqual(settled.operations,[]);assert.deepEqual((await pool.query('SELECT id::text,status,version FROM pilot_ticket.ticket ORDER BY id')).rows,personal);
  for(const table of ['communication.message','communication.outbox','communication.delivery'])assert.equal((await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM '+table)).rows[0]?.count,0);
 });
});
