import assert from 'node:assert/strict';
import {test} from 'node:test';
import {randomUUID} from 'node:crypto';
import {createP2012IncidentCommandService} from '../src/p2-012-incident-command-service.mjs';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';

test('T27 real stable FAILED acknowledgement and original FAILED receipt settle recovery without replacing an immutable UUID or making cleanup failure UNKNOWN',async()=>{
 for(const mode of ['direct','lost','cleanup'])await candidateBrowser({purpose:'t27fail'+mode[0],recovery:true,setup:async({pool,f,candidateId})=>{assert.equal((await createP2012IncidentCommandService({pool,enabled:true}).perform({authContext:{principal_id:text(record(f.admin).id)},command:{action:'START_REVIEW',candidate_review_id:candidateId,expected_row_version:'1',client_command_id:randomUUID(),reason_code:'OPERATOR_REVIEWED'}})).ok,true);}},async({pool,f,candidateId,browser,root,choose})=>{
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);await choose('人工决定','CONFIRM_INCIDENT');await choose('决定原因','CONFIRMED_SHARED_FAULT');await choose('确认范围','LOCAL');await choose('故障负责人',text(record(f.handler).id));await choose('责任组','PILOT_IT');await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('input[data-report-ref="${text(record(f.reports[0]).decisionId)}"]').click()`);await choose('主工单','NONE');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-action=submit-candidate]')?.disabled===false`);
  await pool.query("UPDATE pilot_ticket.resolver_team SET is_active=false WHERE team_id='PILOT_IT'");await browser.evaluate(`(()=>{const send=fetch;globalThis.fetch=async(path,options)=>{const response=await send(path,options);if(options?.method==='POST'&&String(path)==='/api/incident-candidates/${candidateId}/confirm'){globalThis.__t27ActualFailure={status:response.status,body:await response.clone().json(),command:JSON.parse(options.body)};if(${mode==='lost'})throw new TypeError('T27_REAL_FAILED_ACK_LOST');}return response;};})()`);
  if(mode==='cleanup')await browser.evaluate("(()=>{globalThis.__t27SettlementFaults=0;globalThis.__t27Delete=IDBObjectStore.prototype.delete;IDBObjectStore.prototype.delete=function(...args){if(this.name==='operations'){globalThis.__t27SettlementFaults++;throw new DOMException('T27_FAILED_SETTLEMENT_FAILURE','UnknownError');}return globalThis.__t27Delete.apply(this,args);};})()");await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes(${JSON.stringify(mode==='lost'?'结果未知':'原操作已明确失败')})`);const actual=record(await browser.evaluate('globalThis.__t27ActualFailure'));assert.equal(actual.status,409);assert.equal(record(actual.body).ok,false);assert.equal(record(record(actual.body).error).code,'P2_012_OWNER_INVALID');assert.equal(record(record(actual.body).error).retryable,false);const id=text(record(actual.command).client_command_id);assert.equal((await pool.query<{count:number}>('SELECT count(*)::integer AS count FROM incident.incident')).rows[0]?.count,0);
  if(mode==='lost'){const previous=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${previous}&&Boolean(document.querySelector(${JSON.stringify(root)})?.querySelector('[data-action=check-candidate-operation]'))`);const copy=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(copy.drafts));assert.deepEqual(record(record(copy.drafts[0]).value).pending,{candidateId,action:'CONFIRM_INCIDENT',body:actual.command});await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('原操作已明确失败')`);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);}
  const stored=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(stored.operations));if(mode!=='cleanup')assert.deepEqual(stored.operations,[],mode+' stable FAILED must settle the original operation');else{assert.ok(Number(await browser.evaluate('globalThis.__t27SettlementFaults'))>0);assert.equal(stored.operations.length,1);assert.equal(record(stored.operations[0]).commandId,id);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-candidate-outcome]').innerText.includes('清理失败')`),true);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-candidate-outcome]').innerText.includes('结果未知')`),false);await browser.evaluate('IDBObjectStore.prototype.delete=globalThis.__t27Delete');await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('原操作已明确失败')&&!document.querySelector(${JSON.stringify(root)}).querySelector('[data-candidate-outcome]').innerText.includes('清理失败')`);assert.deepEqual(record(await browser.evaluate(candidateCopies)).operations,[]);}
  assert.equal((await pool.query<{state:string}>('SELECT state FROM incident.command_receipt WHERE client_command_id=$1::uuid',[id])).rows[0]?.state,'FAILED');assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="故障负责人"]').value`),text(record(f.handler).id));
 });
});
