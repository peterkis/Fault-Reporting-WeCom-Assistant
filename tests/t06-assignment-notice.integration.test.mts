import {test} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {createCommunicationDeliveryWorker} from '../src/p2-004-communication-delivery-worker.mjs';
import type {PostgresPool} from '../src/platform/postgres-pool.mjs';
type Fixture={pool:PostgresPool;origin:string;cookies:string[];tickets:{ticket:{id:string}}[];principals:{id:string}[]};
function object(value:unknown):Record<string,unknown>{assert.ok(value&&typeof value==='object'&&!Array.isArray(value));return value as Record<string,unknown>;}
test('first assignment then explicit acceptance and later transfers preserve one round and never repeat an already acknowledged responsibility notice',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{
  const first=context.tickets[0],admin=context.principals[0],worker=context.principals[1];assert.ok(first&&admin&&worker);const path='/api/tickets/'+first.ticket.id;
  const http=async(index:number)=>{const cookie=context.cookies[index];assert.ok(cookie);const get=async(url:string)=>{const response=await fetch(context.origin+url,{headers:{cookie}});return {status:response.status,value:object(await response.json())};};const bootstrap=(await get('/api/lifecycle/bootstrap')).value;const post=async(url:string,body:Record<string,unknown>)=>{const response=await fetch(context.origin+url,{method:'POST',headers:{cookie,origin:context.origin,'content-type':'application/json','x-csrf-token':String(bootstrap.csrf_token),'idempotency-key':String(body.client_command_id),'if-match':'"'+body.expected_version+'"'},body:JSON.stringify(body)});return {status:response.status,value:object(await response.json())};};return {get,post};};const a=await http(0),b=await http(2);
  const assign={client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_ASSIGN',target_principal_id:worker.id,resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]};const assigned=await a.post(path+'/assign',assign);assert.equal(assigned.status,200);const cycle=(await a.get(path)).value.handling_cycle;assert.equal(object(cycle).first_responsibility_event_id,assigned.value.ticket_event_id);
  const notices=()=>context.pool.query<{delivery_id:string}>("SELECT delivery_id::text FROM communication.ticket_notification_binding WHERE ticket_id=$1::uuid AND notification_type='TICKET_ACCEPTED' ORDER BY id",[first.ticket.id]);assert.equal((await notices()).rowCount,0);
  const acceptedIntent={client_command_id:randomUUID(),expected_version:3,reason_code:'WORKBENCH_SELF_HANDLING',resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]};assert.equal((await b.post(path+'/accept-for-later-with-conversations',acceptedIntent)).status,200);const accepted=(await notices()).rows;assert.equal(accepted.length,1,'the existing accepted responsibility promise must actually exist before testing transfer deduplication');let calls=0;const delivery=createCommunicationDeliveryWorker({pool:context.pool,enabled:true,sender:{send:async()=>{calls++;return {outcome:'ACKNOWLEDGED',provider_message_id:'T06_SYNTHETIC_ACK',error_code:null,retryable:false};}}});const notice=accepted[0];assert.ok(notice);assert.equal((await delivery.deliver({deliveryId:notice.delivery_id}))?.status,'SENT');assert.equal(calls,1);
  const transfer={...assign,client_command_id:randomUUID(),expected_version:4,reason_code:'WORKBENCH_TRANSFER',target_principal_id:admin.id};assert.equal((await a.post(path+'/transfer-assignment',transfer)).status,200);assert.equal((await a.get(path)).value.status,'ACCEPTED');assert.deepEqual((await a.get(path)).value.handling_cycle,cycle);assert.deepEqual((await notices()).rows,accepted);
  assert.equal((await a.post(path+'/take-and-start-with-conversations',{...acceptedIntent,client_command_id:randomUUID(),expected_version:5})).status,200);assert.equal((await a.get(path)).value.status,'IN_PROGRESS');const transferredBack={...transfer,client_command_id:randomUUID(),expected_version:6,target_principal_id:worker.id};assert.equal((await a.post(path+'/transfer-assignment',transferredBack)).status,200);assert.equal((await a.post(path+'/transfer-assignment',transferredBack)).value.replayed,true);assert.equal((await b.post(path+'/accept-for-later-with-conversations',acceptedIntent)).value.replayed,true);
  assert.deepEqual((await notices()).rows,accepted);assert.deepEqual((await a.get(path)).value.handling_cycle,cycle);assert.equal((await context.pool.query('SELECT count(*)::int AS n FROM pilot_ticket.ticket_handling_cycle WHERE ticket_id=$1::uuid',[first.ticket.id])).rows[0]?.n,1);assert.equal(await delivery.deliver({deliveryId:notice.delivery_id}),null);assert.equal(calls,1);console.log('T06_EXISTING_NOTICE '+JSON.stringify({accepted_notice:1,stub_acknowledgements:calls,same_cycle:true,real_external_send:false}));
 },{ticketAssignmentEnabled:true,ticketConversationSelfHandlingEnabled:true,ticketSelfHandlingWebSource:false});
});
