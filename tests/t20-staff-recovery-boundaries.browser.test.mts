import {test} from 'node:test';
import assert from 'node:assert/strict';
import {writeFile,mkdir} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {randomUUID} from 'node:crypto';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
import {withT11Fixture,t11Http,t11NewTicket} from './helpers/t11-completion-fixture.mjs';
import {createP2016Runtime} from '../src/p2-016-runtime.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
interface StorageFacts{firstSavedAt:number;expiresAt:number;revision:string;extractable:boolean;exportError:string;algorithm:{name:string;length:number};ivBytes:number;cipherBytes:number;hasPlainCanary:boolean;drafts:number;commandId:string|null;operationKeys:string[]}
function errorFacts(error:unknown):unknown{return error instanceof Error?{name:error.name,message:error.message,stack:error.stack,...(error instanceof AggregateError?{errors:error.errors.map(errorFacts)}:{})}:error===null?null:String(error);}
const typeReason=(tab:Browser,text:string)=>tab.evaluate(`(()=>{const input=document.querySelector('#reopen-reason');Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(input,${JSON.stringify(text)});input.dispatchEvent(new Event('input',{bubbles:true}));})()`);
function stored(scope:string){return `(async()=>{const value=await new Promise((resolve,reject)=>{const request=indexedDB.open('wecom-workbench-drafts-v1');request.onerror=()=>reject(request.error);request.onupgradeneeded=()=>request.transaction.abort();request.onsuccess=()=>{const db=request.result,tx=db.transaction(['drafts','operations'],'readonly'),draft=tx.objectStore('drafts').get(${JSON.stringify(scope)}),operation=tx.objectStore('operations').get(${JSON.stringify(scope)});tx.oncomplete=()=>{db.close();resolve({draft:draft.result,operation:operation.result});};tx.onabort=()=>{db.close();reject(tx.error);};};});let exportError='';if(value.draft){try{await crypto.subtle.exportKey('raw',value.draft.key);}catch(error){exportError=error.name;}}return {firstSavedAt:value.draft?.firstSavedAt??0,expiresAt:value.draft?.expiresAt??0,revision:value.draft?.revision??'',extractable:value.draft?.key.extractable??false,exportError,algorithm:value.draft?.key.algorithm??{name:'',length:0},ivBytes:value.draft?.iv.byteLength??0,cipherBytes:value.draft?.ciphertext.byteLength??0,hasPlainCanary:JSON.stringify(value).includes('T20_PRIVATE_REASON_CANARY'),drafts:value.draft?1:0,commandId:value.operation?.commandId??null,operationKeys:value.operation?Object.keys(value.operation).sort():[]};})()`;}
for(const boundary of ['expiry','corrupt'] as const){
 test('production HANDLER '+boundary+' clears staff-reopen sensitive recovery and preserves its original FAILED UUID for explicit GET',{timeout:240_000},async()=>{
  await withT11Fixture(async context=>{
   await context.runtime.stop();const runtime=createP2016Runtime({pool:context.pool,flags:{TICKET_LIFECYCLE_WORKBENCH_ENABLED:true},publicOrigin:context.origin,listenPort:Number(new URL(context.origin).port),principalIds:[context.principals[0]?.id??'',context.outsider.id,context.principals[1]?.id??''],externalSendEnabled:false,ticketSelfHandlingEnabled:true,ticketStaffCompletionEnabled:true,ticketReopenRoundsEnabled:true,workbenchInternalNotesEnabled:true,workbenchDraftRecoveryEnabled:true});
   if('disabled' in runtime)throw Error('T20_BOUNDARY_RUNTIME_DISABLED');let tab:Browser|undefined,error:unknown;
   const directory=join(tmpdir(),'t20-staff-recovery-'+boundary+'-'+randomUUID());await mkdir(directory);
   try{
    const started=await runtime.start();assert.ok(started.cookies);const current={...context,runtime,cookies:started.cookies.map(value=>value.name+'='+value.value)},http=await t11Http(current,2);
    const bootstrap=await (await http.get('/api/lifecycle/bootstrap')).json() as {roles:string[];principal_id:string;ticket_reopen_draft_recovery_enabled:boolean};assert.deepEqual(bootstrap.roles,['HANDLER']);assert.equal(bootstrap.ticket_reopen_draft_recovery_enabled,true);
    const id=await t11NewTicket(current),active=await http.start(id);assert.equal((await http.post(id,'complete',http.command(active))).status,200);const closed=await http.detail(id),cookie=started.cookies[2];assert.ok(cookie);assert.equal(typeof cookie.url,'string');assert.equal(closed.status,'CLOSED');
    tab=await launchSystemBrowser({url:context.origin+'/workbench/app/items/ticket/'+id,width:1920,height:1080,cookies:[{...cookie,url:cookie.url as string}]});assert.ok(tab);
    await tab.waitFor("document.querySelector('.ticket-reopen')?.textContent.includes('工单版本')&&!document.querySelector('.ticket-reopen')?.textContent.includes('正在读取重开权限')");
    const scope=JSON.stringify([bootstrap.principal_id,'ticket',id,'staff-reopen']),expression=stored(scope);
    await typeReason(tab,'T20_PRIVATE_REASON_CANARY first');await tab.waitFor("document.querySelector('[data-reopen-draft-status]')?.textContent.includes('已保存恢复副本')");
    const first=await tab.evaluate(expression) as StorageFacts;assert.equal(first.drafts,1);assert.equal(first.extractable,false);assert.equal(first.exportError,'InvalidAccessError');assert.deepEqual(first.algorithm,{name:'AES-GCM',length:256});assert.equal(first.ivBytes,12);assert.ok(first.cipherBytes>16&&first.cipherBytes<=16400);assert.equal(first.hasPlainCanary,false);assert.equal(first.expiresAt-first.firstSavedAt,86_400_000);
    // Controlled frontend clock only; backend/authentication time and real public commands remain unchanged.
    await tab.evaluate("(()=>{const now=Date.now;Date.now=()=>now()+3600000;})()");await typeReason(tab,'T20_PRIVATE_REASON_CANARY updated');await tab.waitFor(`(async()=>{const stored=await (${expression});return stored.revision!==${JSON.stringify(first.revision)}&&document.querySelector('[data-reopen-draft-status]')?.textContent.includes('已保存恢复副本');})()`);
    const updated=await tab.evaluate(expression) as StorageFacts;assert.equal(updated.firstSavedAt,first.firstSavedAt);assert.equal(updated.expiresAt,first.expiresAt);assert.notEqual(updated.revision,first.revision,'a genuine autosave update must not renew the first-save expiry');
    const note=await http.post(id,'internal-notes',{client_command_id:randomUUID(),expected_version:closed.version,reason_code:'T20_RECOVERY_RACE',note:'合成协作备注，仅推进关闭工单版本',external_visible:false});assert.equal(note.status,200);const changed=await http.detail(id);assert.equal(changed.status,'CLOSED');assert.equal(changed.version,closed.version+1);
    const path='/api/tickets/'+id,observe=String.raw`(()=>{const original=fetch;globalThis.__t20Posts=[];globalThis.__t20Reads=[];globalThis.fetch=async(path,options)=>{const target=String(path);if(options?.method==='POST'){const response=await original(path,options);const body=await response.clone().json();globalThis.__t20Posts.push({path:target,input:JSON.parse(options.body),status:response.status,response:body});if(target.endsWith('/reopen'))throw new TypeError('SIMULATED_FAILED_RESPONSE_LOSS');return response;}globalThis.__t20Reads.push(target);return original(path,options);};})()`;
    await tab.evaluate(observe);await tab.evaluate("document.querySelector('[data-action=reopen-ticket]').click()");await tab.waitFor("globalThis.__t20Posts.length===1&&document.querySelector('[data-reopen-state]')?.textContent.includes('结果未知')");
    const posts=await tab.evaluate('globalThis.__t20Posts') as {path:string;input:{client_command_id:string;expected_version:number};status:number;response:{error:{retryable:boolean}}}[];const original=posts[0];assert.ok(original);assert.equal(original.path,path+'/reopen');assert.equal(original.status,409);assert.equal(original.input.expected_version,closed.version);assert.equal(original.response.error.retryable,false);await writeFile(join(directory,'original-post-observation.json'),JSON.stringify(posts));
    const receipt=await http.get(path+'/reopen/commands/'+original.input.client_command_id);assert.equal(receipt.status,200);assert.equal((await receipt.json() as {state:string}).state,'FAILED');
    const prepared=await tab.evaluate(expression) as StorageFacts;assert.equal(prepared.firstSavedAt,first.firstSavedAt);assert.equal(prepared.expiresAt,first.expiresAt);assert.equal(prepared.commandId,original.input.client_command_id);assert.deepEqual(prepared.operationKeys,['commandId','createdAt','id','kind','principal','purpose','scope']);assert.equal(prepared.hasPlainCanary,false);await writeFile(join(directory,'crypto-and-first-save-facts.json'),JSON.stringify({first,updated,prepared}));
    if(boundary==='corrupt')await tab.evaluate(`new Promise((resolve,reject)=>{const request=indexedDB.open('wecom-workbench-drafts-v1');request.onerror=()=>reject(request.error);request.onsuccess=()=>{const db=request.result,tx=db.transaction('drafts','readwrite'),store=tx.objectStore('drafts'),read=store.get(${JSON.stringify(scope)});read.onsuccess=()=>{const row=read.result,bytes=new Uint8Array(row.ciphertext);bytes[0]^=1;row.ciphertext=bytes.buffer;store.put(row);};tx.oncomplete=()=>{db.close();resolve();};tx.onabort=()=>{db.close();reject(tx.error);};};})`);
    await tab.command('Page.enable');await tab.command('Page.addScriptToEvaluateOnNewDocument',{source:(boundary==='expiry'?"(()=>{const now=Date.now;Date.now=()=>now()+86400001;})();":'')+observe});const previous=await tab.evaluate('performance.timeOrigin');await tab.command('Page.reload');await tab.waitFor(`performance.timeOrigin!==${previous}&&document.readyState==='complete'`);
    await tab.waitFor("Boolean(document.querySelector('[data-action=check-reopen-command]'))&&!document.querySelector('.ticket-reopen')?.textContent.includes('正在读取重开权限')");
    const retained=await tab.evaluate(expression) as StorageFacts;assert.equal(retained.drafts,0);assert.equal(retained.commandId,original.input.client_command_id);assert.equal(retained.hasPlainCanary,false);assert.equal(await tab.evaluate("document.querySelector('#reopen-reason')?.value??''"),'');assert.equal(await tab.evaluate('globalThis.__t20Posts.length'),0);assert.equal(await tab.evaluate(`globalThis.__t20Reads.some(value=>value.startsWith(${JSON.stringify(path+'/reopen/commands/')}))`),false,'reload does not automatically ACK or POST');
    await tab.evaluate("document.querySelector('[data-action=check-reopen-command]').click()");await tab.waitFor("document.querySelector('[data-reopen-state]')?.textContent.includes('已核对原操作被拒绝')");assert.equal(await tab.evaluate(`globalThis.__t20Reads.includes(${JSON.stringify(path+'/reopen/commands/'+original.input.client_command_id)})`),true);assert.equal(await tab.evaluate('globalThis.__t20Posts.length'),0);
    const settled=await tab.evaluate(expression) as StorageFacts;assert.equal(settled.drafts,0);assert.equal(settled.commandId,null);const final=await http.detail(id);assert.equal(final.status,'CLOSED');assert.equal(final.version,changed.version);assert.equal(final.handling_cycle?.id,closed.handling_cycle?.id);await writeFile(join(directory,'terminal-facts.json'),JSON.stringify({boundary,retained,settled,same_cycle:final.handling_cycle?.id===closed.handling_cycle?.id}));await writeFile(join(directory,'terminal.png'),Buffer.from(await tab.screenshot(),'base64'));console.log('T20_STAFF_RECOVERY_BOUNDARY '+JSON.stringify({directory,boundary,role:'HANDLER',frontend_clock_controlled:true,backend_time_unchanged:true}));
   }catch(failure){error=failure;try{await writeFile(join(directory,'primary-error.json'),JSON.stringify(errorFacts(failure)));if(tab){try{await writeFile(join(directory,'failure.png'),Buffer.from(await tab.screenshot(),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify(await tab.evaluate('({text:document.body.innerText,posts:globalThis.__t20Posts,reads:globalThis.__t20Reads})')));}catch(observation){error=new AggregateError([failure,observation],'T20_BOUNDARY_OBSERVATION_FAILED');await writeFile(join(directory,'observer-error.json'),JSON.stringify(errorFacts(observation)));}}}catch(diagnosticFailure){error=new AggregateError([error,diagnosticFailure],'BROWSER_FAILURE_DIAGNOSTICS');}}
   try{await closeBrowserTestResources([async()=>{await tab?.close();if(tab)assert.deepEqual(tab.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{await runtime.stop();assert.equal(runtime.server.listening,false);}],error);}catch(failure){await writeFile(join(directory,'terminal-error-and-cleanup.json'),JSON.stringify({primary:errorFacts(error??null),terminal:errorFacts(failure),browser:tab?.ownedResourceState()??null,listener:runtime.server.listening}));console.error('T20_BOUNDARY_FAILURE_POINTER '+directory);throw failure;}
  });
 });
}

test('production HANDLER with raw recovery enabled keeps input and blocks reopen when native cross-tab support is unavailable',{timeout:240_000},async()=>{
 await withT11Fixture(async context=>{
  await context.runtime.stop();const runtime=createP2016Runtime({pool:context.pool,flags:{TICKET_LIFECYCLE_WORKBENCH_ENABLED:true},publicOrigin:context.origin,listenPort:Number(new URL(context.origin).port),principalIds:[context.principals[0]?.id??'',context.outsider.id,context.principals[1]?.id??''],externalSendEnabled:false,ticketSelfHandlingEnabled:true,ticketStaffCompletionEnabled:true,ticketReopenRoundsEnabled:true,workbenchDraftRecoveryEnabled:true});
  if('disabled' in runtime)throw Error('T20_UNAVAILABLE_RUNTIME_DISABLED');let tab:Browser|undefined,error:unknown;const directory=join(tmpdir(),'t20-staff-recovery-unavailable-'+randomUUID());await mkdir(directory);
  try{
   const started=await runtime.start();assert.ok(started.cookies);const current={...context,runtime,cookies:started.cookies.map(value=>value.name+'='+value.value)},http=await t11Http(current,2),bootstrap=await (await http.get('/api/lifecycle/bootstrap')).json() as {roles:string[];ticket_reopen_draft_recovery_enabled:boolean};assert.deepEqual(bootstrap.roles,['HANDLER']);assert.equal(bootstrap.ticket_reopen_draft_recovery_enabled,true);
   const id=await t11NewTicket(current),active=await http.start(id);assert.equal((await http.post(id,'complete',http.command(active))).status,200);const closed=await http.detail(id),cookie=started.cookies[2];assert.ok(cookie);assert.equal(typeof cookie.url,'string');
   tab=await launchSystemBrowser({url:context.origin+'/workbench/app/items/ticket/'+id,width:1920,height:1080,cookies:[{...cookie,url:cookie.url as string}]});assert.ok(tab);await tab.waitFor("document.querySelector('[data-reopen-draft-status]')?.textContent.includes('草稿仅在当前浏览器')");
   await tab.command('Page.enable');await tab.command('Page.addScriptToEvaluateOnNewDocument',{source:"(()=>{Object.defineProperty(globalThis,'BroadcastChannel',{value:undefined});globalThis.__t20ReopenPosts=0;const original=fetch;globalThis.fetch=(path,options)=>{if(options?.method==='POST'&&String(path).endsWith('/reopen'))globalThis.__t20ReopenPosts++;return original(path,options);};})()"});const previous=await tab.evaluate('performance.timeOrigin');await tab.command('Page.reload');await tab.waitFor(`performance.timeOrigin!==${previous}&&document.readyState==='complete'`);
   await tab.waitFor("document.querySelector('[data-reopen-draft-status]')?.textContent.includes('恢复不可用')&&Boolean(document.querySelector('#reopen-reason'))");await typeReason(tab,'合成原因：跨标签恢复不可用时保留当前输入');assert.equal(await tab.evaluate("document.querySelector('#reopen-reason').value"),'合成原因：跨标签恢复不可用时保留当前输入');assert.equal(await tab.evaluate("document.querySelector('[data-action=reopen-ticket]').disabled"),true);assert.equal(await tab.evaluate('globalThis.__t20ReopenPosts'),0);
   const final=await http.detail(id);assert.equal(final.status,'CLOSED');assert.equal(final.version,closed.version);await writeFile(join(directory,'terminal-facts.json'),JSON.stringify({raw_enabled:true,input_preserved:true,reopen_posts:0,same_version:true}));await writeFile(join(directory,'terminal.png'),Buffer.from(await tab.screenshot(),'base64'));console.log('T20_STAFF_RECOVERY_UNAVAILABLE '+JSON.stringify({directory,role:'HANDLER',raw_enabled:true,production_asset:true}));
  }catch(failure){error=failure;try{await writeFile(join(directory,'primary-error.json'),JSON.stringify(errorFacts(failure)));if(tab){try{await writeFile(join(directory,'failure.png'),Buffer.from(await tab.screenshot(),'base64'));}catch(observation){error=new AggregateError([failure,observation],'T20_UNAVAILABLE_OBSERVATION_FAILED');}}}catch(diagnosticFailure){error=new AggregateError([error,diagnosticFailure],'BROWSER_FAILURE_DIAGNOSTICS');}}
  try{await closeBrowserTestResources([async()=>{await tab?.close();if(tab)assert.deepEqual(tab.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{await runtime.stop();assert.equal(runtime.server.listening,false);}],error);}catch(failure){await writeFile(join(directory,'terminal-error-and-cleanup.json'),JSON.stringify({primary:errorFacts(error??null),terminal:errorFacts(failure),browser:tab?.ownedResourceState()??null,listener:runtime.server.listening}));console.error('T20_UNAVAILABLE_FAILURE_POINTER '+directory);throw failure;}
 });
});
