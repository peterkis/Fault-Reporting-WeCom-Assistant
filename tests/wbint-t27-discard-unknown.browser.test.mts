import assert from 'node:assert/strict';
import {test} from 'node:test';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';
test('T27 explicitly discarding sensitive UNKNOWN recovery keeps its original opaque UUID read-only and never creates a new intent',async()=>{
 await candidateBrowser({purpose:'t27discard',recovery:true},async({candidateId,browser,root,choose})=>{
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);await browser.evaluate(`(()=>{const send=fetch;globalThis.fetch=async(path,options)=>{const response=await send(path,options);if(options?.method==='POST'&&String(path)==='/api/incident-candidates/${candidateId}/start-review'){globalThis.__t27DiscardedAck={status:response.status,body:await response.clone().json()};throw new TypeError('T27_REAL_ACK_LOST');}return response;};})()`);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('结果未知')`);assert.equal(record(await browser.evaluate('globalThis.__t27DiscardedAck')).status,200);const before=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(before.operations)&&before.operations.length===1);const marker=record(before.operations[0]),id=text(marker.commandId);assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=discard-candidate-recovery]'))`),true);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=discard-candidate-recovery]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('select[aria-label="人工决定"]')?.value===''`);const after=record(await browser.evaluate(candidateCopies));assert.deepEqual(after.drafts,[]);assert.deepEqual(after.operations,[marker]);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').disabled`),true);assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=replay-candidate-operation]'))`),false);const posts=await browser.evaluate('globalThis.__t27Posts');assert.ok(Array.isArray(posts)&&posts.length===1);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('已确认提交')`);assert.deepEqual(record(await browser.evaluate(candidateCopies)).operations,[]);const reads=await browser.evaluate('globalThis.__t27DomainReads');assert.ok(Array.isArray(reads));assert.ok(reads.includes('/api/incident-candidates/'+candidateId+'/commands/'+id));assert.equal(await browser.evaluate('globalThis.__t27Posts.length'),1);
 });
});
