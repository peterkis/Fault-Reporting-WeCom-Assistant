import {test} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {seedPersistedIntake} from './helpers/p2-015-postgres-harness.mjs';
import {createContactJourneyStore} from '../src/p2-015-contact-journey.mjs';
import type {PostgresPool} from '../src/platform/postgres-pool.mjs';
import type {P2016EnabledRuntime} from '../src/p2-016-runtime.mjs';
type Fixture={pool:PostgresPool;runtime:P2016EnabledRuntime;origin:string;cookies:string[];tickets:{ticket:{id:string};intake:{intakeId:string}}[];principals:{id:string}[]};
function object(value:unknown):Record<string,unknown>{assert.ok(value&&typeof value==='object'&&!Array.isArray(value));return value as Record<string,unknown>;}
function rows(value:unknown):Record<string,unknown>[]{assert.ok(Array.isArray(value));return value.map(object);}
function string(value:unknown):string{assert.equal(typeof value,'string');return value as string;}
async function http(context:Fixture,index=0){const cookie=context.cookies[index];assert.ok(cookie);const get=async(path:string)=>{const response=await fetch(context.origin+path,{headers:{cookie}});return {status:response.status,value:object(await response.json())};};const bootstrap=(await get('/api/lifecycle/bootstrap')).value;const post=async(path:string,body:Record<string,unknown>,version=body.expected_version??body.expected_row_version)=>{const response=await fetch(context.origin+path,{method:'POST',headers:{cookie,origin:context.origin,'content-type':'application/json','x-csrf-token':String(bootstrap.csrf_token),'idempotency-key':String(body.client_command_id),'if-match':'"'+version+'"'},body:JSON.stringify(body)});return {status:response.status,value:object(await response.json())};};return {get,post};}
function command(target:string,sessions:unknown[]){return {client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_ASSIGN',target_principal_id:target,resolver_team_id:'PILOT_IT',communication_choice:'TRANSFER_SELECTED',sessions};}
async function drain(context:Fixture){const initial=await context.runtime.coordinator.backlog(),bound=Math.ceil(initial.total/context.runtime.coordinator.batchSize)+3;for(let step=0;step<bound;step++){const inbound=await context.runtime.coordinator.runOnce(),realtime=await context.runtime.realtimeProjector.runOnce({limit:100});assert.ok(inbound.streams.every(stream=>stream.failures.length===0));if(inbound.processed===0&&realtime.processed===0&&(await context.runtime.coordinator.backlog()).total===0)return;}assert.fail('finite fixture projection did not settle');}

test('Ticket read access cannot bypass independent communication transfer permission, version, or canonical relation',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{await drain(context);const first=context.tickets[0],other=context.tickets[1],target=context.principals[2];assert.ok(first&&other&&target);const admin=await http(context),handler=await http(context,2),path='/api/tickets/'+first.ticket.id;
  const source=rows((await admin.get(path+'/related-conversations')).value.items)[0];assert.ok(source);assert.equal((await admin.post('/api/conversations/'+source.session_id+'/takeover',{client_command_id:randomUUID(),expected_row_version:Number(source.session_row_version),reason_code:'T06_INDEPENDENT_OWNER'})).status,200);
  const current=rows((await handler.get(path+'/related-conversations')).value.items)[0];assert.ok(current);assert.equal(current.take_allowed,false);const before=(await admin.get(path)).value,responsibility=(await admin.get(path+'/responsibility')).value,events=(await admin.get(path+'/events')).value;
  assert.equal((await handler.post(path+'/assign',command(target.id,[{session_id:current.session_id,expected_row_version:Number(current.session_row_version)}]))).status,403);
  assert.equal((await admin.post(path+'/assign',command(target.id,[{session_id:current.session_id,expected_row_version:1}]))).status,409);
  const foreign=rows((await admin.get('/api/tickets/'+other.ticket.id+'/related-conversations')).value.items)[0];assert.ok(foreign);assert.equal((await admin.get('/api/conversations/'+foreign.session_id)).status,200);
  const refused=await admin.post(path+'/assign',command(target.id,[{session_id:foreign.session_id,expected_row_version:Number(foreign.session_row_version)}]));console.log('T06_COMMUNICATION_REFUSAL '+JSON.stringify({current_ticket_read:true,independent_permission_refused:true,stale_refused:true,foreign_session_read:true,status:refused.status,code:object(refused.value.error).code}));assert.equal(refused.status,404,JSON.stringify(refused.value));
  assert.deepEqual((await admin.get(path)).value,before);assert.deepEqual((await admin.get(path+'/responsibility')).value,responsibility);assert.deepEqual((await admin.get(path+'/events')).value,events);
 },{ticketAssignmentEnabled:true,ticketSelfHandlingWebSource:false});
});

test('failure at the second explicitly selected real Journey Session rolls the first communication write and all Ticket facts back',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{await drain(context);const first=context.tickets[0],target=context.principals[2];assert.ok(first&&target);const path='/api/tickets/'+first.ticket.id,admin=await http(context);
  const leg=(await context.pool.query<{journey_id:string;reporter_identity_hash:string;provider_context_hash:string;channel_identity_hash:string}>('SELECT journey_id::text,reporter_identity_hash,provider_context_hash,channel_identity_hash FROM intake.channel_leg WHERE source_intake_id=$1::uuid',[first.intake.intakeId])).rows[0];assert.ok(leg);
  const inputs=[];for(let n=0;n<2;n++)inputs.push(object(await seedPersistedIntake({pool:context.pool,text:'T06 real selected rollback continuation '+n,requestType:'INCIDENT',status:'RECEIVED'})));await drain(context);const selected:{session_id:string;expected_row_version:number}[]=[];
  for(const input of inputs){const session=(await context.pool.query<{id:string;thread_id:string;row_version:string}>('SELECT id::text,thread_id::text,row_version::text FROM conversation.session WHERE service_intake_id=$1::uuid',[input.intakeId])).rows[0];assert.ok(session);await createContactJourneyStore().ensureLeg({transaction:context.pool,input:{journey_id:leg.journey_id,leg_type:'GROUP_CONTINUATION',source_intake_id:string(input.intakeId),conversation_thread_id:session.thread_id,conversation_session_id:session.id,origin_channel_message_id:string(input.messageId),provider_context_hash:leg.provider_context_hash,channel_identity_hash:leg.channel_identity_hash,reporter_identity_hash:leg.reporter_identity_hash,opened_at:string(input.receivedAt)}});selected.push({session_id:session.id,expected_row_version:Number(session.row_version)});}
  selected.sort((a,b)=>a.session_id.localeCompare(b.session_id));const last=selected.at(-1),earlier=selected[0];assert.ok(last&&earlier);assert.equal(rows((await admin.get(path+'/related-conversations')).value.items).length,3);
  const snapshot=async()=>({ticket:(await admin.get(path)).value,events:(await admin.get(path+'/events')).value,responsibility:(await admin.get(path+'/responsibility')).value,sessions:(await context.pool.query('SELECT id::text,row_version::text,generation_version::text,control_mode FROM conversation.session WHERE id=ANY($1::uuid[]) ORDER BY id',[selected.map(row=>row.session_id)])).rows,counts:(await context.pool.query('SELECT (SELECT count(*) FROM conversation.control_event)::int AS control,(SELECT count(*) FROM conversation.realtime_event)::int AS realtime,(SELECT count(*) FROM pilot_ticket.ticket_handling_cycle)::int AS cycle')).rows});const before=await snapshot(),body=command(target.id,selected);let installed=false;
  try{await context.pool.query('CREATE SEQUENCE platform.t06_first_write_observation');await context.pool.query(`CREATE FUNCTION platform.t06_second_selected_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NOT EXISTS(SELECT 1 FROM conversation.control_event WHERE session_id='${earlier.session_id}'::uuid AND client_command_id=NEW.client_command_id) THEN RAISE EXCEPTION 'T06_FIRST_WRITE_NOT_REACHED'; END IF; PERFORM nextval('platform.t06_first_write_observation'); RAISE EXCEPTION 'T06_SECOND_WRITE_FAILURE_AFTER_FIRST'; END $$`);await context.pool.query(`CREATE TRIGGER t06_second_selected_failure BEFORE INSERT ON conversation.control_event FOR EACH ROW WHEN (NEW.session_id='${last.session_id}'::uuid) EXECUTE FUNCTION platform.t06_second_selected_failure()`);installed=true;const failed=await admin.post(path+'/assign',body);assert.equal(failed.status,503,JSON.stringify(failed.value));assert.equal((await context.pool.query('SELECT is_called FROM platform.t06_first_write_observation')).rows[0]?.is_called,true,'the injected second failure must prove the first real Control event already existed');assert.deepEqual(await snapshot(),before);assert.deepEqual((await context.pool.query('SELECT state FROM pilot_ticket.ticket_command_receipt WHERE client_command_id=$1::uuid',[body.client_command_id])).rows,[{state:'FAILED'}]);assert.equal((await context.pool.query('SELECT 1 FROM conversation.control_event WHERE client_command_id=$1::uuid',[body.client_command_id])).rowCount,0);
  }finally{if(installed)await context.pool.query('DROP TRIGGER t06_second_selected_failure ON conversation.control_event');await context.pool.query('DROP FUNCTION IF EXISTS platform.t06_second_selected_failure()');await context.pool.query('DROP SEQUENCE IF EXISTS platform.t06_first_write_observation');}
  const success=await admin.post(path+'/assign',command(target.id,selected));assert.equal(success.status,200,JSON.stringify(success.value));assert.equal(rows(success.value.conversations).length,2);assert.equal((await admin.get(path)).value.status,'QUEUED');
 },{ticketAssignmentEnabled:true,ticketSelfHandlingWebSource:false});
});
