import assert from 'node:assert/strict';
import {test} from 'node:test';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';

test('T27 expired sensitive recovery retains only its original read-only operation and a confirmed outcome never becomes UNKNOWN when cleanup fails',async()=>{
 await candidateBrowser({purpose:'t27expired',recovery:true},async({candidateId,browser,root,choose})=>{
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);
  await browser.evaluate(`(()=>{const send=fetch;globalThis.fetch=async(path,options)=>{const response=await send(path,options);if(options?.method==='POST'&&String(path)==='/api/incident-candidates/${candidateId}/start-review'){globalThis.__t27ActualCommit={status:response.status,body:await response.clone().json()};throw new TypeError('T27_REAL_ACK_LOST');}return response;};})()`);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('结果未知')`);const transport=record(await browser.evaluate('globalThis.__t27ActualCommit'));assert.equal(transport.status,200);assert.equal(record(transport.body).ok,true);
  const stored=record(await browser.evaluate(candidateCopies));assert.ok(Array.isArray(stored.drafts)&&Array.isArray(stored.operations));assert.equal(stored.operations.length,1);const row=record(stored.drafts[0]),operation=record(stored.operations[0]),id=text(operation.commandId);assert.equal(typeof row.expiresAt,'number');if(typeof row.expiresAt!=='number')throw Error('ORIGINAL_EXPIRY_REQUIRED');
  const previous=await browser.evaluate('performance.timeOrigin');await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:`Date.now=()=>${row.expiresAt+1};`});await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${previous}&&document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('草稿已过期')`);assert.equal(await browser.evaluate('Date.now()'),row.expiresAt+1);const expired=record(await browser.evaluate(candidateCopies));assert.deepEqual(expired.drafts,[]);assert.deepEqual(expired.operations,[operation]);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="人工决定"]').value`),'');assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]'))`),true,'the original opaque operation still requires a read-only receipt after sensitive expiry');assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);
  await browser.evaluate("(()=>{globalThis.__t27Delete=IDBObjectStore.prototype.delete;IDBObjectStore.prototype.delete=function(...args){if(this.name==='operations')throw new DOMException('T27_CONTROLLED_SETTLEMENT_FAILURE','UnknownError');return globalThis.__t27Delete.apply(this,args);};})()");await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('已确认提交')&&document.querySelector(${JSON.stringify(root)}).querySelector('[data-candidate-outcome]').innerText.includes('清理失败')`);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-candidate-outcome]').innerText.includes('结果未知')`),false);assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=submit-candidate]').disabled`),true);assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]'))`),true);assert.deepEqual(record(await browser.evaluate(candidateCopies)).operations,[operation]);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);
  await browser.evaluate('IDBObjectStore.prototype.delete=globalThis.__t27Delete');await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=check-candidate-operation]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-outcome]')?.innerText.includes('已确认提交')&&!document.querySelector(${JSON.stringify(root)}).querySelector('[data-candidate-outcome]').innerText.includes('清理失败')`);assert.deepEqual(record(await browser.evaluate(candidateCopies)).operations,[]);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);const reads=await browser.evaluate('globalThis.__t27DomainReads');assert.ok(Array.isArray(reads));assert.equal(reads.filter(path=>path==='/api/incident-candidates/'+candidateId+'/commands/'+id).length,2);
 });
});
