import {test} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {mkdir,writeFile} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import type {IncomingMessage,ServerResponse} from 'node:http';
import type {PostgresPool} from '../src/platform/postgres-pool.mjs';
import type {P2016EnabledRuntime} from '../src/p2-016-runtime.mjs';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
type Fixture={pool:PostgresPool;runtime:P2016EnabledRuntime;origin:string;cookies:string[];browserCookies:{name:string;value:string;url:string}[];tickets:{ticket:{id:string}}[];principals:{id:string;display_name:string}[]};
function object(value:unknown):Record<string,unknown>{assert.ok(value&&typeof value==='object'&&!Array.isArray(value));return value as Record<string,unknown>;}
function string(value:unknown):string{assert.equal(typeof value,'string');return value as string;}
function failure(value:unknown):unknown{return value instanceof Error?{name:value.name,message:value.message,stack:value.stack}:String(value);}
async function choose(browser:Browser,label:string,value:string){const select=`Array.from(document.querySelectorAll('.ticket-assignment select')).find(input=>Array.from(input.labels??[]).some(label=>label.textContent?.includes(${JSON.stringify(label)})))`;await browser.waitFor(`Boolean((${select})&&Array.from((${select}).options).some(option=>option.value===${JSON.stringify(value)}))`);await browser.evaluate(`(()=>{const input=${select};Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(input,${JSON.stringify(value)});input.dispatchEvent(new Event('change',{bubbles:true}));})()`);}
const stored="new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result.map(row=>({purpose:row.purpose,keys:Object.keys(row)})),operations:operations.result});};};})";

for(const expired of [false,true])test('an UNKNOWN assignment keeps the original UUID through reload and '+(expired?'24h expiry retains only opaque read-only reconciliation':'restores only the currently authorized encrypted purpose'),async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{
  const first=context.tickets[0],owner=context.principals[2],target=context.principals[3],admin=context.cookies[0],cookie=context.cookies[2],browserCookie=context.browserCookies[2];assert.ok(first&&owner&&target&&admin&&cookie&&browserCookie);const path='/api/tickets/'+first.ticket.id;
  const get=async(url:string,current=admin)=>{const response=await fetch(context.origin+url,{headers:{cookie:current}});return {status:response.status,value:object(await response.json())};};const bootstrap=(await get('/api/lifecycle/bootstrap')).value;
  const initial={client_command_id:randomUUID(),expected_version:2,reason_code:'WORKBENCH_ASSIGN',target_principal_id:owner.id,resolver_team_id:'PILOT_IT',communication_choice:'RETAIN_CURRENT',sessions:[]};assert.equal((await fetch(context.origin+path+'/assign',{method:'POST',headers:{cookie:admin,origin:context.origin,'content-type':'application/json','x-csrf-token':String(bootstrap.csrf_token),'idempotency-key':initial.client_command_id,'if-match':'"2"'},body:JSON.stringify(initial)})).status,200);
  const requests:{method:string;path:string;status:number|null;body:unknown}[]=[];
  const observe=(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(browserCookie.name+'='+browserCookie.value))return;const url=new URL(request.url??'/',context.origin);if(!url.pathname.startsWith('/api/'))return;const fact={method:request.method??'',path:url.pathname,status:null as number|null,body:null as unknown};requests.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(fact.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});}
   if(fact.method==='POST'&&fact.path===path+'/transfer-assignment'){const end=response.end.bind(response);response.end=((...args:Parameters<ServerResponse['end']>)=>response.statusCode===200?end('{"ok":true}'):end(...args)) as ServerResponse['end'];}
  };
  context.runtime.server.on('request',observe);const directory=join(tmpdir(),'web01-ui-'+randomUUID());await mkdir(directory);const screenshots:{file:string;width:number;height:number;sha256:string}[]=[];let browser:Browser|undefined,primary:unknown;
  try{
   browser=await launchSystemBrowser({url:context.origin+'/workbench/app/items/ticket/'+first.ticket.id,width:1280,height:900,cookies:[browserCookie]});assert.ok(browser);const active=browser,capture=async(name:string)=>{const bytes=Buffer.from(string(await active.screenshot()),'base64'),file=join(directory,name);await writeFile(file,bytes);screenshots.push({file:file.replaceAll('\\','/'),width:bytes.readUInt32BE(16),height:bytes.readUInt32BE(20),sha256:createHash('sha256').update(bytes).digest('hex')});};
   await browser.waitFor("Boolean(document.querySelector('.ticket-assignment'))&&document.querySelector('[data-realtime-status]')?.dataset.realtimeStatus==='live'");
   assert.equal(await browser.evaluate("Boolean(document.querySelector('[data-assignment-draft-status]'))"),true,'enabled recovery must expose its actual purpose save status before any command is sent');
   await choose(browser,'处理组','PILOT_IT');await choose(browser,'处理人',target.id);await browser.evaluate("document.querySelector('.ticket-assignment input[value=RETAIN_CURRENT]').click()");await browser.waitFor("document.querySelector('[data-assignment-draft-status]')?.textContent.includes('已保存恢复副本')&&document.querySelector('.ticket-assignment [data-action=transfer-assignment]').disabled===false");
   const crypto=object(await browser.evaluate("(async()=>{const row=await new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,read=db.transaction('drafts').objectStore('drafts').getAll();read.onsuccess=()=>{db.close();resolve(read.result.find(row=>row.purpose==='ticket-assignment'));};};});let exportError=null;try{await globalThis.crypto.subtle.exportKey('raw',row.key);}catch(error){exportError=error.name;}return {purpose:row.purpose,extractable:row.key.extractable,algorithm:row.key.algorithm.name,exportError,ttl:row.expiresAt-row.firstSavedAt,bytes:row.ciphertext.byteLength,plaintext:JSON.stringify(row).includes("+JSON.stringify(target.id)+")};})()"));assert.deepEqual({...crypto,bytes:undefined},{purpose:'ticket-assignment',extractable:false,algorithm:'AES-GCM',exportError:'InvalidAccessError',ttl:86400000,plaintext:false,bytes:undefined});assert.ok(Number(crypto.bytes)<=16400);
   await browser.evaluate("document.querySelector('.ticket-assignment [data-action=transfer-assignment]').click()");await browser.waitFor("document.querySelector('.ticket-assignment')?.innerText.includes('结果未知')");const posts=requests.filter(row=>row.method==='POST');assert.equal(posts.length,1);const original=object(posts[0]?.body);assert.equal(original.expected_version,3);assert.equal(original.target_principal_id,target.id);assert.equal((await get(path)).value.assignee_id,target.id);
   assert.equal((await context.pool.query("SELECT count(*)::int AS n FROM pilot_ticket.ticket_event WHERE ticket_id=$1::uuid AND event_type='ticket.assignment_transferred'",[first.ticket.id])).rows[0]?.n,2);
   await browser.command('Page.enable');if(expired)await browser.command('Page.addScriptToEvaluateOnNewDocument',{source:'(()=>{const now=Date.now;Date.now=()=>now()+86400001;})()'});const timeOrigin=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${timeOrigin}&&document.readyState==='complete'`);await browser.waitFor("Boolean(document.querySelector('[data-action=check-assignment-command]'))&&document.querySelector('.ticket-assignment')?.innerText.includes('结果未知')");
   const state=object(await browser.evaluate(stored));assert.ok(Array.isArray(state.operations));assert.equal(state.operations.length,1);const operation=object(state.operations[0]);assert.equal(operation.commandId,original.client_command_id);assert.equal(operation.purpose,'ticket-assignment');assert.equal(JSON.stringify(state.operations).includes(target.id),false);assert.deepEqual(Object.keys(operation).sort(),['commandId','createdAt','id','kind','principal','purpose','scope']);
   assert.equal(requests.filter(row=>row.method==='POST').length,1);assert.equal(requests.some(row=>row.method==='GET'&&row.path.includes('/assignment/commands/')),false,'restoring an unknown intent must not submit or reconcile automatically');assert.equal(await browser.evaluate("document.querySelector('.ticket-assignment [data-action=transfer-assignment]').disabled"),true);
   if(expired){assert.deepEqual(state.drafts,[]);assert.equal(await browser.evaluate("document.querySelector('.ticket-assignment select').value"),'');assert.ok(await browser.evaluate("document.querySelector('[data-assignment-draft-status]').textContent.includes('过期')"));}else{assert.ok(Array.isArray(state.drafts)&&state.drafts.length===1);assert.equal(await browser.evaluate("document.querySelector('.ticket-assignment select').value"),'PILOT_IT');}
   await capture('new-detail-1280.png');await browser.evaluate("document.querySelector('[data-action=check-assignment-command]').click()");await browser.waitFor("document.querySelector('.ticket-assignment')?.innerText.includes('已核对原操作结果：已提交')");assert.equal(requests.filter(row=>row.method==='POST').length,1);assert.equal(requests.filter(row=>row.method==='GET'&&row.path===path+'/assignment/commands/'+original.client_command_id).length,1);assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal((await get(path)).value.version,4);await capture('new-detail-page-1280.png');
   const diagnostic=join(tmpdir(),'t06-recovery-browser-diagnostic-'+randomUUID()+'.json');await writeFile(diagnostic,JSON.stringify({expired,requests,screenshots},null,2));console.log('T06_BROWSER_DIAGNOSTIC '+JSON.stringify({file:diagnostic.replaceAll('\\','/')}));console.log('WEB01_BROWSER '+JSON.stringify({api:'REAL_LOOPBACK_HTTP_PG',staff_handler:true,unknown_original_uuid:true,read_only_ack:true,expired_24h:expired,screenshots}));
  }catch(error){primary=error;console.error('T06_BROWSER_PRIMARY '+JSON.stringify(failure(error)));console.error('T06_BROWSER_FAILURE_DIR '+JSON.stringify({directory:directory.replaceAll('\\','/')}));}
  await closeBrowserTestResources([async()=>{if(primary&&browser){await writeFile(join(directory,'failure.png'),Buffer.from(string(await browser.screenshot()),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify({primary:failure(primary),requests,page:await browser.evaluate('({text:document.body.innerText,url:location.pathname})')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{context.runtime.server.removeListener('request',observe);assert.equal((await context.runtime.observability.metrics()).sse_clients,0);}],primary);
 },{ticketAssignmentEnabled:true,workbenchDraftRecoveryEnabled:true,workbenchRealtimeEnabled:true});
});
