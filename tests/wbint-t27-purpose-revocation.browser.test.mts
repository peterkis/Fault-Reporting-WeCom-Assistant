import assert from 'node:assert/strict';
import {test} from 'node:test';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import {candidateBrowser,record,text} from './helpers/wbint-t27-browser-fixture.mjs';
import {candidateCopies} from './helpers/wbint-t27-draft-observation.mjs';
test('T27 losing the decide purpose while the same candidate remains readable removes sensitive recovery and cannot restore controls',async()=>{
 await candidateBrowser({purpose:'t27purpose',recovery:true},async({pool,f,candidateId,browser,root,choose})=>{
  await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('最长24小时')`);await choose('人工决定','START_REVIEW');await choose('决定原因','OPERATOR_REVIEWED');await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.querySelector('[data-candidate-draft]')?.innerText.includes('已保存恢复副本')`);
  const actor=record(f.admin);await createPilotAccessService({pool}).upsertPrincipal({wecomUserId:text(actor.wecom_user_id),displayName:text(actor.display_name),roles:['HANDLER'],resolverTeamIds:['PILOT_IT']});const fresh=record(await browser.evaluate('fetch("/api/lifecycle/bootstrap").then(response=>response.json())'));assert.equal(fresh.principal_id,actor.id);assert.deepEqual(fresh.roles,['HANDLER']);const current=record(await browser.evaluate(`fetch('/api/incident-candidates/${candidateId}').then(async response=>({status:response.status,body:await response.json()}))`));assert.equal(current.status,200);assert.deepEqual(record(current.body).allowed_scopes,[]);await browser.evaluate(`document.querySelector(${JSON.stringify(root)}).querySelector('[data-action=refresh-candidate]').click()`);await browser.waitFor(`document.querySelector(${JSON.stringify(root)})?.innerText.includes('没有人工决定权限')`);
  let stored:Record<string,unknown>={};for(let i=0;i<100;i++){stored=record(await browser.evaluate(candidateCopies));if(Array.isArray(stored.drafts)&&stored.drafts.length===0)break;await new Promise<void>(resolve=>setTimeout(resolve,50));}assert.deepEqual(stored.drafts,[]);assert.deepEqual(stored.operations,[]);assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(root)}).querySelector('select[aria-label="人工决定"]'))`),false);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);const previous=await browser.evaluate('performance.timeOrigin');await browser.command('Page.reload');await browser.waitFor(`performance.timeOrigin!==${previous}&&document.querySelector(${JSON.stringify(root)})?.innerText.includes('没有人工决定权限')`);assert.deepEqual(record(await browser.evaluate(candidateCopies)).drafts,[]);assert.deepEqual(await browser.evaluate('globalThis.__t27Posts'),[]);
 });
});
