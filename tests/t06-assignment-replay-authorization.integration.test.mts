import {test} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {seedPersistedIntake} from './helpers/p2-015-postgres-harness.mjs';
import {createContactJourneyStore} from '../src/p2-015-contact-journey.mjs';
import {createPilotTicketCore} from '../src/p1-005-pilot-ticket-core.mjs';
import {assertLocalDateTime} from '../src/platform/time-contract.mjs';
import {createPilotAccessService} from '../src/p1-009-pilot-access-workbench.mjs';
import type {PostgresPool} from '../src/platform/postgres-pool.mjs';
import type {P2016EnabledRuntime} from '../src/p2-016-runtime.mjs';
type Fixture={pool:PostgresPool;runtime:P2016EnabledRuntime;origin:string;cookies:string[];tickets:{ticket:{id:string};intake:{intakeId:string}}[];principals:{id:string}[]};
function object(value:unknown):Record<string,unknown>{assert.ok(value&&typeof value==='object'&&!Array.isArray(value));return value as Record<string,unknown>;}
function rows(value:unknown):Record<string,unknown>[]{assert.ok(Array.isArray(value));return value.map(object);}
function string(value:unknown):string{assert.equal(typeof value,'string');return value as string;}
async function http(context:Fixture,index=0){const cookie=context.cookies[index];assert.ok(cookie);const get=async(path:string)=>{const response=await fetch(context.origin+path,{headers:{cookie}});return {status:response.status,value:object(await response.json())};};const bootstrap=(await get('/api/lifecycle/bootstrap')).value;const post=async(path:string,body:Record<string,unknown>)=>{const response=await fetch(context.origin+path,{method:'POST',headers:{cookie,origin:context.origin,'content-type':'application/json','x-csrf-token':String(bootstrap.csrf_token),'idempotency-key':String(body.client_command_id),'if-match':'"'+body.expected_version+'"'},body:JSON.stringify(body)});return {status:response.status,value:object(await response.json())};};return {get,post};}
async function drain(context:Fixture){const initial=await context.runtime.coordinator.backlog(),bound=Math.ceil(initial.total/context.runtime.coordinator.batchSize)+3;for(let step=0;step<bound;step++){const inbound=await context.runtime.coordinator.runOnce(),realtime=await context.runtime.realtimeProjector.runOnce({limit:100});assert.ok(inbound.streams.every(stream=>stream.failures.length===0));if(inbound.processed===0&&realtime.processed===0&&(await context.runtime.coordinator.backlog()).total===0)return;}assert.fail('finite fixture projection did not settle');}
function assignment(target:string,version:number,team='PILOT_IT',sessions:{session_id:string;expected_row_version:number}[]=[]){return {client_command_id:randomUUID(),expected_version:version,reason_code:'WORKBENCH_ASSIGN',target_principal_id:target,resolver_team_id:team,communication_choice:sessions.length?'TRANSFER_SELECTED':'RETAIN_CURRENT',sessions};}
test('COMMITTED compound replay requires current Session READ without requiring the already handed-off TRANSFER write authority',async()=>{
 await withWeb01Fixture(async(context:Fixture)=>{
  const first=context.tickets[0],actor=context.principals[1],owner=context.principals[2];assert.ok(first&&actor&&owner);await drain(context);const path='/api/tickets/'+first.ticket.id,admin=await http(context);
  await context.pool.query("INSERT INTO pilot_ticket.resolver_team(team_id,display_name) VALUES('T06_REPLAY_B','T06 replay target group B')");await context.pool.query("INSERT INTO pilot_ticket.pilot_team_member(principal_id,team_id) VALUES($1::uuid,'T06_REPLAY_B')",[actor.id]);const target=await createPilotAccessService({pool:context.pool}).upsertPrincipal({wecomUserId:'t06-replay-target-'+randomUUID(),displayName:'T06 replay internal target',roles:['HANDLER'],resolverTeamIds:['T06_REPLAY_B']});
  const leg=(await context.pool.query<{journey_id:string;reporter_identity_hash:string;provider_context_hash:string;channel_identity_hash:string}>('SELECT journey_id::text,reporter_identity_hash,provider_context_hash,channel_identity_hash FROM intake.channel_leg WHERE source_intake_id=$1::uuid',[first.intake.intakeId])).rows[0];assert.ok(leg);const input=object(await seedPersistedIntake({pool:context.pool,text:'T06 real related Session retains source group A.',requestType:'INCIDENT',status:'RECEIVED'}));await drain(context);
  const sourceTicket=(await createPilotTicketCore({pool:context.pool}).createForIntake({intakeId:string(input.intakeId),occurredAt:assertLocalDateTime(input.receivedAt),traceId:'t06-replay-source'})).ticket;assert.ok(sourceTicket);const sourcePath='/api/tickets/'+sourceTicket.id;assert.equal((await admin.post(sourcePath+'/assign',assignment(owner.id,sourceTicket.version))).status,200);
  const session=(await context.pool.query<{id:string;thread_id:string;row_version:string}>('SELECT id::text,thread_id::text,row_version::text FROM conversation.session WHERE service_intake_id=$1::uuid',[input.intakeId])).rows[0];assert.ok(session);await createContactJourneyStore().ensureLeg({transaction:context.pool,input:{journey_id:leg.journey_id,leg_type:'GROUP_CONTINUATION',source_intake_id:string(input.intakeId),conversation_thread_id:session.thread_id,conversation_session_id:session.id,origin_channel_message_id:string(input.messageId),provider_context_hash:leg.provider_context_hash,channel_identity_hash:leg.channel_identity_hash,reporter_identity_hash:leg.reporter_identity_hash,opened_at:string(input.receivedAt)}});await drain(context);
  assert.equal((await admin.post(path+'/assign',assignment(owner.id,2))).status,200);const handler=await http(context,2);assert.equal((await handler.get(path)).status,200);assert.equal((await handler.get('/api/conversations/'+session.id)).status,200);const body=assignment(target.id,3,'T06_REPLAY_B',[{session_id:session.id,expected_row_version:Number(session.row_version)}]);body.reason_code='WORKBENCH_TRANSFER';const committed=await handler.post(path+'/transfer-assignment',body);assert.equal(committed.status,200,JSON.stringify(committed.value));assert.equal(rows(committed.value.conversations).length,1);
  const current=(await handler.get(path)).value;assert.equal(current.resolver_team_id,'T06_REPLAY_B');assert.equal(current.assignee_id,target.id);assert.equal(current.version,4);assert.equal((await admin.get(sourcePath)).value.resolver_team_id,'PILOT_IT');const choice=rows((await handler.get(path+'/related-conversations')).value.items).find(row=>row.session_id===session.id);assert.ok(choice);assert.equal(choice.take_allowed,false,'the former communicator no longer has TRANSFER write authority');
  const lawful=await handler.post(path+'/transfer-assignment',body);assert.equal(lawful.status,200,JSON.stringify(lawful.value));assert.equal(lawful.value.replayed,true);assert.deepEqual(lawful.value.conversations,committed.value.conversations);
  await context.pool.query("DELETE FROM pilot_ticket.pilot_team_member WHERE principal_id=$1::uuid AND team_id='PILOT_IT'",[actor.id]);assert.equal((await handler.get(path)).status,200,'group B Ticket access remains authorized');assert.equal((await handler.get('/api/conversations/'+session.id)).status,404,'independent source-group A Session permission was revoked');
  const denied=await handler.post(path+'/transfer-assignment',body);console.log('T06_COMMITTED_REPLAY '+JSON.stringify({ticket_read:200,session_read:404,original_uuid:true,status:denied.status,returned_selected_metadata:Array.isArray(denied.value.conversations)}));assert.equal(denied.status,404,'replay must reauthorize READ before returning a COMMITTED selected Session DTO');assert.equal(JSON.stringify(denied.value).includes(session.id),false);assert.deepEqual((await handler.get(path)).value,current);assert.equal((await context.pool.query('SELECT state FROM pilot_ticket.ticket_command_receipt WHERE client_command_id=$1::uuid',[body.client_command_id])).rows[0]?.state,'COMMITTED');
  const ack=await handler.get(path+'/assignment/commands/'+body.client_command_id);assert.equal(ack.status,200);assert.deepEqual(ack.value,{state:'COMMITTED',ticket_id:first.ticket.id,ticket_version:4,ticket_event_id:committed.value.ticket_event_id});assert.equal(JSON.stringify(ack.value).includes(session.id),false);
 },{ticketAssignmentEnabled:true,ticketSelfHandlingWebSource:false,manualProjection:true,chronologicalTicketEvents:true,workbenchDraftRecoveryEnabled:true});
});
