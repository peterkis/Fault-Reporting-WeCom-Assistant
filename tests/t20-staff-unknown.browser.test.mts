import {test} from 'node:test';
import assert from 'node:assert/strict';
import {writeFile,mkdir} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {randomUUID,createHash} from 'node:crypto';
import {launchSystemBrowser,closeBrowserTestResources} from './helpers/p2-006-browser-harness.mjs';
import {withT11Fixture,t11Http,t11NewTicket} from './helpers/t11-completion-fixture.mjs';
import {createP2016Runtime} from '../src/p2-016-runtime.mjs';
import {yxxTab} from './helpers/p2-g2-yixiaoxiu-browser.mjs';
type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;

test('production PC HANDLER checks its original unknown STAFF_REOPEN by GET without raw storage or resending',async()=>{
 await withT11Fixture(async context=>{
  await context.runtime.stop();const runtime=createP2016Runtime({pool:context.pool,flags:{TICKET_LIFECYCLE_WORKBENCH_ENABLED:true},publicOrigin:context.origin,
   listenPort:Number(new URL(context.origin).port),principalIds:[context.principals[0]?.id??'',context.outsider.id,context.principals[1]?.id??''],externalSendEnabled:false,
   ticketSelfHandlingEnabled:true,ticketStaffCompletionEnabled:true,ticketReopenRoundsEnabled:true});
  if('disabled' in runtime)throw Error('T20_PC_DISABLED');let tab:Browser|undefined,error:unknown;
  const directory=join(tmpdir(),'t20-staff-browser-'+randomUUID());await mkdir(directory);
  try{
   const started=await runtime.start();assert.ok(started.cookies);const current={...context,runtime,cookies:started.cookies.map(c=>c.name+'='+c.value)};
   const http=await t11Http(current,2),bootstrap=await (await http.get('/api/lifecycle/bootstrap')).json() as {roles:string[]};assert.deepEqual(bootstrap.roles,['HANDLER']);
   const ticketId=await t11NewTicket(current),active=await http.start(ticketId);assert.equal((await http.post(ticketId,'complete',http.command(active))).status,200);const closed=await http.detail(ticketId);
   const cookie=started.cookies[2];assert.ok(cookie);assert.equal(typeof cookie.url,'string');
   tab=await launchSystemBrowser({url:context.origin+'/workbench/app/items/ticket/'+ticketId,width:1920,height:1080,cookies:[{...cookie,url:cookie.url as string}]});assert.ok(tab);
   await tab.waitFor("document.querySelector('#detail-title')&&document.querySelector('.properties')?.textContent.includes('已关闭')");
   await tab.waitFor("document.querySelector('.ticket-reopen')?.textContent.includes('工单版本')&&!document.querySelector('.ticket-reopen')?.textContent.includes('正在读取重开权限')");
   assert.equal(await tab.evaluate("Boolean(document.querySelector('[data-action=reopen-ticket]'))"),true,'production PC must expose independent authorized staff reopen');
   await tab.evaluate("(()=>{const original=globalThis.fetch;globalThis.__t20Posts=[];globalThis.__t20Reads=[];globalThis.__t20Statuses=[];globalThis.__t20Responses=[];globalThis.fetch=async(path,options)=>{if(options?.method==='POST'){globalThis.__t20Posts.push({path:String(path),body:JSON.parse(options.body)});const response=await original(path,options);const text=await response.clone().text();globalThis.__t20Responses.push({path:String(path),status:response.status,body:JSON.parse(text)});globalThis.__t20Statuses.push({path:String(path),status:response.status});if(String(path).endsWith('/reopen'))throw new TypeError('SIMULATED_COMMITTED_RESPONSE_LOSS');return response;}const response=await original(path,options);globalThis.__t20Reads.push(String(path));if(String(path).includes('/reopen/commands/'))globalThis.__t20Receipt={path:String(path),status:response.status,state:(await response.clone().json()).state};return response;};})()");
   await tab.evaluate("(()=>{const input=document.querySelector('#reopen-reason');Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(input,'工作人员核实同一故障仍需处置');input.dispatchEvent(new Event('input',{bubbles:true}));})()");
   const before=Buffer.from(await tab.screenshot(),'base64');await writeFile(join(directory,'staff-explicit-reopen-1920.png'),before);
   await tab.evaluate("document.querySelector('[data-action=reopen-ticket]').click()");
   await tab.waitFor("document.querySelector('[data-reopen-state]')?.textContent.includes('结果未知')");
   await writeFile(join(directory,'original-post-observation.json'),JSON.stringify(await tab.evaluate('globalThis.__t20Responses')));
   assert.equal(await tab.evaluate('globalThis.__t20Posts.length'),1);
   assert.deepEqual(await tab.evaluate('globalThis.__t20Statuses'),[{path:'/api/tickets/'+ticketId+'/reopen',status:200}],'the public original POST must complete before its response is deliberately lost');
   assert.equal(await tab.evaluate("Boolean(document.querySelector('[data-action=check-reopen-command]'))"),true,'unknown STAFF_REOPEN requires independent GET-only acknowledgement');
   await tab.evaluate("document.querySelector('[data-action=check-reopen-command]').click()");
   await tab.waitFor("globalThis.__t20Receipt?.status===200&&globalThis.__t20Receipt?.state==='COMMITTED'&&globalThis.__t20Receipt?.path.endsWith(globalThis.__t20Posts[0].body.client_command_id)&&document.querySelector('[data-reopen-follow-up]')?.checkVisibility()===true&&document.querySelector('.ticket-handling-cycle')?.textContent.includes('处理轮次 2')&&!document.querySelector('[data-action=check-reopen-command]')");
   const posts=await tab.evaluate('globalThis.__t20Posts') as {path:string;body:{client_command_id:string;expected_version:number;reason_code:string;note:string}}[];
   assert.equal(posts.length,1);assert.equal(await tab.evaluate(`globalThis.__t20Reads.includes(${JSON.stringify('/api/tickets/'+ticketId+'/reopen/commands/')}+globalThis.__t20Posts[0].body.client_command_id)`),true);assert.equal(posts[0]?.path,'/api/tickets/'+ticketId+'/reopen');assert.equal(posts[0]?.body.expected_version,closed.version);assert.equal(posts[0]?.body.reason_code,'STAFF_REOPEN');assert.equal(posts[0]?.body.note,'工作人员核实同一故障仍需处置');
   const fresh=await http.detail(ticketId);assert.equal(fresh.ticket_no,closed.ticket_no);assert.equal(fresh.assignee_id,null);assert.equal(fresh.status,'REOPENED');assert.equal(fresh.handling_cycle?.cycle_no,2);
   assert.equal(await tab.evaluate(`globalThis.__t20Reads.some(path=>path===${JSON.stringify('/api/tickets/'+ticketId)})`),true);
   assert.equal(await tab.evaluate('document.documentElement.scrollWidth>innerWidth'),false);
   assert.equal((await tab.evaluate('JSON.stringify({local:{...localStorage},session:{...sessionStorage}})') as string).includes(posts[0]?.body.client_command_id??'INVALID'),false);
   assert.deepEqual(await tab.evaluate('indexedDB.databases().then(values=>values.map(value=>value.name))'),[],'raw recovery OFF must not allocate a protected operation store');
   const after=Buffer.from(await tab.screenshot(),'base64');await writeFile(join(directory,'staff-new-round-1920.png'),after);
   console.log('T20_PC_UNKNOWN '+JSON.stringify({directory,role:'HANDLER',production_asset:true,real_http_pg:true,external_calls:0,png:[{file:join(directory,'staff-explicit-reopen-1920.png'),sha256:createHash('sha256').update(before).digest('hex')},{file:join(directory,'staff-new-round-1920.png'),sha256:createHash('sha256').update(after).digest('hex')}]}));
  }catch(failure){error=failure;try{if(tab){await writeFile(join(directory,'failure.png'),Buffer.from(await tab.screenshot(),'base64'));await writeFile(join(directory,'failure.json'),JSON.stringify(await tab.evaluate('({text:document.body.innerText,path:location.pathname})')));}}catch(diagnosticFailure){error=new AggregateError([error,diagnosticFailure],'BROWSER_FAILURE_DIAGNOSTICS');}}
  await closeBrowserTestResources([async()=>{await tab?.close();if(tab)assert.deepEqual(tab.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{await runtime.stop();assert.equal(runtime.server.listening,false);}],error);
 });
});

test('raw OFF HANDLER clears its mounted original UUID on same-scope native invalidation and ignores a late receipt after actual READ loss',{timeout:240_000},async()=>{
 await withT11Fixture(async context=>{
  await context.runtime.stop();const runtime=createP2016Runtime({pool:context.pool,flags:{TICKET_LIFECYCLE_WORKBENCH_ENABLED:true},publicOrigin:context.origin,listenPort:Number(new URL(context.origin).port),principalIds:[context.principals[0]?.id??'',context.outsider.id,context.principals[1]?.id??''],externalSendEnabled:false,ticketSelfHandlingEnabled:true,ticketStaffCompletionEnabled:true,ticketReopenRoundsEnabled:true});
  if('disabled' in runtime)throw Error('T20_MEMORY_RUNTIME_DISABLED');let tab:Browser|undefined,other:Awaited<ReturnType<typeof yxxTab>>|undefined,error:unknown;const directory=join(tmpdir(),'t20-staff-memory-revoked-'+randomUUID());await mkdir(directory);
  try{
   const started=await runtime.start();assert.ok(started.cookies);const current={...context,runtime,cookies:started.cookies.map(value=>value.name+'='+value.value)},http=await t11Http(current,2),bootstrap=await (await http.get('/api/lifecycle/bootstrap')).json() as {roles:string[];principal_id:string;ticket_reopen_draft_recovery_enabled:boolean};assert.deepEqual(bootstrap.roles,['HANDLER']);assert.equal(bootstrap.ticket_reopen_draft_recovery_enabled,false);
   const id=await t11NewTicket(current),active=await http.start(id);assert.equal((await http.post(id,'complete',http.command(active))).status,200);const closed=await http.detail(id),cookie=started.cookies[2];assert.ok(cookie);assert.equal(typeof cookie.url,'string');tab=await launchSystemBrowser({url:context.origin+'/workbench/app/items/ticket/'+id,width:1920,height:1080,cookies:[{...cookie,url:cookie.url as string}]});assert.ok(tab);await tab.waitFor("Boolean(document.querySelector('#reopen-reason'))&&!document.querySelector('.ticket-reopen')?.textContent.includes('正在读取重开权限')");
   await tab.evaluate("(()=>{globalThis.__t20Posts=[];globalThis.__t20Receipts=[];const original=fetch;globalThis.fetch=async(path,options)=>{const target=String(path),response=await original(path,options);if(options?.method==='POST'&&target.endsWith('/reopen')){globalThis.__t20Posts.push({path:target,input:JSON.parse(options.body),status:response.status,response:await response.clone().json()});throw new TypeError('SIMULATED_COMMITTED_RESPONSE_LOSS');}if(target.includes('/reopen/commands/')){globalThis.__t20Receipts.push({path:target,status:response.status,response:await response.clone().json()});await new Promise(resolve=>{globalThis.__releaseT20Receipt=()=>{globalThis.__releasedT20Receipt=true;resolve();};});}return response;};})()");
   await tab.evaluate("(()=>{const input=document.querySelector('#reopen-reason');Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(input,'T20_MEMORY_PRIVATE_CANARY');input.dispatchEvent(new Event('input',{bubbles:true}));})()");await tab.evaluate("document.querySelector('[data-action=reopen-ticket]').click()");await tab.waitFor("document.querySelector('[data-reopen-state]')?.textContent.includes('结果未知')");
   const posts=await tab.evaluate('globalThis.__t20Posts') as {input:{client_command_id:string};status:number;response:{ticket_version:number}}[];const original=posts[0];assert.ok(original);assert.equal(original.status,200);assert.equal(original.response.ticket_version,closed.version+1);await writeFile(join(directory,'original-post-observation.json'),JSON.stringify(posts));assert.equal(await tab.evaluate("Boolean(document.querySelector('[data-action=check-reopen-command]'))"),true);
   await tab.evaluate("document.querySelector('[data-action=check-reopen-command]').click()");await tab.waitFor('globalThis.__t20Receipts.length===1');const receipts=await tab.evaluate('globalThis.__t20Receipts') as {path:string;status:number;response:{state:string}}[];assert.equal(receipts[0]?.path,'/api/tickets/'+id+'/reopen/commands/'+original.input.client_command_id);assert.equal(receipts[0]?.status,200);assert.equal(receipts[0]?.response.state,'COMMITTED');await writeFile(join(directory,'held-original-receipt.json'),JSON.stringify(receipts));
   await context.pool.query('DELETE FROM pilot_ticket.pilot_team_member WHERE principal_id=$1::uuid',[bootstrap.principal_id]);const denied=await http.get('/api/tickets/'+id);assert.equal(denied.status,404);await writeFile(join(directory,'actual-current-read-rejection.json'),JSON.stringify({status:denied.status,body:await denied.json()}));
   // Native transport control after genuine server READ loss; this message grants no business authority.
   other=await yxxTab(tab,context.origin+'/workbench/app');await other.waitFor(`location.origin===${JSON.stringify(context.origin)}&&document.readyState==='complete'`);await other.evaluate(`(()=>{globalThis.__t20Invalidation=new BroadcastChannel('wecom-workbench-drafts-v1');globalThis.__t20Invalidation.postMessage(${JSON.stringify({principal:bootstrap.principal_id,kind:'ticket',id,purpose:'staff-reopen',reason:'revoked'})});})()`);
   await tab.waitFor("document.querySelector('#reopen-reason')?.value===''&&!document.querySelector('[data-action=check-reopen-command]')");await tab.evaluate('globalThis.__releaseT20Receipt()');await tab.waitFor('globalThis.__releasedT20Receipt===true');await tab.evaluate('Promise.resolve().then(()=>Promise.resolve())');assert.equal(await tab.evaluate("Boolean(document.querySelector('[data-action=check-reopen-command]'))"),false);assert.equal(await tab.evaluate("document.querySelector('#reopen-reason')?.value??''"),'');assert.equal(await tab.evaluate("document.body.innerText.includes('T20_MEMORY_PRIVATE_CANARY')"),false);assert.equal(await tab.evaluate('globalThis.__t20Posts.length'),1);assert.deepEqual(await tab.evaluate('indexedDB.databases().then(values=>values.map(value=>value.name))'),[]);
   await tab.evaluate("document.querySelector('[data-action=refresh-reopen]').click()");await tab.waitFor("!document.querySelector('#detail-title')&&!document.querySelector('.ticket-reopen')");const admin=await t11Http(current,0),final=await admin.detail(id);assert.equal(final.status,'REOPENED');assert.equal(final.version,closed.version+1);await writeFile(join(directory,'terminal-facts.json'),JSON.stringify({original_uuid:original.input.client_command_id,post_status:200,held_receipt_status:200,current_read_status:404,native_same_scope_invalidation:true,late_receipt_not_restored:true,new_post_count:0,no_idb:true}));await writeFile(join(directory,'terminal.png'),Buffer.from(await tab.screenshot(),'base64'));console.log('T20_STAFF_MEMORY_REVOKED '+JSON.stringify({directory,role:'HANDLER',raw_enabled:false,native_transport_control:true,current_http_read_status:404}));
  }catch(failure){error=failure;try{await writeFile(join(directory,'primary-error.json'),JSON.stringify(failure instanceof Error?{name:failure.name,message:failure.message,stack:failure.stack}:String(failure)));if(tab){try{await writeFile(join(directory,'failure.png'),Buffer.from(await tab.screenshot(),'base64'));}catch(observation){error=new AggregateError([failure,observation],'T20_MEMORY_OBSERVATION_FAILED');}}}catch(diagnosticFailure){error=new AggregateError([error,diagnosticFailure],'BROWSER_FAILURE_DIAGNOSTICS');}}
  await closeBrowserTestResources([async()=>{await other?.close();},async()=>{await tab?.close();if(tab)assert.deepEqual(tab.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{await runtime.stop();assert.equal(runtime.server.listening,false);}],error);
 });
});
