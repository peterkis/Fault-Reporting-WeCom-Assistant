import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {withWeb01Fixture} from './helpers/web01-workbench-fixture.mjs';
import {seedPersistedIntake} from './helpers/p2-015-postgres-harness.mjs';
import {createContactJourneyStore} from '../app/server/src/p2-015-contact-journey.mjs';
import {acceptedSetup,acceptedOptions,object,rows,text,version} from './helpers/t07-public-fixture.mjs';
import type {T07Fixture} from './helpers/t07-public-fixture.mjs';
test('second canonical communication write failure rolls back the first real Control and all takeover-start facts, then a new explicit command commits one original round',async()=>{
 await withWeb01Fixture(async(f:T07Fixture)=>{
  const s=await acceptedSetup(f);assert.equal((await s.b.post(s.path+'/takeover',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'T07_NETWORK',communication_choice:'RETAIN_CURRENT',sessions:[]})).status,200);
  const leg=(await f.pool.query<{journey_id:string;reporter_identity_hash:string;provider_context_hash:string;channel_identity_hash:string}>('SELECT journey_id::text,reporter_identity_hash,provider_context_hash,channel_identity_hash FROM intake.channel_leg WHERE source_intake_id=$1::uuid',[s.first.intake.intakeId])).rows[0];assert.ok(leg);const inputs=[];
  for(let n=0;n<2;n++)inputs.push(object(await seedPersistedIntake({pool:f.pool,text:'T07 合成实际关联会话 '+n,requestType:'INCIDENT',status:'RECEIVED'})));
  for(let n=0;n<3;n++)await f.runtime.coordinator.runOnce();const selected:{session_id:string;expected_row_version:number}[]=[];
  for(const input of inputs){const session=(await f.pool.query<{id:string;thread_id:string;row_version:string}>('SELECT id::text,thread_id::text,row_version::text FROM conversation.session WHERE service_intake_id=$1::uuid',[input.intakeId])).rows[0];assert.ok(session);await createContactJourneyStore().ensureLeg({transaction:f.pool,input:{journey_id:leg.journey_id,leg_type:'GROUP_CONTINUATION',source_intake_id:text(input.intakeId),conversation_thread_id:session.thread_id,conversation_session_id:session.id,origin_channel_message_id:text(input.messageId),provider_context_hash:leg.provider_context_hash,channel_identity_hash:leg.channel_identity_hash,reporter_identity_hash:leg.reporter_identity_hash,opened_at:text(input.receivedAt)}});selected.push({session_id:session.id,expected_row_version:Number(session.row_version)});}
  selected.sort((a,b)=>a.session_id.localeCompare(b.session_id));const earlier=selected[0],last=selected[1];assert.ok(earlier&&last);const choices=await s.a.get(s.path+'/related-conversations');assert.equal(choices.status,200);assert.equal(rows(choices.value.items).length,3);assert.ok(selected.every(item=>rows(choices.value.items).some(row=>row.session_id===item.session_id&&row.take_allowed===true)));
  const snapshot=async()=>({ticket:(await s.a.get(s.path)).value,events:(await s.a.get(s.path+'/events')).value,communication:(await s.a.get(s.path+'/responsibility')).value,notices:(await s.a.get(s.path+'/deliveries')).value,sessions:(await f.pool.query('SELECT s.id::text,s.row_version::text,s.generation_version::text,s.control_mode,a.assigned_principal_id::text,a.assignment_version::text FROM conversation.session s LEFT JOIN conversation.assignment a ON a.session_id=s.id WHERE s.id=ANY($1::uuid[]) ORDER BY s.id',[selected.map(row=>row.session_id)])).rows,counts:(await f.pool.query('SELECT (SELECT count(*) FROM conversation.control_event)::int AS control,(SELECT count(*) FROM conversation.realtime_event)::int AS realtime,(SELECT count(*) FROM pilot_ticket.ticket_handling_cycle_event)::int AS cycle_links')).rows});
  let settled=false;for(let n=0;n<3;n++){const projected=await f.runtime.realtimeProjector.runOnce({limit:100});if(projected.processed===0){settled=true;break;}}assert.equal(settled,true,'finite original realtime projection must settle before the atomicity snapshot');
  const before=await snapshot(),command={client_command_id:randomUUID(),expected_version:version(before.ticket.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'PILOT_IT',communication_choice:'TAKE_SELECTED',sessions:selected};let installed=false;
  try{
   await f.pool.query('CREATE SEQUENCE platform.t07_first_control_observation');await f.pool.query(`CREATE FUNCTION platform.t07_second_control_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NOT EXISTS(SELECT 1 FROM conversation.control_event WHERE session_id='${earlier.session_id}'::uuid AND client_command_id=NEW.client_command_id) THEN RAISE EXCEPTION 'T07_FIRST_WRITE_NOT_REACHED'; END IF; PERFORM nextval('platform.t07_first_control_observation'); RAISE EXCEPTION 'T07_SECOND_WRITE_AFTER_FIRST'; END $$`);await f.pool.query(`CREATE TRIGGER t07_second_control_failure BEFORE INSERT ON conversation.control_event FOR EACH ROW WHEN (NEW.session_id='${last.session_id}'::uuid) EXECUTE FUNCTION platform.t07_second_control_failure()`);installed=true;
   const failed=await s.a.post(s.path+'/takeover-and-start',command);assert.equal(failed.status,503,JSON.stringify(failed.value));assert.equal((await f.pool.query('SELECT is_called FROM platform.t07_first_control_observation')).rows[0]?.is_called,true,'actual second boundary proves the first real Control write happened');assert.deepEqual(await snapshot(),before);assert.deepEqual((await f.pool.query("SELECT state,command_type FROM pilot_ticket.ticket_command_receipt WHERE client_command_id=$1::uuid",[command.client_command_id])).rows,[{state:'FAILED',command_type:'WORKBENCH_TICKET_TAKEOVER'}]);assert.equal((await f.pool.query('SELECT 1 FROM conversation.control_event WHERE client_command_id=$1::uuid',[command.client_command_id])).rowCount,0);
  }finally{if(installed)await f.pool.query('DROP TRIGGER t07_second_control_failure ON conversation.control_event');await f.pool.query('DROP FUNCTION IF EXISTS platform.t07_second_control_failure()');await f.pool.query('DROP SEQUENCE IF EXISTS platform.t07_first_control_observation');}
  const committed=await s.a.post(s.path+'/takeover-and-start',{...command,client_command_id:randomUUID()});assert.equal(committed.status,200,JSON.stringify(committed.value));const after=await snapshot();assert.equal(after.ticket.status,'IN_PROGRESS');assert.equal(after.ticket.assignee_id,s.owner.id);assert.equal(after.ticket.resolver_team_id,'PILOT_IT');assert.equal(after.ticket.version,version(before.ticket.version)+2);assert.deepEqual(after.ticket.handling_cycle,before.ticket.handling_cycle);assert.deepEqual(after.notices,before.notices);assert.equal(rows(committed.value.conversations).length,2);assert.ok(rows(committed.value.conversations).every(row=>row.changed===true&&row.session_row_version===2));const prior=rows(before.events.items),events=rows(after.events.items);assert.deepEqual(events.slice(0,prior.length),prior);const appended=events.slice(prior.length);assert.deepEqual(appended.map(row=>row.event_type),['ticket.assignment_transferred','ticket.started']);
  const cycle=object(after.ticket.handling_cycle);assert.equal((await f.pool.query('SELECT 1 FROM pilot_ticket.ticket_handling_cycle_event WHERE cycle_id=$1::uuid AND ticket_event_id=ANY($2::uuid[])',[cycle.id,appended.map(row=>row.event_id)])).rowCount,2);assert.equal((await f.pool.query('SELECT 1 FROM pilot_ticket.ticket_handling_cycle WHERE ticket_id=$1::uuid',[s.first.ticket.id])).rowCount,1);console.log('T07_SECOND_SESSION_ATOMICITY '+JSON.stringify({actual_first_write:true,second_failure:503,rollback_all_facts:true,explicit_new_command:200,original_cycle:true}));
 },{...acceptedOptions,manualProjection:true});
});
