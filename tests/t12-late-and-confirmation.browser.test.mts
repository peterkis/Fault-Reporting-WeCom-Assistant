type Browser=NonNullable<Awaited<ReturnType<typeof launchSystemBrowser>>>;
type Fact={method:string;path:string;status:number|null;body:unknown};
async function input(browser:Browser,selector:string,value:string){await browser.evaluate(`(()=>{const element=document.querySelector(${JSON.stringify(selector)});Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(element,${JSON.stringify(value)});element.dispatchEvent(new Event('input',{bubbles:true}));})()`);}
async function fill(browser:Browser,retain=true,team='T07_NETWORK'){await browser.waitFor("document.querySelector('.ticket-takeover-completion select')?.options.length>2&&document.querySelector('.ticket-takeover-completion select').disabled===false");await browser.evaluate(`(()=>{const element=document.querySelector('.ticket-takeover-completion select');Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set.call(element,${JSON.stringify(team)});element.dispatchEvent(new Event('change',{bubbles:true}));})()`);await browser.waitFor("document.querySelector('.ticket-takeover-completion fieldset').disabled===false");if(retain)await browser.evaluate("document.querySelector('.ticket-takeover-completion input[value=RETAIN_CURRENT]').click()");await input(browser,'#takeover-completion-process','T12_LATE_PRIVATE_CANARY');await input(browser,'#takeover-completion-summary','服务恢复，独立确认摘要。');await browser.waitFor("document.querySelector('#takeover-completion-confirmed').disabled===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-confirmed').checked"),true);}
const stored="new Promise((resolve,reject)=>{const open=indexedDB.open('wecom-workbench-drafts-v1');open.onerror=()=>reject(open.error);open.onsuccess=()=>{const db=open.result,tx=db.transaction(['drafts','operations']),drafts=tx.objectStore('drafts').getAll(),operations=tx.objectStore('operations').getAll();tx.oncomplete=()=>{db.close();resolve({drafts:drafts.result.filter(row=>row.purpose==='ticket-takeover-completion'),operations:operations.result.filter(row=>row.purpose==='ticket-takeover-completion')});};};})";
function observe(cookie:{name:string;value:string},origin:string,facts:Fact[]){return(request:IncomingMessage,response:ServerResponse)=>{if(!request.headers.cookie?.includes(cookie.name+'='+cookie.value))return;const path=new URL(request.url??'/',origin).pathname;if(!path.startsWith('/api/'))return;const fact:Fact={method:request.method??'',path,status:null,body:null};facts.push(fact);response.once('finish',()=>{fact.status=response.statusCode;});if(fact.method==='POST'){request.pause();const chunks:Buffer[]=[];request.on('data',(chunk:unknown)=>{if(Buffer.isBuffer(chunk))chunks.push(chunk);});request.once('end',()=>{try{fact.body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{fact.body=null;}});}};}
async function diagnostics(f:T11Fixture,browser:Browser|undefined,directory:string,facts:Fact[],listener:(request:IncomingMessage,response:ServerResponse)=>void,primary:unknown,release?:()=>void){await closeBrowserTestResources([async()=>{release?.();if(browser){const bytes=Buffer.from(text(await browser.screenshot()),'base64'),file=join(directory,primary?'failure.png':'terminal.png');await writeFile(file,bytes);await writeFile(join(directory,'receipt.json'),JSON.stringify({facts,primary_failure:primary instanceof Error?primary.message:null,screenshot:{file:file.replaceAll('\\','/'),sha256:createHash('sha256').update(bytes).digest('hex')}}));await writeFile(join(directory,'page.json'),JSON.stringify(await browser.evaluate('({text:document.body.innerText})')));console.log('T12_LATE_CONFIRM_DIAGNOSTIC '+JSON.stringify({file:join(directory,'receipt.json').replaceAll('\\','/')}));}},async()=>{await browser?.close();if(browser)assert.deepEqual(browser.ownedResourceState(),{processes:0,profiles:0,commandTimers:0,sockets:0});},async()=>{f.runtime.server.removeListener('request',listener);assert.equal((await f.runtime.observability.metrics()).sse_clients,0);}],primary);}

for(const mode of ['late-post','late-ack'] as const)test('actual '+mode+' cannot revive a T12 private capture after a trusted current principal401',async()=>{
 await withT12Profile(async f=>{
  const s=await acceptedSetup(f);assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_LATE_START'})).status,200);const initial=(await s.b.get(s.path)).value,cookie=f.browserCookies[2];assert.ok(cookie);const facts:Fact[]=[],record=observe(cookie,f.origin,facts),hold:{release:(()=>void)|null;reached:boolean}={release:null,reached:false};let obscure=mode==='late-ack';
  const listener=(request:IncomingMessage,response:ServerResponse)=>{record(request,response);if(!request.headers.cookie?.includes(cookie.name+'='+cookie.value))return;const path=new URL(request.url??'/',f.origin).pathname;if(path===s.path+'/takeover-and-complete'||path.startsWith(s.path+'/takeover-completion/commands/')){const end=response.end.bind(response);response.end=((...args:Parameters<ServerResponse['end']>)=>{if(response.statusCode!==200)return end(...args);if(mode==='late-post'&&request.method==='POST'||mode==='late-ack'&&request.method==='GET'){hold.reached=true;hold.release=()=>{hold.release=null;end(...args);};return response;}if(obscure&&request.method==='POST'){obscure=false;return end('{"ok":true}');}return end(...args);}) as ServerResponse['end'];}};
  const directory=join(tmpdir(),'t12-'+mode+'-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;f.runtime.server.on('request',listener);
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[{...cookie,url:text(cookie.url)}]});assert.ok(browser);await fill(browser);await browser.waitFor("document.querySelector('[data-action=takeover-and-complete]').disabled===false");await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').click()");if(mode==='late-ack'){await browser.waitFor("document.querySelector('.ticket-takeover-completion')?.innerText.includes('结果未知')");await browser.evaluate("document.querySelector('[data-action=check-takeover-completion]').click()");}
   let reached=false;for(let n=0;n<100;n++){if(hold.reached){reached=true;break;}await new Promise(resolve=>setTimeout(resolve,20));}assert.equal(reached,true,'the actual committed response must reach the transport hold, not a fabricated collaborator result');assert.equal((await s.b.get(s.path)).value.status,'CLOSED');assert.equal((await s.b.get(s.path)).value.version,version(initial.version)+2);
   const posts=facts.filter(row=>row.method==='POST');assert.equal(posts.length,1);const original=object(posts[0]?.body);assert.equal(rows(object(await browser.evaluate(stored)).operations)[0]?.commandId,original.client_command_id);
   await f.pool.query('UPDATE pilot_ticket.pilot_principal SET is_active=false WHERE id=$1::uuid',[s.actor.id]);assert.equal((await s.b.get('/api/lifecycle/bootstrap')).status,401);await browser.evaluate("document.querySelector('[data-action=refresh-completion]').click()");await browser.waitFor("!document.querySelector('.ticket-takeover-completion')&&!document.querySelector('#detail-title')");
   hold.release?.();await browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await browser.evaluate("Boolean(document.querySelector('.ticket-takeover-completion'))||document.body.innerText.includes('T12_LATE_PRIVATE_CANARY')"),false);assert.deepEqual(object(await browser.evaluate(stored)),{drafts:[],operations:[]});assert.equal(facts.filter(row=>row.method==='POST').length,1);assert.equal(facts.filter(row=>row.method==='GET'&&row.path.startsWith(s.path+'/takeover-completion/commands/')).length,mode==='late-ack'?1:0);assert.equal((await f.pool.query('SELECT count(*)::int AS n FROM pilot_ticket.staff_completion_notification_commitment WHERE ticket_id=$1::uuid',[s.first.ticket.id])).rows[0]?.n,1);
  }catch(error){primary=error;}await diagnostics(f,browser,directory,facts,listener,primary,()=>hold.release?.());
 },{recoveryEnabled:true,notesEnabled:false});
});

test('loss of a selected Session READ removes its current choice and blocks T12 while current Ticket READ and target qualification remain200',async()=>{
 await withT12Profile(async f=>{
  const s=await acceptedSetup(f),access=createPilotAccessService({pool:f.pool});await f.pool.query("INSERT INTO pilot_ticket.resolver_team(team_id,display_name) VALUES('T12_OTHER','合成另一处理组')");await access.upsertPrincipal({wecomUserId:'web01-synthetic-1',displayName:'陈悦',roles:['HANDLER'],resolverTeamIds:['PILOT_IT','T07_NETWORK','T12_OTHER']});assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_SELECTION_SCOPE_START'})).status,200);const started=(await s.b.get(s.path)).value;assert.equal((await s.b.post(s.path+'/takeover',{client_command_id:randomUUID(),expected_version:version(started.version),reason_code:'WORKBENCH_TAKEOVER',resolver_team_id:'T07_NETWORK',communication_choice:'RETAIN_CURRENT',sessions:[]})).status,200);
  const source=rows((await s.a.get(s.path+'/related-conversations')).value.items)[0];assert.ok(source);const session=text(source.session_id);assert.equal((await s.a.post('/api/conversations/'+session+'/release',{client_command_id:randomUUID(),expected_row_version:Number(text(source.session_row_version)),reason_code:'T12_SELECTION_SCOPE_RELEASE'})).status,200);assert.equal(rows((await s.b.get(s.path+'/related-conversations')).value.items)[0]?.take_allowed,true);const cookie=f.browserCookies[2];assert.ok(cookie);const facts:Fact[]=[],listener=observe(cookie,f.origin,facts),directory=join(tmpdir(),'t12-selected-read-loss-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;f.runtime.server.on('request',listener);
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[{...cookie,url:text(cookie.url)}]});assert.ok(browser);await fill(browser,false,'T12_OTHER');await browser.waitFor(`document.querySelector('.ticket-takeover-completion [data-session-choice="${session}"]')?.disabled===false`);await browser.evaluate(`document.querySelector('.ticket-takeover-completion [data-session-choice="${session}"]').click()`);await browser.waitFor("document.querySelector('#takeover-completion-confirmed').checked===false");await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");await browser.waitFor("document.querySelector('[data-action=takeover-and-complete]').disabled===false");
   await access.upsertPrincipal({wecomUserId:'web01-synthetic-1',displayName:'陈悦',roles:['HANDLER'],resolverTeamIds:['T12_OTHER']});assert.equal((await s.b.get(s.path)).status,200);const targets=await s.b.get(s.path+'/takeover-completion-targets?resolver_team_id=T12_OTHER');assert.equal(targets.status,200);assert.deepEqual(targets.value.allowed_actions,['takeover-and-complete']);assert.equal((await s.b.get('/api/conversations/'+session)).status,404);const related=await s.b.get(s.path+'/related-conversations');assert.equal(related.status,200);assert.deepEqual(related.value.items,[]);
   await browser.evaluate("document.querySelector('[data-action=refresh-takeover-completion]').click()");await browser.waitFor(`!document.querySelector('.ticket-takeover-completion [data-session-choice="${session}"]')`);await browser.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');assert.equal(await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').disabled"),true,'absence of a current authorized Session is never proof that an old choice is still eligible');assert.ok(await browser.evaluate("document.querySelector('.ticket-takeover-completion').innerText.includes('已选择 0 个会话')"));assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-confirmed').checked"),false);assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-process').value"),'T12_LATE_PRIVATE_CANARY');assert.equal(await browser.evaluate("Boolean(document.querySelector('#detail-title'))"),true,'one selected Session loss never substitutes for loss of Ticket READ');assert.equal(facts.filter(row=>row.method==='POST').length,0);assert.equal((await s.b.get(s.path)).status,200);assert.equal((await f.pool.query("SELECT 1 FROM pilot_ticket.ticket_command_receipt WHERE command_type='WORKBENCH_TICKET_TAKEOVER_COMPLETION'")).rowCount,0);
  }catch(error){primary=error;}await diagnostics(f,browser,directory,facts,listener,primary);
 },{recoveryEnabled:false});
});

test('every explicitly selected Session edit resets the T12 public preview confirmation before one atomic selected takeover completion',async()=>{
 await withT12Profile(async f=>{
  const s=await acceptedSetup(f);assert.equal((await s.a.post(s.path+'/start',{client_command_id:randomUUID(),expected_version:version(s.before.version),reason_code:'T12_SELECTED_FORM_START'})).status,200);const related=rows((await s.a.get(s.path+'/related-conversations')).value.items)[0];assert.ok(related);const session=text(related.session_id);assert.equal((await s.a.post('/api/conversations/'+session+'/release',{client_command_id:randomUUID(),expected_row_version:Number(text(related.session_row_version)),reason_code:'T12_SELECTED_FORM_RELEASE'})).status,200);const current=rows((await s.b.get(s.path+'/related-conversations')).value.items).find(row=>row.session_id===session);assert.ok(current);assert.equal(current.take_allowed,true);const initial=(await s.b.get(s.path)).value,cookie=f.browserCookies[2];assert.ok(cookie);const facts:Fact[]=[],listener=observe(cookie,f.origin,facts),directory=join(tmpdir(),'t12-selection-confirm-'+randomUUID());await mkdir(directory);let browser:Browser|undefined,primary:unknown;f.runtime.server.on('request',listener);
  try{
   browser=await launchSystemBrowser({url:f.origin+'/workbench/app/items/ticket/'+s.first.ticket.id,width:1280,height:900,cookies:[{...cookie,url:text(cookie.url)}]});assert.ok(browser);await fill(browser,false);await browser.waitFor(`document.querySelector('.ticket-takeover-completion [data-session-choice="${session}"]')?.disabled===false`);await browser.evaluate(`document.querySelector('.ticket-takeover-completion [data-session-choice="${session}"]').click()`);assert.equal(await browser.evaluate("document.querySelector('#takeover-completion-confirmed').checked"),false,'changing selected responsibility requires a fresh public preview confirmation');assert.equal(facts.filter(row=>row.method==='POST').length,0);await browser.evaluate("document.querySelector('#takeover-completion-confirmed').click()");await browser.waitFor("document.querySelector('[data-action=takeover-and-complete]').disabled===false");await browser.evaluate("document.querySelector('[data-action=takeover-and-complete]').click()");await browser.waitFor("document.querySelector('.ticket-takeover-completion')?.innerText.includes('已接管并完工')");const posts=facts.filter(row=>row.method==='POST');assert.equal(posts.length,1);const original=object(posts[0]?.body);assert.equal(posts[0]?.status,200);assert.equal(original.communication_choice,'TAKE_SELECTED');assert.deepEqual(original.sessions,[{session_id:session,expected_row_version:Number(text(current.session_row_version))}]);assert.equal((await s.b.get(s.path)).value.version,version(initial.version)+2);assert.equal((await s.b.get(s.path)).value.status,'CLOSED');assert.deepEqual((await f.pool.query('SELECT state,command_type FROM pilot_ticket.ticket_command_receipt WHERE client_command_id=$1::uuid',[original.client_command_id])).rows,[{state:'COMMITTED',command_type:'WORKBENCH_TICKET_TAKEOVER_COMPLETION'}]);assert.equal((await f.pool.query('SELECT 1 FROM conversation.control_event WHERE client_command_id=$1::uuid',[original.client_command_id])).rowCount,1);
  }catch(error){primary=error;}await diagnostics(f,browser,directory,facts,listener,primary);
 },{recoveryEnabled:false});
});
