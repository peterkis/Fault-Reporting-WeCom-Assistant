import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {test} from 'node:test';
import {withT43Fixture,object,text,rows,version} from './helpers/t43-full-service-fixture.mjs';
import type {Intake} from './helpers/t43-full-service-fixture.mjs';
import {get,post,launch,screenshot,close} from './helpers/t43-service-actions.mjs';
import type {Browser,Screenshot} from './helpers/t43-service-actions.mjs';

test('T43 normal shared-group reports form a human-confirmed Incident, publish a separate safe personal summary and recover individual synthetic deliveries without mutating their Tickets',{timeout:240000},()=>withT43Fixture(async f=>{
 const admin=f.staff[0],handler=f.staff[1],dispatcher=f.staff[2],outsider=f.staff[3];assert.ok(admin&&handler&&dispatcher&&outsider);
 const reports:Intake[]=[];
 for(const reporter of ['synthetic-A','synthetic-B','synthetic-C'])reports.push(await f.inbound('group','测试诊室断网。',reporter));
 for(let index=0;index<2;index++){const report=reports[index];assert.ok(report?.ticketId);const reference=(await f.pool.query<{public_ref:string}>('SELECT public_ref FROM pilot_ticket.reporter_public_ref WHERE ticket_id=$1::uuid',[report.ticketId])).rows[0];assert.ok(reference);const continued=await f.inbound('single','续接工单 '+reference.public_ref+'：测试诊室仍然断网。',index===0?'synthetic-A':'synthetic-B');assert.equal(continued.ticketId,report.ticketId,'the real source continuation must retain the original Core Ticket');}
 const candidate=await f.correlate(),candidatePath='/api/incident-candidates/'+candidate;
 assert.equal((await f.pool.query('SELECT id FROM incident.incident')).rowCount,0,'a correlation candidate is not an Incident');
 const beforeTickets=await Promise.all(reports.map(async report=>{assert.ok(report.ticketId);return {id:report.ticketId,detail:await get(admin,'/api/tickets/'+report.ticketId),events:await get(admin,'/api/tickets/'+report.ticketId+'/events?limit=200')};}));
 const before=await get(admin,candidatePath);assert.equal(before.distinct_reporters,3);await post(admin,candidatePath+'/start-review',{client_command_id:randomUUID(),expected_row_version:text(before.row_version),reason_code:'OPERATOR_REVIEWED'});
 const current=await get(admin,candidatePath),selected=rows(current.report_sources).filter(source=>reports.some(report=>report.intakeId===source.service_intake_id));assert.equal(new Set(selected.map(s=>s.service_intake_id)).size,3);
 const confirmed=await post(admin,candidatePath+'/confirm',{client_command_id:randomUUID(),expected_candidate_version:text(current.row_version),expected_material_basis:text(current.material_basis),reason_code:'CONFIRMED_SHARED_FAULT',confirmed_scope:'LOCAL',owner_principal_id:text(f.principals[1]),owner_team_id:null,selected_report_refs:selected.map(s=>text(s.source_decision_id)),primary_ticket_id:null});
 const id=text(confirmed.result_ref_id),path='/api/incidents/'+id,canary='T43_INCIDENT_PRIVATE_'+randomUUID();
 for(const principal of f.principals.slice(0,3))for(const permission of ['INCIDENT_DELIVERY_RETRY','INCIDENT_DELIVERY_RECONCILE'])f.grants.add(principal+'|'+id+'|'+permission);
 assert.equal((await dispatcher.get(path)).status,200,'the handoff target must already read the precise Incident');assert.equal((await outsider.get(path)).status,404);
 const targets=rows((await get(admin,path+'/owner-transfer-targets?limit=30')).items);assert.ok(targets.some(target=>target.id===f.principals[2]));assert.ok(!targets.some(target=>target.id===f.principals[3]));
 await post(admin,path+'/transfer-owner',{client_command_id:randomUUID(),expected_row_version:text((await get(admin,path)).row_version),reason_code:'OPERATOR_REVIEWED',owner_principal_id:text(f.principals[2]),owner_team_id:'PILOT_IT'});
 await post(admin,path+'/internal-notes',{client_command_id:randomUUID(),expected_row_version:text((await get(admin,path)).row_version),reason_code:'WORKBENCH_INTERNAL_DISPOSITION',audience:'INTERNAL',text:canary});
 const subscriptions=rows((await get(admin,path+'/subscriptions?limit=100')).items),active=subscriptions.filter(row=>row.status==='ACTIVE');assert.equal(active.length,2);const pause=active[0];assert.ok(pause);
 await post(admin,path+'/subscriptions/'+text(pause.id)+'/pause',{client_command_id:randomUUID(),expected_row_version:text((await get(admin,path)).row_version),expected_subscription_version:text(pause.row_version),reason_code:'SUBSCRIPTION_REQUEST'});
 const lifecycle=rows((await get(admin,path+'/notifications?limit=100')).items);assert.equal(lifecycle.filter(row=>row.audience_type==='GROUP').length,1,'one original shared-group route is independent of personal subscription pause');
 let browser:Browser|undefined,error:unknown;const screenshots:Screenshot[]=[];
 try{
  browser=await launch(f,'/workbench/app/incidents/'+id);await browser.waitFor('Boolean(document.querySelector("textarea[aria-label=公开进展摘要]"))');
  assert.equal(await browser.evaluate('document.querySelector("textarea[aria-label=公开进展摘要]").value'),'','the public summary starts independently blank');
  const summary='合成人工公开进展：已定位网络连接，正在分批核验恢复。';
  await browser.evaluate('(()=>{const input=document.querySelector("textarea[aria-label=公开进展摘要]");Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,"value").set.call(input,'+JSON.stringify(summary)+');input.dispatchEvent(new Event("input",{bubbles:true}));})()');
  await browser.waitFor('document.querySelector("[data-action=preview-public-progress]")?.disabled===false');await browser.evaluate('document.querySelector("[data-action=preview-public-progress]").click()');await browser.waitFor('Boolean(document.querySelector("[data-public-progress-preview]"))');
  assert.equal(await browser.evaluate('document.querySelector("[data-public-progress-preview]").textContent.includes('+JSON.stringify(canary)+')'),false);assert.equal(await browser.evaluate('document.querySelector("[data-action=submit-public-progress]").disabled'),true);
  await browser.evaluate('document.querySelector("input[aria-label=确认安全公开摘要]").click()');await browser.waitFor('document.querySelector("[data-action=submit-public-progress]")?.disabled===false');await browser.evaluate('document.querySelector("[data-action=submit-public-progress]").click()');await browser.waitFor('document.querySelector("[data-public-progress-outcome]")?.textContent.includes("已发布")');
  const publications=rows((await get(admin,path+'/public-progress?limit=10')).items);assert.equal(publications.length,1);const publication=publications[0];assert.ok(publication);assert.equal(publication.summary,summary);
  const progressPath=path+'/public-progress/'+text(publication.id)+'/deliveries?limit=30',progress=rows((await get(admin,progressPath)).items);assert.equal(progress.length,1,'paused and no-direct-binding subscribers are excluded');assert.equal(progress[0]?.route,'BOT_DIRECT');assert.equal(progress[0]?.audience,'REPORTER_DIRECT');assert.deepEqual(rows((await get(admin,path+'/notifications?limit=100')).items),lifecycle,'a new public update never broadcasts to the shared group');
  const group=lifecycle.find(row=>row.audience_type==='GROUP'),personal=lifecycle.find(row=>row.audience_type==='REPORTER_DIRECT');assert.ok(group&&personal);const groupId=text(group.delivery_id),personalId=text(personal.delivery_id),groupPath=path+'/notifications/'+groupId;
  // Send a sibling once, then drive UNKNOWN through the original Worker and scoped HTTP control.
  f.setSenderOutcome('ACKNOWLEDGED');await f.deliver(personalId);const sibling=rows((await get(admin,path+'/notifications?limit=100')).items).find(row=>row.delivery_id===personalId);assert.ok(sibling);assert.equal(sibling.status,'SENT');
  f.setSenderOutcome('UNKNOWN');await f.deliver(groupId);const unknown=rows((await get(admin,path+'/notifications?limit=100')).items).find(row=>row.delivery_id===groupId);assert.ok(unknown);assert.equal(unknown.status,'RECONCILIATION_REQUIRED');assert.equal(unknown.side_effect_state,'UNKNOWN');
  assert.equal((await get(handler,groupPath+'/control')).reconcile,false,'owner or HANDLER status does not grant UNKNOWN authority');assert.equal((await get(dispatcher,groupPath+'/control')).reconcile,false,'even a separately granted current DISPATCHER cannot reconcile UNKNOWN');
  const reconcile={client_command_id:randomUUID(),expected_row_version:text((await get(admin,path)).row_version),expected_status:'RECONCILIATION_REQUIRED',expected_side_effect_state:'UNKNOWN',expected_delivery_attempt_count:version(unknown.attempt_count),reason_code:'OPERATOR_CONFIRMED_NOT_SENT',resolution:'CONFIRMED_NOT_SENT_REQUEUE'};
  const callCount=f.senderCalls.length;await post(admin,groupPath+'/reconcile',reconcile);assert.equal(f.senderCalls.length,callCount,'reconciliation itself does not send');f.setSenderOutcome('ACKNOWLEDGED');await f.deliver(groupId);await f.deliver(groupId);assert.equal(f.senderCalls.filter(call=>call.delivery_id===groupId).length,2);assert.equal(f.senderCalls.filter(call=>call.delivery_id===personalId).length,1);
  assert.deepEqual(rows((await get(admin,path+'/notifications?limit=100')).items).find(row=>row.delivery_id===personalId),sibling);
  const progressId=text(progress[0]?.id),progressControlPath=path+'/notifications/'+progressId;f.setSenderOutcome('REJECTED_NOT_APPLIED');await f.deliver(progressId);const failed=rows((await get(admin,progressPath)).items)[0];assert.ok(failed);assert.equal(failed.status,'DEAD_LETTER');assert.equal(failed.side_effect_state,'NOT_ATTEMPTED');assert.equal((await get(handler,progressControlPath+'/control')).retry,false);assert.equal((await get(dispatcher,progressControlPath+'/control')).retry,true);
  const retry={client_command_id:randomUUID(),expected_row_version:text((await get(admin,path)).row_version),expected_status:'DEAD_LETTER',expected_side_effect_state:'NOT_ATTEMPTED',expected_delivery_attempt_count:version(failed.attempt_count),reason_code:'OPERATOR_RETRY'};await post(dispatcher,progressControlPath+'/retry',retry);f.setSenderOutcome('ACKNOWLEDGED');await f.deliver(progressId);assert.equal(rows((await get(admin,progressPath)).items)[0]?.status,'SENT');
  for(const call of f.senderCalls)assert.ok(!JSON.stringify(call.message.content).includes(canary),'private Incident disposition must never enter any external delivery');
  for(const original of beforeTickets){assert.deepEqual(await get(admin,'/api/tickets/'+original.id),original.detail);assert.deepEqual(await get(admin,'/api/tickets/'+original.id+'/events?limit=200'),original.events);}
  await browser.command('Page.reload',{ignoreCache:true});await browser.waitFor('document.querySelector(".detail-body")?.textContent.includes("公开进展摘要")');screenshots.push(await screenshot(browser,'new-detail-page-1280.png'));
  console.log('T43_INCIDENT_DELIVERY '+JSON.stringify({normal_reports:reports.map(r=>r.intakeId),candidate,incident:id,shared_group_routes:1,active_before:2,paused:1,public_personal_routes:progress.length,public_group_routes:0,ticket_facts_unchanged:true,sender:'ORIGINAL_WORKER_RECORDING_ADAPTER_ONLY',attempts:f.senderCalls.map(call=>({delivery_id:call.delivery_id,target_type:call.target_type})),live_send:false}));
 }catch(failure){error=failure;if(browser){try{console.log('T43_INCIDENT_DIAGNOSTIC '+JSON.stringify(await browser.evaluate('({text:document.body.innerText,url:location.href})')));}catch(diagnosticFailure){console.log('T43_SECONDARY_DIAGNOSTIC_FAILURE '+JSON.stringify({message:diagnosticFailure instanceof Error?diagnosticFailure.message:String(diagnosticFailure)}));}}}
 await close(browser,error);console.log('WEB01_BROWSER '+JSON.stringify({api:'REAL_LOOPBACK_HTTP_PG',purpose:'t43-incident-safe-publication-independent-recovery',screenshots}));
},{syntheticDelivery:true}));
