async function reserve(media:YxxH5Media,owner=scope){return media.reserve({scope:owner,input:{schema_version:1,client_command_id:randomUUID(),kind:'IMAGE',mime_type:'image/png',byte_size:PNG.length,duration_ms:null},verifyCurrentWrite:allow});}
async function upload(media:YxxH5Media,ref:string,owner=scope){return media.upload({scope:owner,ref,body:Readable.from([PNG]),verifyCurrentWrite:allow});}
async function bind(pool:PostgresPool,media:YxxH5Media,refs:readonly string[],owner=scope,abort=false){const store=createYxxSelfServiceStore({pool});return store.accept({scope:owner,input:{schema_version:1,client_command_id:randomUUID(),description:'synthetic media integration fault',location:{text:null,unknown:true},service_code:null,impact_scope:'UNKNOWN',reported_department_text:null,extension:null},onBeforeCommit:async({transaction,receipt,replayed})=>{
 if(replayed)return true;assert.ok(receipt);const q=await transaction.query<{intake_id:string;submission_id:string;retention:string}>('SELECT b.intake_id::text,i.primary_web_submission_id::text AS submission_id,b.retention_until_epoch_ms::text AS retention FROM intake.web_request_binding b JOIN intake.service_intake i ON i.id=b.intake_id WHERE b.request_ref=$1',[receipt.request_ref]);const row=q.rows[0];assert.ok(row);await media.claimInTransaction({transaction,scope:owner,refs,intakeId:row.intake_id,submissionId:row.submission_id,requestRef:receipt.request_ref,retentionUntilEpochMs:row.retention});if(abort)throw new Error('synthetic rollback');return true;
 }});}
async function bytes(lease:Awaited<ReturnType<YxxH5Media['read']>>){const chunks:Buffer[]=[];try{for await(const chunk of lease.stream)chunks.push(Buffer.from(chunk));return Buffer.concat(chunks);}finally{await lease.close();}}

