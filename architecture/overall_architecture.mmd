flowchart TB
    subgraph CHANNELS[Service Entry Channels]
        WECOM[Enterprise WeCom]
        PORTAL[Intranet Reporting Portal]
        API[Hospital API Platform]
        ALERT[Monitoring Alerts]
        FUTURE[Future Sources]
    end

    subgraph PLATFORM[Unified Service Platform]
        WADAPTER[WeCom SDK Adapter]
        ICONN[Integration Connector / Receiver]
        CINBOX[Channel Message Inbox]
        IINBOX[Integration Inbox]
        CONV[Conversation Thread / Session]
        INTAKE[Service Intake]
        TICKET[Unified Ticket Core]
        EVENT[Append-only Ticket Event]
        INCIDENT[Incident / Subscription]
        COMM[Communication Outbox / Delivery]
        IOUT[Integration Outbox / Projection]
        WORKBENCH[REST + SSE Workbench]
        PG[(PostgreSQL)]
    end

    subgraph OPTIONAL[Disableable Enhancements]
        RULES[Rules / Catalog]
        AI[DeepSeek Provider]
        OCR[OCR / Media]
    end

    WECOM --> WADAPTER --> CINBOX
    PORTAL --> ICONN
    API --> ICONN
    ALERT --> ICONN
    FUTURE --> ICONN
    ICONN --> IINBOX
    CINBOX --> CONV
    IINBOX --> CONV
    CONV --> INTAKE --> TICKET
    TICKET --> EVENT
    TICKET --> INCIDENT
    TICKET --> COMM --> WADAPTER
    TICKET --> IOUT --> ICONN
    CONV --> WORKBENCH
    TICKET --> WORKBENCH
    CINBOX --> PG
    IINBOX --> PG
    CONV --> PG
    INTAKE --> PG
    TICKET --> PG
    EVENT --> PG
    COMM --> PG
    IOUT --> PG
    CONV -.async.-> RULES
    RULES -.optional.-> AI
    CONV -.optional.-> OCR
    AI -.suggestion/draft only.-> CONV
