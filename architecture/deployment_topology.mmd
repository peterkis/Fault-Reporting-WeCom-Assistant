flowchart TB
    CLOUD[Enterprise WeCom<br/>openws WSS]

    subgraph PILOT[Phase 1 公网试点环境]
        GW1[Gateway Active]
        GW2[Gateway Standby<br/>无活动连接]
        CORE[Pilot Ticket Core<br/>Channel + Intake + Ticket + Event]
        RELAY[Outbox / Delivery Worker]
        H5[Pilot Handler UI / H5]
        PG[(Pilot PostgreSQL)]
        STORE[(Private Object Storage)]
    end

    subgraph ENHANCEMENT[Phase 2 可关闭增强]
        AI[AI / OCR]
    end

    subgraph HOSPITAL[Phase 3 医院环境]
        ADAPTER[Ticket Adapter]
        TICKETS[Hospital Tickets]
        HM[Hospital Identity / Organization]
    end

    GW1 <-->|WSS 443 出站| CLOUD
    GW2 -.standby.-> CLOUD
    GW1 --> CORE
    CORE --> PG
    CORE --> RELAY
    RELAY --> GW1
    CORE --> H5
    GW1 --> STORE
    CORE -.async.-> AI
    CORE -.Phase 3 only.-> ADAPTER
    ADAPTER --> TICKETS
    ADAPTER --> HM
