flowchart TB
    WECOM[Enterprise WeCom openws WSS]

    subgraph CLOUD[2C4G Cloud Host]
        EDGE[Nginx optional]
        APP[Node App / REST / SSE / Workbench]
        WORKER[Node Worker]
        GW[WeCom Gateway Active]
        PG[(PostgreSQL)]
        STORE[(Encrypted Local or External Object Storage)]
    end

    subgraph INTRANET[Hospital Intranet - Phase 3]
        CONNECTOR[Intranet Connector Agent]
        SSO[SSO / Person / Organization APIs]
        PORTAL[New Reporting Portal / Hospital API / Monitoring]
    end

    subgraph EXTERNAL[External AI - Phase 2]
        MODEL[DeepSeek API]
    end

    GW <-->|single outbound WSS 443| WECOM
    EDGE --> APP
    APP --> PG
    WORKER --> PG
    GW --> PG
    APP --> STORE
    WORKER --> STORE
    WORKER -.approved outbound HTTPS.-> MODEL
    CONNECTOR --> SSO
    CONNECTOR --> PORTAL
    CONNECTOR -->|outbound mTLS HTTPS/WSS| EDGE

