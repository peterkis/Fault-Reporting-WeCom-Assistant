stateDiagram-v2
  state CandidateReview {
    [*] --> CANDIDATE
    CANDIDATE --> UNDER_REVIEW: human
    CANDIDATE --> REJECTED: human
    UNDER_REVIEW --> REJECTED: human
    CANDIDATE --> EXPIRED: bounded SYSTEM maintenance
    UNDER_REVIEW --> CONFIRMED: human confirms scope and owner
  }
  state Incident {
    [*] --> CONFIRMED_LOCAL
    [*] --> CONFIRMED_BUILDING
    [*] --> CONFIRMED_CAMPUS
    [*] --> CONFIRMED_HOSPITAL_WIDE
    CONFIRMED_LOCAL --> INVESTIGATING
    CONFIRMED_BUILDING --> INVESTIGATING
    CONFIRMED_CAMPUS --> INVESTIGATING
    CONFIRMED_HOSPITAL_WIDE --> INVESTIGATING
    INVESTIGATING --> RESOLVED
    RESOLVED --> CLOSED
  }
  state IncidentReport {
    [*] --> LINKED: explicit human selection
    LINKED --> UNLINKED: human correction; preserve Ticket
    UNLINKED --> LINKED: human relink
  }
  note right of Incident
    model calls = 0; no reopen
    reporter recovery changes only Report/Subscription
    Ticket lifecycle stays independent
  end note
